import * as tabs from "@zag-js/tabs";
import { createService, ssrService, normalizeProps } from "marko-ui";

export interface Input {
  value?: string;
  valueChange?: (value: string) => void;
}

static const TAB_VALUES = ["one", "two", "three"];

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<const/machineProps=() => ({
  id: uid,
  defaultValue: "one",
  value: input.value,
  onValueChange(details: { value: string }) {
    input.valueChange?.(details.value);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(tabs.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<const/computeUi=() => {
  const api = tabs.connect(svc ?? ssrService(tabs.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    list: api.getListProps(),
    triggers: Object.fromEntries(TAB_VALUES.map((v) => [v, api.getTriggerProps({ value: v })])),
    contents: Object.fromEntries(TAB_VALUES.map((v) => [v, api.getContentProps({ value: v })])),
  };
}/>
<const/ui=(rev, computeUi())/>

<div ...ui.root>
  <div ...ui.list>
    <for|value| of=TAB_VALUES>
      <button ...ui.triggers[value]>Tab ${value}</button>
    </for>
  </div>
  <for|value| of=TAB_VALUES>
    <div ...ui.contents[value]>Content ${value}</div>
  </for>
</div>
