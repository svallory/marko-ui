// base-vega parity: DOM/data-slot/class strings match shadcn
// styles/base-vega/ui/questionnaire.tsx's `QuestionnairePrevious`
// (`buttonVariants({size, variant})` + "col-start-1 row-start-1 min-h-11
// justify-self-start sm:min-h-0", default variant="outline" size="default",
// default label "Previous"). Its underlying primitive
// (`Questionnaire.Previous` in use-render-based `components.tsx`) is
// visible only when `total > 1 && !first`, toggled via `hidden`/`inert`/
// `aria-hidden`/`data-hidden`/`data-visible` (NOT removed from the DOM —
// removing it would break the Actions grid's fixed column assignment),
// and disabled while invisible; clicking calls `goPrevious()`.
import { buttonVariants, type ButtonVariant, type ButtonSize } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import type { QuestionnaireControllerGetter } from "./lib/controller.ts";

export interface Input extends Marko.Input<"button"> {
  controller: QuestionnaireControllerGetter;
  variant?: ButtonVariant;
  size?: ButtonSize;
}

<const/{ controller, variant = "outline", size = "default", class: className, content, onClick, type, disabled: disabledProp = false, tabindex, ...rest }=input/>

<let/_version=controller().versionStore.getSnapshot()>
<lifecycle
  onMount() {
    const unsubscribeVersion = controller().versionStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    });
    const unsubscribeActive = controller().activeItemStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    });
    // Marko merges onMount's RETURNED OBJECT into `this` (returning a bare
    // cleanup function is silently ignored) — onDestroy reads it back.
    return {
      cleanup: () => {
        unsubscribeVersion();
        unsubscribeActive();
      },
    };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<const/visible=(_version >= 0 && controller().total() > 1 && !controller().isFirst())/>

<button
  ...rest
  type=(type ?? "button")
  data-slot="questionnaire-previous"
  data-size=size
  data-variant=variant
  data-hidden=(visible ? undefined : "")
  data-visible=(visible ? "" : undefined)
  aria-hidden=(!visible || undefined)
  hidden=(!visible)
  inert=(!visible)
  disabled=disabledProp
  tabindex=(visible ? tabindex : -1)
  class=cn(buttonVariants({ variant, size }), "col-start-1 row-start-1 min-h-11 justify-self-start sm:min-h-0", className)
  onClick(event: MouseEvent) {
    onClick?.(event);
    if (event.defaultPrevented) return;
    controller().goPrevious();
  }
>
  <if=content>
    <${content}/>
  </if>
  <else>Previous</else>
</button>
