import { emptyMediaVariants, type EmptyMediaVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, EmptyMediaVariants {}

<const/{ variant, class: className, content, ...rest }=input/>

<div
  ...rest
  data-slot="empty-icon"
  data-variant=(variant ?? "default")
  class=cn(emptyMediaVariants({ variant }), className)
>
  <${content}/>
</div>
