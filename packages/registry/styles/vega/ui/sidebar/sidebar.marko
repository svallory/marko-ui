import { cn } from "#lib/utils.ts";

// base-vega parity: matches SidebarTrigger's `collapsible === "none"` branch
// exactly (data-slot="sidebar", class "flex h-full w-(--sidebar-width)
// flex-col bg-sidebar text-sidebar-foreground"). We only wire the shape our
// default registry implements (no mobile Sheet, no desktop
// gap/container/inner group mechanics, no data-state/data-variant/data-side
// attrs) — those require a Sheet primitive and rail/inset mechanics we don't
// have in rhea yet. `collapsible` is accepted for API-shape honesty but is
// not used to switch behavior/markup.
export interface Input extends Marko.Input<"div"> {
  open?: boolean;
  /** Accepted for API parity with base-vega; only the "none" shape is implemented. */
  collapsible?: "offcanvas" | "icon" | "none";
  content?: Marko.Body;
}

<const/{ open, collapsible = "none", class: className, content, ...rest }=input/>

<div
  ...rest
  data-slot="sidebar"
  class=cn("flex h-full w-(--sidebar-width) flex-col bg-sidebar text-sidebar-foreground", className)
>
  <${content}/>
</div>
