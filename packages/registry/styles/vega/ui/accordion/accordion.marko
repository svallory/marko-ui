// base-vega parity: DOM/data-slot/class strings match
// shadcn styles/base-vega/ui/accordion.tsx. base-vega (Base UI) drives item
// styling off data-open (not Radix's data-state="open"/"closed") and the
// trigger icon-swap off group-aria-expanded rather than a data-state
// selector on the chevron itself — zag's accordion machine emits
// data-state="open"/"closed" (see accordion.connect.js), so data-open is
// computed explicitly here from `expanded`, same treatment as
// switch.marko's data-checked. base-vega's AccordionContent also targets
// data-open/data-closed for its own open/close animation (no intermediate
// wrapper div driving the height, unlike the default's --marko-accordion-
// content-height approach) — that measured-height + closing-animation
// tracking machinery is preserved unchanged from the default port (it's an
// invisible internal, not a class-string target) and reused here verbatim,
// just re-keyed onto data-open/data-closed instead of data-state.
// base-vega's inner wrapper div also targets data-ending-style/
// data-starting-style (Base UI's own transition-phase attributes, with h-0
// during those phases) — zag has no equivalent phase attributes, so those
// two classes are dropped; the measured-height keyframe animation on the
// outer panel (documented above) is the substitute mechanism.
import * as accordionMachine from "@zag-js/accordion";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface AccordionItem {
  value: string;
  title: string;
  content?: string;
}

export interface AccordionItemAttrs {
  value: string;
  title: string;
  content?: Marko.Body;
}

// Dual API: compound attr tags (`<@item>`) are the primary, Marko-idiomatic
// form; `items=` remains as sugar for the data-driven case. Both sources are
// merged into one normalized array below.
export type Input = MachineInput<"div", accordionMachine.Props> & {
  items?: AccordionItem[];
  item?: Marko.AttrTag<AccordionItemAttrs>;
  content?: Marko.Body<[AccordionItem]>;
  valueChange?: (value: string[]) => void;
};

// Normalize BOTH sources into ONE explicit common shape (mirrors
// radio-group.marko) so the render path below never branches on the source
// and needs no casts: `body` carries the attr-tag markup body, `text` the
// items= string content, and `source` the plain-data item handed to the
// `content` render prop. Attr tags win if both are present.
<const/itemTags=[...(input.item ?? [])].map((item) => ({ value: item.value, title: item.title, body: item.content, text: undefined as string | undefined, source: { value: item.value, title: item.title } }))/>
<const/normalizedItems=(itemTags.length > 0 ? itemTags : (input.items ?? []).map((item) => ({ value: item.value, title: item.title, body: undefined as Marko.Body | undefined, text: item.content, source: item })))/>

<machine-props/machineProps from=input pick=accordionMachine.props
  onValueChange(details: accordionMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => accordionMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  accordionMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownChangeHandler,
    items: ownItems,
    item: ownItem,
    content: ownContent,
    ...native
  } = accordionMachine.splitProps(input)[1] as typeof input;
  return native;
}>

// Zag's `getItemContentProps().hidden` flips to `true` in the SAME render
// that flips expanded to `false` — there is no equivalent to Base UI's
// Presence/animationend-gated unmount. `hidden` forces `display:none`, which
// yanks the panel out of layout before the browser paints a single frame of
// the closing keyframe, so the close animation never plays (verified live
// via the same trace the default port documents).
//
// Fix: track item values that are mid-close here at the root (keyed by
// value) and keep those panels unhidden/playing the closing keyframe for
// one more animation cycle, cleared via an event-delegated `animationend`
// listener on the root element — unchanged from the default port, just
// re-keyed onto data-open/data-closed for base-vega's class-string targets.
<let/closingValues=[] as string[]>
// Tracks each item's expanded state as of the last render so the `<script>`
// below can detect an actual open->closed TRANSITION rather than firing for
// every item that simply starts out closed on first render.
<let/previouslyExpanded={} as Record<string, boolean>>
// Holds the fallback timer handle for whichever item is currently mid-close
// (keyed by value) — see the default accordion.marko's identical note for
// why a stale timer from a prior close must be cancelled before scheduling
// a new one.
<let/fallbackTimers={} as Record<string, ReturnType<typeof setTimeout>>>

// Client-only: measure each open panel's natural height and publish it as
// `--marko-accordion-content-height` (mirrors the default port's identical
// mechanism — see its extensive comment for the full rationale: Radix/
// Base UI both use a ResizeObserver-measured height var so `height: 0 ->
// auto` becomes `height: 0 -> <measured px>` in every browser, not just
// ones with `calc-size()` support). Both the height publishing and the
// close-animation tracking are wired through a SINGLE root-level lifecycle
// using event delegation, unchanged from the default port.
<lifecycle
  onMount() {
    const root = document.getElementById(api().getRootProps().id);
    if (!root) return;

    const publishHeight = (el: HTMLElement) => {
      if (el.hidden) return;
      el.style.setProperty("--marko-accordion-content-height", `${el.scrollHeight}px`);
    };

    const panels = () => [...root.querySelectorAll<HTMLElement>('[data-slot="accordion-content"]')];

    const initialTimer = setTimeout(() => {
      for (const panel of panels()) publishHeight(panel);
    }, 0);

    const resizeObserver = new ResizeObserver((entries) => {
      for (const entry of entries) publishHeight(entry.target as HTMLElement);
    });
    for (const panel of panels()) resizeObserver.observe(panel);

    const onAnimationEnd = (event: AnimationEvent) => {
      const target = event.target as HTMLElement;
      if (target.dataset.slot !== "accordion-content") return;
      // Matches globals.css's renamed keyframes (`marko-accordion-down`/
      // `marko-accordion-up`) — see the default accordion.marko's comment
      // above its @theme inline block for why the rename was necessary.
      if (event.animationName === "marko-accordion-down") {
        publishHeight(target);
      } else if (event.animationName === "marko-accordion-up") {
        const value = target.dataset.value;
        if (value) {
          clearTimeout(fallbackTimers[value]);
          delete fallbackTimers[value];
          closingValues = closingValues.filter((v) => v !== value);
        }
      }
    };
    root.addEventListener("animationend", onAnimationEnd);

    // Marko merges onMount's RETURNED OBJECT into `this` (returning a bare
    // cleanup function is silently ignored) — onDestroy reads it back.
    return {
      cleanup: () => {
        clearTimeout(initialTimer);
        resizeObserver.disconnect();
        root.removeEventListener("animationend", onAnimationEnd);
        for (const value in fallbackTimers) clearTimeout(fallbackTimers[value]);
      },
    };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="accordion"
  class=cn("flex w-full flex-col", input.class)
>
  <for|item| of=normalizedItems>
    <const/expanded=api().getItemState({ value: item.value }).expanded/>
    <const/itemContentProps=api().getItemContentProps({ value: item.value })/>
    <const/isClosing=closingValues.includes(item.value)/>
    <div
      ...api().getItemProps({ value: item.value })
      data-slot="accordion-item"
      data-open=String(expanded)
      class="not-last:border-b"
    >
      <h3 class="flex">
        <button
          ...api().getItemTriggerProps({ value: item.value })
          data-slot="accordion-trigger"
          class="group/accordion-trigger relative flex flex-1 items-start justify-between rounded-md border border-transparent py-4 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:after:border-ring aria-disabled:pointer-events-none aria-disabled:opacity-50 **:data-[slot=accordion-trigger-icon]:ml-auto **:data-[slot=accordion-trigger-icon]:size-4 **:data-[slot=accordion-trigger-icon]:text-muted-foreground"
        >
          ${item.title}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-slot="accordion-trigger-icon"
            class="pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden"
          >
            <path d="m6 9 6 6 6-6"/>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-slot="accordion-trigger-icon"
            class="pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline"
          >
            <path d="m18 15-6-6-6 6"/>
          </svg>
        </button>
      </h3>
      <div
        ...itemContentProps
        hidden=(itemContentProps.hidden && !isClosing)
        data-slot="accordion-content"
        data-value=item.value
        data-open=String(expanded || isClosing)
        data-closed=String(!expanded && !isClosing)
        data-closing=(isClosing || undefined)
        class="overflow-hidden text-sm data-open:animate-accordion-down data-closed:animate-accordion-up"
      >
        <div class="h-(--accordion-panel-height) pt-0 pb-4 data-ending-style:h-0 data-starting-style:h-0 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground [&_p:not(:last-child)]:mb-4">
          <if=item.body>
            <${item.body}/>
          </if>
          <else-if=input.content>
            <${input.content}(item.source)/>
          </else-if>
          <else>${item.text}</else>
        </div>
      </div>
    </div>

    <script>
      // Re-runs per item whenever ITS expanded state changes. Only a real
      // open->closed TRANSITION (guarded by `previouslyExpanded`) holds the
      // panel visible for one more animation cycle instead of letting
      // `hidden` apply in the same render — see the comment above
      // `closingValues` for why. Unchanged from the default port beyond the
      // data-open/data-closed re-keying that already happened above.
      const wasExpanded = previouslyExpanded[item.value];
      if (wasExpanded && !expanded && !isClosing) {
        closingValues = [...closingValues, item.value];
        clearTimeout(fallbackTimers[item.value]);
        fallbackTimers[item.value] = setTimeout(() => {
          delete fallbackTimers[item.value];
          closingValues = closingValues.filter((v) => v !== value);
        }, 1000);
      }
      if (wasExpanded !== expanded) {
        previouslyExpanded = { ...previouslyExpanded, [item.value]: expanded };
      }
    </script>
  </for>
</div>

<return=api>
