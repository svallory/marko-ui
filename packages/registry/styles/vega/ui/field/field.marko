import { fieldVariants, type FieldVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, FieldVariants {}

<const/{ orientation = "vertical", class: className, content, ...rest }=input/>

<div
  ...rest
  role="group"
  data-slot="field"
  data-orientation=orientation
  class=cn(fieldVariants({ orientation }), className)
>
  <${content}/>
</div>
