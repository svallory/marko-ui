// base-vega parity: DOM/data-slot/class strings match
// shadcn styles/base-vega/ui/dropdown-menu.tsx. base-vega (Base UI) uses
// data-open/data-closed on the popup, data-popup-open/data-open on the
// sub-trigger, and data-highlighted on items; zag emits api().open (boolean)
// and getItemProps highlighted state via data-highlighted already (zag menu
// sets `data-highlighted` itself), so most attrs line up 1:1 — the popup
// open/closed animation state and sub-trigger open state are computed
// explicitly below to keep base-vega's exact class-string targets.
import * as menu from "@zag-js/menu";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface DropdownMenuItem {
  type?: "item" | "separator" | "label";
  value?: string;
  label?: string;
  disabled?: boolean;
  shortcut?: string;
  danger?: boolean;
}

// Attr-tag form of DropdownMenuItem. A SINGLE attr tag name (`item`) carries
// all three kinds (discriminated by `type`) rather than separate
// `item`/`separator`/`label` attr tags: Marko collects each attr-tag NAME
// into its own independent iterable on `input` with no shared ordering
// between differently-named siblings, so
// `<@item>`/`<@separator>`/`<@label>` as distinct tag names could not
// preserve call-site interleaving. One name with a `type` discriminant
// keeps document order intact by construction (same design as
// context-menu.marko). `content` lets an item or label carry a markup body;
// the plain `label` string renders as the fallback when no body is supplied.
export interface DropdownMenuItemAttrs extends DropdownMenuItem {
  content?: Marko.Body;
}

export interface Input {
  trigger: Marko.Body<[Record<string, unknown>]>;
  items?: DropdownMenuItem[];
  item?: Marko.AttrTag<DropdownMenuItemAttrs>;
  select?: (value: string) => void;
  class?: string;
}

<machine-props/machineProps from=input pick=menu.props
  onSelect(details: menu.SelectionDetails) {
    input.select?.(details.value);
  }/>
<service/service machine=() => menu.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  menu.connect(service, normalizeProps)
  service=service
/>

<const/{ class: className, trigger }=input/>
// Normalize whichever source was supplied into ONE entries list so the
// render path below never branches. Attr tags win when present (compound is
// primary per the compound-tag-dx report); `items=` is the fallback.
// `items=` entries never carry a body, so each is mapped into the
// DropdownMenuItemAttrs shape with an explicit undefined `content` — no
// casts needed (mirrors accordion/toggle-group).
<const/attrItems=[...(input.item ?? [])]/>
<const/entries=(attrItems.length > 0 ? attrItems : (input.items ?? []).map((item) => ({ ...item, content: undefined as Marko.Body | undefined })))/>

<${trigger}({ ...api().getTriggerProps(), "data-slot": "dropdown-menu-trigger" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle class="isolate z-50 outline-none" data-slot="dropdown-menu-positioner">
      <div
        ...api().getContentProps()
        data-slot="dropdown-menu-content"
        class=cn(
          "cn-menu-target cn-menu-translucent z-50 max-h-(--available-height) w-(--anchor-width) min-w-32 origin-(--transform-origin) overflow-x-hidden overflow-y-auto rounded-md bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10 duration-100 outline-none data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:overflow-hidden data-closed:fade-out-0 data-closed:zoom-out-95",
          className,
        )
      >
        <for|entry, index| of=entries>
          <if=entry.type === "separator">
            <div ...api().getSeparatorProps() data-slot="dropdown-menu-separator" class="-mx-1 my-1 h-px bg-border"/>
          </if>
          <else if=entry.type === "label">
            <div data-slot="dropdown-menu-label" class="px-2 py-1.5 text-xs font-medium text-muted-foreground data-inset:pl-8">
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
            </div>
          </else>
          <else>
            <div
              ...api().getItemProps({ value: entry.value ?? `item-${index}`, disabled: entry.disabled })
              data-slot="dropdown-menu-item"
              data-variant=(entry.danger ? "destructive" : "default")
              class="group/dropdown-menu-item relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground not-data-[variant=destructive]:focus:**:text-accent-foreground data-inset:pl-8 data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 data-[variant=destructive]:focus:text-destructive dark:data-[variant=destructive]:focus:bg-destructive/20 data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-[variant=destructive]:*:[svg]:text-destructive"
            >
              <if=entry.content>
                <span><${entry.content}/></span>
              </if>
              <else>
                <span>${entry.label}</span>
              </else>
              <if=entry.shortcut>
                <span data-slot="dropdown-menu-shortcut" class="ml-auto text-xs tracking-widest text-muted-foreground group-focus/dropdown-menu-item:text-accent-foreground">${entry.shortcut}</span>
              </if>
            </div>
          </else>
        </for>
      </div>
    </div>
  </if>
</portal>

<return=api>
