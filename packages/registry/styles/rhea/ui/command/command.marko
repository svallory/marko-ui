// base-rhea parity: DOM/data-slot/class strings match
// shadcn styles/base-rhea/ui/command.tsx. base-rhea's Command is built on
// cmdk (CommandPrimitive), which drives its own internal fuzzy-search
// filtering/scoring and marks the active item with data-selected +
// data-[disabled=true]; this repo's command.marko is the zag-combobox-based
// default (see command.marko's header comment there) filtering on
// substring match via `filterGroups`, so cmdk's fuzzy-search/scoring has no
// equivalent here and is not reproduced (documented deviation — substring
// filter only, same as default). data-selected (cmdk's "is the highlighted
// item") is mapped from zag's getItemState({item}).highlighted; disabled
// items are not modeled in CommandItem's shape in either the default or
// this port (no `disabled` field on CommandItem) so data-[disabled=true] is
// never emitted, matching the default's behavior.
//
// CommandDialog (Dialog-wrapped variant) is a composition of this Command
// with the AlertDialog/Dialog primitive and is omitted — no Marko
// default-implementation equivalent exists here to preserve; the plain
// Command below embeds the same "in-data-[slot=dialog-content]" class
// hook verbatim so a caller who portals it into a rhea dialog gets the
// dialog-specific radius automatically.
import * as commandMachine from "@zag-js/combobox";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface CommandItem {
  value: string;
  label: string;
  shortcut?: string;
}

export interface CommandGroup {
  label: string;
  items: CommandItem[];
}

// `collection`, `value`, and `inputValue` are machine-owned in
// combobox.Props but this component derives its own collection from
// `groups` and manages the search query internally, so they are omitted
// here rather than exposed on the public Input.
export type Input = Omit<
  MachineInput<"div", commandMachine.Props>,
  "collection" | "value" | "inputValue"
> & {
  groups: CommandGroup[];
  valueChange?: (value: string) => void;
};

static function filterGroups(groups: CommandGroup[], query: string): CommandGroup[] {
  const normalizedQuery = query.trim().toLowerCase();
  if (!normalizedQuery) return groups;
  return groups
    .map((group) => ({
      ...group,
      items: group.items.filter((item) => item.label.toLowerCase().includes(normalizedQuery)),
    }))
    .filter((group) => group.items.length > 0);
}

<let/query=""/>
<const/filteredGroups=filterGroups(input.groups, query)/>
<const/allItems=filteredGroups.flatMap((group) => group.items)/>

// `collection` is machine-owned but derived from `groups`/`query`, not a
// pass-through of `input`, so it is built here and merged into the props
// closure below rather than passed through <machine-props>'s override
// mechanism — overrides are copied as plain tag input, and a Zag collection
// carries methods that would fail serialization if it crossed that boundary.
<machine-props/machineProps from=input pick=commandMachine.props
  open=true
  inputBehavior="autohighlight"
  selectionBehavior="clear"
  onInputValueChange(details: commandMachine.InputValueChangeDetails) {
    input.onInputValueChange?.(details);
    query = details.inputValue;
  }
  onValueChange(details: commandMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    if (details.value[0] != null) {
      input.valueChange?.(details.value[0]);
    }
  }/>
<const/serviceProps=() => ({
  ...machineProps(),
  collection: commandMachine.collection({
    items: allItems,
    itemToValue: (item: CommandItem) => item.value,
    itemToString: (item: CommandItem) => item.label,
  }),
})/>
<service/service machine=() => commandMachine.machine props=serviceProps/>
<connect/api=(service, normalizeProps) =>
  commandMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    groups: ownGroups,
    valueChange: ownValueChange,
    ...native
  } = commandMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="command" class=cn("flex size-full flex-col overflow-hidden rounded-3xl bg-popover p-1 text-popover-foreground", input.class)>
  <div data-slot="command-input-wrapper" class="p-1 pb-0">
    <div ...api().getControlProps() class="flex h-8 items-center gap-2 rounded-2xl border border-input/30 bg-input/50 px-2.5">
      <input
        ...api().getInputProps()
        data-slot="command-input"
        placeholder=input.placeholder
        class="w-full text-sm outline-hidden placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
      />
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 opacity-50">
        <path d="m21 21-4.34-4.34"/>
        <circle cx="11" cy="11" r="8"/>
      </svg>
    </div>
  </div>
  <div ...api().getContentProps() data-slot="command-list" class="no-scrollbar max-h-72 scroll-py-1 overflow-x-hidden overflow-y-auto outline-none">
    <if=(allItems.length === 0)>
      <div data-slot="command-empty" class="py-6 text-center text-sm">No results found.</div>
    </if>
    <else>
      <for|group, groupIndex| of=filteredGroups>
        <div ...api().getItemGroupProps({ id: `group-${groupIndex}` }) data-slot="command-group" class="overflow-hidden p-1 text-foreground **:[[cmdk-group-heading]]:px-2 **:[[cmdk-group-heading]]:py-1.5 **:[[cmdk-group-heading]]:text-xs **:[[cmdk-group-heading]]:font-medium **:[[cmdk-group-heading]]:text-muted-foreground">
          <div ...api().getItemGroupLabelProps({ htmlFor: `group-${groupIndex}` }) data-slot="command-group-label" class="px-2 py-1.5 text-xs font-medium text-muted-foreground">
            ${group.label}
          </div>
          <for|item| of=group.items>
            <div
              ...api().getItemProps({ item })
              data-slot="command-item"
              data-selected=(api().getItemState({ item }).highlighted ? "true" : undefined)
              class="group/command-item relative flex min-h-7 cursor-default items-center gap-2 rounded-xl px-2 py-1.5 text-sm outline-hidden select-none in-data-[slot=dialog-content]:rounded-2xl data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 data-selected:bg-muted data-selected:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-selected:*:[svg]:text-foreground"
            >
              <span>${item.label}</span>
              <if=item.shortcut>
                <span data-slot="command-shortcut" class="ml-auto text-xs tracking-widest text-muted-foreground group-data-selected/command-item:text-foreground">${item.shortcut}</span>
              </if>
            </div>
          </for>
        </div>
      </for>
    </else>
  </div>
</div>

<return=api>
