// base-rhea parity: DOM/data-slot/class strings match shadcn
// styles/base-rhea/ui/questionnaire.tsx's `Questionnaire` (a thin wrapper
// over `@shadcn/react/questionnaire`'s `Questionnaire.Root`, a plain
// `<form>`).
//
// ARCHITECTURE DEVIATION FROM SOURCE (documented per task instructions):
// the source's `Questionnaire.Root` owns item registration, active-item
// state, and keyboard routing via a `useQuestionnaireRoot` hook and
// broadcasts them to descendants (`Item`, `Choice`, `Input`, `Progress`,
// `Previous`/`Skip`/`Next`/`Submit`) through `QuestionnaireContext`. Marko
// has no context/provider primitive ("React context -> pass values down as
// attrs from a container tag" per this project's stated gotchas), so this
// port creates ONE `QuestionnaireController` instance here
// (lib/controller.ts) and requires every descendant part to receive it
// explicitly via its `controller=` prop — same pattern as
// `../message-scroller/message-scroller-provider.marko`. See
// `lib/controller.ts`'s header comment for exactly which behaviors are
// ported vs. simplified.
//
// Because there is no context to discover child `<QuestionnaireItem>`s
// through, item NAMES must be supplied up front via `items=` (an array of
// `{ name, required?, disabled? }`, matching the source's own `items=`
// prop — see apps/v4/examples/base/questionnaire-*.tsx, which all pass
// `items=` even in the React version) so the controller can compute
// progress/navigation before any item has registered itself.
import { cn } from "#lib/utils.ts";
import { createQuestionnaireController, type QuestionnaireController } from "./lib/controller.ts";
import type { QuestionnaireShortcutMode } from "./lib/types.ts";

export interface QuestionnaireItemDefinition {
  name: string;
  required?: boolean;
  disabled?: boolean;
}

export interface Input extends Omit<Marko.Input<"form">, "onReset" | "onSubmit"> {
  /** Item names/flags, in declaration order. Required — see header comment. */
  items: QuestionnaireItemDefinition[];
  /** Name of the item shown first. Defaults to the first item. */
  defaultItem?: string;
  /** Keyboard shortcut style offered to choices. Defaults to none. */
  shortcuts?: QuestionnaireShortcutMode;
  itemChange?: (item: string) => void;
  onItemChange?: (item: string) => void;
  onReset?: (event: Event) => void;
  onSubmit?: (event: SubmitEvent) => void;
  /** Render-prop body receiving the live controller; the primary way to compose parts. */
  content?: Marko.Body<[QuestionnaireController]>;
}

<const/{
  items,
  defaultItem,
  shortcuts,
  itemChange,
  onItemChange,
  onReset,
  onSubmit,
  class: className,
  content,
  ...rest
}=input/>

<const/controller=createQuestionnaireController({
  itemNames: items.map((item) => item.name),
  defaultItem,
  shortcuts,
})/>

<script>
  for (const item of items) {
    controller.registerItem(item.name, Boolean(item.required), Boolean(item.disabled));
  }
</script>

<lifecycle
  onMount() {
    return controller.activeItemStore.subscribe(() => {
      const next = controller.activeItemStore.getSnapshot();
      if (next) {
        itemChange?.(next);
        onItemChange?.(next);
      }
    });
  }
/>

<form/formEl
  ...rest
  data-slot="questionnaire"
  data-shortcuts=(shortcuts ?? undefined)
  class=cn("flex w-full min-w-0 flex-col gap-6", className)
  onReset(event: Event) {
    onReset?.(event);
    if (event.defaultPrevented) return;
    controller.reset();
  }
  onSubmit(event: SubmitEvent) {
    const firstInvalid = controller.findFirstInvalidItem();
    if (firstInvalid) {
      event.preventDefault();
      controller.setItem(firstInvalid);
      return;
    }
    onSubmit?.(event);
  }
  onKeydown(event: KeyboardEvent) {
    controller.handleKeyDown(event, () => formEl().requestSubmit());
  }
>
  <${content}(controller)/>
</form>
