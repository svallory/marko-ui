// base-rhea parity: DOM/data-slot/class strings match shadcn
// styles/base-rhea/ui/questionnaire.tsx's `QuestionnaireNext`
// (`buttonVariants({size, variant})` + "col-start-3 row-start-1 min-h-11
// justify-self-end sm:min-h-0", default variant="default" size="default",
// default label "Next"). Its underlying primitive is visible only when
// `total > 1 && !last`, toggled via
// `hidden`/`inert`/`aria-hidden`/`data-hidden`/`data-visible` (not removed
// — see previous.marko's header comment; it shares the grid cell with
// Submit, which is visible exactly when Next is not); clicking calls
// `goNext()` (validates the active item first).
import { buttonVariants, type ButtonVariant, type ButtonSize } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import type { QuestionnaireControllerGetter } from "./lib/controller.ts";

export interface Input extends Marko.Input<"button"> {
  controller: QuestionnaireControllerGetter;
  variant?: ButtonVariant;
  size?: ButtonSize;
}

<const/{ controller, variant = "default", size = "default", class: className, content, onClick, type, disabled: disabledProp = false, tabindex, ...rest }=input/>

<let/_version=controller().versionStore.getSnapshot()>
<lifecycle
  onMount() {
    const unsubscribeVersion = controller().versionStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    });
    const unsubscribeActive = controller().activeItemStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    });
    // Marko merges onMount's RETURNED OBJECT into `this` (returning a bare
    // cleanup function is silently ignored) — onDestroy reads it back.
    return {
      cleanup: () => {
        unsubscribeVersion();
        unsubscribeActive();
      },
    };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<const/visible=(_version >= 0 && controller().total() > 1 && !controller().isLast())/>

<button
  ...rest
  type=(type ?? "button")
  data-slot="questionnaire-next"
  data-size=size
  data-variant=variant
  data-hidden=(visible ? undefined : "")
  data-visible=(visible ? "" : undefined)
  aria-hidden=(!visible || undefined)
  hidden=(!visible)
  inert=(!visible)
  disabled=disabledProp
  tabindex=(visible ? tabindex : -1)
  aria-keyshortcuts=(visible && !disabledProp ? "Enter" : undefined)
  class=cn(buttonVariants({ variant, size }), "col-start-3 row-start-1 min-h-11 justify-self-end sm:min-h-0", className)
  onClick(event: MouseEvent) {
    onClick?.(event);
    if (event.defaultPrevented) return;
    controller().goNext();
  }
>
  <if=content>
    <${content}/>
  </if>
  <else>Next</else>
</button>
