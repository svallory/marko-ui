// Guide: /docs/creating-components · adapter internals: /docs/zag-adapter
// Authoring rules: notes/component-authoring.md (v2 pattern)
//
// base-rhea parity: same DOM structure / data-slot / class strings as
// shadcn styles/base-rhea/ui/sheet.tsx. base-rhea (Base UI) drives the
// backdrop/popup transitions off data-starting-style/data-ending-style (CSS
// transition hooks, not the data-open/data-closed animate-in/out classes
// dialog/alert-dialog use). Base UI keeps the popup mounted through
// data-ending-style during the closing transition; zag's dialog machine
// unmounts these elements as soon as api().open goes false (no exit-
// animation phase), so there is no moment at which data-ending-style would
// ever apply in this port — that transition is inert here (documented
// deviation, purely cosmetic exit-transition loss, same class of deviation
// as the alert-dialog precedent's data-closed:* loss). data-starting-style
// is likewise never set: zag mounts already-open, so nothing observes it.
import * as dialogMachine from "@zag-js/dialog";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { buttonVariants } from "../button/variants.ts";
import { sheetVariants, type SheetVariants } from "./variants.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Sheet open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object.
export type Input = MachineInput<"div", dialogMachine.Props> &
  SheetVariants & {
    openChange?: (open: boolean) => void;
    trigger?: Marko.Body<[Record<string, unknown>]>;
    title?: Marko.Body;
    description?: Marko.Body;
    content?: Marko.Body;
    showCloseButton?: boolean;
  };

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=dialogMachine.props
  role="dialog"
  onOpenChange(details: dialogMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => dialogMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  dialogMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, openChange, trigger, title, description, content, side,
// showCloseButton) passes through to the content element: aria-*, data-*...
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    openChange: ownChangeHandler,
    trigger: ownTrigger,
    title: ownTitle,
    description: ownDescription,
    content: ownContent,
    side: ownSide,
    showCloseButton: ownShowCloseButton,
    ...native
  } = dialogMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<const/{ side = "right", showCloseButton = true }=input/>

<if=input.trigger>
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "sheet-trigger" })/>
</if>
<portal>
  <if=api().open>
    <div
      ...api().getBackdropProps()
      data-slot="sheet-overlay"
      class="fixed inset-0 z-50 bg-black/30 transition-opacity duration-150 data-ending-style:opacity-0 data-starting-style:opacity-0 supports-backdrop-filter:backdrop-blur-sm"
    />
    <div ...api().getPositionerProps() data-slot="sheet-positioner" class="contents">
      <div
        ...nativeAttrs()
        ...api().getContentProps()
        data-slot="sheet-content"
        data-side=side
        class=cn(sheetVariants({ side }), input.class)
      >
        <if=input.title || input.description>
          <div data-slot="sheet-header" class="flex flex-col gap-1.5 p-6">
            <if=input.title>
              <h2 ...api().getTitleProps() data-slot="sheet-title" class="cn-font-heading text-base font-medium text-foreground">
                <${input.title}/>
              </h2>
            </if>
            <if=input.description>
              <p ...api().getDescriptionProps() data-slot="sheet-description" class="text-sm text-muted-foreground">
                <${input.description}/>
              </p>
            </if>
          </div>
        </if>
        <if=input.content>
          <${input.content}/>
        </if>
        <if=showCloseButton>
          <button
            ...api().getCloseTriggerProps()
            data-slot="sheet-close"
            class=cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "absolute top-4 right-4 bg-secondary")
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
              <path d="M18 6 6 18"/>
              <path d="m6 6 12 12"/>
            </svg>
            <span class="sr-only">Close</span>
          </button>
        </if>
      </div>
    </div>
  </if>
</portal>

// Parents can receive the api getter: <Sheet/sheetApi/> then
// `sheetApi().open` — it stays live across machine updates.
<return=api>
