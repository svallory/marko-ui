// base-sera parity: DOM/data-slot/class strings match
// shadcn styles/base-sera/ui/calendar.tsx. base-sera wraps react-day-picker
// (react-day-picker's own `data-*` modifier vocabulary — data-selected,
// data-today, data-outside, data-range-start/-middle/-end,
// data-selected-single, data-focused — computed by DayPicker's modifiers)
// with Base UI Buttons for nav/day triggers; this port is `inline`+`open`
// always-true @zag-js/date-picker, so month/day navigation, view switching
// and range/single selection all run through zag's day-picker machine
// instead. zag's `getDayTableCellState()` already exposes the same
// day-cell state vocabulary (selected/today/outsideRange/focused/
// firstInRange/lastInRange/inRange/selectable) so each modifier below is
// mapped 1:1 from that state — see per-field mapping notes at the `weeks`
// const. Caption/dropdown navigation (`captionLayout="dropdown"`,
// month/year <select>s) and `showWeekNumber` are NOT present in the
// existing default calendar this is ported from, so they are intentionally
// left out here too (matches default's scope, not full base-sera prop
// surface) — only `captionLayout="label"` (plain text month/year caption)
// is implemented, and only `buttonVariant="ghost"` styling (the base-sera
// default) is used for nav triggers.
import * as datePickerMachine from "@zag-js/date-picker";
import { CalendarDate, type DateValue } from "@internationalized/date";
import type { MachineInput } from "marko-ui";
import { buttonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";

// Calendar is an inline, always-open date-picker: `open`/`inline`/
// `closeOnSelect` are fixed by this component, not exposed to callers.
// `value`/`valueChange` use plain { year, month, day } objects instead of
// Zag's DateValue so consumers don't need @internationalized/date.
export type Input = Omit<
  MachineInput<"div", datePickerMachine.Props>,
  "open" | "inline" | "closeOnSelect" | "value" | "min" | "max"
> & {
  /** Selected date(s) as plain objects — one entry per selected date (single mode uses a one-element array). */
  value?: { year: number; month: number; day: number }[];
  /** Fires with the full selection as plain date objects whenever it changes; enables `value:=` two-way binding. */
  valueChange?: (value: { year: number; month: number; day: number }[]) => void;
  /** Earliest selectable date (inclusive); days before it render disabled. */
  min?: { year: number; month: number; day: number };
  /** Latest selectable date (inclusive); days after it render disabled. */
  max?: { year: number; month: number; day: number };
};

static function toDateValue(date: { year: number; month: number; day: number }): DateValue {
  return new CalendarDate(date.year, date.month, date.day);
}

static function toPlain(date: DateValue) {
  return { year: date.year, month: date.month, day: date.day };
}

<machine-props/pickedProps from=input pick=datePickerMachine.props
  open=true
  inline=true
  closeOnSelect=false
  onValueChange(details: datePickerMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value.map(toPlain));
  }/>
<const/machineProps=() => ({
  ...pickedProps(),
  value: input.value?.map(toDateValue),
  min: input.min ? toDateValue(input.min) : undefined,
  max: input.max ? toDateValue(input.max) : undefined,
})/>
<service/service machine=() => datePickerMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  datePickerMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const { class: ownClass, valueChange: ownChangeHandler, ...native } = datePickerMachine.splitProps(input)[1];
  return native;
}>

// Per-cell modifier mapping (react-day-picker/base-sera name ← zag
// DayTableCellState field):
//   data-selected      ← selected
//   data-selected-single ← selected && !firstInRange && !lastInRange && !inRange
//     (react-day-picker's "lone selected day, not part of a range")
//   data-range-start    ← firstInRange
//   data-range-end      ← lastInRange
//   data-range-middle   ← inRange && !firstInRange && !lastInRange
//   data-today          ← today
//   data-outside        ← outsideRange
//   data-disabled       ← !selectable (covers disabled/unavailable/out-of-min-max)
//   data-focused        ← focused (drives the group-data-[focused=true]/day
//     ring/z-index treatment that replaces react-day-picker's imperative
//     `ref.current?.focus()` on the DayButton — zag's roving tabIndex/focus
//     management already keeps exactly one trigger tabbable & focused, so
//     the effect from the source is unnecessary here)
<const/weeks=() =>
  api().weeks.map((week) =>
    week.map((date) => {
      const cellState = api().getDayTableCellState({ value: date });
      return {
        cell: api().getDayTableCellProps({ value: date }),
        trigger: api().getDayTableCellTriggerProps({ value: date }),
        label: String(date.day),
        selected: cellState.selected,
        selectedSingle: cellState.selected && !cellState.firstInRange && !cellState.lastInRange && !cellState.inRange,
        rangeStart: cellState.firstInRange,
        rangeEnd: cellState.lastInRange,
        rangeMiddle: cellState.inRange && !cellState.firstInRange && !cellState.lastInRange,
        today: cellState.today,
        outside: cellState.outsideRange,
        disabled: !cellState.selectable,
        focused: cellState.focused,
      };
    }),
  )
/>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="calendar"
  class=cn(
    "group/calendar bg-background p-3 [--cell-radius:0] [--cell-size:--spacing(8)] in-data-[slot=card-content]:bg-transparent in-data-[slot=popover-content]:bg-transparent",
    input.class,
  )
>
  <div ...api().getContentProps() data-slot="calendar-content" class="relative flex flex-col gap-4 md:flex-row">
    <div data-slot="calendar-month" class="flex w-full flex-col gap-4">
      <div data-slot="calendar-nav" class="absolute inset-x-0 top-0 flex w-full items-center justify-between gap-1">
        <button
          ...api().getPrevTriggerProps()
          data-slot="calendar-prev-trigger"
          class=cn(buttonVariants({ variant: "ghost" }), "size-(--cell-size) p-0 select-none aria-disabled:opacity-50")
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip size-4">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span class="sr-only">Previous</span>
        </button>
        <button
          ...api().getNextTriggerProps()
          data-slot="calendar-next-trigger"
          class=cn(buttonVariants({ variant: "ghost" }), "size-(--cell-size) p-0 select-none aria-disabled:opacity-50")
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip size-4">
            <path d="m9 18 6-6-6-6"/>
          </svg>
          <span class="sr-only">Next</span>
        </button>
      </div>
      <div data-slot="calendar-month-caption" class="flex h-(--cell-size) w-full items-center justify-center px-(--cell-size)">
        <button ...api().getViewTriggerProps() data-slot="calendar-caption" class="cn-calendar-caption text-sm font-medium select-none">
          ${api().visibleRangeText.formatted}
        </button>
      </div>
      <table ...api().getTableProps() data-slot="calendar-table" class="w-full border-collapse">
        <thead ...api().getTableHeadProps() data-slot="calendar-table-head">
          <tr class="flex">
            <for|weekDay| of=api().weekDays>
              <th class="flex-1 rounded-(--cell-radius) text-[0.8rem] font-normal text-muted-foreground select-none">
                ${weekDay.narrow}
                <span class="sr-only">${weekDay.long}</span>
              </th>
            </for>
          </tr>
        </thead>
        <tbody ...api().getTableBodyProps() data-slot="calendar-table-body">
          <for|week, i| of=weeks() by=(_, i) => i>
            <tr class="mt-2 flex w-full">
              <for|day, j| of=week by=(_, j) => j>
                <td
                  ...day.cell
                  data-slot="calendar-day"
                  data-selected=String(day.selected)
                  class=cn(
                    "group/day relative aspect-square h-full w-full rounded-(--cell-radius) p-0 text-center select-none [&:last-child[data-selected=true]_button]:rounded-r-(--cell-radius)",
                    day.rangeStart && "relative isolate z-0 rounded-l-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:right-0 after:w-4 after:bg-muted",
                    day.rangeMiddle && "rounded-none",
                    day.rangeEnd && "relative isolate z-0 rounded-r-(--cell-radius) bg-muted after:absolute after:inset-y-0 after:left-0 after:w-4 after:bg-muted",
                    day.today && "rounded-(--cell-radius) bg-muted text-foreground data-[selected=true]:rounded-none",
                    day.outside && "text-muted-foreground aria-selected:text-muted-foreground",
                    day.disabled && "text-muted-foreground opacity-50",
                  )
                >
                  <button
                    ...day.trigger
                    data-slot="calendar-day-button"
                    data-day=day.label
                    data-selected-single=String(day.selectedSingle)
                    data-range-start=String(day.rangeStart)
                    data-range-end=String(day.rangeEnd)
                    data-range-middle=String(day.rangeMiddle)
                    data-today=String(day.today)
                    data-outside=String(day.outside)
                    data-disabled=String(day.disabled)
                    data-focused=String(day.focused)
                    class="relative isolate z-10 flex aspect-square size-auto w-full min-w-(--cell-size) flex-col gap-1 border-0 leading-none font-normal group-data-[focused=true]/day:relative group-data-[focused=true]/day:z-10 group-data-[focused=true]/day:border-ring group-data-[focused=true]/day:ring-[3px] group-data-[focused=true]/day:ring-ring/50 data-[range-end=true]:rounded-(--cell-radius) data-[range-end=true]:rounded-r-(--cell-radius) data-[range-end=true]:bg-primary data-[range-end=true]:text-primary-foreground data-[range-middle=true]:rounded-none data-[range-middle=true]:bg-muted data-[range-middle=true]:text-foreground data-[range-start=true]:rounded-(--cell-radius) data-[range-start=true]:rounded-l-(--cell-radius) data-[range-start=true]:bg-primary data-[range-start=true]:text-primary-foreground data-[selected-single=true]:bg-primary data-[selected-single=true]:text-primary-foreground dark:hover:text-foreground [&>span]:text-xs [&>span]:opacity-70"
                  >
                    ${day.label}
                  </button>
                </td>
              </for>
            </tr>
          </for>
        </tbody>
      </table>
    </div>
  </div>
</div>

<return=api>
