import Separator from "../separator/separator.marko";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  orientation?: "horizontal" | "vertical";
}

<const/{ orientation = "vertical", class: className, content, ...rest }=input/>

<Separator
