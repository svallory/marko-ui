// base-rhea parity: DOM/data-slot/class strings match
// shadcn styles/base-rhea/ui/collapsible.tsx. base-rhea (Base UI) ships this
// component with NO Tailwind classes of its own (data-slot passthrough
// only) — root/trigger/content just forward `...props`/`class` as-is, so
// there is nothing to hardcode here beyond data-slot.
import * as collapsibleMachine from "@zag-js/collapsible";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Collapsible open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object.
export type Input = MachineInput<"div", collapsibleMachine.Props> & {
  openChange?: (open: boolean) => void;
  trigger?: Marko.Body<[Record<string, unknown>]>;
  content: Marko.Body;
};

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=collapsibleMachine.props
  onOpenChange(details: collapsibleMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => collapsibleMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  collapsibleMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, openChange, trigger, content) passes through to the root: aria-*,
// data-*...
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    openChange: ownChangeHandler,
    trigger: ownTrigger,
    content: ownContent,
    ...native
  } = collapsibleMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="collapsible" class=cn(input.class)>
  <if=input.trigger>
    <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "collapsible-trigger" })/>
  </if>
  <div ...api().getContentProps() data-slot="collapsible-content">
    <${input.content}/>
  </div>
</div>

// Parents can receive the api getter: <Collapsible/collapsibleApi/> then
// `collapsibleApi().open` — it stays live across machine updates.
<return=api>
