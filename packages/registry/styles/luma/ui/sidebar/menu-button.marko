import { cn } from "#lib/utils.ts";

// base-rhea parity: implements sidebarMenuButtonVariants (variant:
// default/outline; size: default/sm/lg) as plain cn() composition instead of
// cva. We keep our href/anchor-vs-button pattern instead of base-rhea's
// `render` prop. data-active is emitted as String(!!active) since Marko
// renders bare boolean attrs (see switch.marko comments) and base-rhea's
// classes target `data-active:` (Tailwind data-* boolean variant, which
// matches on a truthy string attribute, not `data-[active=true]:`). We also
// emit data-size=size on the button itself: the source's sibling-selector
// classes (e.g. peer-data-[size=default]/menu-button:) are consumed by
// SidebarMenuAction/SidebarMenuBadge — parts we do not port — but the
// button also carries `peer/menu-button` itself, so emitting data-size here
// keeps the attribute contract honest for any future sibling parts.
// tooltip prop is skipped entirely: no Tooltip primitive is available in
// this registry.
export interface Input extends Marko.Input<"button"> {
  /** Renders an <a> instead of a <button> when set (with href passed through rest). */
  asChild?: boolean;
  active?: boolean;
  href?: string;
  variant?: "default" | "outline";
  size?: "default" | "sm" | "lg";
}

<const/{
  asChild,
  active,
  variant = "default",
  size = "default",
  class: className,
  content,
  href,
  ...rest
}=input/>

<const/base="peer/menu-button group/menu-button flex w-full items-center gap-2 overflow-hidden rounded-xl px-3 py-2 text-left text-sm whitespace-nowrap ring-sidebar-ring outline-hidden transition-[width,height,padding] duration-200 group-has-data-[sidebar=menu-action]/menu-item:pr-8 group-data-[collapsible=icon]:size-8! group-data-[collapsible=icon]:p-2! hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-3 active:bg-sidebar-accent active:text-sidebar-accent-foreground disabled:pointer-events-none disabled:opacity-50 has-[>svg:first-child]:pl-2.5 has-[>svg:last-child]:pr-2.5 aria-disabled:pointer-events-none aria-disabled:opacity-50 data-open:hover:bg-sidebar-accent data-open:hover:text-sidebar-accent-foreground data-active:bg-sidebar-accent data-active:font-medium data-active:text-sidebar-accent-foreground [&_svg]:size-4 [&_svg]:shrink-0 [&>span:last-child]:truncate"/>

<const/variantClass=(variant === "outline"
  ? "bg-background shadow-[0_0_0_1px_hsl(var(--sidebar-border))] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground hover:shadow-[0_0_0_1px_hsl(var(--sidebar-accent))]"
  : "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")/>

<const/sizeClass=(size === "sm"
  ? "h-7 text-xs"
  : size === "lg"
  ? "h-12 px-3 text-sm group-data-[collapsible=icon]:p-0!"
  : "h-8 text-sm")/>

<const/menuButtonClass=cn(base, variantClass, sizeClass, className)/>

<if=href>
  <a
    ...rest
    href=href
    data-slot="sidebar-menu-button"
    data-sidebar="menu-button"
    data-size=size
    data-active=String(!!active)
    class=menuButtonClass
  >
    <${content}/>
  </a>
</if>
<else>
  <button
    ...rest
    type="button"
    data-slot="sidebar-menu-button"
    data-sidebar="menu-button"
    data-size=size
    data-active=String(!!active)
    class=menuButtonClass
  >
    <${content}/>
  </button>
</else>
