// Built on the REAL @zag-js/drawer machine (drag-to-dismiss, snap points,
// swipe-to-open areas) — not the dialog machine.
// Authoring rules: notes/component-authoring.md (v2 pattern)
//
// base-luma parity: DOM structure / data-slot names / class strings match
// shadcn styles/base-luma/ui/drawer.tsx (Base UI's Drawer primitive) as
// closely as a Zag-machine port allows. Notable deviations, all forced by
// the default (zag) port's DOM shape rather than a styling choice:
//   - base-luma's tsx has NO "drawer-body" slot (children pass straight into
//     DrawerContent) and no built-in close button — both are default-marko
//     features (hideCloseTrigger / content body) preserved here unstyled by
//     the tsx; drawer-body gets no tsx-sourced classes (there are none to
//     copy) and drawer-close reuses the default's own classes verbatim
//     since base-luma has nothing at that data-slot.
//   - base-luma's overlay/backdrop uses swipe-progress-driven opacity
//     (`--drawer-swipe-progress`) and `data-ending-style`/`data-starting-style`
//     transition hooks that only exist on Base UI's own Backdrop primitive;
//     Zag's drawer machine unmounts the backdrop on close (no exit-animation
//     phase) and doesn't publish a swipe-progress custom property, so those
//     specific selectors are inert here — kept in the copied class string
//     for parity/documentation, per the alert-dialog precedent, rather than
//     silently dropped.
//   - base-luma's Popup uses `data-ending-style`/`data-starting-style`
//     (Base UI transition-status attrs) for the closed transform; Zag has no
//     equivalent (elements unmount on close), so — as with the backdrop —
//     those selectors are present but inert.
//   - `data-modal={modal}` is reproduced as a literal string ("true"/"false")
//     per gotcha #1 below; base-luma's Viewport gets it from a plain boolean
//     prop passed straight through by Base UI's className engine, so no
//     explicit stringification was needed there.
import * as drawerMachine from "@zag-js/drawer";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import {
  drawerContentVariants,
  drawerGrabberVariants,
  drawerGrabberIndicatorVariants,
} from "./variants.ts";

export type Input = MachineInput<"div", drawerMachine.Props> & {
  /** Sugar for onOpenChange — receives the plain boolean, enables `open:=state`. */
  openChange?: (open: boolean) => void;
  /** Sugar for onSnapPointChange — receives the plain snap point. */
  snapPointChange?: (snapPoint: drawerMachine.SnapPoint | null) => void;
  /** Sugar for onTriggerValueChange — receives the plain trigger value. */
  triggerValueChange?: (value: string | null) => void;
  /** Render-prop trigger: `<@trigger|props|><Button ...props/></@trigger>`. */
  trigger?: Marko.Body<[Record<string, unknown>]>;
  title?: Marko.Body;
  description?: Marko.Body;
  content?: Marko.Body;
  footer?: Marko.Body;
  /** Hide the vaul-style grab handle (dragging the content body still works). */
  hideGrabber?: boolean;
  /** Whether the content body itself is draggable, or only the grabber. */
  draggable?: boolean;
  /** Render an edge swipe area that opens the drawer by swiping inward. */
  swipeArea?: boolean;
  /** Show the top-right close button. */
  hideCloseTrigger?: boolean;
};

<machine-props/machineProps from=input pick=drawerMachine.props
  onOpenChange(details: drawerMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }
  onSnapPointChange(details: drawerMachine.SnapPointChangeDetails) {
    input.onSnapPointChange?.(details);
    input.snapPointChange?.(details.snapPoint);
  }
  onTriggerValueChange(details: drawerMachine.TriggerValueChangeDetails) {
    input.onTriggerValueChange?.(details);
    input.triggerValueChange?.(details.value);
  }/>
<service/service machine=() => drawerMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  drawerMachine.connect(service, normalizeProps)
  service=service
/>

// Everything that is neither machine-owned (splitProps) nor component-owned
// passes through to the root wrapper. Leaking a component-owned prop here
// would render it as a bogus DOM attribute.
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    openChange: ownOpenChange,
    snapPointChange: ownSnapPointChange,
    triggerValueChange: ownTriggerValueChange,
    trigger: ownTrigger,
    title: ownTitle,
    description: ownDescription,
    content: ownContent,
    footer: ownFooter,
    hideGrabber: ownHideGrabber,
    draggable: ownDraggable,
    swipeArea: ownSwipeArea,
    hideCloseTrigger: ownHideCloseTrigger,
    ...native
  } = drawerMachine.splitProps(input)[1];
  return native;
}>

// The machine resolves logical `start`/`end` against `dir`, so the physical
// direction that drives our layout classes must be read back off the api.
<const/contentProps=() => api().getContentProps({ draggable: input.draggable ?? true })>
<const/swipeDirection=() =>
  contentProps()["data-swipe-direction"] as "up" | "down" | "left" | "right">

<div ...nativeAttrs() data-slot="drawer">
  <if=input.trigger>
    <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "drawer-trigger" })/>
  </if>

  <if=input.swipeArea>
    <div
      ...api().getSwipeAreaProps()
      data-slot="drawer-swipe-area"
      class="fixed z-40 data-[swipe-direction=down]:inset-x-0 data-[swipe-direction=down]:bottom-0 data-[swipe-direction=down]:h-6 data-[swipe-direction=up]:inset-x-0 data-[swipe-direction=up]:top-0 data-[swipe-direction=up]:h-6 data-[swipe-direction=left]:inset-y-0 data-[swipe-direction=left]:left-0 data-[swipe-direction=left]:w-6 data-[swipe-direction=right]:inset-y-0 data-[swipe-direction=right]:right-0 data-[swipe-direction=right]:w-6"
    />
  </if>

  <portal>
    <if=api().open>
      <div
        ...api().getBackdropProps()
        data-slot="drawer-overlay"
        data-open="true"
        class="fixed inset-0 z-50 min-h-dvh bg-black/30 opacity-[max(var(--drawer-overlay-min-opacity,0),calc(1-var(--drawer-swipe-progress)))] transition-opacity duration-450 ease-[cubic-bezier(0.32,0.72,0,1)] select-none data-ending-style:pointer-events-none data-ending-style:opacity-0 data-ending-style:duration-[calc(var(--drawer-swipe-strength)*400ms)] data-snap-points:[--drawer-overlay-min-opacity:0.5] data-starting-style:opacity-0 data-swiping:duration-0 supports-backdrop-filter:backdrop-blur-sm supports-[-webkit-touch-callout:none]:absolute"
      />
      <div
        ...api().getPositionerProps()
        data-slot="drawer-viewport"
        data-modal="true"
        class="pointer-events-none fixed inset-0 z-50 select-none data-[modal=true]:pointer-events-auto"
      >
        // No style= attribute on this element, ever: Zag owns its inline
        // transform and every --drawer-* custom property here.
        <div
          ...contentProps()
          data-slot="drawer-popup"
          data-open="true"
          class=cn(
            drawerContentVariants({ swipeDirection: swipeDirection() }),
            input.class,
          )
        >
          <if=!input.hideGrabber>
            <div
              ...api().getGrabberProps()
              data-slot="drawer-swipe-handle"
              aria-hidden="true"
              class=drawerGrabberVariants({ swipeDirection: swipeDirection() })
            >
              <div
                ...api().getGrabberIndicatorProps()
                data-slot="drawer-grabber-indicator"
                class=drawerGrabberIndicatorVariants({
                  swipeDirection: swipeDirection(),
                })
              />
            </div>
          </if>

          <div
            data-slot="drawer-content"
            class="flex min-h-0 flex-1 flex-col overflow-hidden overscroll-contain rounded-[inherit] transition-opacity duration-300 ease-[cubic-bezier(0.45,1.005,0,1.005)] select-text group-data-nested-drawer-open/drawer-popup:opacity-0 group-data-nested-drawer-swiping/drawer-popup:opacity-100 group-data-swiping/drawer-popup:select-none"
          >
            <if=input.title || input.description>
              <div data-slot="drawer-header" class="flex shrink-0 flex-col gap-0.5 p-4 pb-0 group-data-[swipe-axis=y]/drawer-popup:text-center md:gap-1.5 md:text-left">
                <if=input.title>
                  <h2
                    ...api().getTitleProps()
                    data-slot="drawer-title"
                    class="cn-font-heading text-base font-medium text-foreground"
                  >
                    <${input.title}/>
                  </h2>
                </if>
                <if=input.description>
                  <p
                    ...api().getDescriptionProps()
                    data-slot="drawer-description"
                    class="text-sm text-balance text-muted-foreground"
                  >
                    <${input.description}/>
                  </p>
                </if>
              </div>
            </if>

            <if=input.content>
              <div data-slot="drawer-body" class="min-h-0 flex-1 overflow-auto px-4">
                <${input.content}/>
              </div>
            </if>

            <if=input.footer>
              <div
                data-slot="drawer-footer"
                class="mt-auto flex shrink-0 flex-col gap-2 p-4 pt-0"
              >
                <${input.footer}/>
              </div>
            </if>
          </div>

          <if=!input.hideCloseTrigger>
            <button
              ...api().getCloseTriggerProps()
              data-slot="drawer-close"
              class="ring-offset-background focus:ring-ring absolute top-4 right-4 rounded-xs opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
              >
                <path d="M18 6 6 18"/>
                <path d="m6 6 12 12"/>
              </svg>
              <span class="sr-only">Close</span>
            </button>
          </if>
        </div>
      </div>
    </if>
  </portal>
</div>

<return=api>
