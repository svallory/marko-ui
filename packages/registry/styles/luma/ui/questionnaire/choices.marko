// base-luma parity: DOM/data-slot/class strings match shadcn
// styles/base-luma/ui/questionnaire.tsx's `QuestionnaireChoices`
// ("group/questionnaire-choices grid min-w-0 gap-3"). The source renders a
// plain `<div>` (`Questionnaire.Choices` in the primitive), whose only
// behavioral role is being the DOM container `<Choice>`/`<Input>` render
// into — no state of its own.
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {}

<const/{ class: className, content, ...rest }=input/>

<div ...rest data-slot="questionnaire-choices" class=cn("group/questionnaire-choices grid min-w-0 gap-3", className)>
  <${content}/>
</div>
