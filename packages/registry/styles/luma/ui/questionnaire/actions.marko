// base-luma parity: DOM/data-slot/class strings match shadcn
// styles/base-luma/ui/questionnaire.tsx's `QuestionnaireActions`
// ("grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto_auto] items-center
// gap-2 sm:min-h-9"). The source is a plain `<div>` (not part of the
// headless primitive) whose grid columns position Previous/Skip/Next-or-
// Submit — layout only, no state.
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {}

<const/{ class: className, content, ...rest }=input/>

<div
  ...rest
  data-slot="questionnaire-actions"
  class=cn("grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-2 sm:min-h-9", className)
>
  <${content}/>
</div>
