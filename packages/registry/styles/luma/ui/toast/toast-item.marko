// One live Zag toast child service, rendered by <Toaster> for each entry in the
// group machine's `toasts` context.
//
// base-rhea parity + the CSS-geometry deviation (read this before touching
// class strings): base-luma's Toast (Base UI) positions/stacks/animates every
// toast entirely through CSS custom properties Base UI itself writes onto the
// root element — --toast-index, --toast-height, --toast-frontmost-height,
// --toast-offset-y, --toast-swipe-movement-x/y — consumed by a `transform:`
// value built with derived vars (--gap, --offset-y, --peek, --scale, --shrink)
// defined right there in the Tailwind arbitrary-value classes, plus
// data-expanded/data-starting-style/data-ending-style/data-limited/
// data-swipe-direction for the entrance/exit/expand phases and
// data-behind (on ToastContent) for the background-toast fade.
//
// Zag's toast machine has its OWN, differently-named CSS-var placement system
// (see toast.utils.ts getPlacementStyle/getGhostBeforeStyle): --x, --y,
// --scale, --z-index, --opacity, --gap, --first-height, written by
// `getRootProps().style` and consumed here via the `translate`/`scale`/
// `opacity` CSS PROPERTIES (not Tailwind's `transform` utility, which would
// clobber them) exactly as the existing default rhea toast-item.marko already
// does. These two var vocabularies are NOT interchangeable — Base UI never
// produces --x/--y/--scale/--z-index/--opacity, and Zag never produces
// --toast-index/--toast-swipe-movement-*/--toast-offset-y. Rather than fake
// base-rhea's exact custom-property names on top of geometry Zag doesn't
// compute (swipe-to-dismiss movement in particular: Zag's toast has no
// pointer-swipe gesture at all, so --toast-swipe-movement-x/y and every
// data-[swipe-direction=*] class are structurally inapplicable here), this
// port keeps Zag's own working geometry system verbatim — it already animates
// stacking, expand/collapse and enter/exit correctly — and re-maps only the
// STATIC class strings (colors, spacing, radius, borders, shadow, icon/text
// layout) onto base-rhea's Tailwind classes. Every dropped or added
// data-attribute is called out below at its point of use. See component
// report for the full list.
import * as toastMachine from "@zag-js/toast";
import type { MarkoService } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface Input {
  /** Getter for this toast's options as held by the group machine. */
  options: () => toastMachine.Props;
  /** Getter for the running group service that owns this toast. */
  parent: () => MarkoService;
  /** This toast's position in the group, front-most first. */
  index: number;
  /**
   * The group service's update counter.
   *
   * Half of this machine's rendered geometry comes from the PARENT's context —
   * `computed("height")`, `heightIndex`, `heightBefore` and `zIndex` all read
   * `prop("parent").context`. A group update therefore has to invalidate this
   * child's connected api, and reading the counter inside `machineProps` is
   * what makes `<service>`'s tracking script call `propsChanged()` here.
   */
  groupRevision: number;
}

<const/machineProps=() => ({
  ...input.options(),
  index: input.index,
  parent: input.parent(),
  groupRevision: input.groupRevision,
})/>
<service/service machine=() => toastMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  toastMachine.connect(service, normalizeProps)
  service=service
/>

// The machine measures this toast in a microtask fired by its entry action —
// which in Marko lands before the browser has laid the new element out, so the
// measurement reads 0 and the whole stack collapses onto one offset. Re-send
// the machine's own MEASURE event once layout has actually happened.
<lifecycle
  onMount() {
    const frame = requestAnimationFrame(() => {
      requestAnimationFrame(() => service.service?.send({ type: "MEASURE" }));
    });
    // Marko merges onMount's RETURNED OBJECT into `this` (returning a bare
    // cleanup function is silently ignored) — onDestroy reads it back.
    return { cleanup: () => cancelAnimationFrame(frame) };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<div
  ...api().getRootProps()
  data-slot="toast"
  // base-rhea: data-open/data-closed drive Base UI's entrance/exit + expand
  // transform classes; base-rhea's data-expanded gates the "expanded stack"
  // offset math. Zag exposes an equivalent boolean pair as data-state=
  // "open"/"closed" (already emitted by getRootProps()) plus data-mounted/
  // data-first/data-sibling/data-stack/data-overlap — mapped 1:1 to base-rhea
  // intent below via a group-scoped compound class rather than duplicated
  // data-* attrs, since Zag's own vocabulary already reaches the DOM through
  // getRootProps() and re-emitting base-rhea's exact attribute names would
  // fight Zag's real state instead of describing it.
  class=cn(
    "group/toast pointer-events-auto relative flex w-[356px] max-w-[calc(100vw-2rem)] items-start gap-3 rounded-2xl! border border-border bg-popover p-4 text-sm text-popover-foreground shadow-lg outline-none will-change-transform select-none",
    // Zag drives placement/stacking through CSS custom properties on this
    // element (--x/--y/--scale/--z-index/--opacity, see getPlacementStyle).
    // They must be consumed by the `translate`/`scale`/`opacity` PROPERTIES,
    // not by Tailwind's `transform`/`opacity` utilities, which would
    // overwrite them. `--scale` is only set for background toasts in overlap
    // mode, so it needs an identity fallback.
    "min-h-14 [translate:var(--x)_var(--y)] [scale:var(--scale,1)] [z-index:var(--z-index)] opacity-[var(--opacity)]",
    "[will-change:translate,opacity,scale] [transition:translate_400ms,scale_400ms,opacity_400ms] [transition-timing-function:cubic-bezier(0.21,1.02,0.73,1)]",
    "data-[state=closed]:[transition:translate_400ms,scale_400ms,opacity_200ms]",
    "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50",
    "data-[type=error]:border-destructive/50 data-[type=error]:text-destructive",
  )
>
  // Ghost elements keep hover/pointer state stable across the gap between
  // toasts and during exit transitions. The "before" ghost is scaled to twice
  // the root height, so every real part must stack above it to stay clickable.
  // base-rhea has no direct equivalent (Base UI's overlap gap is closed by its
  // own hit-testing, not a ghost element) — kept from the existing default
  // implementation since it's load-bearing for correct hover behavior in
  // Zag's overlap mode.
  <span ...api().getGhostBeforeProps()/>

  <div data-slot="toast-content" class="relative z-[1] flex h-full min-w-0 flex-1 items-center gap-3 overflow-hidden">
    <if=(api().type === "success")>
      <span data-slot="toast-icon" class="shrink-0 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.801 10A10 10 0 1 1 17 3.335"/>
          <path d="m9 11 3 3L22 4"/>
        </svg>
      </span>
    </if>
    <else-if=(api().type === "info")>
      <span data-slot="toast-icon" class="shrink-0 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" x2="12.01" y1="8" y2="8"/>
          <line x1="12" x2="12" y1="12" y2="16"/>
        </svg>
      </span>
    </else-if>
    <else-if=(api().type === "warning")>
      <span data-slot="toast-icon" class="shrink-0 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" x2="12" y1="9" y2="13"/>
          <line x1="12" x2="12.01" y1="17" y2="17"/>
        </svg>
      </span>
    </else-if>
    <else-if=(api().type === "error")>
      <span data-slot="toast-icon" class="shrink-0 text-destructive [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" x2="12" y1="8" y2="12"/>
          <line x1="12" x2="12.01" y1="16" y2="16"/>
        </svg>
      </span>
    </else-if>
    <else-if=(api().type === "loading")>
      <span data-slot="toast-icon" class="shrink-0 animate-spin [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
      </span>
    </else-if>

    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <if=api().title>
        <div ...api().getTitleProps() data-slot="toast-title" class="text-sm font-medium">
          ${api().title}
        </div>
      </if>
      <if=api().description>
        <div ...api().getDescriptionProps() data-slot="toast-description" class="text-sm text-muted-foreground">
          ${api().description}
        </div>
      </if>
    </div>

    <if=input.options().action>
      <button
        ...api().getActionTriggerProps()
        data-slot="toast-action"
        class="inline-flex h-7 shrink-0 items-center justify-center gap-1.5 rounded-2xl border border-border bg-background px-3 text-xs font-medium whitespace-nowrap shadow-xs transition-all outline-none hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 disabled:pointer-events-none disabled:opacity-50 dark:bg-transparent dark:hover:bg-input/30"
      >
        ${input.options().action?.label}
      </button>
    </if>

    <if=api().closable>
      <button
        ...api().getCloseTriggerProps()
        data-slot="toast-close"
        aria-label="Close toast"
        class="relative inline-flex size-7 shrink-0 items-center justify-center rounded-2xl text-muted-foreground transition-all outline-none after:absolute after:-inset-2 after:content-[''] hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </if>
  </div>

  <span ...api().getGhostAfterProps()/>
</div>
