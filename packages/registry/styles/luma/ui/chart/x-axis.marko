// XAxis ticks — base-rhea port of ../../../default/ui/chart/x-axis.marko,
// byte-identical: no shadcn chart.tsx counterpart in either theme (XAxis is
// a bare Recharts component). Internal; ctx threaded by the chart tags. Tick
// <text> carries literal fill="#666" — the container's
// [&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground restyles it.
// No axis line / tick lines: shadcn demos always pass tickLine={false}
// axisLine={false}, so we simply never render them. Any tickFormatter is
// applied by the CALLER before passing `ticks`.
import { xTicks, type CartesianCtx, type XTick } from "./math.ts";

export interface Input {
  ctx: CartesianCtx;
  ticks?: XTick[];
  tickMargin?: number;
}

<const/{ ctx, tickMargin = 8 }=input/>
<const/ticks=(input.ticks ?? xTicks(ctx))/>
<const/tickY=(ctx.plot.y + ctx.plot.height + tickMargin)/>

<g class="recharts-cartesian-axis recharts-xAxis xAxis">
  <g class="recharts-cartesian-axis-ticks">
    <for|tick| of=ticks>
      <g class="recharts-layer recharts-cartesian-axis-tick">
        <text
          orientation="bottom"
          stroke="none"
          fill="#666"
          class="recharts-text recharts-cartesian-axis-tick-value"
          x=tick.x
          y=tickY
          text-anchor="middle"
        ><tspan x=tick.x dy="0.71em">${tick.value}</tspan></text>
      </g>
    </for>
  </g>
</g>
