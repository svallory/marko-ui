// base-luma parity: DOM/data-slot/class strings match
// shadcn styles/base-luma/ui/radio-group.tsx. base-luma (Base UI) emits
// data-checked on the item root; zag emits data-state="checked"/"unchecked"
// via getItemState().checked, so we compute data-checked ourselves to keep
// base-luma's exact class-string targets.
import * as radioGroupMachine from "@zag-js/radio-group";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export interface RadioGroupItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface RadioGroupItemAttrs {
  value: string;
  disabled?: boolean;
  content?: Marko.Body;
}

// The root is a native <div>; `value` is overridden to drop the native
// string-attribute type in favor of the machine's `string | null`.
// `valueChange` is additive sugar enabling Marko's two-way bind shorthand
// (<RadioGroup value:=myState/>); Zag's own `onValueChange` also works and
// receives the details object.
//
// Dual API: compound attr tags (`<@item>`) are the primary, Marko-idiomatic
// form; `items=` remains as sugar for the data-driven case. If both are
// supplied, attr tags win.
export type Input = Omit<MachineInput<"div", radioGroupMachine.Props>, "value"> & {
  items?: RadioGroupItem[];
  item?: Marko.AttrTag<RadioGroupItemAttrs>;
  value?: string | null;
  valueChange?: (value: string | null) => void;
};

<const/{ items }=input/>

// Normalize whichever source was supplied into one shape so the render path
// below never branches. Attr tags win if both are present (compound is
// primary per the compound-tag-dx report).
<const/itemTags=[...(input.item ?? [])].map((item) => ({ value: item.value, disabled: item.disabled, label: undefined as string | undefined, content: item.content }))/>
<const/normalizedItems=(itemTags.length > 0 ? itemTags : (items ?? []).map((item) => ({ value: item.value, disabled: item.disabled, label: item.label as string | undefined, content: undefined as Marko.Body | undefined })))/>

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=radioGroupMachine.props
  onValueChange(details: radioGroupMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => radioGroupMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  radioGroupMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, items, valueChange) passes through to the root div.
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    item: ownItem,
    valueChange: ownChangeHandler,
    ...native
  } = radioGroupMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="radio-group" class=cn("grid w-full gap-3", input.class)>
  <for|item| of=normalizedItems by=(item) => item.value>
    <label
      data-slot="radio-group-item-wrapper"
      class="flex items-center gap-2"
    >
      <span
        ...api().getItemProps({ value: item.value, disabled: item.disabled })
        data-slot="radio-group-item"
        data-checked=String(api().getItemState({ value: item.value, disabled: item.disabled }).checked)
        class="group/radio-group-item peer relative flex aspect-square size-4 shrink-0 rounded-full border border-transparent bg-input/90 outline-none after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary"
      >
        <if=api().getItemState({ value: item.value, disabled: item.disabled }).checked>
          <span
            data-slot="radio-group-indicator"
            class="flex size-4 items-center justify-center"
          >
            <span class="absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-foreground dark:size-2.5"/>
          </span>
        </if>
      </span>
      <input ...api().getItemHiddenInputProps({ value: item.value, disabled: item.disabled })>
      <if=item.content>
        <${item.content}/>
      </if>
      <else>
        ${item.label}
      </else>
    </label>
  </for>
</div>

// Parents can receive the api getter: <RadioGroup/radioGroupApi/> then
// `radioGroupApi().value` — it stays live across machine updates.
<return=api>
