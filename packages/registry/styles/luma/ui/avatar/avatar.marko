// base-luma parity: DOM/data-slot/class strings match
// shadcn styles/base-luma/ui/avatar.tsx. base-luma (Base UI) exposes a
// `size` prop that is mirrored onto `data-size` for CSS targeting (used by
// AvatarFallback/AvatarBadge via `group-data-[size=...]/avatar:`); zag's
// avatar machine has no size concept, so `size` is component-owned here,
// same treatment as switch.marko's `size`.
import * as avatarMachine from "@zag-js/avatar";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"span", avatarMachine.Props> & {
  src?: string;
  alt?: string;
  fallback?: string;
  content?: Marko.Body;
  statusChange?: (status: avatarMachine.LoadStatus) => void;
  size?: "default" | "sm" | "lg";
};

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=avatarMachine.props
  onStatusChange(details: avatarMachine.StatusChangeDetails) {
    input.onStatusChange?.(details);
    input.statusChange?.(details.status);
  }/>
<service/service machine=() => avatarMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  avatarMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, src, alt, fallback, content, statusChange, size) passes through to
// the root span: aria-*, data-*...
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    src: ownSrc,
    alt: ownAlt,
    fallback: ownFallback,
    content: ownContent,
    statusChange: ownChangeHandler,
    size: ownSize,
    ...native
  } = avatarMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<const/{ size = "default" }=input/>

<span
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="avatar"
  data-size=size
  class=cn(
    "group/avatar relative flex size-8 shrink-0 rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken data-[size=lg]:size-10 data-[size=sm]:size-6 dark:after:mix-blend-lighten",
    input.class,
  )
>
  <if=input.src>
    <img
      ...api().getImageProps()
      src=input.src
      alt=input.alt
      data-slot="avatar-image"
      class="aspect-square size-full rounded-full object-cover"
    />
  </if>
  <span
    ...api().getFallbackProps()
    data-slot="avatar-fallback"
    class="flex size-full items-center justify-center rounded-full bg-muted text-sm text-muted-foreground group-data-[size=sm]/avatar:text-xs"
  >
    <if=input.content>
      <${input.content}/>
    </if>
    <else>
      ${input.fallback}
    </else>
  </span>
</span>

// Parents can receive the api getter: <Avatar/avatarApi/> then
// `avatarApi().loaded` — it stays live across machine updates.
<return=api>
