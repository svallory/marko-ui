// base-luma parity: DOM/data-slot/class strings match
// shadcn styles/base-luma/ui/carousel.tsx. That source wraps embla-carousel
// via a React context (Carousel/CarouselContent/CarouselItem/CarouselPrevious/
// CarouselNext as five separate components sharing `useCarousel()`); this port
// preserves the existing default luma implementation's architecture — one
// component built on @zag-js/carousel — and re-maps only the DOM/class/data-
// slot output to base-luma's naming. See component report for the resulting
// structural deviations (single-component vs. five-component context split,
// and the zag-vs-embla feature gaps: no CarouselPrevious/Next `orientation`
// prop swap for vertical carousels' rotate/position classes, since base-luma's
// prev/next buttons are absolutely positioned relative to the root and this
// port's buttons are laid out as siblings of the indicator group like the
// existing default implementation — see report for full reasoning).
import * as carouselMachine from "@zag-js/carousel";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export interface CarouselSlideAttrs {
  content?: Marko.Body;
}

// Dual API: compound attr tags (`<@slide>`) are the primary, Marko-idiomatic
// form for static/manual slide lists; `items=` + `content` remain as sugar
// for the data-driven, generic-T case. If both are supplied, attr tags win.
export type Input<T = unknown> = Omit<
  MachineInput<"div", carouselMachine.Props>,
  "slideCount"
> & {
  items?: T[];
  content?: Marko.Body<[T, number]>;
  slide?: Marko.AttrTag<CarouselSlideAttrs>;
  pageChange?: (page: number) => void;
};

// Normalize whichever source was supplied into one shape so the render path
// below never branches: a list of `{ content, item }` entries, where `item`
// (data-driven path only) is rendered through the shared `content` render
// prop at render time. Attr tags win if both are present (compound is
// primary per the compound-tag-dx report).
<const/slideTags=[...(input.slide ?? [])]/>
<const/slides=(slideTags.length > 0 ? slideTags.map((slide) => ({ content: slide.content, item: undefined as unknown })) : (input.items ?? []).map((item) => ({ content: undefined, item })))/>

<machine-props/machineProps from=input pick=carouselMachine.props
  slideCount=slides.length
  onPageChange(details: carouselMachine.PageChangeDetails) {
    input.onPageChange?.(details);
    input.pageChange?.(details.page);
  }/>
<service/service machine=() => carouselMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  carouselMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    content: ownContent,
    slide: ownSlide,
    pageChange: ownChangeHandler,
    ...native
  } = carouselMachine.splitProps(input)[1];
  return native;
}>

<const/orientation=() => api().getRootProps()["data-orientation"] ?? "horizontal"/>

<div ...nativeAttrs() ...api().getRootProps() data-slot="carousel" class=cn("relative", input.class)>
  <div data-slot="carousel-content" class="overflow-hidden">
    <div
      ...api().getItemGroupProps()
      data-slot="carousel-item-group"
      tabindex="0"
      class=cn("flex", orientation() === "horizontal" ? "-ml-4" : "-mt-4 flex-col")
    >
      <for|slide, index| of=slides>
        <div
          ...api().getItemProps({ index })
          data-slot="carousel-item"
          class=cn("min-w-0 shrink-0 grow-0 basis-full", orientation() === "horizontal" ? "pl-4" : "pt-4")
        >
          <if=slide.content>
            <${slide.content}/>
          </if>
          // A bodyless `<@slide/>` has no `content` and an undefined `item`, so
          // when the caller also passed a `content` render prop it is invoked
          // with `undefined` here — intentional and safe: the render prop owns
          // placeholder slides, and the `${slide.item}` fallback renders nothing.
          <else-if=input.content>
            <${input.content}(slide.item, index)/>
          </else-if>
          <else>
            ${slide.item}
          </else>
        </div>
      </for>
    </div>
  </div>
  <button
    ...api().getPrevTriggerProps()
    data-slot="carousel-previous"
    class=cn(
      "absolute touch-manipulation rounded-full group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 size-8 border-border bg-background hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:bg-transparent dark:hover:bg-input/30",
      orientation() === "horizontal" ? "inset-y-0 -left-12 my-auto" : "-top-12 left-1/2 -translate-x-1/2 rotate-90",
    )
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    <span class="sr-only">Previous slide</span>
  </button>
  <button
    ...api().getNextTriggerProps()
    data-slot="carousel-next"
    class=cn(
      "absolute touch-manipulation rounded-full group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 size-8 border-border bg-background hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:bg-transparent dark:hover:bg-input/30",
      orientation() === "horizontal" ? "inset-y-0 -right-12 my-auto" : "-bottom-12 left-1/2 -translate-x-1/2 rotate-90",
    )
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cn-rtl-flip">
      <path d="m9 18 6-6-6-6"/>
    </svg>
    <span class="sr-only">Next slide</span>
  </button>
  <div ...api().getIndicatorGroupProps() data-slot="carousel-indicator-group" class="flex items-center justify-center gap-2 pt-4">
    <for|_, index| of=api().pageSnapPoints>
      <button
        ...api().getIndicatorProps({ index })
        data-slot="carousel-indicator"
        class="group/indicator flex size-6 items-center justify-center"
      >
        <span aria-hidden="true" class="size-2 rounded-full bg-primary/20 group-data-[current]/indicator:bg-primary"></span>
        <span class="sr-only">Go to slide ${index + 1}</span>
      </button>
    </for>
  </div>
</div>

<return=api>
