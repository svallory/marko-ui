// base-luma parity: DOM/data-slot/class strings match
// shadcn styles/base-luma/ui/popover.tsx. base-luma (Base UI) exposes
// side/sideOffset/align/alignOffset as flat props on its Positioner; zag's
// popover machine folds all four into a single `positioning` object
// (@zag-js/popper PositioningOptions), so we accept the same four input
// props and assemble `positioning` from them before handing off to
// <machine-props> (positioning is derived, not a plain passthrough field,
// same reason <select> layers `collection` in via a closure instead of a
// <machine-props> override). base-ui's PopoverHeader/Title/Description are
// separate exported components; zag's popover machine already provides
// getTitleProps/getDescriptionProps so those two map directly, and
// PopoverHeader (a plain styled <div>, no machine involvement) is folded in
// here as an optional `header` render slot to keep this a single-file
// component like the other rhea multi-part ports.
import * as popoverMachine from "@zag-js/popover";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props (minus
// `positioning`, replaced below by the flat side/sideOffset/align/
// alignOffset input base-luma exposes), with `id` made optional (generated
// below, overridable). `openChange` is additive sugar enabling Marko's
// two-way bind shorthand (<Popover open:=myState/>); Zag's own
// `onOpenChange` also works and receives the details object.
export type Input = Omit<MachineInput<"div", popoverMachine.Props>, "positioning"> & {
  /** Trigger render-prop — the element that opens the popover. */
  trigger: Marko.Body<[Record<string, unknown>]>;
  /** Popover content shown when open. */
  content: Marko.Body;
  /** Optional title, rendered via getTitleProps(). */
  title?: Marko.Body;
  /** Optional description, rendered via getDescriptionProps(). */
  description?: Marko.Body;
  /** Optional header wrapper class (only used when title/description given). */
  headerClass?: string;
  openChange?: (open: boolean) => void;
  align?: "start" | "center" | "end";
  alignOffset?: number;
  side?: "top" | "bottom" | "left" | "right";
  sideOffset?: number;
};

<const/{
  align = "center",
  alignOffset = 0,
  side = "bottom",
  sideOffset = 4,
}=input/>

// @zag-js/popper's `positioning.placement` is a floating-ui Placement
// string that fuses side+align (e.g. "bottom-start"), unlike base-ui's flat
// side/align props — combine them here. `gutter` is the main-axis
// (side) offset; `shift` is the secondary-axis (align) offset.
<const/placement=(align === "center" ? side : `${side}-${align}`) as popoverMachine.Placement/>

<machine-props/machineProps from=input pick=popoverMachine.props
  positioning={ placement, gutter: sideOffset, shift: alignOffset }
  onOpenChange(details: popoverMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => popoverMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  popoverMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, trigger, content, title, description, headerClass, openChange,
// align, alignOffset, side, sideOffset) passes through to the content
// element: aria-*, data-*...
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    trigger: ownTrigger,
    content: ownContent,
    title: ownTitle,
    description: ownDescription,
    headerClass: ownHeaderClass,
    openChange: ownChangeHandler,
    align: ownAlign,
    alignOffset: ownAlignOffset,
    side: ownSide,
    sideOffset: ownSideOffset,
    ...native
  } = popoverMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<${input.trigger}({ ...api().getTriggerProps(), "data-slot": "popover-trigger" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle class="isolate z-50">
      <div
        ...nativeAttrs()
        ...api().getContentProps()
        data-slot="popover-content"
        data-open="true"
        class=cn(
          "z-50 flex w-72 origin-(--transform-origin) flex-col gap-4 rounded-3xl bg-popover p-4 text-sm text-popover-foreground shadow-lg ring-1 ring-foreground/5 outline-hidden duration-100 data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 dark:ring-foreground/10 data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95",
          input.class,
        )
      >
        <if=(input.title || input.description)>
          <div data-slot="popover-header" class=cn("flex flex-col gap-1 text-sm", input.headerClass)>
            <if=input.title>
              <h2 ...api().getTitleProps() data-slot="popover-title" class="text-base font-medium">
                <${input.title}/>
              </h2>
            </if>
            <if=input.description>
              <p ...api().getDescriptionProps() data-slot="popover-description" class="text-muted-foreground">
                <${input.description}/>
              </p>
            </if>
          </div>
        </if>
        <${input.content}/>
      </div>
    </div>
  </if>
</portal>

// Parents can receive the api getter: <Popover/popoverApi/> then
// `popoverApi().open` — it stays live across machine updates.
<return=api>
