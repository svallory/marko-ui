// base-lyra parity: DOM/data-slot/class strings match
// shadcn styles/base-lyra/ui/pagination.tsx. base-lyra composes
// nav > ul(PaginationContent) > li(PaginationItem) > Button-as-anchor, with
// PaginationLink/Previous/Next/Ellipsis as separate exported parts; zag's
// pagination machine drives everything from the root api (getPrevTriggerProps
// /getItemProps/getNextTriggerProps/getEllipsisProps returning native
// <button> attrs, not <a>), so this port keeps the default's flattened
// single-file structure (mirroring how lyra's own alert-dialog/dropdown-menu
// inline their sub-parts) while reproducing base-lyra's exact class strings,
// data-slot names, and data-active attribute on the active page item.
import * as paginationMachine from "@zag-js/pagination";
import type { MachineInput } from "marko-zag";
import { buttonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"nav", paginationMachine.Props> & {
  pageChange?: (page: number) => void;
  previousText?: string;
  nextText?: string;
};

<machine-props/machineProps from=input pick=paginationMachine.props
  onPageChange(details: paginationMachine.PageChangeDetails) {
    input.onPageChange?.(details);
    input.pageChange?.(details.page);
  }/>
<service/service machine=() => paginationMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  paginationMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    pageChange: ownChangeHandler,
    previousText: ownPreviousText,
    nextText: ownNextText,
    ...native
  } = paginationMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<nav
  ...nativeAttrs()
  ...api().getRootProps()
  role="navigation"
  aria-label="pagination"
  data-slot="pagination"
  class=cn("mx-auto flex w-full justify-center", input.class)
>
  <ul data-slot="pagination-content" class="flex items-center gap-0.5">
    <li data-slot="pagination-item">
      <button
        ...api().getPrevTriggerProps()
        aria-label="Go to previous page"
        data-slot="pagination-link"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "pl-1.5!")
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-icon="inline-start"
          class="cn-rtl-flip"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="hidden sm:block">${input.previousText ?? "Previous"}</span>
      </button>
    </li>
    <for|item, index| of=api().pages by=(item, index) => item.type === "page" ? `page-${item.value}` : `ellipsis-${index}`>
      <if=item.type === "page">
        <li data-slot="pagination-item">
          <button
            ...api().getItemProps({ type: "page", value: item.value })
            aria-current=(item.value === api().page ? "page" : undefined)
            data-slot="pagination-link"
            data-active=String(item.value === api().page)
            class=buttonVariants({ variant: item.value === api().page ? "outline" : "ghost", size: "icon" })
          >
            ${item.value}
          </button>
        </li>
      </if>
      <else>
        <li data-slot="pagination-item">
          <span
            ...api().getEllipsisProps({ index })
            aria-hidden
            data-slot="pagination-ellipsis"
            class="flex size-8 items-center justify-center [&_svg:not([class*='size-'])]:size-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="1"/>
              <circle cx="19" cy="12" r="1"/>
              <circle cx="5" cy="12" r="1"/>
            </svg>
            <span class="sr-only">More pages</span>
          </span>
        </li>
      </else>
    </for>
    <li data-slot="pagination-item">
      <button
        ...api().getNextTriggerProps()
        aria-label="Go to next page"
        data-slot="pagination-link"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "pr-1.5!")
      >
        <span class="hidden sm:block">${input.nextText ?? "Next"}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-icon="inline-end"
          class="cn-rtl-flip"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </li>
  </ul>
</nav>

<return=api>
