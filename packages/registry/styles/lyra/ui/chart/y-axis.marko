// YAxis ticks — base-lyra port of ../../../default/ui/chart/y-axis.marko,
// byte-identical: no shadcn chart.tsx counterpart in either theme (YAxis is
// a bare Recharts component). Internal; ctx threaded by the chart tags. Only
// rendered when a chart tag gets `yAxis` (default off,
// matching the shadcn demos). Literal fill="#666" — restyled by the
// container's fill-muted-foreground selector. No axis/tick lines.
import { yTicks, type CartesianCtx, type YTick } from "./math.ts";

export interface Input {
  ctx: CartesianCtx;
  ticks?: YTick[];
  tickMargin?: number;
  /** Approximate number of ticks (d3 `ticks()` count) — recharts' tickCount. Default 5. */
  tickCount?: number;
}

<const/{ ctx, tickMargin = 8 }=input/>
<const/ticks=(input.ticks ?? yTicks(ctx, input.tickCount))/>
<const/tickX=(ctx.plot.x - tickMargin)/>

<g class="recharts-cartesian-axis recharts-yAxis yAxis">
  <g class="recharts-cartesian-axis-ticks">
    <for|tick| of=ticks>
      <g class="recharts-layer recharts-cartesian-axis-tick">
        <text
          orientation="left"
          stroke="none"
          fill="#666"
          class="recharts-text recharts-cartesian-axis-tick-value"
          x=tickX
          y=tick.y
          text-anchor="end"
        ><tspan x=tickX dy="0.355em">${tick.value}</tspan></text>
      </g>
    </for>
  </g>
</g>
