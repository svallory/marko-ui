// LineChart — base-lyra port of ../../../default/ui/chart/line.marko,
// byte-identical: base-lyra's chart.tsx only re-themes ChartContainer/
// ChartTooltipContent/ChartLegendContent (see chart.marko/tooltip.marko/
// legend.marko in this dir) — Line/LineChart are Recharts components,
// untouched by either shadcn theme. This template emits the same SVG
// structure, classes, and literal default attributes recharts renders, so
// the shadcn container's selectors (stroke="#fff" dots -> stroke-transparent,
// the tooltip cursor -> stroke-border, tick text -> fill-muted-foreground)
// restyle it identically under base-lyra too. Series colors are always
// var(--color-<dataKey>) — resolved by the ChartStyle <style> the <chart>
// container emits, never in JS. Imports below resolve to THIS dir's grid/
// x-axis/y-axis/tooltip/legend siblings, not default's.
//
// SSR-first: the whole chart body is server-rendered; the only client
// state is the hovered band index for the tooltip/cursor. Everything the
// client needs (cursor paths, tooltip rows, positions) is precomputed into
// plain serializable arrays — the d3 ctx (functions) never crosses into
// reactive scope.
import { configFor, seriesColor, type ChartConfig } from "./config.ts";
import {
  cartesianCtx,
  linePath,
  thinTicksByGap,
  type CartesianCtx,
  type CurveType,
  type Margin,
  type Row,
} from "./math.ts";
import { cn } from "#lib/utils.ts";
import ChartGrid from "./grid.marko";
import ChartXAxis from "./x-axis.marko";
import ChartYAxis from "./y-axis.marko";
import ChartTooltip from "./tooltip.marko";
import ChartLegend from "./legend.marko";

export interface LabelSpec {
  dataKey?: string;
  color?: string;
  formatter?: (value: string) => string;
}

export interface LineSeriesAttrs {
  dataKey: string;
  /** Curve type (default "natural" — the shadcn line-default demo). */
  type?: CurveType;
  strokeWidth?: number;
  /** Render point markers (default false — shadcn demos hide dots). */
  dot?: boolean;
  /** Dot fill comes from each row's own `fill` field instead of the series color (chart-line-dots-colors). */
  dotColorByRow?: boolean;
  /** Replaces the default <circle> dot with custom content per point (chart-line-dots-custom). */
  dotContent?: Marko.Body<[{ x: number; y: number; row: Row }]>;
  /** LabelList-equivalent: value (or another field) rendered above each point. */
  labels?: LabelSpec[];
}

export interface Input {
  /** Same object passed to <chart> — Marko has no context, so it travels twice. */
  config: ChartConfig;
  data: Row[];
  xKey: string;
  width?: number;
  height?: number;
  margin?: Partial<Margin>;
  /** false ⇒ no tooltip (and no hover state at all). Default true. */
  tooltip?: boolean;
  /** false ⇒ no hover cursor line. Default true. */
  cursor?: boolean;
  indicator?: "line" | "dot" | "dashed";
  hideLabel?: boolean;
  /** Horizontal grid lines (recharts <CartesianGrid vertical={false}/>). Default true. */
  grid?: boolean;
  /** Default false — matches the shadcn demos. */
  yAxis?: boolean;
  legend?: boolean | "top" | "bottom";
  xTickFormatter?: (value: string) => string;
  /** Minimum pixel gap between kept x-axis ticks (recharts XAxis minTickGap) — thins dense date-series ticks. */
  xTickMinGap?: number;
  /** Applied to the tooltip's label row only (recharts ChartTooltipContent labelFormatter). */
  tooltipLabelFormatter?: (value: string) => string;
  class?: string;
  series?: Marko.AttrTag<LineSeriesAttrs>;
}

// recharts default margin is 5 on every side; the shadcn line demos add
// left/right 12 — that composite is our default, overridable via margin=.
static const DEFAULT_MARGIN = { top: 5, right: 12, bottom: 5, left: 12 };
static const DEFAULT_WIDTH = 628;
static const DEFAULT_HEIGHT = 353;
static const X_AXIS_HEIGHT = 30;

export interface PointerGeo {
  width: number;
  plotX: number;
  plotWidth: number;
  count: number;
}

// Point-scale x positions, like recharts uses for line/area charts: the
// first point sits at the plot's left edge, the last at its right edge
// (the default left/right margin of 12 gives the curve breathing room).
// Same helper as area.marko — kept local because client hover handlers can
// only reference plain serializable data, not the d3 scales in ctx.
static function pointPositions(ctx: CartesianCtx, count: number): number[] {
  if (count <= 1) return [ctx.plot.x + ctx.plot.width / 2];
  const step = ctx.plot.width / (count - 1);
  return Array.from({ length: count }, (item, index) => ctx.plot.x + index * step);
}

// Pointer → nearest point index, on plain numbers only (point scale —
// nearest point wins, like recharts). Identical to area.marko's helper.
static function pointerIndex(
  offsetX: number,
  clientWidth: number,
  geo: PointerGeo,
): number {
  if (clientWidth <= 0 || geo.count === 0) return -1;
  const scaledX = offsetX * (geo.width / clientWidth);
  if (scaledX < geo.plotX || scaledX > geo.plotX + geo.plotWidth) return -1;
  if (geo.count === 1) return 0;
  const step = geo.plotWidth / (geo.count - 1);
  const index = Math.round((scaledX - geo.plotX) / step);
  return Math.max(0, Math.min(geo.count - 1, index));
}

static function labelOf(config: ChartConfig, key: string): string {
  const entry = configFor(config, key);
  return entry && entry.label ? entry.label : key;
}

export interface SeriesRender {
  dataKey: string;
  color: string;
  strokeWidth: number;
  dot: boolean;
  dotColorByRow: boolean;
  dotContent?: Marko.Body<[{ x: number; y: number; row: Row }]>;
  labels?: LabelSpec[];
  path: string;
  points: { x: number; y: number; row: Row }[];
}

static function dotColor(row: Row, fallback: string): string {
  const fill = row["fill"];
  if (typeof fill === "string" && fill !== "") return fill;
  return fallback;
}

static function buildSeries(
  seriesList: LineSeriesAttrs[],
  data: Row[],
  centers: number[],
  yScale: (value: number) => number,
): SeriesRender[] {
  return seriesList.map((series) => {
    const yFor = (row: Row) => yScale(Number(row[series.dataKey] ?? 0));
    return {
      dataKey: series.dataKey,
      color: seriesColor(series.dataKey),
      strokeWidth: series.strokeWidth ?? 2,
      dot: series.dot === true,
      dotColorByRow: series.dotColorByRow === true,
      dotContent: series.dotContent,
      labels: series.labels,
      path: linePath(
        data,
        (row, index) => centers[index] ?? 0,
        yFor,
        series.type ?? "natural",
      ),
      points: data.map((row, index) => ({
        x: centers[index] ?? 0,
        y: yFor(row),
        row,
      })),
    };
  });
}

export interface TooltipRowData {
  key: string;
  label: string;
  value: number | string;
  color: string;
}

static function buildTooltipRows(
  seriesList: LineSeriesAttrs[],
  data: Row[],
  config: ChartConfig,
): TooltipRowData[][] {
  return data.map((row) =>
    seriesList.map((series) => ({
      key: series.dataKey,
      label: labelOf(config, series.dataKey),
      value: Number(row[series.dataKey] ?? 0),
      color: series.dotColorByRow ? dotColor(row, seriesColor(series.dataKey)) : seriesColor(series.dataKey),
    })),
  );
}

<const/{ config, data, xKey, class: className }=input/>
<const/seriesList=[...(input.series ?? [])]/>
<const/seriesKeys=seriesList.map((series) => series.dataKey)/>
<const/width=(input.width ?? DEFAULT_WIDTH)/>
<const/height=(input.height ?? DEFAULT_HEIGHT)/>
<const/margin={ ...DEFAULT_MARGIN, ...input.margin }/>
<const/showTooltip=(input.tooltip !== false)/>
<const/showCursor=(input.cursor !== false)/>
<const/showGrid=(input.grid !== false)/>
<const/showLegend=(input.legend === true || input.legend === "top" || input.legend === "bottom")/>
<const/legendPosition=(input.legend === "top" ? "top" : "bottom")/>
<const/indicator=input.indicator/>
<const/hideLabel=input.hideLabel/>
<const/formatter=input.xTickFormatter/>

<const/ctx=cartesianCtx({
  data,
  xKey,
  seriesKeys,
  width,
  height,
  margin,
  xAxisHeight: X_AXIS_HEIGHT,
  paddingInner: 0,
  paddingOuter: 0,
})/>
<const/centers=pointPositions(ctx, data.length)/>
<const/renderSeries=buildSeries(seriesList, data, centers, ctx.y)/>
<const/allTicks=data.map((row, index) => ({ value: (formatter ? formatter(String(row[xKey])) : String(row[xKey])), x: centers[index] ?? 0 }))/>
<const/ticks=(input.xTickMinGap ? thinTicksByGap(allTicks, input.xTickMinGap) : allTicks)/>
<const/legendItems=seriesList.map((series) => ({ key: series.dataKey, label: labelOf(config, series.dataKey), color: seriesColor(series.dataKey) }))/>

// Plain serializable arrays for the client-reactive region (see header note).
<const/cursorPaths=centers.map((x) => (`M ${x},${ctx.plot.y} L ${x},${ctx.plot.y + ctx.plot.height}`))/>
<const/leftPcts=centers.map((x) => Math.min(88, Math.max(12, (x / width) * 100)))/>
<const/tooltipRows=buildTooltipRows(seriesList, data, config)/>
<const/xLabels=data.map((row) => (input.tooltipLabelFormatter ? input.tooltipLabelFormatter(String(row[xKey])) : String(row[xKey])))/>
<const/geo={ width, plotX: ctx.plot.x, plotWidth: ctx.plot.width, count: data.length }/>

<let/activeIndex=(-1)/>

<div
  class=cn("recharts-wrapper", className)
  style={ position: "relative", width: "100%", height: "100%" }
  onPointermove(event: PointerEvent, el: HTMLDivElement) {
    if (showTooltip) {
      // offsetX is relative to the event TARGET (an inner svg node when
      // hovering the chart), so derive the wrapper-relative x from clientX.
      const rect = el.getBoundingClientRect();
      activeIndex = pointerIndex(event.clientX - rect.left, rect.width, geo);
    }
  }
  onPointerleave() {
    activeIndex = -1;
  }
>
  <if=(showLegend && legendPosition === "top")>
    <ChartLegend items=legendItems verticalAlign="top"/>
  </if>
  <svg
    class="recharts-surface"
    width="100%"
    height="100%"
    viewBox=`0 0 ${width} ${height}`
  >
    <if=showGrid>
      <ChartGrid ctx=ctx/>
    </if>
    <if=(showTooltip && showCursor && activeIndex >= 0)>
      <g class="recharts-layer">
        <path
          class="recharts-curve recharts-tooltip-cursor"
          stroke="#ccc"
          pointer-events="none"
          fill="none"
          d=cursorPaths[activeIndex]
        />
      </g>
    </if>
    <ChartXAxis ctx=ctx ticks=ticks/>
    <if=input.yAxis>
      <ChartYAxis ctx=ctx/>
    </if>
    <for|series| of=renderSeries>
      <g class="recharts-layer recharts-line">
        <path
          class="recharts-curve recharts-line-curve"
          stroke=series.color
          fill="none"
          stroke-width=series.strokeWidth
          d=series.path
        />
        <if=series.dotContent>
          <g class="recharts-layer recharts-line-dots">
            <for|point| of=series.points>
              <${series.dotContent}({ x: point.x, y: point.y, row: point.row })/>
            </for>
          </g>
        </if>
        <else-if=series.dot>
          <g class="recharts-layer recharts-line-dots">
            <for|point| of=series.points>
              <circle
                class="recharts-dot recharts-line-dot"
                r="3"
                stroke="#fff"
                stroke-width="1"
                fill=(series.dotColorByRow ? dotColor(point.row, series.color) : series.color)
                cx=point.x
                cy=point.y
              />
            </for>
          </g>
        </else-if>
        <if=series.labels>
          <g class="recharts-layer recharts-label-list">
            <for|point| of=series.points>
              <for|spec| of=series.labels>
                <const/labelValue=(spec.dataKey ? String(point.row[spec.dataKey] ?? "") : String(point.row[series.dataKey] ?? ""))/>
                <const/labelText=(spec.formatter ? spec.formatter(labelValue) : labelValue)/>
                <text
                  x=point.x
                  y=(point.y - 12)
                  text-anchor="middle"
                  fill=(spec.color ?? "var(--foreground)")
                  font-size="12"
                  class="recharts-text"
                >${labelText}</text>
              </for>
            </for>
          </g>
        </if>
      </g>
    </for>
  </svg>
  <if=(showLegend && legendPosition === "bottom")>
    <ChartLegend items=legendItems verticalAlign="bottom"/>
  </if>
  <if=(showTooltip && activeIndex >= 0)>
    <div
      style={
        position: "absolute",
        left: `${leftPcts[activeIndex]}%`,
        top: "12px",
        transform: "translateX(-50%)",
        "pointer-events": "none",
      }
    >
      <ChartTooltip
        rows=tooltipRows[activeIndex]
        label=xLabels[activeIndex]
        indicator=indicator
        hideLabel=hideLabel
      />
    </div>
  </if>
</div>
