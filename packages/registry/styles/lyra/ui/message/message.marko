import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  align?: "start" | "end";
}

<const/{ align = "start", class: className, content, ...rest }=input/>

<div
  ...rest
  data-slot="message"
  data-align=align
  class=cn(
    "group/message relative flex w-full min-w-0 gap-1.5 text-xs data-[align=end]:flex-row-reverse",
    className,
  )
>
  <${content}/>
</div>
