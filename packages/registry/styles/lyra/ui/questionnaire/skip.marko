// base-lyra parity: DOM/data-slot/class strings match shadcn
// styles/base-lyra/ui/questionnaire.tsx's `QuestionnaireSkip`
// (`buttonVariants({size, variant})` + "col-start-2 row-start-1 min-h-11
// justify-self-end sm:min-h-0", default variant="outline" size="default",
// default label "Skip"). Its underlying primitive is visible only when
// `activeItemRequired === false`, toggled via
// `hidden`/`inert`/`aria-hidden`/`data-hidden`/`data-visible` (not removed
// — see previous.marko's header comment); clicking calls `skipCurrent()`.
import { buttonVariants, type ButtonVariant, type ButtonSize } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import type { QuestionnaireControllerGetter } from "./lib/controller.ts";

export interface Input extends Marko.Input<"button"> {
  controller: QuestionnaireControllerGetter;
  variant?: ButtonVariant;
  size?: ButtonSize;
}

<const/{ controller, variant = "outline", size = "default", class: className, content, onClick, type, disabled: disabledProp = false, tabindex, ...rest }=input/>

<let/_version=controller().versionStore.getSnapshot()>
// A reactive <let>, NOT a <const> read off the store: navigation changes the
// active item without bumping the version, so a const would stay frozen at
// its server-rendered value and Skip would never appear/disappear.
<let/activeName=controller().activeItemStore.getSnapshot()>
<lifecycle
  onMount() {
    const unsubscribeVersion = controller().versionStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    });
    const unsubscribeActive = controller().activeItemStore.subscribe(() => {
      activeName = controller().activeItemStore.getSnapshot();
      _version = controller().versionStore.getSnapshot();
    });
    // Marko merges onMount's RETURNED OBJECT into `this` (returning a bare
    // cleanup function is silently ignored) — onDestroy reads it back.
    return {
      cleanup: () => {
        unsubscribeVersion();
        unsubscribeActive();
      },
    };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<const/visible=(_version >= 0 && activeName != null && controller().isRequired(activeName) === false)/>

<button
  ...rest
  type=(type ?? "button")
  data-slot="questionnaire-skip"
  data-size=size
  data-variant=variant
  data-hidden=(visible ? undefined : "")
  data-visible=(visible ? "" : undefined)
  aria-hidden=(!visible || undefined)
  hidden=(!visible)
  inert=(!visible)
  disabled=disabledProp
  tabindex=(visible ? tabindex : -1)
  class=cn(buttonVariants({ variant, size }), "col-start-2 row-start-1 min-h-11 justify-self-end sm:min-h-0", className)
  onClick(event: MouseEvent, target: HTMLButtonElement) {
    onClick?.(event);
    if (event.defaultPrevented) return;
    // event.currentTarget is unsupported in Marko's delegated events —
    // the handler's 2nd argument is the element the handler is bound to.
    controller().skipCurrent(() => {
      target?.form?.requestSubmit();
    });
  }
>
  <if=content>
    <${content}/>
  </if>
  <else>Skip</else>
</button>
