import { cn } from "#lib/utils.ts";
import Button from "@marko-ui/registry/styles/rhea/ui/button/button.marko";

// base-lyra parity: base-lyra renders <Button variant="ghost" size="icon-sm">
// with data-slot="sidebar-trigger" data-sidebar="trigger", a PanelLeftIcon,
// and an sr-only "Toggle Sidebar" span. We don't have lucide-react, so we
// keep our existing inline SVG geometry (already a panel-left icon) but
// compose through the rhea Button part so the button-level classes/markup
// match base-lyra exactly.
export interface Input extends Marko.Input<"button"> {
  open?: boolean;
  toggle?: () => void;
}

<const/{ open, toggle, class: className, content, ...rest }=input/>

<Button
  ...rest
  type="button"
  variant="ghost"
  size="icon-sm"
  data-slot="sidebar-trigger"
  data-sidebar="trigger"
  data-state=(open ? "open" : "closed")
  aria-label="Toggle sidebar"
  class=cn(className)
  onClick() {
    toggle?.();
  }
>
  <if=content>
    <${content}/>
  </if>
  <else>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <rect width="18" height="18" x="3" y="3" rx="2"/>
      <path d="M9 3v18"/>
    </svg>
    <span class="sr-only">Toggle Sidebar</span>
  </else>
</Button>
