// base-maia parity: DOM/data-slot/class strings match shadcn
// styles/base-maia/ui/questionnaire.tsx's `QuestionnaireChoice` (the
// `<label>` wrapper, hidden `<input type=radio|checkbox>`, custom
// indicator span with dot/check SVG, and optional shortcut badge) exactly,
// including the `group/questionnaire-choice` class-string targets the
// indicator and shortcut badge react to.
//
// SIMPLIFICATION FROM SOURCE: the source's `id` comes from `React.useId()`
// (use-questionnaire-choice.ts); this port derives a deterministic id from
// `itemName` + `value` instead (`useId()` has no Marko-resumability
// equivalent, and a deterministic id is required for the id to be stable
// across SSR/hydration and to double as the choice's registration key —
// see lib/controller.ts's `registerAnswer`). `checked`/`defaultChecked`
// (the fully-controlled shape) are not ported — see lib/controller.ts's
// header comment.
import { cn } from "#lib/utils.ts";
import type { QuestionnaireControllerGetter } from "./lib/controller.ts";

export interface Input extends Omit<Marko.Input<"label">, "onChange"> {
  controller: QuestionnaireControllerGetter;
  itemName: string;
  multiple?: boolean;
  value: string;
  disabled?: boolean;
  /** Position among this item's rendered choices; drives shortcut assignment. */
  index?: number;
  onChange?: (event: Event) => void;
}

<const/{
  controller,
  itemName,
  multiple = false,
  value,
  disabled = false,
  index = 0,
  class: className,
  content,
  onChange,
  ...rest
}=input/>

<const/answerId=`questionnaire-${itemName}-choice-${value}`/>
<const/type=(multiple ? "checkbox" : "radio")/>

<script>
  controller().registerAnswer(itemName, {
    id: answerId,
    type: "choice",
    value,
    disabled,
    element: null,
  });
</script>

<let/_version=controller().versionStore.getSnapshot()>
<lifecycle
  onMount() {
    // Marko merges onMount's RETURNED OBJECT into `this` (returning the
    // bare unsubscribe function is silently ignored) — onDestroy reads it.
    return { cleanup: controller().versionStore.subscribe(() => {
      _version = controller().versionStore.getSnapshot();
    }) };
  }
  onDestroy() {
    this.cleanup?.();
  }
/>

<const/snapshot=(_version >= 0 ? controller().getItemSnapshot(itemName) : undefined)/>
<const/checked=(snapshot?.selectedAnswerIds.includes(answerId) ?? false)/>
<const/status=(_version >= 0 ? controller().getStatus(itemName) : "unanswered")/>
<const/invalid=(_version >= 0 && controller().isInvalid(itemName))/>
<const/shortcut=controller().getShortcutForChoice(itemName, index, disabled)/>

<label
  ...rest
  data-slot="questionnaire-choice"
  data-type=type
  data-checked=String(checked)
  data-invalid=(invalid ? "true" : undefined)
  data-disabled=(disabled ? "true" : undefined)
  data-shortcut=(shortcut ?? undefined)
  class=cn(
    "group/questionnaire-choice relative flex min-h-11 cursor-pointer items-start gap-3 rounded-4xl border border-input bg-input/20 px-4 py-3.5 text-start text-sm transition-colors outline-none select-none hover:bg-input/40 has-[>input:focus-visible]:border-ring has-[>input:focus-visible]:ring-[3px] has-[>input:focus-visible]:ring-ring/50 data-invalid:border-destructive data-checked:border-primary/40 data-checked:bg-primary/10",
    "data-disabled:pointer-events-none data-disabled:cursor-not-allowed data-disabled:opacity-50",
    className,
  )
>
  <input/inputEl
    data-slot="questionnaire-choice-input"
    class="absolute inset-0 z-10 size-full cursor-pointer opacity-0"
    type=type
    id=answerId
    name=(status === "skipped" ? undefined : itemName)
    value=value
    checked=checked
    disabled=disabled
    required=(controller().isRequired(itemName) && !multiple)
    aria-invalid=(invalid || undefined)
    aria-keyshortcuts=([shortcut, !disabled && checked ? "Enter" : null].filter(Boolean).join(" ") || undefined)
    onChange(event: Event) {
      onChange?.(event);
      if (event.defaultPrevented) return;
      const target = event.target as HTMLInputElement;
      controller().setAnswerSelected(itemName, answerId, target.checked, multiple);
    }
  >
  <span
    aria-hidden="true"
    data-slot="questionnaire-choice-indicator"
    class="pointer-events-none relative flex size-4 shrink-0 translate-y-[--spacing(0.45)] items-center justify-center rounded-[6px] border border-input group-has-data-[slot=questionnaire-choice-description]/questionnaire-choice:translate-y-0.5 group-data-[type=radio]/questionnaire-choice:rounded-full group-data-checked/questionnaire-choice:border-primary group-data-checked/questionnaire-choice:bg-primary group-data-checked/questionnaire-choice:text-primary-foreground dark:bg-input/30 dark:group-data-checked/questionnaire-choice:bg-primary"
  >
    <span
      data-slot="questionnaire-choice-indicator-dot"
      class="hidden size-2 rounded-full bg-primary-foreground group-data-[type=checkbox]/questionnaire-choice:hidden group-data-checked/questionnaire-choice:block"
    />
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-slot="questionnaire-choice-indicator-check"
      class="hidden size-3.5 group-data-[type=radio]/questionnaire-choice:hidden group-data-checked/questionnaire-choice:block"
    >
      <path d="M20 6 9 17l-5-5"/>
    </svg>
  </span>
  <span data-slot="questionnaire-choice-label" class="flex min-w-0 flex-1 flex-col gap-1 leading-snug">
    <${content}/>
  </span>
  <span
    data-slot="questionnaire-choice-shortcut"
    class="pointer-events-none ms-auto hidden size-5 shrink-0 translate-y-[--spacing(0.45)] items-center justify-center rounded-full border border-input bg-background/80 font-mono text-[0.625rem] leading-none font-medium text-muted-foreground group-has-data-[slot=questionnaire-choice-description]/questionnaire-choice:translate-y-0.5 group-data-[shortcut]/questionnaire-choice:inline-flex"
  >
    ${shortcut}
  </span>
</label>

<lifecycle
  onMount() {
    controller().registerAnswer(itemName, {
      id: answerId,
      type: "choice",
      value,
      disabled,
      element: inputEl(),
    });
  }
/>
