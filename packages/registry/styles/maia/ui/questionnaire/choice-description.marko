// base-maia parity: DOM/data-slot/class strings match shadcn
// styles/base-maia/ui/questionnaire.tsx's `QuestionnaireChoiceDescription`
// ("text-muted-foreground"). The source renders a plain `<span>` (not part
// of the headless primitive — a styling-only convenience so
// QuestionnaireChoice's indicator/shortcut can react to its presence via
// `group-has-data-[slot=questionnaire-choice-description]`).
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"span"> {}

<const/{ class: className, content, ...rest }=input/>

<span ...rest data-slot="questionnaire-choice-description" class=cn("text-muted-foreground", className)>
  <${content}/>
</span>
