// base-nova parity: DOM/data-slot/class strings match
// shadcn styles/base-nova/ui/combobox.tsx. base-nova (Base UI) emits
// data-open/data-closed for the popup animation state and data-highlighted /
// data-selected / data-disabled on items; zag exposes api().open (boolean)
// and getItemState() instead, so those are mapped explicitly below. Zag
// unmounts the popup on close (no exit-animation phase), so data-open="true"
// is applied statically while mounted — the data-closed:* classes are
// therefore inert in our port (same documented deviation as
// alert-dialog.marko / dropdown-menu.marko's positioner).
//
// base-rhea's combobox.tsx is built around Base UI's InputGroup primitive
// (trigger/clear button embedded as an input addon) and an opt-in
// multi-select "chips" mode (ComboboxChips/ComboboxChip/ComboboxChipsInput,
// useComboboxAnchor). This repo has no InputGroup component and the
// zag-combobox default implementation here is single-value only (no
// `multiple` wiring, no chip anatomy in @zag-js/combobox's ComboboxApi) —
// ComboboxChips/ComboboxChip/ComboboxChipsInput/useComboboxAnchor have no
// equivalent and are intentionally omitted (see component report). The
// trigger/clear button are rendered as plain elements carrying base-rhea's
// InputGroupButton classes verbatim instead of wrapping an InputGroup that
// doesn't exist in this registry.
import * as combobox from "@zag-js/combobox";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface ComboboxItem {
  value: string;
  label: string;
  disabled?: boolean;
}

// `items`/`value` are narrowed vs. the raw machine Props: `items` drives the
// generated `collection`, and `value` is typed as the plain string[] the
// caller works with (the machine's own `value` type matches already).
export type Input = Omit<MachineInput<"div", combobox.Props>, "collection"> & {
  items: ComboboxItem[];
  valueChange?: (value: string[]) => void;
  inputValueChange?: (inputValue: string) => void;
  highlightChange?: (highlightedValue: string | null) => void;
};

<const/{ items, class: className }=input/>

<let/filtered=items/>

<const/buildCollection=(list: ComboboxItem[]) =>
  combobox.collection({
    items: list,
    itemToValue: (item: ComboboxItem) => item.value,
    itemToString: (item: ComboboxItem) => item.label,
    isItemDisabled: (item: ComboboxItem) => !!item.disabled,
  })
/>

<machine-props/machineProps from=input pick=combobox.props
  onInputValueChange(details: combobox.InputValueChangeDetails) {
    input.onInputValueChange?.(details);
    input.inputValueChange?.(details.inputValue);
    // Only narrow the list while the user is typing. Zag also fires this
    // with reason "item-select" (writing the chosen label into the input),
    // which would otherwise re-filter the list down to the selection and
    // leave the reopened dropdown showing a single item.
    if (details.reason !== "input-change") {
      filtered = items;
      return;
    }
    const query = details.inputValue.trim().toLowerCase();
    filtered = query === "" ? items : items.filter((item) => item.label.toLowerCase().includes(query));
  }
  onValueChange(details: combobox.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
    filtered = items;
  }
  onHighlightChange(details: combobox.HighlightChangeDetails) {
    input.onHighlightChange?.(details);
    input.highlightChange?.(details.highlightedValue);
  }/>
// `collection` is derived state (rebuilt whenever `filtered` changes), not a
// plain input field, so it cannot be picked/overridden inside <machine-props>
// (that tag's overrides are evaluated eagerly at the tag-input boundary).
// Wrap machineProps in a closure that layers it in for <service>.
<const/serviceProps=() => ({ ...machineProps(), collection: buildCollection(filtered) })/>
<service/service machine=() => combobox.machine props=serviceProps/>
<connect/api=(service, normalizeProps) =>
  combobox.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    valueChange: ownValueChange,
    inputValueChange: ownInputValueChange,
    highlightChange: ownHighlightChange,
    ...native
  } = combobox.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="combobox" class=cn(className)>
  <div
    ...api().getControlProps()
    data-slot="combobox-control"
    class="flex min-h-8 w-auto items-center gap-1 rounded-2xl border border-transparent bg-input/50 bg-clip-padding px-2.5 py-1 text-sm transition-[color,box-shadow] duration-200 focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/30"
  >
    <input
      ...api().getInputProps()
      data-slot="combobox-input"
      class="w-full min-w-0 flex-1 text-sm outline-hidden placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
    />
    <button
      ...api().getTriggerProps()
      data-slot="combobox-trigger"
      class="flex size-6 shrink-0 items-center justify-center rounded-full text-muted-foreground hover:bg-accent data-pressed:bg-transparent disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 [&_svg:not([class*='size-'])]:size-4"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none size-4 text-muted-foreground">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>
  </div>
  <portal>
    <if=api().open>
      // data-chips is NOT ported on the content div below: the source derives
      // it from its chips-mode anchor element, and chips mode is unported (see
      // header comment) — the original `data-chips=(!!anchor)` referenced a
      // variable that never existed here (ReferenceError on open).
      <div ...api().getPositionerProps() style=positionerStyle data-slot="combobox-positioner" class="isolate z-50">
        <div
          ...api().getContentProps()
          data-slot="combobox-content"
          class="cn-menu-target cn-menu-translucent group/combobox-content relative max-h-(--available-height) w-(--anchor-width) max-w-(--available-width) min-w-[calc(var(--anchor-width)+--spacing(7))] origin-(--transform-origin) overflow-hidden rounded-lg bg-popover text-popover-foreground shadow-md ring-1 ring-foreground/10 duration-100 data-[chips=true]:min-w-(--anchor-width) data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 *:data-[slot=input-group]:m-1 *:data-[slot=input-group]:mb-0 *:data-[slot=input-group]:h-8 *:data-[slot=input-group]:border-input/30 *:data-[slot=input-group]:bg-input/30 *:data-[slot=input-group]:shadow-none data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95"
        >
          <div
            ...api().getListProps()
            data-slot="combobox-list"
            class="no-scrollbar max-h-[min(calc(--spacing(72)---spacing(9)),calc(var(--available-height)---spacing(9)))] scroll-py-1 overflow-y-auto overscroll-contain p-1 data-empty:p-0"
          >
            <for|item| of=filtered>
              <div
                ...api().getItemProps({ item })
                data-slot="combobox-item"
                data-highlighted=(api().getItemState({ item }).highlighted ? "true" : undefined)
                data-disabled=(api().getItemState({ item }).disabled ? "true" : undefined)
                class="relative flex w-full cursor-default items-center gap-2 rounded-md py-1 pr-8 pl-1.5 text-sm outline-hidden select-none data-highlighted:bg-accent data-highlighted:text-accent-foreground not-data-[variant=destructive]:data-highlighted:**:text-accent-foreground data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
              >
                <span ...api().getItemTextProps({ item }) data-slot="combobox-item-text">${item.label}</span>
                <if=api().getItemState({ item }).selected>
                  <span ...api().getItemIndicatorProps({ item }) data-slot="combobox-item-indicator" class="pointer-events-none absolute right-2 flex size-4 items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  </span>
                </if>
              </div>
            </for>
            <if=(filtered.length === 0)>
              <div data-slot="combobox-empty" class="hidden w-full justify-center py-2 text-center text-sm text-muted-foreground group-data-empty/combobox-content:flex">No results found.</div>
            </if>
          </div>
        </div>
      </div>
    </if>
  </portal>
</div>

<return=api>
