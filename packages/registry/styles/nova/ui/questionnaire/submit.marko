// base-nova parity: DOM/data-slot/class strings match shadcn
// styles/base-nova/ui/questionnaire.tsx's `QuestionnaireSubmit`
// (`buttonVariants({size, variant})` + "col-start-3 row-start-1 min-h-11
// justify-self-end sm:min-h-0", default variant="default" size="default",
// default label "Submit", default `type="submit"`). Its underlying
// primitive is visible only when `total > 0 && last`, toggled via
// `hidden`/`inert`/`aria-hidden`/`data-hidden`/`data-visible` (not removed
// — see previous.marko's header comment); no click handler of its own —
// it submits the form natively and the root's `onSubmit` runs validation.
import { buttonVariants, type ButtonVariant, type ButtonSize } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import type { QuestionnaireController } from "./lib/controller.ts";

export interface Input extends Marko.Input<"button"> {
  controller: QuestionnaireController;
  variant?: ButtonVariant;
  size?: ButtonSize;
}

<const/{ controller, variant = "default", size = "default", class: className, content, type, disabled: disabledProp = false, tabindex, ...rest }=input/>

<let/_version=controller.versionStore.getSnapshot()>
<lifecycle
  onMount() {
    const unsubscribeVersion = controller.versionStore.subscribe(() => {
      _version = controller.versionStore.getSnapshot();
    });
    const unsubscribeActive = controller.activeItemStore.subscribe(() => {
      _version = controller.versionStore.getSnapshot();
    });
    return () => {
      unsubscribeVersion();
      unsubscribeActive();
    };
  }
/>

<const/visible=(_version >= 0 && controller.total() > 0 && controller.isLast())/>

<button
  ...rest
  type=(type ?? "submit")
  data-slot="questionnaire-submit"
  data-size=size
  data-variant=variant
  data-hidden=(visible ? undefined : "")
  data-visible=(visible ? "" : undefined)
  aria-hidden=(!visible || undefined)
  hidden=(!visible)
  inert=(!visible)
  disabled=disabledProp
  tabindex=(visible ? tabindex : -1)
  aria-keyshortcuts=(visible && !disabledProp ? "Enter" : undefined)
  class=cn(buttonVariants({ variant, size }), "col-start-3 row-start-1 min-h-11 justify-self-end sm:min-h-0", className)
>
  <if=content>
    <${content}/>
  </if>
  <else>Submit</else>
</button>
