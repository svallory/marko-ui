// base-nova parity: DOM/data-slot/class strings match
// shadcn styles/base-nova/ui/scroll-area.tsx. Built on the REAL
// @zag-js/scroll-area machine (synthetic draggable thumb, auto-hiding
// scrollbars) — not native browser scrollbars re-skinned, same as the
// default port. base-ui's ScrollAreaPrimitive.Scrollbar takes an
// `orientation` prop and emits `data-orientation` plus boolean
// data-horizontal/data-vertical presence attrs that its class string
// targets directly (data-horizontal:*, data-vertical:*); zag's
// getScrollbarProps({ orientation }) already sets data-orientation itself,
// so data-horizontal/data-vertical are added explicitly here to match the
// base-nova selector targets.
import * as scrollAreaMachine from "@zag-js/scroll-area";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", scrollAreaMachine.Props> & {
  content?: Marko.Body;
  /** Render a horizontal scrollbar + thumb in addition to the vertical one. */
  horizontal?: boolean;
};

// scroll-area has no onXxxChange callbacks in its Props — nothing to adapt,
// <machine-props> just picks the machine's own props off input.
<machine-props/machineProps from=input pick=scrollAreaMachine.props/>
<service/service machine=() => scrollAreaMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  scrollAreaMachine.connect(service, normalizeProps)
  service=service
/>

// Everything that is neither machine-owned (splitProps) nor component-owned
// (class, content, horizontal) passes through to the root wrapper.
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    content: ownContent,
    horizontal: ownHorizontal,
    ...native
  } = scrollAreaMachine.splitProps(input)[1] as typeof input;
  return native;
}>

// root/scrollbar/thumb/corner all carry Zag-owned reactive `style` objects
// (imperative --corner-width/--thumb-height CSS vars, absolute positioning) —
// do NOT add a style attribute of our own to any of them; only `class`.
<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="scroll-area"
  class=cn("relative", input.class)
>
  <div
    ...api().getViewportProps()
    data-slot="scroll-area-viewport"
    tabindex="0"
    class="size-full rounded-[inherit] transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1"
  >
    <div ...api().getContentProps()>
      <${input.content}/>
    </div>
  </div>

  <div
    ...api().getScrollbarProps({ orientation: "vertical" })
    data-slot="scroll-area-scrollbar"
    data-vertical
    class="flex touch-none p-px transition-colors select-none data-horizontal:h-2.5 data-horizontal:flex-col data-horizontal:border-t data-horizontal:border-t-transparent data-vertical:h-full data-vertical:w-2.5 data-vertical:border-l data-vertical:border-l-transparent"
  >
    <div
      ...api().getThumbProps({ orientation: "vertical" })
      data-slot="scroll-area-thumb"
      class="relative flex-1 rounded-full bg-border"
    />
  </div>

  <if=input.horizontal>
    <div
      ...api().getScrollbarProps({ orientation: "horizontal" })
      data-slot="scroll-area-scrollbar"
      data-horizontal
      class="flex touch-none p-px transition-colors select-none data-horizontal:h-2.5 data-horizontal:flex-col data-horizontal:border-t data-horizontal:border-t-transparent data-vertical:h-full data-vertical:w-2.5 data-vertical:border-l data-vertical:border-l-transparent"
    >
      <div
        ...api().getThumbProps({ orientation: "horizontal" })
        data-slot="scroll-area-thumb"
        class="relative flex-1 rounded-full bg-border"
      />
    </div>
  </if>

  <div ...api().getCornerProps() data-slot="scroll-area-corner"/>
</div>

<return=api>
