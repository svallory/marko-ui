import { alertVariants, type AlertVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, AlertVariants {}

<const/{ variant, class: className, content, ...rest }=input/>

<div ...rest role="alert" data-slot="alert" class=cn(alertVariants({ variant }), className)>
  <${content}/>
</div>
