// base-mira parity: DOM/data-slot/class strings match
// shadcn styles/base-mira/ui/toggle.tsx. base-mira (Base UI's TogglePrimitive)
// targets `aria-pressed:bg-muted` for the on-state (see toggle-variants.ts),
// not a data-state attribute, so no extra data-state work is needed here
// beyond what the default toggle already computes.
import { toggleVariants, type ToggleVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"button">, ToggleVariants {
  pressed?: boolean;
  pressedChange?: (pressed: boolean) => void;
}

<let/pressed=input.pressed ?? false/>
<script>
  if (input.pressed !== undefined) pressed = input.pressed;
</script>
<const/{ variant, size, class: className, content, pressed: _pressed, pressedChange, ...rest }=input/>

<button
  ...rest
  type="button"
  data-slot="toggle"
  aria-pressed=String(pressed)
  class=cn(toggleVariants({ variant, size }), className)
  onClick() {
    pressed = !pressed;
    pressedChange?.(pressed);
  }
>
  <${content}/>
</button>
