import { cn } from "#lib/utils.ts";

// base-rhea parity: base-rhea's SidebarProvider renders `data-slot="sidebar-wrapper"`
// (NOT "sidebar-provider" — the shadcn source names the *component* SidebarProvider
// but the DOM slot it stamps is "sidebar-wrapper"). We keep our wiring/behavior
// pattern (plain <let> state, openChange callback, sidebar/content body slots)
// from the default registry instead of base-rhea's React context + cookie
// persistence + isMobile/Sheet branch, since we have no Sheet primitive here.
export interface Input extends Marko.Input<"div"> {
  /** Controlled open state. Uncontrolled default: true. */
  open?: boolean;
  openChange?: (open: boolean) => void;
  /** CSS length for --sidebar-width, default 16rem. */
  width?: string;
  /** Sidebar panel content (header/content/footer parts). */
  sidebar?: Marko.Body<[{ open: boolean; toggle: () => void }]>;
  /** Main content area, rendered next to the sidebar. */
  content?: Marko.Body<[{ open: boolean; toggle: () => void }]>;
}

<let/open=input.open ?? true/>
<script>
  if (input.open !== undefined) open = input.open;
</script>
<const/{
  open: _open,
  openChange,
  width,
  sidebar,
  class: className,
  content,
  ...rest
}=input/>

<const/toggle=() => {
  open = !open;
  openChange?.(open);
}/>

<div
  ...rest
  data-slot="sidebar-wrapper"
  style={ "--sidebar-width": width ?? "16rem", "--sidebar-width-icon": "3rem" }
  class=cn("group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar", className)
>
  <if=sidebar>
    <${sidebar}({ open, toggle })/>
  </if>
  <if=content>
    <${content}({ open, toggle })/>
  </if>
</div>
