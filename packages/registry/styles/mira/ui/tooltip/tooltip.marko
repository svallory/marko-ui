// base-mira parity: DOM/data-slot/class strings match
// shadcn styles/base-mira/ui/tooltip.tsx. base-mira (Base UI) keeps the
// popup mounted through its exit animation and drives it off
// data-open/data-closed (plus data-[state=delayed-open] for the initial
// open transition); zag's tooltip machine only mounts the content while
// api().open is true (no exit-animation phase, same situation documented
// in rhea's alert-dialog.marko), so data-open="true" is applied statically
// while mounted — the data-closed:* classes are therefore inert in this
// port (documented deviation, purely cosmetic exit-transition loss). zag
// already emits data-side natively (see dropdown-menu.marko), so the
// data-[side=...] slide-in classes line up unchanged. base-mira renders a
// single <Arrow> element; zag's tooltip machine splits this into a
// popper-positioned wrapper (getArrowProps/data-slot=tooltip-arrow, no
// visual styling) plus an inner rotated-square tip (getArrowTipProps) —
// same two-part structure the default tooltip already uses. base-mira's
// arrow classes are applied to the inner tip, which is the element actually
// painted.
import * as tooltipMachine from "@zag-js/tooltip";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Tooltip open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object.
export type Input = MachineInput<"div", tooltipMachine.Props> & {
  /** Trigger render-prop — typically the element the tooltip describes. */
  trigger: Marko.Body<[Record<string, unknown>]>;
  /** Tooltip content shown when open. */
  content: string | Marko.Body;
  openChange?: (open: boolean) => void;
};

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=tooltipMachine.props
  onOpenChange(details: tooltipMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => tooltipMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  tooltipMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, openChange, trigger, content) passes through to the root span:
// aria-*, data-*, arbitrary attributes callers attach to the tooltip as
// a whole.
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    openChange: ownChangeHandler,
    trigger: ownTrigger,
    content: ownContent,
    ...native
  } = tooltipMachine.splitProps(input)[1] as typeof input;
  return native;
}>

<span ...nativeAttrs() data-slot="tooltip">
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "tooltip-trigger" })/>
  <portal>
    <if=api().open>
      <div ...api().getPositionerProps() style=positionerStyle class="isolate z-50" data-slot="tooltip-positioner">
        <div
          ...api().getContentProps()
          data-slot="tooltip-content"
          data-open="true"
          class=cn(
            "z-50 inline-flex w-fit max-w-xs origin-(--transform-origin) items-center gap-1.5 rounded-md bg-foreground px-3 py-1.5 text-xs text-background has-data-[slot=kbd]:pr-1.5 data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 **:data-[slot=kbd]:relative **:data-[slot=kbd]:isolate **:data-[slot=kbd]:z-50 **:data-[slot=kbd]:rounded-sm data-[state=delayed-open]:animate-in data-[state=delayed-open]:fade-in-0 data-[state=delayed-open]:zoom-in-95 data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95",
            input.class,
          )
        >
          <if=(typeof input.content === "string")>
            ${input.content}
          </if>
          <else>
            <${input.content}/>
          </else>
          <div ...api().getArrowProps() data-slot="tooltip-arrow">
            <div
              ...api().getArrowTipProps()
              data-slot="tooltip-arrow-tip"
              class="z-50 size-2.5 translate-y-[calc(-50%-2px)] rotate-45 rounded-[2px] bg-foreground fill-foreground data-[side=bottom]:top-1 data-[side=inline-end]:top-1/2! data-[side=inline-end]:-left-1 data-[side=inline-end]:-translate-y-1/2 data-[side=inline-start]:top-1/2! data-[side=inline-start]:-right-1 data-[side=inline-start]:-translate-y-1/2 data-[side=left]:top-1/2! data-[side=left]:-right-1 data-[side=left]:-translate-y-1/2 data-[side=right]:top-1/2! data-[side=right]:-left-1 data-[side=right]:-translate-y-1/2 data-[side=top]:-bottom-2.5"
            />
          </div>
        </div>
      </div>
    </if>
  </portal>
</span>

// Parents can receive the api getter: <Tooltip/tooltipApi/> then
// `tooltipApi().open` — it stays live across machine updates.
<return=api>
