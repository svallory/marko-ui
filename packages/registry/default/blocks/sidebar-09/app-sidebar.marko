// Note: mirroring the source's "IRL you should use the url/router" caveat —
// active item is local UI state here, not routing.
<let/activeItemId="inbox"/>
<let/visibleMails=MAILS/>

<const/selectItem=(itemId: string) => {
  activeItemId = itemId;
  const shuffled = [...MAILS].sort(() => Math.random() - 0.5);
  const count = Math.max(5, Math.floor(Math.random() * 10) + 1);
  visibleMails = shuffled.slice(0, count);
  if (!input.open) input.toggle?.();
}/>

<const/activeItem=NAV_MAIN.find((item) => item.id === activeItemId) ?? NAV_MAIN[0]/>

<div class="flex h-full overflow-hidden *:data-[slot=sidebar]:flex-row">
  <!-- Icon rail: fixed-width, always visible (not affected by the outer open/close state). -->
  <Sidebar open=true class="w-[calc(var(--sidebar-width-icon,3rem)+1px)]! border-r">
    <SidebarHeader>
      <SidebarMenu>
        <SidebarMenuItem>
          <SidebarMenuButton href="#" class="md:h-8 md:p-0">
            <div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
              >
                <path d="m16 6-8.414 8.586a2 2 0 0 0 0 2.828 2 2 0 0 0 2.828 0l8.414-8.586a4 4 0 0 0 0-5.656 4 4 0 0 0-5.656 0l-8.415 8.585a6 6 0 1 0 8.486 8.486"/>
              </svg>
            </div>
            <div class="grid flex-1 text-left text-sm leading-tight">
              <span class="truncate font-medium">Acme Inc</span>
              <span class="truncate text-xs">Enterprise</span>
            </div>
          </SidebarMenuButton>
        </SidebarMenuItem>
      </SidebarMenu>
    </SidebarHeader>
    <SidebarContent>
      <SidebarGroup>
        <div class="px-1.5 md:px-0">
          <SidebarMenu>
            <for|item| of=NAV_MAIN by=(item) => item.id>
              <SidebarMenuItem>
                <SidebarMenuButton
                  href="#"
                  active=(item.id === activeItemId)
                  title=item.title
                  class="px-2.5 md:px-2"
                  onClick(event: Event) {
                    event.preventDefault();
                    selectItem(item.id);
                  }
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d=NAV_ICONS[item.id]/>
                  </svg>
                  <span>${item.title}</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
            </for>
          </SidebarMenu>
        </div>
      </SidebarGroup>
    </SidebarContent>
    <SidebarFooter>
      <NavUser user=USER/>
    </SidebarFooter>
  </Sidebar>

  <!-- Mail list: fills remaining space, hidden on small screens. -->
  <Sidebar open=true class="hidden flex-1 md:flex">
    <SidebarHeader class="gap-3.5 border-b p-4">
      <div class="flex w-full items-center justify-between">
        <div class="text-base font-medium text-foreground">${activeItem.title}</div>
        <Label class="flex items-center gap-2 text-sm">
          <span>Unreads</span>
          <Switch class="shadow-none"/>
        </Label>
      </div>
      <TextInput placeholder="Type to search..." class="h-8 shadow-none"/>
    </SidebarHeader>
    <SidebarContent>
      <SidebarGroup class="px-0">
        <for|mail| of=visibleMails by=(mail) => mail.id>
          <a
            href="#"
            class="flex flex-col items-start gap-2 border-b p-4 text-sm leading-tight whitespace-nowrap last:border-b-0 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
          >
            <div class="flex w-full items-center gap-2">
              <span>${mail.name}</span>
              <span class="ml-auto text-xs">${mail.date}</span>
            </div>
            <span class="font-medium">${mail.subject}</span>
            <span class="line-clamp-2 w-[260px] text-xs whitespace-break-spaces">${mail.teaser}</span>
          </a>
        </for>
      </SidebarGroup>
    </SidebarContent>
  </Sidebar>
</div>
