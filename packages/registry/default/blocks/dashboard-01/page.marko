// Port of shadcn's dashboard-01 page.tsx.
//
// DEVIATIONS (registry primitive gaps):
// - shadcn's SidebarInset (a <main> variant that insets/rounds the content
//   area when the sidebar's variant="inset") has no dedicated equivalent
//   among our sidebar sub-parts, so the content region is a plain <div>
//   carrying the source's SidebarInset classes directly, following the
//   precedent in blocks/sidebar-07/page.marko and blocks/sidebar-15/page.marko.
//   Our <Sidebar> part also has no `variant` prop, so app-sidebar.marko
//   cannot set data-variant="inset" on the sidebar's own root; the visual
//   inset styling (peer-data-[variant=inset]:* on this wrapper) therefore
//   has no effect here — content renders as a plain full-bleed panel next
//   to the sidebar instead of a rounded, margined inset panel. Noted, not
//   silently dropped.
// - SidebarProvider only exposes a --sidebar-width style var (its own
//   `style={}` is written after `...rest` in provider.marko, so an
//   input-level `style` attribute would be silently overridden, not
//   merged). The source's --header-height custom property is applied on
//   an outer wrapper div instead, following blocks/sidebar-16/page.marko's
//   precedent for the same gap.
import SidebarProvider from "@marko-ui/registry/ui/sidebar/provider.marko";
import AppSidebar from "./app-sidebar.marko";
import SiteHeader from "./site-header.marko";
import SectionCards from "./section-cards.marko";
import ChartAreaInteractive from "./chart-area-interactive.marko";
import DocumentsTable from "./documents-table.marko";

<div style="--header-height: calc(var(--spacing) * 12)">
  <SidebarProvider width="calc(var(--spacing) * 72)">
    <@sidebar|{ open }|>
      <AppSidebar open=open/>
    </@sidebar>
    <@content|{ open, toggle }|>
      <div data-slot="sidebar-inset" class="relative flex w-full flex-1 flex-col bg-background md:m-2 md:ml-0 md:rounded-xl md:shadow-sm">
        <SiteHeader open=open toggle=toggle/>
        <div class="flex flex-1 flex-col">
          <div class="@container/main flex flex-1 flex-col gap-2">
            <div class="flex flex-col gap-4 py-4 md:gap-6 md:py-6">
              <SectionCards/>
              <div class="px-4 lg:px-6">
                <ChartAreaInteractive/>
              </div>
              <DocumentsTable/>
            </div>
          </div>
        </div>
      </div>
    </@content>
  </SidebarProvider>
</div>
