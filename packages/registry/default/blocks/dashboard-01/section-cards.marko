// Port of shadcn's section-cards.tsx. Wrapper classes/data-slot selectors
// (the *:data-[slot=card]:* container-query grid) are emitted verbatim.
import Badge from "@marko-ui/registry/ui/badge/badge.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardAction from "@marko-ui/registry/ui/card/action.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";

static const METRICS = [
  {
    id: "revenue",
    label: "Total Revenue",
    value: "$1,250.00",
    delta: "+12.5%",
    trend: "up",
    headline: "Trending up this month",
    detail: "Visitors for the last 6 months",
  },
  {
    id: "customers",
    label: "New Customers",
    value: "1,234",
    delta: "-20%",
    trend: "down",
    headline: "Down 20% this period",
    detail: "Acquisition needs attention",
  },
  {
    id: "accounts",
    label: "Active Accounts",
    value: "45,678",
    delta: "+12.5%",
    trend: "up",
    headline: "Strong user retention",
    detail: "Engagement exceed targets",
  },
  {
    id: "growth",
    label: "Growth Rate",
    value: "4.5%",
    delta: "+4.5%",
    trend: "up",
    headline: "Steady performance increase",
    detail: "Meets growth projections",
  },
];

<div class="grid grid-cols-1 gap-4 px-4 *:data-[slot=card]:bg-gradient-to-t *:data-[slot=card]:from-primary/5 *:data-[slot=card]:to-card *:data-[slot=card]:shadow-xs lg:px-6 @xl/main:grid-cols-2 @5xl/main:grid-cols-4 dark:*:data-[slot=card]:bg-card">
  <for|metric| of=METRICS by=(metric) => metric.id>
    <Card class="@container/card">
      <CardHeader>
        <CardDescription>${metric.label}</CardDescription>
        <CardTitle class="text-2xl font-semibold tabular-nums @[250px]/card:text-3xl">${metric.value}</CardTitle>
        <CardAction>
          <Badge variant="outline">
            <if=metric.trend === "up">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 7h6v6"/>
                <path d="m22 7-8.5 8.5-5-5L2 17"/>
              </svg>
            </if>
            <else>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 17h6v-6"/>
                <path d="m22 17-8.5-8.5-5 5L2 7"/>
              </svg>
            </else>
            ${metric.delta}
          </Badge>
        </CardAction>
      </CardHeader>
      <CardFooter class="flex-col items-start gap-1.5 text-sm">
        <div class="line-clamp-1 flex gap-2 font-medium">
          ${metric.headline}
          <if=metric.trend === "up">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
              <path d="M16 7h6v6"/>
              <path d="m22 7-8.5 8.5-5-5L2 17"/>
            </svg>
          </if>
          <else>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
              <path d="M16 17h6v-6"/>
              <path d="m22 17-8.5-8.5-5 5L2 7"/>
            </svg>
          </else>
        </div>
        <div class="text-muted-foreground">${metric.detail}</div>
      </CardFooter>
    </Card>
  </for>
</div>
