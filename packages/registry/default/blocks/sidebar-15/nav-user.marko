import Avatar from "@marko-ui/registry/ui/avatar/avatar.marko";
import DropdownMenu from "@marko-ui/registry/ui/dropdown-menu/dropdown-menu.marko";
import SidebarMenu from "@marko-ui/registry/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/registry/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/registry/ui/sidebar/menu-button.marko";

export interface NavUserData {
  name: string;
  email: string;
  avatar: string;
}

export interface Input {
  user: NavUserData;
}

// The dropdown-menu `<@item>` attr tag accepts a markup `content` body plus
// a `class` override on label entries (see
// ui/dropdown-menu/dropdown-menu.marko), so the source's rich
// DropdownMenuLabel — avatar + name/email, with `p-0 font-normal` replacing
// the default padded/muted label classes — ports faithfully instead of
// being flattened to a plain string label.
//
// Width: the source sizes DropdownMenuContent with
// `w-(--radix-dropdown-menu-trigger-width)`, a Radix CSS var mirroring the
// trigger's measured width. zag's popper exposes the same measurement as
// `--reference-width` on the positioner (see @zag-js/popper
// get-placement.js/get-styles.js), so `w-(--reference-width)` is the
// visual-equivalent mapping for our primitive.

<SidebarMenu>
  <SidebarMenuItem>
    <DropdownMenu class="w-(--reference-width) min-w-56 rounded-lg">
      <@trigger|triggerProps|>
        <SidebarMenuButton
          ...triggerProps
          size="lg"
          class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground"
        >
          <Avatar src=input.user.avatar alt=input.user.name fallback="CN" class="h-8 w-8 rounded-lg"/>
          <div class="grid flex-1 text-left text-sm leading-tight">
            <span class="truncate font-medium">${input.user.name}</span>
            <span class="truncate text-xs">${input.user.email}</span>
          </div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-auto size-4"
          >
            <path d="m7 15 5 5 5-5"/>
            <path d="m7 9 5-5 5 5"/>
          </svg>
        </SidebarMenuButton>
      </@trigger>
      <@item type="label" class="p-0 font-normal">
        <div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
          <Avatar src=input.user.avatar alt=input.user.name fallback="CN" class="h-8 w-8 rounded-lg"/>
          <div class="grid flex-1 text-left text-sm leading-tight">
            <span class="truncate font-medium">${input.user.name}</span>
            <span class="truncate text-xs">${input.user.email}</span>
          </div>
        </div>
      </@item>
      <@item type="separator"/>
      <@item type="item" value="upgrade" label="Upgrade to Pro"/>
      <@item type="separator"/>
      <@item type="item" value="account" label="Account"/>
      <@item type="item" value="billing" label="Billing"/>
      <@item type="item" value="notifications" label="Notifications"/>
      <@item type="separator"/>
      <@item type="item" value="logout" label="Log out"/>
    </DropdownMenu>
  </SidebarMenuItem>
</SidebarMenu>
