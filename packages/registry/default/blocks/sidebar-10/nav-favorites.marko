import SidebarGroup from "@marko-ui/registry/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/registry/ui/sidebar/group-label.marko";
import SidebarMenu from "@marko-ui/registry/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/registry/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/registry/ui/sidebar/menu-button.marko";
import DropdownMenu from "@marko-ui/registry/ui/dropdown-menu/dropdown-menu.marko";

export interface FavoriteItem {
  id: string;
  name: string;
  url: string;
  emoji: string;
}

export interface Input {
  favorites: FavoriteItem[];
}

// NOTE: shadcn's SidebarMenuAction (a hover-revealed icon button anchored to
// a menu item) has no equivalent in our sidebar sub-parts yet, so the "more"
// trigger below is a plain inline button styled to match. Deviation from the
// source, noted per block-porting rules.

<const/menuItems=[
  { value: "remove", label: "Remove from Favorites" },
  { type: "separator" as const },
  { value: "copy-link", label: "Copy Link" },
  { value: "open-new-tab", label: "Open in New Tab" },
  { type: "separator" as const },
  { value: "delete", label: "Delete", danger: true },
]/>

<SidebarGroup class="group-data-[collapsible=icon]:hidden">
  <SidebarGroupLabel>Favorites</SidebarGroupLabel>
  <SidebarMenu>
    <for|item| of=input.favorites by=(item) => item.id>
      <SidebarMenuItem class="group/favorite-item relative">
        <SidebarMenuButton href=item.url title=item.name class="pr-8">
          <span>${item.emoji}</span>
          <span>${item.name}</span>
        </SidebarMenuButton>
        <DropdownMenu items=menuItems class="w-56">
          <@trigger|attrs|>
            <button
              ...attrs
              type="button"
              class="absolute right-1 top-1.5 flex aspect-square w-5 items-center justify-center rounded-md p-0 text-sidebar-foreground opacity-0 outline-none ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 group-hover/favorite-item:opacity-100 data-[state=open]:opacity-100 [&>svg]:size-4 [&>svg]:shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="1"/>
                <circle cx="19" cy="12" r="1"/>
                <circle cx="5" cy="12" r="1"/>
              </svg>
              <span class="sr-only">More</span>
            </button>
          </@trigger>
        </DropdownMenu>
      </SidebarMenuItem>
    </for>
    <SidebarMenuItem>
      <SidebarMenuButton class="text-sidebar-foreground/70">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="1"/>
          <circle cx="19" cy="12" r="1"/>
          <circle cx="5" cy="12" r="1"/>
        </svg>
        <span>More</span>
      </SidebarMenuButton>
    </SidebarMenuItem>
  </SidebarMenu>
</SidebarGroup>
