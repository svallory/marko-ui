            </div>
            <div class="flex flex-col gap-0.5 leading-none">
              <span class="font-medium">Documentation</span>
              <span>v1.0.0</span>
            </div>
          </SidebarMenuButton>
        </SidebarMenuItem>
      </SidebarMenu>
    </SidebarHeader>
    <SidebarContent>
      <SidebarGroup>
        <SidebarMenu class="gap-2">
          <for|section| of=NAV_MAIN by=(section) => section.id>
            <SidebarMenuItem>
              <SidebarMenuButton href=section.url class="font-medium">
                ${section.title}
              </SidebarMenuButton>
              <if=section.items.length !== 0>
                <!-- Kit gap: ui/sidebar has no SidebarMenuSub/SidebarMenuSubItem/SidebarMenuSubButton
                     primitives (shadcn source uses those here). Falling back to a plain <ul>/<li>
                     border wrapper and reusing SidebarMenuButton at a smaller size for the sub-links,
                     so active/hover/focus styling stays sourced from the design system instead of a
                     hand-duplicated class list. See registry.meta.json "deviations". -->
                <ul class="ml-0 flex min-w-0 flex-col gap-1 border-l-0 px-1.5 py-0.5">
                  <for|item| of=section.items by=(item) => item.id>
                    <li>
                      <SidebarMenuButton
                        href=item.url
                        active=item.active
                        class="h-7 text-sidebar-foreground/70 data-[active=true]:font-normal"
                      >
                        ${item.title}
                      </SidebarMenuButton>
                    </li>
                  </for>
                </ul>
              </if>
            </SidebarMenuItem>
          </for>
        </SidebarMenu>
      </SidebarGroup>
    </SidebarContent>
  </@content>
</Sidebar>
