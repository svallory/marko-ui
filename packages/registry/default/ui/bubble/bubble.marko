import { bubbleVariants, type BubbleVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, BubbleVariants {
  align?: "start" | "end";
}

<const/{ variant = "default", align = "start", class: className, content, ...rest }=input/>

<div
  data-slot="bubble"
  data-variant=variant
  data-align=align
  class=cn(bubbleVariants({ variant }), className)
  ...rest
>
  <${content}/>
</div>
