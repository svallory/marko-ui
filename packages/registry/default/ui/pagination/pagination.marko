import * as paginationMachine from "@zag-js/pagination";
import type { MachineInput } from "marko-zag";
import { buttonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"nav", paginationMachine.Props> & {
  pageChange?: (page: number) => void;
};

<machine-props/machineProps from=input pick=paginationMachine.props
  onPageChange(details: paginationMachine.PageChangeDetails) {
    input.onPageChange?.(details);
    input.pageChange?.(details.page);
  }/>
<service/service machine=() => paginationMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  paginationMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    pageChange: ownChangeHandler,
    ...native
  } = paginationMachine.splitProps(input)[1];
  return native;
}>

<nav ...nativeAttrs() ...api().getRootProps() data-slot="pagination" class=cn(input.class)>
  <ul class="flex flex-row items-center gap-1">
    <li>
      <button
        ...api().getPrevTriggerProps()
        data-slot="pagination-prev"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "gap-1 px-2.5 sm:pl-2.5")
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="hidden sm:block">Previous</span>
      </button>
    </li>
    <for|item, index| of=api().pages by=(item, index) => item.type === "page" ? `page-${item.value}` : `ellipsis-${index}`>
      <if=item.type === "page">
        <li>
          <button
            ...api().getItemProps({ type: "page", value: item.value })
            data-slot="pagination-item"
            class=buttonVariants({ variant: item.value === api().page ? "outline" : "ghost", size: "icon" })
          >
            ${item.value}
          </button>
        </li>
      </if>
      <else>
        <li>
          <span
            ...api().getEllipsisProps({ index })
            data-slot="pagination-ellipsis"
            class="flex size-9 items-center justify-center"
          >
            &hellip;
          </span>
        </li>
      </else>
    </for>
    <li>
      <button
        ...api().getNextTriggerProps()
        data-slot="pagination-next"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "gap-1 px-2.5 sm:pr-2.5")
      >
        <span class="hidden sm:block">Next</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </li>
  </ul>
</nav>

<return=api>
