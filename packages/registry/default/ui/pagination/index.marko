import * as pagination from "@zag-js/pagination";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { buttonVariants } from "../button/variants.ts";
import { cn } from "../../lib/utils.ts";

export interface Input extends Omit<Marko.Input<"nav">, "count"> {
  count: number;
  pageSize?: number;
  siblingCount?: number;
  page?: number;
  pageChange?: (details: { page: number; pageSize: number }) => void;
}

<const/{ count, pageSize, siblingCount, page, pageChange, class: className, ...rest }=input/>

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<const/machineProps=() => ({
  id: uid,
  count,
  pageSize,
  siblingCount,
  page,
  onPageChange(details: { page: number; pageSize: number }) {
    pageChange?.(details);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(pagination.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.count;
  input.pageSize;
  input.siblingCount;
  input.page;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = pagination.connect(svc ?? ssrService(pagination.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    prevTrigger: api.getPrevTriggerProps(),
    nextTrigger: api.getNextTriggerProps(),
    pages: api.pages.map((p, index) =>
      p.type === "page"
        ? { type: "page" as const, value: p.value, itemProps: api.getItemProps({ value: p.value, type: "page" }) }
        : { type: "ellipsis" as const, index, ellipsisProps: api.getEllipsisProps({ index }) },
    ),
  };
}/>
<const/ui=(rev, computeUi())/>

<nav ...rest ...ui.root data-slot="pagination" class=cn(className)>
  <ul class="flex flex-row items-center gap-1">
    <li>
      <button
        ...ui.prevTrigger
        data-slot="pagination-prev"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "gap-1 px-2.5 sm:pl-2.5")
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="hidden sm:block">Previous</span>
      </button>
    </li>
    <for|item| of=ui.pages by=(item) => item.type === "page" ? `page-${item.value}` : `ellipsis-${item.index}`>
      <if=item.type === "page">
        <li>
          <button
            ...item.itemProps
            data-slot="pagination-item"
            class=buttonVariants({ variant: item.itemProps["data-selected"] !== undefined ? "outline" : "ghost", size: "icon" })
          >
            ${item.value}
          </button>
        </li>
      </if>
      <else>
        <li>
          <span
            ...item.ellipsisProps
            data-slot="pagination-ellipsis"
            class="flex size-9 items-center justify-center"
          >
            &hellip;
          </span>
        </li>
      </else>
    </for>
    <li>
      <button
        ...ui.nextTrigger
        data-slot="pagination-next"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "gap-1 px-2.5 sm:pr-2.5")
      >
        <span class="hidden sm:block">Next</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </li>
  </ul>
</nav>
