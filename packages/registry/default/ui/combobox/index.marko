import * as combobox from "@zag-js/combobox";
import { createService, ssrService, normalizeProps, positionerStyle } from "marko-zag";
import { cn } from "../../lib/utils.ts";

export interface ComboboxItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface Input extends Omit<Marko.Input<"div">, "value"> {
  items: ComboboxItem[];
  value?: string[];
  valueChange?: (value: string[]) => void;
  placeholder?: string;
  disabled?: boolean;
  name?: string;
}

<const/{ items, value, valueChange, placeholder, disabled, name, class: className, ...rest }=input/>

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<let/filtered=items/>

<const/buildCollection=(list: ComboboxItem[]) => combobox.collection({ items: list, itemToValue: (item: ComboboxItem) => item.value, itemToString: (item: ComboboxItem) => item.label, isItemDisabled: (item: ComboboxItem) => !!item.disabled })/>

<const/machineProps=() => ({
  id: uid,
  collection: buildCollection(filtered),
  value,
  disabled,
  name,
  onInputValueChange(details: { inputValue: string }) {
    const query = details.inputValue.trim().toLowerCase();
    filtered = query === "" ? items : items.filter((item) => item.label.toLowerCase().includes(query));
  },
  onValueChange(details: { value: string[] }) {
    valueChange?.(details.value);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(combobox.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.items;
  input.value;
  input.disabled;
  input.name;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = combobox.connect(svc ?? ssrService(combobox.machine, machineProps), normalizeProps);
  return {
    open: api.open,
    inputValue: api.inputValue,
    root: api.getRootProps(),
    control: api.getControlProps(),
    input: api.getInputProps(),
    trigger: api.getTriggerProps(),
    positioner: api.getPositionerProps(),
    content: api.getContentProps(),
    items: filtered.map((item) => ({
      item,
      itemProps: api.getItemProps({ item }),
      itemTextProps: api.getItemTextProps({ item }),
      itemIndicatorProps: api.getItemIndicatorProps({ item }),
    })),
  };
}/>
<const/ui=(rev, computeUi())/>

<div ...rest ...ui.root data-slot="combobox" class=cn(className)>
  <div
    ...ui.control
    data-slot="combobox-control"
    class="border-input relative flex items-center rounded-md border shadow-xs focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/50"
  >
    <input
      ...ui.input
      data-slot="combobox-input"
      placeholder=placeholder
      class="h-9 flex-1 bg-transparent px-3 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
    />
    <button
      ...ui.trigger
      data-slot="combobox-trigger"
      class="flex h-9 w-9 items-center justify-center text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-50">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>
  </div>
  <if=ui.open>
    <portal>
      <div ...ui.positioner style=positionerStyle data-slot="combobox-positioner" class="z-50">
        <div
          ...ui.content
          data-slot="combobox-content"
          class="bg-popover text-popover-foreground relative z-50 min-w-[8rem] overflow-x-hidden overflow-y-auto rounded-md border p-1 shadow-md data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95"
        >
          <for|entry| of=ui.items>
            <div
              ...entry.itemProps
              data-slot="combobox-item"
              class="focus:bg-accent focus:text-accent-foreground data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 relative flex w-full cursor-default items-center gap-2 rounded-sm py-1.5 pr-8 pl-2 text-sm outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50"
            >
              <span ...entry.itemTextProps data-slot="combobox-item-text">${entry.item.label}</span>
              <span ...entry.itemIndicatorProps data-slot="combobox-item-indicator" class="absolute right-2 flex size-3.5 items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
              </span>
            </div>
          </for>
          <if=(ui.items.length === 0)>
            <div data-slot="combobox-empty" class="text-muted-foreground py-1.5 px-2 text-sm">No results found.</div>
          </if>
        </div>
      </div>
    </portal>
  </if>
</div>
