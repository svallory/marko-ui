import * as menu from "@zag-js/menu";
import { positionerStyle } from "marko-ui";
import { cn } from "#lib/utils.ts";
import type { DropdownMenuItem } from "../dropdown-menu/dropdown-menu.marko";

// Attr-tag "parts" — additive sugar alongside `items=`. See
// agent/reports/compound-tag-dx.md (Variant A). Each attr tag name is
// collected into its own separate array by Marko (no shared index across
// different attr-tag names exists), so relative order between `<@item>`,
// `<@separator>`, and `<@label>` tags at the call site is NOT preserved —
// items render first, then separators, then labels, mirroring the
// same-name grouping every other migrated menu component uses. Callers
// that need precise interleaved ordering should use `items=` instead.
export interface ItemAttrs {
  value?: string;
  disabled?: boolean;
  danger?: boolean;
  shortcut?: string;
  content?: Marko.Body;
}
export interface SeparatorAttrs {}
export interface LabelAttrs {
  content?: Marko.Body;
}

export interface Input {
  trigger: Marko.Body<[Record<string, unknown>]>;
  items?: DropdownMenuItem[];
  item?: Marko.AttrTag<ItemAttrs>;
  separator?: Marko.AttrTag<SeparatorAttrs>;
  label?: Marko.AttrTag<LabelAttrs>;
  select?: (value: string) => void;
  class?: string;
}

<machine-props/machineProps from=input pick=menu.props
  onSelect(details: menu.SelectionDetails) {
    input.select?.(details.value);
  }/>
<service/service machine=() => menu.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  menu.connect(service, normalizeProps)
  service=service
/>

<const/{ class: className, trigger, items }=input/>
<const/itemAttrs=[...(input.item ?? [])]/>
<const/separatorAttrs=[...(input.separator ?? [])]/>
<const/labelAttrs=[...(input.label ?? [])]/>
<const/usingAttrTags=(itemAttrs.length > 0 || separatorAttrs.length > 0 || labelAttrs.length > 0)/>

<${trigger}({ ...api().getTriggerProps(), "data-slot": "menubar-trigger" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="menubar-positioner">
      <div
        ...api().getContentProps()
        data-slot="menubar-content"
        class=cn(
          "bg-popover text-popover-foreground z-50 min-w-[12rem] overflow-hidden rounded-md border p-1 shadow-md",
          "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
          "data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2",
          className,
        )
      >
        <if=usingAttrTags>
          <for|label, index| of=labelAttrs>
            <div data-slot="menubar-label" class="px-2 py-1.5 text-xs font-medium text-muted-foreground">
              <${label.content}/>
            </div>
          </for>
          <for|item, index| of=itemAttrs>
            <div
              ...api().getItemProps({ value: item.value ?? `item-${index}`, disabled: item.disabled })
              data-slot="menubar-item"
              data-danger=item.danger || undefined
              class=cn(
                "relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none",
                "data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground",
                "data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
                "data-[danger]:text-destructive data-[danger]:data-[highlighted]:bg-destructive/10",
              )
            >
              <span><${item.content}/></span>
              <if=item.shortcut>
                <span class="ml-auto text-xs tracking-widest text-muted-foreground">${item.shortcut}</span>
              </if>
            </div>
          </for>
          <for|separator, index| of=separatorAttrs>
            <div ...api().getSeparatorProps() data-slot="menubar-separator" class="bg-border -mx-1 my-1 h-px"/>
          </for>
        </if>
        <else>
          <for|entry, index| of=(items ?? [])>
            <if=entry.type === "separator">
              <div ...api().getSeparatorProps() data-slot="menubar-separator" class="bg-border -mx-1 my-1 h-px"/>
            </if>
            <else if=entry.type === "label">
              <div data-slot="menubar-label" class="px-2 py-1.5 text-xs font-medium text-muted-foreground">
                ${entry.label}
              </div>
            </else>
            <else>
              <div
                ...api().getItemProps({ value: entry.value ?? `item-${index}`, disabled: entry.disabled })
                data-slot="menubar-item"
                data-danger=entry.danger || undefined
                class=cn(
                  "relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none",
                  "data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground",
                  "data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
                  "data-[danger]:text-destructive data-[danger]:data-[highlighted]:bg-destructive/10",
                )
              >
                <span>${entry.label}</span>
                <if=entry.shortcut>
                  <span class="ml-auto text-xs tracking-widest text-muted-foreground">${entry.shortcut}</span>
                </if>
              </div>
            </else>
          </for>
        </else>
      </div>
    </div>
  </if>
</portal>

<return=api>
