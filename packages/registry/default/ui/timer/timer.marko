// Countdown / stopwatch timer.
// Guide: /docs/creating-components · authoring rules: notes/component-authoring.md
import * as timerMachine from "@zag-js/timer";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", timerMachine.Props> & {
  tickChange?: (details: timerMachine.TickDetails) => void;
  complete?: () => void;
  /** Time parts to render as digit segments, in order. */
  parts?: timerMachine.TimePart[];
};

static const defaultParts: timerMachine.TimePart[] = ["hours", "minutes", "seconds"];

<machine-props/machineProps from=input pick=timerMachine.props
  onTick(details: timerMachine.TickDetails) {
    input.onTick?.(details);
    input.tickChange?.(details);
  }
  onComplete() {
    input.onComplete?.();
    input.complete?.();
  }/>
<service/service machine=() => timerMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  timerMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    tickChange: ownTickChange,
    complete: ownComplete,
    parts: ownParts,
    ...native
  } = timerMachine.splitProps(input)[1];
  return native;
}>

<const/timeParts=input.parts || defaultParts>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="timer"
  class=cn("flex flex-col items-center gap-4 rounded-xl border bg-card py-6 text-card-foreground shadow-sm", input.class)
>
  <div ...api().getAreaProps() data-slot="timer-area" class="flex items-center gap-1">
    <for|part, index| of=timeParts>
      <if=index>
        <span ...api().getSeparatorProps() data-slot="timer-separator" class="pb-4 text-2xl font-semibold text-muted-foreground">:</span>
      </if>
      <div ...api().getItemProps({ type: part }) data-slot="timer-item" class="flex flex-col items-center gap-1">
        <span
          ...api().getItemValueProps({ type: part })
          data-slot="timer-item-value"
          class="flex h-14 min-w-14 items-center justify-center rounded-md border bg-muted px-2 font-mono text-3xl font-semibold tabular-nums text-foreground"
        >
          ${api().formattedTime[part]}
        </span>
        <span
          ...api().getItemLabelProps({ type: part })
          data-slot="timer-item-label"
          class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
        >
          ${part}
        </span>
      </div>
    </for>
  </div>
  <div ...api().getControlProps() data-slot="timer-control" class="flex items-center gap-2">
    <if=!api().running && !api().paused>
      <button
        ...api().getActionTriggerProps({ action: "start" })
        data-slot="timer-action"
        type="button"
        class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50"
      >
        Start
      </button>
    </if>
    <if=api().running>
      <button
        ...api().getActionTriggerProps({ action: "pause" })
        data-slot="timer-action"
        type="button"
        class="inline-flex h-9 items-center justify-center rounded-md border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50"
      >
        Pause
      </button>
    </if>
    <if=api().paused>
      <button
        ...api().getActionTriggerProps({ action: "resume" })
        data-slot="timer-action"
        type="button"
        class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50"
      >
        Resume
      </button>
    </if>
    <button
      ...api().getActionTriggerProps({ action: "reset" })
      data-slot="timer-action"
      type="button"
      class="inline-flex h-9 items-center justify-center rounded-md border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50"
    >
      Reset
    </button>
  </div>
</div>

<return=api>
