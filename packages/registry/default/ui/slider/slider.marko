import * as sliderMachine from "@zag-js/slider";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", sliderMachine.Props> & {
  valueChange?: (value: number[]) => void;
};

<machine-props/machineProps from=input pick=sliderMachine.props
  onValueChange(details: sliderMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => sliderMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  sliderMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownChangeHandler,
    ...native
  } = sliderMachine.splitProps(input)[1];
  return native;
}>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="slider"
  class=cn("relative flex w-full touch-none items-center select-none", input.class)
>
  <div ...api().getControlProps() data-slot="slider-control" class="relative flex grow touch-none items-center select-none">
    <div ...api().getTrackProps() data-slot="slider-track" class="bg-muted relative grow rounded-full h-1.5 w-full">
      <div ...api().getRangeProps() data-slot="slider-range" class="bg-primary absolute h-full"></div>
    </div>
    <for|_, i| of=api().value>
      <input ...api().getHiddenInputProps({ index: i })>
      // 24px hit box around a 16px visual knob — WCAG 2.5.8 minimum target
      // size (Lighthouse: target-size) without changing the look.
      <div ...api().getThumbProps({ index: i }) data-slot="slider-thumb" class="flex size-6 shrink-0 items-center justify-center">
        <span aria-hidden="true" class="size-4 rounded-full border-primary bg-background border shadow-sm block"></span>
      </div>
    </for>
  </div>
</div>

<return=api>
