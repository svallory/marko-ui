import * as fileUpload from "@zag-js/file-upload";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "../button/variants.ts";

export interface FileUploadFileInfo {
  name: string;
  size: number;
  type: string;
}

export interface Input {
  accept?: string | string[] | Record<string, string[]>;
  maxFiles?: number;
  maxFileSize?: number;
  filesChange?: (files: FileUploadFileInfo[]) => void;
  class?: string;
}

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<let/files=[] as FileUploadFileInfo[]/>

<const/apiRef={ current: null as InstanceType<typeof fileUpload.connect> | null }/>

<const/machineProps=() => ({
  id: uid,
  accept: input.accept,
  maxFiles: input.maxFiles,
  maxFileSize: input.maxFileSize,
  onFileChange(details: { acceptedFiles: File[] }) {
    files = details.acceptedFiles.map((file) => ({
      name: file.name,
      size: file.size,
      type: file.type,
    }));
    input.filesChange?.(files);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(fileUpload.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.accept;
  input.maxFiles;
  input.maxFileSize;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = fileUpload.connect(svc ?? ssrService(fileUpload.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    dropzone: api.getDropzoneProps(),
    hiddenInput: api.getHiddenInputProps(),
    trigger: api.getTriggerProps(),
    itemGroup: api.getItemGroupProps(),
    dragging: api.dragging,
  };
}/>
<const/ui=(rev, computeUi())/>

<script>
  // Keep a live (client-only) api reference for imperative delete actions.
  // Never assigned during SSR, so it never enters serialized state.
  rev;
  if (svc) {
    apiRef.current = fileUpload.connect(svc, normalizeProps);
  }
</script>

<const/formatSize=(bytes: number) => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}/>

<const/removeFile=(name: string) => {
  const api = apiRef.current;
  if (!api) return;
  const file = api.acceptedFiles.find((f: File) => f.name === name);
  if (file) api.deleteFile(file);
}/>

<div ...ui.root data-slot="file-upload" class=cn("flex w-full flex-col gap-4", input.class)>
  <div
    ...ui.dropzone
    data-slot="file-upload-dropzone"
    class="border-input hover:bg-accent/50 flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed p-6 text-center transition-colors data-[dragging]:border-primary data-[dragging]:bg-accent/50"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-muted-foreground size-8"
    >
      <path d="M12 13v8"/>
      <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
      <path d="m8 17 4-4 4 4"/>
    </svg>
    <div class="text-sm">
      <span class="font-medium">Drag and drop files here</span>
    </div>
    <p class="text-muted-foreground text-xs">or click browse to choose files</p>
    <button ...ui.trigger data-slot="file-upload-trigger" class=cn(buttonVariants({ variant: "outline", size: "sm" }), "mt-2")>
      Browse files
    </button>
    <input ...ui.hiddenInput data-slot="file-upload-hidden-input"/>
  </div>

  <if=files.length>
    <ul ...ui.itemGroup data-slot="file-upload-item-group" class="flex flex-col gap-2">
      <for|file| of=files>
        <li data-slot="file-upload-item" class="border-input bg-background flex items-center justify-between gap-2 rounded-md border px-3 py-2 text-sm">
          <div class="flex min-w-0 flex-col">
            <span data-slot="file-upload-item-name" class="truncate font-medium">${file.name}</span>
            <span data-slot="file-upload-item-size-text" class="text-muted-foreground text-xs">${formatSize(file.size)}</span>
          </div>
          <button
            type="button"
            data-slot="file-upload-item-delete-trigger"
            class=cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-7 shrink-0")
            onClick() { removeFile(file.name); }
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
            >
              <path d="M18 6 6 18"/>
              <path d="m6 6 12 12"/>
            </svg>
            <span class="sr-only">Remove ${file.name}</span>
          </button>
        </li>
      </for>
    </ul>
  </if>
</div>
