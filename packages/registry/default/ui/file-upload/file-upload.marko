import * as fileUploadMachine from "@zag-js/file-upload";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";
import { buttonVariants } from "../button/variants.ts";

export interface FileUploadFileInfo {
  name: string;
  size: number;
  type: string;
}

export type Input = MachineInput<"input", fileUploadMachine.Props> & {
  filesChange?: (files: FileUploadFileInfo[]) => void;
};

<machine-props/machineProps from=input pick=fileUploadMachine.props
  onFileChange(details: fileUploadMachine.FileChangeDetails) {
    input.onFileChange?.(details);
    input.filesChange?.(
      details.acceptedFiles.map((file) => ({
        name: file.name,
        size: file.size,
        type: file.type,
      })),
    );
  }/>
<service/service machine=() => fileUploadMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  fileUploadMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    filesChange: ownChangeHandler,
    ...native
  } = fileUploadMachine.splitProps(input)[1];
  return native;
}>

<const/formatSize=(bytes: number) => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}>

<div ...api().getRootProps() data-slot="file-upload" class=cn("flex w-full flex-col gap-4", input.class)>
  // Zag makes the dropzone itself a focusable role="button", but ours
  // contains the "Browse files" trigger — an interactive control nested in
  // another (axe: nested-interactive). The trigger is the keyboard path, so
  // the dropzone drops out of the tab order and stays a plain click/drag
  // target for pointer users.
  <const/dropzoneProps=(() => {
    const { role, tabIndex, tabindex, ...rest } =
      api().getDropzoneProps() as Record<string, unknown>;
    return rest;
  })()>
  <div
    ...dropzoneProps
    data-slot="file-upload-dropzone"
    class="border-input hover:bg-accent/50 flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed p-6 text-center transition-colors data-[dragging]:border-primary data-[dragging]:bg-accent/50"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-muted-foreground size-8"
    >
      <path d="M12 13v8"/>
      <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
      <path d="m8 17 4-4 4 4"/>
    </svg>
    <div class="text-sm">
      <span class="font-medium">Drag and drop files here</span>
    </div>
    <p class="text-muted-foreground text-xs">or click browse to choose files</p>
    <button ...api().getTriggerProps() data-slot="file-upload-trigger" class=cn(buttonVariants({ variant: "outline", size: "sm" }), "mt-2")>
      Browse files
    </button>
    <input ...nativeAttrs() ...api().getHiddenInputProps() data-slot="file-upload-hidden-input"/>
  </div>

  <if=api().acceptedFiles.length>
    <ul ...api().getItemGroupProps() data-slot="file-upload-item-group" class="flex flex-col gap-2">
      <for|file| of=api().acceptedFiles>
        <li ...api().getItemProps({ file }) data-slot="file-upload-item" class="border-input bg-background flex items-center justify-between gap-2 rounded-md border px-3 py-2 text-sm">
          <div class="flex min-w-0 flex-col">
            <span ...api().getItemNameProps({ file }) data-slot="file-upload-item-name" class="truncate font-medium">${file.name}</span>
            <span ...api().getItemSizeTextProps({ file }) data-slot="file-upload-item-size-text" class="text-muted-foreground text-xs">${formatSize(file.size)}</span>
          </div>
          <button
            ...api().getItemDeleteTriggerProps({ file })
            data-slot="file-upload-item-delete-trigger"
            class=cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-7 shrink-0")
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
            >
              <path d="M18 6 6 18"/>
              <path d="m6 6 12 12"/>
            </svg>
            <span class="sr-only">Remove ${file.name}</span>
          </button>
        </li>
      </for>
    </ul>
  </if>
</div>

<return=api>
