import * as menu from "@zag-js/menu";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";
import Icon from "../icon/icon.marko";

export interface ContextMenuItem {
  type?: "item" | "separator" | "label" | "checkbox" | "radio";
  value?: string;
  label?: string;
  disabled?: boolean;
  shortcut?: string;
  /** Upstream `variant: "default" | "destructive"`, emitted as `data-variant`. */
  variant?: "default" | "destructive";
  /** Emits `data-inset` — indents the entry to align with icon-bearing siblings. */
  inset?: boolean;
  /** Checked state for `type="checkbox"` and `type="radio"` entries. */
  checked?: boolean;
}

// Attr-tag form of ContextMenuItem. A SINGLE attr tag name (`item`) carries
// all five kinds (discriminated by `type`) rather than separate per-kind
// attr tags: Marko collects each attr-tag NAME into its own independent
// iterable on `input` with no shared ordering between differently-named
// siblings, so distinct tag names could not preserve call-site interleaving.
// One name with a `type` discriminant keeps document order intact by
// construction (same design as dropdown-menu.marko). `content` lets an item
// or label carry a markup body; the plain `label` string renders as the
// fallback when no body is supplied.
export interface ContextMenuItemAttrs extends ContextMenuItem {
  content?: Marko.Body;
}

export interface Input {
  content: Marko.Body;
  items?: ContextMenuItem[];
  item?: Marko.AttrTag<ContextMenuItemAttrs>;
  select?: (value: string) => void;
  class?: string;
}

<machine-props/machineProps from=input pick=menu.props
  onSelect(details: menu.SelectionDetails) {
    input.select?.(details.value);
  }/>
<service/service machine=() => menu.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  menu.connect(service, normalizeProps)
  service=service
/>

<const/{ class: className }=input/>

// Normalize whichever source was supplied into ONE entries list so the
// render path below never branches. Attr tags win when present (compound is
// primary per the compound-tag-dx report); `items=` is the fallback. The
// single `<@item>` tag name preserves true document order by construction,
// so interleaved item/separator/label entries render exactly as written.
// `items=` entries never carry a body, so each is mapped into the
// ContextMenuItemAttrs shape with an explicit undefined `content` — no
// casts needed (mirrors accordion/toggle-group).
<const/attrItems=[...(input.item ?? [])]/>
<const/entries=(attrItems.length > 0 ? attrItems : (input.items ?? []).map((item) => ({ ...item, content: undefined as Marko.Body | undefined })))/>

<div ...api().getContextTriggerProps() data-slot="context-menu-trigger" class="mu-context-menu-trigger select-none">
  <${input.content}/>
</div>
<portal data-slot="context-menu-portal">
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="context-menu-positioner">
      <div
        ...api().getContentProps()
        data-slot="context-menu-content"
        class=cn(
          "mu-context-menu-content mu-menu-target mu-menu-translucent z-50 max-h-(--radix-context-menu-content-available-height) origin-(--radix-context-menu-content-transform-origin) overflow-x-hidden overflow-y-auto",
          className,
        )
      >
        <for|entry, index| of=entries>
          <if=entry.type === "separator">
            <div ...api().getSeparatorProps() data-slot="context-menu-separator" class="mu-context-menu-separator"/>
          </if>
          <else if=entry.type === "label">
            <div data-slot="context-menu-label" data-inset=entry.inset || undefined class="mu-context-menu-label">
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
            </div>
          </else>
          <else if=entry.type === "checkbox">
            <div
              ...api().getOptionItemProps({ type: "checkbox", value: entry.value ?? `item-${index}`, checked: entry.checked, disabled: entry.disabled })
              data-slot="context-menu-checkbox-item"
              data-inset=entry.inset || undefined
              class="mu-context-menu-checkbox-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span ...api().getItemIndicatorProps({ type: "checkbox", value: entry.value ?? `item-${index}`, checked: entry.checked }) data-slot="context-menu-checkbox-item-indicator" class="mu-context-menu-item-indicator pointer-events-none">
                <if=entry.checked>
                  <Icon name="Check"/>
                </if>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="context-menu-shortcut" class="mu-context-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else if=entry.type === "radio">
            <div
              ...api().getOptionItemProps({ type: "radio", value: entry.value ?? `item-${index}`, checked: entry.checked, disabled: entry.disabled })
              data-slot="context-menu-radio-item"
              data-inset=entry.inset || undefined
              class="mu-context-menu-radio-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span ...api().getItemIndicatorProps({ type: "radio", value: entry.value ?? `item-${index}`, checked: entry.checked }) data-slot="context-menu-radio-item-indicator" class="mu-context-menu-item-indicator pointer-events-none">
                <if=entry.checked>
                  <Icon name="Check"/>
                </if>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="context-menu-shortcut" class="mu-context-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else>
            <div
              ...api().getItemProps({ value: entry.value ?? `item-${index}`, disabled: entry.disabled })
              data-slot="context-menu-item"
              data-inset=entry.inset || undefined
              data-variant=entry.variant ?? "default"
              class="mu-context-menu-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="context-menu-shortcut" class="mu-context-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
        </for>
      </div>
    </div>
  </if>
</portal>

<return=api>
