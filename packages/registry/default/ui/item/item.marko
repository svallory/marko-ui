import { itemVariants, type ItemVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, ItemVariants {}

<const/{ variant, size, class: className, content, ...rest }=input/>

<div ...rest data-slot="item" data-variant=(variant ?? "default") data-size=(size ?? "default") class=cn(itemVariants({ variant, size }), className)>
  <${content}/>
</div>
