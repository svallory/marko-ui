import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  orientation?: "horizontal" | "vertical";
}

<const/{ orientation = "vertical", class: className, content, ...rest }=input/>

<div
  ...rest
  data-slot="button-group-separator"
  role="separator"
  data-orientation=orientation
  class=cn(
    "bg-input relative !m-0 self-stretch data-[orientation=vertical]:h-auto data-[orientation=vertical]:w-px data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full",
    className,
  )
>
  <${content}/>
</div>
