import * as accordionMachine from "@zag-js/accordion";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export interface AccordionItem {
  value: string;
  title: string;
  content?: string;
}

export type Input = MachineInput<"div", accordionMachine.Props> & {
  items: AccordionItem[];
  content?: Marko.Body<[AccordionItem]>;
  valueChange?: (value: string[]) => void;
};

<machine-props/machineProps from=input pick=accordionMachine.props
  onValueChange(details: accordionMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => accordionMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  accordionMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownChangeHandler,
    items: ownItems,
    content: ownContent,
    ...native
  } = accordionMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="accordion" class=cn(input.class)>
  <for|item| of=input.items>
    <div
      ...api().getItemProps({ value: item.value })
      data-slot="accordion-item"
      class="border-b last:border-b-0"
    >
      <h3 class="flex">
        <button
          ...api().getItemTriggerProps({ value: item.value })
          data-slot="accordion-trigger"
          class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180"
        >
          ${item.title}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-0.5 transition-transform duration-200"
          >
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      </h3>
      <div
        ...api().getItemContentProps({ value: item.value })
        data-slot="accordion-content"
        class="overflow-hidden text-sm data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down"
      >
        <div class="pt-0 pb-4">
          <if=input.content>
            <${input.content}(item)/>
          </if>
          <if=!input.content>${item.content}</if>
        </div>
      </div>
    </div>
  </for>
</div>

<return=api>
