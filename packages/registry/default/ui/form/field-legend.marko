import { cn } from "../../lib/utils.ts";

export interface Input extends Marko.Input<"legend"> {
  variant?: "legend" | "label";
}

<const/{ variant = "legend", class: className, content, ...rest }=input/>

<legend
  ...rest
  data-slot="field-legend"
  data-variant=variant
  class=cn(
    "mb-3 font-medium",
    "data-[variant=legend]:text-base",
    "data-[variant=label]:text-sm",
    className,
  )
>
  <${content}/>
</legend>
