import { cn } from "../../lib/utils.ts";

export interface FieldContentProps {
  id: string;
  describedBy: string | undefined;
  invalid: boolean;
}

export interface Input {
  label?: string;
  description?: string;
  error?: string;
  content: Marko.Body<[FieldContentProps]>;
  class?: string;
}

<id/uid/>
<const/descriptionId=input.description ? `${uid}-description` : undefined/>
<const/errorId=input.error ? `${uid}-error` : undefined/>
<const/describedBy=[descriptionId, errorId].filter(Boolean).join(" ") || undefined/>
<const/invalid=!!input.error/>

<div data-slot="field" class=cn("grid gap-2", input.class)>
  <if=input.label>
    <label
      for=uid
      data-slot="field-label"
      class=cn("text-sm font-medium leading-none", invalid && "text-destructive")
    >
      ${input.label}
    </label>
  </if>
  <${input.content}({ id: uid, describedBy, invalid })/>
  <if=input.description>
    <p id=descriptionId data-slot="field-description" class="text-muted-foreground text-sm">
      ${input.description}
    </p>
  </if>
  <if=input.error>
    <p id=errorId data-slot="field-error" class="text-destructive text-sm font-medium">
      ${input.error}
    </p>
  </if>
</div>
