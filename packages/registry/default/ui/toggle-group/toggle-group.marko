import * as toggleGroupMachine from "@zag-js/toggle-group";
import type { MachineInput } from "marko-ui";
import { toggleVariants, type ToggleVariants } from "../toggle/variants.ts";
import { cn } from "#lib/utils.ts";

export interface ToggleGroupItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export type Input = MachineInput<"div", toggleGroupMachine.Props> &
  ToggleVariants & {
    items: ToggleGroupItem[];
    valueChange?: (value: string[]) => void;
  };

<machine-props/machineProps from=input pick=toggleGroupMachine.props
  onValueChange(details: toggleGroupMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => toggleGroupMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  toggleGroupMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    variant: ownVariant,
    size: ownSize,
    valueChange: ownChangeHandler,
    ...native
  } = toggleGroupMachine.splitProps(input)[1];
  return native;
}>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="toggle-group"
  class=cn("flex items-center gap-1", input.class)
>
  <for|item| of=input.items by=(item) => item.value>
    <button
      ...api().getItemProps({ value: item.value, disabled: item.disabled })
      data-slot="toggle-group-item"
      class=toggleVariants({ variant: input.variant, size: input.size })
    >
      ${item.label}
    </button>
  </for>
</div>

<return=api>
