import * as toggleGroup from "@zag-js/toggle-group";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { toggleVariants, type ToggleVariants } from "../toggle/variants.ts";
import { cn } from "../../lib/utils.ts";

export interface ToggleGroupItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface Input extends Omit<Marko.Input<"div">, "value">, ToggleVariants {
  items: ToggleGroupItem[];
  multiple?: boolean;
  value?: string[];
  valueChange?: (value: string[]) => void;
  disabled?: boolean;
}

<const/{ items, multiple, value, valueChange, disabled, variant, size, class: className, ...rest }=input/>

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<const/machineProps=() => ({
  id: uid,
  multiple,
  value,
  disabled,
  onValueChange(details: { value: string[] }) {
    valueChange?.(details.value);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(toggleGroup.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.multiple;
  input.value;
  input.disabled;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = toggleGroup.connect(svc ?? ssrService(toggleGroup.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    items: items.map((item) => ({
      value: item.value,
      itemProps: api.getItemProps({ value: item.value, disabled: item.disabled }),
      state: api.getItemState({ value: item.value, disabled: item.disabled }),
    })),
  };
}/>
<const/ui=(rev, computeUi())/>

<div ...rest ...ui.root data-slot="toggle-group" class=cn("flex items-center gap-1", className)>
  <for|item, i| of=ui.items by=(item) => item.value>
    <button
      ...item.itemProps
      data-slot="toggle-group-item"
      data-state=(item.state.pressed ? "on" : "off")
      class=toggleVariants({ variant, size })
    >
      ${items[i].label}
    </button>
  </for>
</div>
