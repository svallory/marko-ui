import * as tabsMachine from "@zag-js/tabs";
import type { MachineInput } from "marko-zag";
import { tabsListVariants, type TabsListVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface TabItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface TabsTriggerAttrs {
  value: string;
  disabled?: boolean;
  content?: Marko.Body;
}

export interface TabsPanelAttrs {
  value: string;
  content?: Marko.Body;
}

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `valueChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Tabs value:=myState/>); Zag's own `onValueChange` also works and
// receives the details object.
//
// Dual API: compound attr tags (`<@trigger>`/`<@panel>`) are the primary,
// Marko-idiomatic form; `items=` + `content` remain as sugar for the
// data-driven case. If both are supplied, attr tags win.
export type Input = MachineInput<"div", tabsMachine.Props> &
  TabsListVariants & {
    items?: TabItem[];
    content?: Marko.Body<[string]>;
    trigger?: Marko.AttrTag<TabsTriggerAttrs>;
    panel?: Marko.AttrTag<TabsPanelAttrs>;
    valueChange?: (value: string) => void;
  };

<const/{ items, content }=input/>

// Normalize whichever source was supplied into one shape so the render path
// below never branches. Attr tags win if both are present (compound is
// primary per the compound-tag-dx report).
//
// NOTE: `trigger` and `panel` normalize INDEPENDENTLY — the "attr tags win"
// rule applies per tag name, not to the component as a whole. Mixing
// `<@trigger>` tags with `items=` (and no `<@panel>` tags) therefore yields
// attr-tag-derived triggers paired with items=-derived panels — a hybrid;
// supply both tag names (or neither) to stay on one source.
<const/triggerTags=[...(input.trigger ?? [])]/>
<const/panelTags=[...(input.panel ?? [])]/>
<const/triggers=(triggerTags.length > 0 ? triggerTags : (items ?? []).map((item) => ({ value: item.value, disabled: item.disabled, label: item.label })))/>
<const/panels=(panelTags.length > 0 ? panelTags : (items ?? []).map((item) => ({ value: item.value })))/>

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=tabsMachine.props
  defaultValue=input.defaultValue ?? triggers[0]?.value
  onValueChange(details: tabsMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => tabsMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  tabsMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, items, content, valueChange) passes through to the root div.
<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    content: ownContent,
    trigger: ownTrigger,
    panel: ownPanel,
    variant: ownVariant,
    valueChange: ownChangeHandler,
    ...native
  } = tabsMachine.splitProps(input)[1];
  return native;
}>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="tabs"
  class=cn("mu-tabs group/tabs flex data-horizontal:flex-col", input.class)
>
  <div
    ...api().getListProps()
    data-slot="tabs-list"
    data-variant=(input.variant ?? "default")
    class=tabsListVariants({ variant: input.variant })
  >
    <for|trigger| of=triggers>
      <button
        ...api().getTriggerProps({ value: trigger.value, disabled: trigger.disabled })
        data-slot="tabs-trigger"
        class="mu-tabs-trigger relative inline-flex h-[calc(100%-1px)] flex-1 items-center justify-center whitespace-nowrap text-foreground/60 transition-all group-data-vertical/tabs:w-full group-data-vertical/tabs:justify-start hover:text-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 dark:text-muted-foreground dark:hover:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 group-data-[variant=line]/tabs-list:bg-transparent group-data-[variant=line]/tabs-list:data-[selected]:bg-transparent dark:group-data-[variant=line]/tabs-list:data-[selected]:border-transparent dark:group-data-[variant=line]/tabs-list:data-[selected]:bg-transparent data-[selected]:bg-background data-[selected]:text-foreground dark:data-[selected]:border-input dark:data-[selected]:bg-input/30 dark:data-[selected]:text-foreground after:absolute after:bg-foreground after:opacity-0 after:transition-opacity group-data-horizontal/tabs:after:inset-x-0 group-data-horizontal/tabs:after:bottom-[-5px] group-data-horizontal/tabs:after:h-0.5 group-data-vertical/tabs:after:inset-y-0 group-data-vertical/tabs:after:-right-1 group-data-vertical/tabs:after:w-0.5 group-data-[variant=line]/tabs-list:data-[selected]:after:opacity-100"
      >
        <if=trigger.content>
          <${trigger.content}/>
        </if>
        <else>
          ${trigger.label}
        </else>
      </button>
    </for>
  </div>
  <for|panel| of=panels>
    <div ...api().getContentProps({ value: panel.value }) data-slot="tabs-content" class="mu-tabs-content flex-1 outline-none">
      <if=panel.content>
        <${panel.content}/>
      </if>
      <else>
        <${content}(panel.value)/>
      </else>
    </div>
  </for>
</div>

// Parents can receive the api getter: <Tabs/tabsApi/> then
// `tabsApi().value` — it stays live across machine updates.
<return=api>
