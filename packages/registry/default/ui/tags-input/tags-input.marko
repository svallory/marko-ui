import * as tagsInputMachine from "@zag-js/tags-input";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", tagsInputMachine.Props> & {
  valueChange?: (value: string[]) => void;
  inputValueChange?: (inputValue: string) => void;
  highlightedValueChange?: (highlightedValue: string | null) => void;
  label?: string;
  /** Placeholder for the tag entry field (also its accessible-name fallback). */
  placeholder?: string;
};

<machine-props/machineProps from=input pick=tagsInputMachine.props
  onValueChange(details: tagsInputMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }
  onInputValueChange(details: tagsInputMachine.InputValueChangeDetails) {
    input.onInputValueChange?.(details);
    input.inputValueChange?.(details.inputValue);
  }
  onHighlightChange(details: tagsInputMachine.HighlightChangeDetails) {
    input.onHighlightChange?.(details);
    input.highlightedValueChange?.(details.highlightedValue);
  }/>
<service/service machine=() => tagsInputMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  tagsInputMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownValueChangeHandler,
    inputValueChange: ownInputValueChangeHandler,
    highlightedValueChange: ownHighlightedValueChangeHandler,
    label: ownLabel,
    // placeholder belongs on the entry <input>, not the root div — pulled out
    // here and applied below.
    placeholder: ownPlaceholder,
    ...native
  } = tagsInputMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="tags-input-root" class=cn("flex flex-col gap-1.5", input.class)>
  <if=input.label>
    <label ...api().getLabelProps() data-slot="tags-input-label" class="text-sm font-medium">${input.label}</label>
  </if>
  <div
    ...api().getControlProps()
    data-slot="tags-input-control"
    class="border-input flex min-h-9 w-full flex-wrap items-center gap-1.5 rounded-md border bg-transparent px-3 py-1.5 shadow-xs transition-[color,box-shadow] has-[input:focus]:border-ring has-[input:focus]:ring-ring/50 has-[input:focus]:ring-[3px] data-[disabled]:pointer-events-none data-[disabled]:cursor-not-allowed data-[disabled]:bg-muted data-[invalid]:border-destructive data-[invalid]:ring-destructive/20 dark:data-[invalid]:ring-destructive/40"
  >
    <for|value, index| of=api().value>
      <span
        ...api().getItemProps({ index, value })
        data-slot="tags-input-item"
        class="inline-flex items-center rounded-md border border-transparent bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground data-[disabled]:bg-muted data-[disabled]:text-muted-foreground"
      >
        <span
          ...api().getItemPreviewProps({ index, value })
          data-slot="tags-input-item-preview"
          class="inline-flex items-center gap-1"
        >
          <span ...api().getItemTextProps({ index, value }) data-slot="tags-input-item-text">${value}</span>
          <button
            ...api().getItemDeleteTriggerProps({ index, value })
            data-slot="tags-input-item-delete-trigger"
            type="button"
            class="inline-flex size-3.5 shrink-0 items-center justify-center rounded-sm outline-none hover:bg-secondary-foreground/20 focus-visible:ring-[3px] focus-visible:ring-ring/50"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3">
              <path d="M18 6 6 18"/>
              <path d="m6 6 12 12"/>
            </svg>
            <span class="sr-only">Remove ${value}</span>
          </button>
        </span>
        <input
          ...api().getItemInputProps({ index, value })
          data-slot="tags-input-item-input"
          class="w-[--width] min-w-4 bg-transparent text-xs outline-none"
        />
      </span>
    </for>
    <input
      ...api().getInputProps()
      placeholder=input.placeholder
      data-slot="tags-input-input"
      class="h-6 min-w-20 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed"
    />
  </div>
  <input ...api().getHiddenInputProps()>
</div>

<return=api>
