import * as dialogMachine from "@zag-js/dialog";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", dialogMachine.Props> & {
  openChange?: (open: boolean) => void;
  trigger?: Marko.Body<[Record<string, unknown>]>;
  title?: Marko.Body;
  description?: Marko.Body;
  content?: Marko.Body;
  footer?: Marko.Body;
};

<machine-props/machineProps from=input pick=dialogMachine.props
  role="dialog"
  onOpenChange(details: dialogMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => dialogMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  dialogMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    openChange: ownChangeHandler,
    trigger: ownTrigger,
    title: ownTitle,
    description: ownDescription,
    content: ownContent,
    footer: ownFooter,
    ...native
  } = dialogMachine.splitProps(input)[1];
  return native;
}>

<if=input.trigger>
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "dialog-trigger" })/>
</if>
<portal>
  <if=api().open>
    <div
      ...api().getBackdropProps()
      data-slot="dialog-backdrop"
      class="fixed inset-0 z-50 bg-black/50 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0"
    />
    <div ...api().getPositionerProps() data-slot="dialog-positioner" class="fixed inset-0 z-50 flex items-center justify-center">
      <div
        ...nativeAttrs()
        ...api().getContentProps()
        data-slot="dialog-content"
        class=cn(
          "bg-background grid w-full max-w-lg gap-4 rounded-lg border p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95",
          input.class,
        )
      >
        <if=input.title>
          <h2 ...api().getTitleProps() data-slot="dialog-title" class="text-lg leading-none font-semibold">
            <${input.title}/>
          </h2>
        </if>
        <if=input.description>
          <p ...api().getDescriptionProps() data-slot="dialog-description" class="text-muted-foreground text-sm">
            <${input.description}/>
          </p>
        </if>
        <if=input.content>
          <${input.content}/>
        </if>
        <if=input.footer>
          <div data-slot="dialog-footer" class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <${input.footer}/>
          </div>
        </if>
        <button
          ...api().getCloseTriggerProps()
          data-slot="dialog-close"
          class="ring-offset-background focus:ring-ring absolute top-4 right-4 rounded-xs opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-none disabled:pointer-events-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <path d="M18 6 6 18"/>
            <path d="m6 6 12 12"/>
          </svg>
          <span class="sr-only">Close</span>
        </button>
      </div>
    </div>
  </if>
</portal>

<return=api>
