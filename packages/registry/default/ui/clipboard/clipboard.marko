import * as clipboardMachine from "@zag-js/clipboard";
import type { MachineInput } from "marko-zag";
import { cn } from "../../lib/utils.ts";

export type Input = MachineInput<"input", clipboardMachine.Props> & {
  valueChange?: (value: string) => void;
  statusChange?: (copied: boolean) => void;
  label?: string;
};

<machine-props/machineProps from=input pick=clipboardMachine.props
  onValueChange(details: clipboardMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }
  onStatusChange(details: clipboardMachine.CopyStatusDetails) {
    input.onStatusChange?.(details);
    input.statusChange?.(details.copied);
  }/>
<service/service machine=() => clipboardMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  clipboardMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownValueChangeHandler,
    statusChange: ownStatusChangeHandler,
    label: ownLabel,
    ...native
  } = clipboardMachine.contextProps(input)[1];
  return native;
}>

<div ...api().getRootProps() data-slot="clipboard-root" class=cn("grid w-full gap-1.5", input.class)>
  <if=input.label>
    <label ...api().getLabelProps() data-slot="clipboard-label" class="text-sm leading-none font-medium select-none">
      ${input.label}
    </label>
  </if>
  <div ...api().getControlProps() data-slot="clipboard-control" class="flex items-center gap-2">
    <input
      ...nativeAttrs()
      ...api().getInputProps()
      data-slot="clipboard-input"
      readonly
      class="file:text-foreground placeholder:text-muted-foreground dark:bg-input/30 border-input flex h-9 w-full min-w-0 rounded-md border bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"
    />
    <button
      ...api().getTriggerProps()
      data-slot="clipboard-trigger"
      type="button"
      class="border-input bg-background hover:bg-accent hover:text-accent-foreground inline-flex size-9 shrink-0 items-center justify-center gap-2 rounded-md border shadow-xs transition-all outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4"
    >
      <span ...api().getIndicatorProps({ copied: api().copied }) data-slot="clipboard-indicator">
        <if=api().copied>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        </if>
        <else>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
        </else>
      </span>
      <span class="sr-only">Copy</span>
    </button>
  </div>
</div>

<return=api>
