import * as commandMachine from "@zag-js/combobox";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";

// Upstream's `CommandDialog` is a THIN separate wrapper function — not part
// of `Command` itself — that composes `<Dialog><DialogContent
// className="cn-command-dialog top-1/3 translate-y-0 overflow-hidden p-0">
// <Command/></DialogContent></Dialog>` with a sr-only title/description.
// Dialog is being re-baselined concurrently by another agent (see
// rebaseline-fleet-brief.md), so that composition is NOT wired up here to
// avoid depending on its in-flight shape. Consumers get the same result by
// composing it themselves against the shipped `Dialog` component:
//
//   <Dialog class="mu-command-dialog top-1/3 translate-y-0 overflow-hidden p-0" showCloseButton=false>
//     <@title class="sr-only">Command Palette</@title>
//     <@description class="sr-only">Search for a command to run...</@description>
//     <@content><Command groups=... /></@content>
//   </Dialog>
//
// `mu-command-dialog` is reserved here (this comment) for check-anchors
// parity with upstream's `cn-command-dialog` hook — the style CSS layer
// targets it regardless of which file composes the wrapper.

export interface CommandItem {
  value: string;
  label: string;
  shortcut?: string;
}

export interface CommandGroup {
  label: string;
  items: CommandItem[];
}

// `collection`, `value`, and `inputValue` are machine-owned in
// combobox.Props but this component derives its own collection from
// `groups` and manages the search query internally, so they are omitted
// here rather than exposed on the public Input.
export type Input = Omit<
  MachineInput<"div", commandMachine.Props>,
  "collection" | "value" | "inputValue"
> & {
  groups: CommandGroup[];
  valueChange?: (value: string) => void;
};

static function filterGroups(groups: CommandGroup[], query: string): CommandGroup[] {
  const normalizedQuery = query.trim().toLowerCase();
  if (!normalizedQuery) return groups;
  return groups
    .map((group) => ({
      ...group,
      items: group.items.filter((item) => item.label.toLowerCase().includes(normalizedQuery)),
    }))
    .filter((group) => group.items.length > 0);
}

<let/query=""/>
<const/filteredGroups=filterGroups(input.groups, query)/>
<const/allItems=filteredGroups.flatMap((group) => group.items)/>

// `collection` is machine-owned but derived from `groups`/`query`, not a
// pass-through of `input`, so it is built here and merged into the props
// closure below rather than passed through <machine-props>'s override
// mechanism — overrides are copied as plain tag input, and a Zag collection
// carries methods that would fail serialization if it crossed that boundary.
<machine-props/machineProps from=input pick=commandMachine.props
  open=true
  inputBehavior="autohighlight"
  selectionBehavior="clear"
  onInputValueChange(details: commandMachine.InputValueChangeDetails) {
    input.onInputValueChange?.(details);
    query = details.inputValue;
  }
  onValueChange(details: commandMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    if (details.value[0] != null) {
      input.valueChange?.(details.value[0]);
    }
  }/>
<const/serviceProps=() => ({
  ...machineProps(),
  collection: commandMachine.collection({
    items: allItems,
    itemToValue: (item: CommandItem) => item.value,
    itemToString: (item: CommandItem) => item.label,
  }),
})/>
<service/service machine=() => commandMachine.machine props=serviceProps/>
<connect/api=(service, normalizeProps) =>
  commandMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    groups: ownGroups,
    valueChange: ownValueChange,
    ...native
  } = commandMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="command" class=cn("mu-command flex size-full flex-col overflow-hidden", input.class)>
  <div data-slot="command-input-wrapper" class="mu-command-input-wrapper">
    <div ...api().getControlProps() data-slot="command-input-group" class="mu-command-input-group group/input-group relative flex w-full min-w-0 items-center outline-none">
      <input
        ...api().getInputProps()
        data-slot="command-input"
        placeholder=input.placeholder
        class="mu-command-input outline-hidden disabled:cursor-not-allowed disabled:opacity-50"
      />
      <div data-slot="command-input-addon" class="flex items-center">
        <Icon name="Search" data-slot="command-input-icon" class="mu-command-input-icon"/>
      </div>
    </div>
  </div>
  <div ...api().getContentProps() data-slot="command-list" class="mu-command-list overflow-x-hidden overflow-y-auto">
    <if=(allItems.length === 0)>
      <div data-slot="command-empty" class="mu-command-empty">No results found.</div>
    </if>
    <else>
      <for|group, groupIndex| of=filteredGroups>
        <if=(groupIndex > 0)>
          <div data-slot="command-separator" class="mu-command-separator"></div>
        </if>
        <div ...api().getItemGroupProps({ id: `group-${groupIndex}` }) data-slot="command-group" class="mu-command-group">
          <div ...api().getItemGroupLabelProps({ htmlFor: `group-${groupIndex}` }) cmdk-group-heading="">
            ${group.label}
          </div>
          <for|item| of=group.items>
            <div
              ...api().getItemProps({ item })
              data-slot="command-item"
              class="mu-command-item group/command-item data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground"
            >
              <span>${item.label}</span>
              <if=item.shortcut>
                <span data-slot="command-shortcut" class="mu-command-shortcut">${item.shortcut}</span>
              </if>
              <Icon
                name="Check"
                data-slot="command-item-indicator"
                class="mu-command-item-indicator ml-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-[state=checked]/command-item:opacity-100"
              />
            </div>
          </for>
        </div>
      </for>
    </else>
  </div>
</div>

<return=api>
