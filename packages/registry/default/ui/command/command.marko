import * as combobox from "@zag-js/combobox";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { cn } from "../../lib/utils.ts";

export interface CommandItem {
  value: string;
  label: string;
  shortcut?: string;
}

export interface CommandGroup {
  label: string;
  items: CommandItem[];
}

export interface Input extends Omit<Marko.Input<"div">, "select"> {
  groups: CommandGroup[];
  placeholder?: string;
  select?: (value: string) => void;
  class?: string;
}

static function filterGroups(groups: CommandGroup[], query: string): CommandGroup[] {
  const q = query.trim().toLowerCase();
  if (!q) return groups;
  return groups
    .map((group) => ({
      ...group,
      items: group.items.filter((item) => item.label.toLowerCase().includes(q)),
    }))
    .filter((group) => group.items.length > 0);
}

<let/rev=0/>
<let/svc=null/>
<let/query=""/>
<const/filteredGroups=filterGroups(input.groups, query)/>
<const/allItems=filteredGroups.flatMap((group) => group.items)/>

<id/uid/>
<const/machineProps=() => ({
  id: uid,
  open: true,
  inputBehavior: "autohighlight",
  selectionBehavior: "clear",
  placeholder: input.placeholder,
  collection: combobox.collection({
    items: allItems,
    itemToValue: (item: CommandItem) => item.value,
    itemToString: (item: CommandItem) => item.label,
  }),
  onInputValueChange(details: { inputValue: string }) {
    query = details.inputValue;
  },
  onValueChange(details: { value: string[] }) {
    if (details.value[0] != null) {
      input.select?.(details.value[0]);
    }
  },
})/>
<lifecycle
  onMount() {
    svc = createService(combobox.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.groups;
  input.placeholder;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = combobox.connect(svc ?? ssrService(combobox.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    control: api.getControlProps(),
    input: api.getInputProps(),
    content: api.getContentProps(),
    groups: filteredGroups.map((group, groupIndex) => ({
      label: group.label,
      groupProps: api.getItemGroupProps({ id: `group-${groupIndex}` }),
      labelProps: api.getItemGroupLabelProps({ htmlFor: `group-${groupIndex}` }),
      items: group.items.map((item) => ({
        item,
        itemProps: api.getItemProps({ item }),
        itemState: api.getItemState({ item }),
      })),
    })),
    isEmpty: allItems.length === 0,
  };
}/>
<const/ui=(rev, computeUi())/>

<const/{ groups: _groups, placeholder, select: _select, class: className, ...rest }=input/>

<div ...rest ...ui.root data-slot="command" class=cn("bg-popover text-popover-foreground flex w-full flex-col overflow-hidden rounded-lg border shadow-md", className)>
  <div ...ui.control data-slot="command-input-wrapper" class="flex h-9 items-center gap-2 border-b px-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 opacity-50">
      <path d="m21 21-4.34-4.34"/>
      <circle cx="11" cy="11" r="8"/>
    </svg>
    <input
      ...ui.input
      data-slot="command-input"
      placeholder=placeholder
      class="placeholder:text-muted-foreground h-9 w-full bg-transparent text-sm outline-none disabled:cursor-not-allowed disabled:opacity-50"
    />
  </div>
  <div ...ui.content data-slot="command-list" class="max-h-80 scroll-py-1 overflow-y-auto overflow-x-hidden p-1">
    <if=ui.isEmpty>
      <div data-slot="command-empty" class="py-6 text-center text-sm">No results found.</div>
    </if>
    <else>
      <for|group| of=ui.groups>
        <div ...group.groupProps data-slot="command-group" class="text-foreground overflow-hidden p-1">
          <div ...group.labelProps data-slot="command-group-label" class="text-muted-foreground px-2 py-1.5 text-xs font-medium">
            ${group.label}
          </div>
          <for|entry| of=group.items>
            <div
              ...entry.itemProps
              data-slot="command-item"
              class="data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50"
            >
              <span>${entry.item.label}</span>
              <if=entry.item.shortcut>
                <span data-slot="command-shortcut" class="text-muted-foreground ml-auto text-xs tracking-widest">${entry.item.shortcut}</span>
              </if>
            </div>
          </for>
        </div>
      </for>
    </else>
  </div>
</div>
