import * as popoverMachine from "@zag-js/popover";
import type { MachineInput } from "marko-ui";
import { positionerStyle } from "marko-ui";
import { cn } from "#lib/utils.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Popover open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object.
export type Input = MachineInput<"div", popoverMachine.Props> & {
  /** Trigger render-prop — the element that opens the popover. */
  trigger: Marko.Body<[Record<string, unknown>]>;
  /** Popover content shown when open. */
  content: Marko.Body;
  openChange?: (open: boolean) => void;
};

<machine-props/machineProps from=input pick=popoverMachine.props
  onOpenChange(details: popoverMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => popoverMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  popoverMachine.connect(service, normalizeProps)
  service=service
/>

<${input.trigger}({ ...api().getTriggerProps(), "data-slot": "popover-trigger" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="popover-positioner">
      <div
        ...api().getContentProps()
        data-slot="popover-content"
        class=cn(
          "bg-popover text-popover-foreground z-50 w-72 rounded-md border p-4 shadow-md outline-hidden",
          "data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95",
          input.class,
        )
      >
        <${input.content}/>
      </div>
    </div>
  </if>
</portal>

<return=api>
