import * as switchMachine from "@zag-js/switch";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { cn } from "../../lib/utils.ts";

export interface Input extends Omit<Marko.Input<"input">, "checked" | "value"> {
  checked?: boolean;
  checkedChange?: (checked: boolean) => void;
  disabled?: boolean;
  name?: string;
  value?: string;
  class?: string;
}

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<const/machineProps=() => ({
  id: uid,
  checked: input.checked,
  disabled: input.disabled,
  name: input.name,
  value: input.value,
  onCheckedChange(details: { checked: boolean }) {
    input.checkedChange?.(details.checked);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(switchMachine.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.checked;
  input.disabled;
  input.name;
  input.value;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = switchMachine.connect(svc ?? ssrService(switchMachine.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    control: api.getControlProps(),
    thumb: api.getThumbProps(),
    hiddenInput: api.getHiddenInputProps(),
  };
}/>
<const/ui=(rev, computeUi())/>

<const/{ class: className, ...rest }=input/>

<label ...ui.root data-slot="switch-label" class="inline-flex items-center gap-2">
  <span
    ...ui.control
    data-slot="switch"
    class=cn(
      "peer inline-flex h-[1.15rem] w-8 shrink-0 items-center rounded-full border border-transparent shadow-xs transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=unchecked]:bg-input dark:data-[state=unchecked]:bg-input/80",
      className,
    )
  >
    <span
      ...ui.thumb
      data-slot="switch-thumb"
      class="pointer-events-none block size-4 rounded-full bg-background ring-0 transition-transform data-[state=unchecked]:translate-x-0 data-[state=checked]:translate-x-[calc(100%-2px)] dark:data-[state=unchecked]:bg-foreground dark:data-[state=checked]:bg-primary-foreground"
    />
  </span>
  <input ...rest ...ui.hiddenInput/>
</label>
