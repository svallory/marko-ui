// Reference implementation of the <service>/<connect> pattern.
// See notes/component-authoring.md (v2) and /docs/zag-adapter.
import * as switchMachine from "@zag-js/switch";
import { cn } from "../../lib/utils.ts";

export interface Input
  extends Omit<Marko.Input<"input">, "checked" | "value">,
    Pick<
      switchMachine.Props,
      "checked" | "defaultChecked" | "disabled" | "name" | "value" | "required" | "invalid" | "readOnly"
    > {
  checkedChange?: (checked: boolean) => void;
  class?: string;
}

<id/uid/>
<const/machineProps=(): switchMachine.Props => ({
  id: uid,
  checked: input.checked,
  defaultChecked: input.defaultChecked,
  disabled: input.disabled,
  name: input.name,
  value: input.value,
  required: input.required,
  invalid: input.invalid,
  readOnly: input.readOnly,
  onCheckedChange(details) {
    input.checkedChange?.(details.checked);
  },
})/>
<service/service machine=() => switchMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) => switchMachine.connect(service, normalizeProps) service=service/>

<const/{
  class: className,
  checked,
  defaultChecked,
  disabled,
  name,
  value,
  required,
  invalid,
  readOnly,
  checkedChange,
  ...rest
}=input/>

<label
  ...api().getRootProps()
  data-slot="switch-label"
  class="inline-flex items-center gap-2"
>
  <span
    ...api().getControlProps()
    data-slot="switch"
    class=cn(
      "peer inline-flex h-[1.15rem] w-8 shrink-0 items-center rounded-full border border-transparent shadow-xs transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=unchecked]:bg-input dark:data-[state=unchecked]:bg-input/80",
      className,
    )
  >
    <span
      ...api().getThumbProps()
      data-slot="switch-thumb"
      class="pointer-events-none block size-4 rounded-full bg-background ring-0 transition-transform data-[state=unchecked]:translate-x-0 data-[state=checked]:translate-x-[calc(100%-2px)] dark:data-[state=unchecked]:bg-foreground dark:data-[state=checked]:bg-primary-foreground"
    />
  </span>
  <input ...rest ...api().getHiddenInputProps()>
</label>

<return=api/>
