import * as progressMachine from "@zag-js/progress";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"div", progressMachine.Props> & {
  valueChange?: (value: number | null) => void;
  label?: string;
};

<machine-props/machineProps from=input pick=progressMachine.props
  onValueChange(details: progressMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => progressMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  progressMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownChangeHandler,
    label: ownLabel,
    ...native
  } = progressMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="progress" class=cn("flex flex-col gap-2", input.class)>
  <if=input.label>
    <div class="flex items-center justify-between text-sm">
      <span ...api().getLabelProps()>${input.label}</span>
      <span ...api().getValueTextProps()>${api().valueAsString}</span>
    </div>
  </if>
  <div
    ...api().getTrackProps()
    data-slot="progress-track"
    class="bg-primary/20 relative h-2 w-full overflow-hidden rounded-full"
  >
    <div ...api().getRangeProps() data-slot="progress-range" class="bg-primary h-full transition-all"/>
  </div>
</div>

<return=api>
