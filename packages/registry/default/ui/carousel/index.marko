import * as carousel from "@zag-js/carousel";
import { createService, ssrService, normalizeProps } from "marko-zag";
import { cn } from "../../lib/utils.ts";

export interface Input<T = unknown> extends Omit<Marko.Input<"div">, "content"> {
  items: T[];
  content?: Marko.Body<[T, number]>;
  loop?: boolean;
  slidesPerPage?: number;
  page?: number;
  pageChange?: (page: number) => void;
}

<id/uid/>
<let/rev=0/>
<let/svc=null/>
<const/machineProps=() => ({
  id: uid,
  slideCount: input.items.length,
  loop: input.loop,
  slidesPerPage: input.slidesPerPage,
  page: input.page,
  onPageChange(details: { page: number }) {
    input.pageChange?.(details.page);
  },
})/>
<lifecycle
  onMount() {
    svc = createService(carousel.machine, machineProps, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  input.items.length;
  input.loop;
  input.slidesPerPage;
  input.page;
  svc?.propsChanged();
</script>
<const/computeUi=() => {
  const api = carousel.connect(svc ?? ssrService(carousel.machine, machineProps), normalizeProps);
  return {
    root: api.getRootProps(),
    itemGroup: api.getItemGroupProps(),
    items: input.items.map((_, index) => api.getItemProps({ index })),
    prevTrigger: api.getPrevTriggerProps(),
    nextTrigger: api.getNextTriggerProps(),
    indicatorGroup: api.getIndicatorGroupProps(),
    indicators: api.pageSnapPoints.map((_, index) => api.getIndicatorProps({ index })),
  };
}/>
<const/ui=(rev, computeUi())/>

<const/{ items, content, class: className, loop, slidesPerPage, page, pageChange, ...rest }=input/>

<div ...rest ...ui.root data-slot="carousel" class=cn("relative", className)>
  <div ...ui.itemGroup data-slot="carousel-item-group" class="overflow-hidden">
    <for|item, index| of=items>
      <div ...ui.items[index] data-slot="carousel-item" class="min-w-0 shrink-0 grow-0 basis-full">
        <if=content>
          <${content}(item, index)/>
        </if>
        <else>
          ${item}
        </else>
      </div>
    </for>
  </div>
  <button
    ...ui.prevTrigger
    data-slot="carousel-prev"
    class="absolute top-1/2 left-2 size-8 -translate-y-1/2 rounded-full border border-input bg-background shadow-xs inline-flex items-center justify-center disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    <span class="sr-only">Previous slide</span>
  </button>
  <button
    ...ui.nextTrigger
    data-slot="carousel-next"
    class="absolute top-1/2 right-2 size-8 -translate-y-1/2 rounded-full border border-input bg-background shadow-xs inline-flex items-center justify-center disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="m9 18 6-6-6-6"/>
    </svg>
    <span class="sr-only">Next slide</span>
  </button>
  <div ...ui.indicatorGroup data-slot="carousel-indicator-group" class="flex items-center justify-center gap-2 pt-4">
    <for|indicatorProps, index| of=ui.indicators>
      <button
        ...indicatorProps
        data-slot="carousel-indicator"
        class="size-2 rounded-full bg-primary/20 data-[current]:bg-primary"
      >
        <span class="sr-only">Go to slide ${index + 1}</span>
      </button>
    </for>
  </div>
</div>
