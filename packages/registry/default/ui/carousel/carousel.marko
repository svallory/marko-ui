import * as carouselMachine from "@zag-js/carousel";
import type { MachineInput } from "marko-ui";
import { cn } from "#lib/utils.ts";

export interface CarouselSlideAttrs {
  content?: Marko.Body;
}

// Dual API: compound attr tags (`<@slide>`) are the primary, Marko-idiomatic
// form for static/manual slide lists; `items=` + `content` remain as sugar
// for the data-driven, generic-T case. If both are supplied, attr tags win.
export type Input<T = unknown> = Omit<
  MachineInput<"div", carouselMachine.Props>,
  "slideCount"
> & {
  items?: T[];
  content?: Marko.Body<[T, number]>;
  slide?: Marko.AttrTag<CarouselSlideAttrs>;
  pageChange?: (page: number) => void;
};

// Normalize whichever source was supplied into one shape so the render path
// below never branches: a list of `{ content, item }` entries, where `item`
// (data-driven path only) is rendered through the shared `content` render
// prop at render time. Attr tags win if both are present (compound is
// primary per the compound-tag-dx report).
<const/slideTags=[...(input.slide ?? [])]/>
<const/slides=(slideTags.length > 0 ? slideTags.map((slide) => ({ content: slide.content, item: undefined as unknown })) : (input.items ?? []).map((item) => ({ content: undefined, item })))/>

<machine-props/machineProps from=input pick=carouselMachine.props
  slideCount=slides.length
  onPageChange(details: carouselMachine.PageChangeDetails) {
    input.onPageChange?.(details);
    input.pageChange?.(details.page);
  }/>
<service/service machine=() => carouselMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  carouselMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    items: ownItems,
    content: ownContent,
    slide: ownSlide,
    pageChange: ownChangeHandler,
    ...native
  } = carouselMachine.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="carousel" class=cn("relative", input.class)>
  // Zag's item group is a real scroll container (scroll-snap), so keyboard
  // users need it focusable to scroll it (axe: scrollable-region-focusable).
  <div
    ...api().getItemGroupProps()
    data-slot="carousel-item-group"
    tabindex="0"
    class="overflow-hidden outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
  >
    <for|slide, index| of=slides>
      <div
        ...api().getItemProps({ index })
        data-slot="carousel-item"
        class="min-w-0 shrink-0 grow-0 basis-full"
      >
        <if=slide.content>
          <${slide.content}/>
        </if>
        // A bodyless `<@slide/>` has no `content` and an undefined `item`, so
        // when the caller also passed a `content` render prop it is invoked
        // with `undefined` here — intentional and safe: the render prop owns
        // placeholder slides, and the `${slide.item}` fallback renders nothing.
        <else-if=input.content>
          <${input.content}(slide.item, index)/>
        </else-if>
        <else>
          ${slide.item}
        </else>
      </div>
    </for>
  </div>
  <button
    ...api().getPrevTriggerProps()
    data-slot="carousel-prev"
    class="absolute top-1/2 left-2 size-8 -translate-y-1/2 rounded-full border border-input bg-background shadow-xs inline-flex items-center justify-center disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    <span class="sr-only">Previous slide</span>
  </button>
  <button
    ...api().getNextTriggerProps()
    data-slot="carousel-next"
    class="absolute top-1/2 right-2 size-8 -translate-y-1/2 rounded-full border border-input bg-background shadow-xs inline-flex items-center justify-center disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="m9 18 6-6-6-6"/>
    </svg>
    <span class="sr-only">Next slide</span>
  </button>
  <div ...api().getIndicatorGroupProps() data-slot="carousel-indicator-group" class="flex items-center justify-center gap-2 pt-4">
    <for|_, index| of=api().pageSnapPoints>
      // 24px hit box around an 8px visual dot — WCAG 2.5.8 minimum target
      // size (Lighthouse: target-size) without changing the look.
      <button
        ...api().getIndicatorProps({ index })
        data-slot="carousel-indicator"
        class="group/indicator flex size-6 items-center justify-center"
      >
        <span aria-hidden="true" class="size-2 rounded-full bg-primary/20 group-data-[current]/indicator:bg-primary"></span>
        <span class="sr-only">Go to slide ${index + 1}</span>
      </button>
    </for>
  </div>
</div>

<return=api>
