// Restored from zag-plugin-marko's <use-machine> (Marko 5 / Zag 0.x era),
// reshaped for Marko 6 resumability + Zag v1.
//
// The old companion tags stay retired on evidence: Zag v1 core exports no
// `subscribe`, no actors, no spawn — use-service (withContext/setContext/
// SETUP), use-snapshot (service.subscribe), and use-actor ([state, send])
// wrapped APIs that no longer exist; connect(service, normalizeProps)
// absorbed all three roles.
//
// Usage — returns the connected api as a serializable GETTER (per
// Marko-team guidance: pass template-created functions, not runtime
// objects). All machinery (svc lifecycle, rev invalidation, ssrService)
// is internal:
//
//   <use-machine/api
//     machine=() => sw.machine
//     props=machineProps
//     connect=(svc, np) => sw.connect(svc, np)
//   />
//   <label ...api().getRootProps()>...
//
// Both `machine` and `connect` MUST be closures written in the caller's
// template (serializable via compiler REGISTRY); passing the raw machine
// or `sw.connect` directly as input throws `Unable to serialize "input"`
// — verified empirically.
import { createService, ssrService, type MarkoService } from "../machine.ts";
import { normalizeProps } from "../normalize-props.ts";

export interface Input {
  /** Machine getter: `machine=() => sw.machine` (never the raw machine). */
  machine: () => any;
  /** machineProps closure: () => ({ id, ...mapped input }) */
  props: () => Record<string, any>;
  /** Connect closure: `connect=(svc, np) => sw.connect(svc, np)` */
  connect: (svc: MarkoService, normalize: typeof normalizeProps) => any;
}

<let/rev=0/>
<let/svc=null/>
<lifecycle
  onMount() {
    svc = createService(input.machine(), input.props, () => { rev += 1 });
    svc.start();
  }
  onDestroy() {
    svc?.stop();
  }
/>
<script>
  // Tracks every reactive read inside the caller's machineProps closure —
  // controlled props re-notify the machine without a hand-typed dep list.
  input.props();
  svc?.propsChanged();
</script>
<const/api=(rev, () => input.connect(svc ?? ssrService(input.machine(), input.props), normalizeProps))/>
<return=api/>
