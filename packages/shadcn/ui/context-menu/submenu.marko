// One nested submenu: a real second `@zag-js/menu` machine instance, linked
// to its parent menu's raw service via `setParent`/`setChild` — the wiring
// zag's own connect() exposes for exactly this (`menu.connect(...).setParent`
// / `.setChild`, both documented to accept the *raw* MarkoService, not the
// connected api — confirmed against `@zag-js/menu@1.43.0`'s connect source).
// Marko gives this its own component instance (and therefore its own
// `<lifecycle>`) per call site, which is exactly the child-machine lifetime
// zag wants — same shape as `<toast-item>`'s per-toast child service linked
// to the toaster's group service. Copied from menubar/submenu.marko (see
// that file's header for the full toast-precedent rationale) — this is the
// same mechanical pattern, just context-menu's own item shape and class
// strings.
//
// The trigger row lives in the PARENT menu's item list, so this component
// renders only the sub-trigger's own subtree: the trigger row itself (via
// `<@trigger>`) plus the popped-out content. The row's props need the
// parent's `getTriggerItemProps(ownApi)`, so the parent hands its api down
// as the `parentApi` getter and this component merges the props itself —
// see the `triggerProps` const below for why that merge cannot live in the
// caller's `<@trigger>` body.
// Rendered by `context-menu.marko` for `type: "sub"` entries. Supports one
// level of nesting (a submenu's own items are flat — item/separator/label
// only); a `type: "sub"` entry inside a submenu's `subEntries` is not wired.
import * as menu from "@zag-js/menu";
import { positionerStyle, connect } from "marko-zag";
import Icon from "../icon/icon.marko";
import type { ContextMenuItem } from "./context-menu.marko";

export interface Input {
  /** This submenu's own item list — same entry shape as the top-level menu. */
  entries: ContextMenuItem[];
  /** Label rendered on the sub-trigger row. */
  label?: string;
  disabled?: boolean;
  inset?: boolean;
  /** Getter for the parent menu's raw service — this submenu registers onto it via `setParent`. */
  parent: () => menu.Service | null;
  /**
   * Fires once this submenu's own raw service exists (on mount), so the
   * parent can complete the link with `parentApi().setChild(childService)` —
   * `setChild` needs the RAW service (see menu.connect's `child.prop("id")`),
   * which only exists after this component's own `<zag-machine>` has mounted.
   */
  onChildReady?: (childService: menu.Service) => void;
  /**
   * Getter for the PARENT menu's connected api. The sub-trigger row's props
   * come from `parentApi().getTriggerItemProps(ownApi)`, and this submenu
   * builds them itself (see the `triggerProps` const below) rather than
   * letting the caller's `<@trigger>` body reach for its own `api()`.
   */
  parentApi: () => menu.Api;
  /**
   * Trigger render-prop: receives the FINISHED sub-trigger props object
   * (already merged from the parent's `getTriggerItemProps` and this
   * submenu's own api), so the caller only spreads it onto its element.
   */
  trigger: Marko.AttrTag<{ content: Marko.Body<[Record<string, unknown>]> }>;
}

<zag-machine/service=() => menu from=input/>
<const/api=() => connect(menu, service())/>

// Link this submenu to its parent as soon as both raw services exist.
// `setParent`/`setChild` both take the raw MarkoService (see menu.connect's
// `parent.prop("id")` / `child.prop("id")` calls) — every ancestor's
// `<zag-machine>` has already mounted by the time any descendant mounts
// (Marko mounts render bottom-up after the full tree commits), so
// `input.parent()` and `service()` are both live here.
<lifecycle
  onMount() {
    const parentService = input.parent();
    const ownService = service();
    if (!parentService) return;
    api().setParent(parentService);
    input.onChildReady?.(ownService);
  }
/>

// The sub-trigger's props are built HERE, not in the caller's `<@trigger>`
// body, and that placement is load-bearing.
//
// The `<@trigger>` body is an attr-tag body owned by the PARENT menu's
// template, so a `parentApi()` call written inside it compiles to a raw
// scope walk (`$scope._._._._._.<apiSlot>()`) plus a `subscribeToScopeSet`
// on the parent's api signal. When this submenu mounts, that notify makes
// Marko's `_closure` re-queue the subscribed child scopes — and the portal
// body's scope has not had the parent's `<const/api>` slot assigned on that
// pass, so the walk lands on an empty slot and dies with
// `TypeError: $scope._.<slot> is not a function`. The parent's
// `<const/api=() => connect(...)>` is assigned only on the resume segment,
// while a menu opened after hydration renders its portal body client-side
// only — so on that path the slot is never populated at all.
//
// Routing the parent api through tag INPUT (`parentApi`, a
// template-written closure — serializable currency per the SSR-safe Zag
// pattern) removes the cross-scope subscription entirely: this component
// calls it inside its own `<const>`, and the caller's body only spreads a
// finished plain object. Same reason the api is handed over as a closure
// rather than a live object.
<const/triggerProps=() => input.parentApi().getTriggerItemProps(api())/>
<${input.trigger.content}(triggerProps())/>

<zag-portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="context-menu-sub-content-positioner">
      <div
        ...api().getContentProps()
        data-slot="context-menu-sub-content"
        class="mu-context-menu-sub-content mu-menu-target mu-menu-translucent z-50 origin-(--radix-context-menu-content-transform-origin) overflow-hidden"
      >
        <for|entry, index| of=input.entries>
          <const/value=entry.value ?? `sub-item-${index}`/>
          <if=entry.type === "separator">
            <div ...api().getSeparatorProps() data-slot="context-menu-separator" class="mu-context-menu-separator"/>
          </if>
          <else if=entry.type === "label">
            <div data-slot="context-menu-label" data-inset=entry.inset || undefined class="mu-context-menu-label">
              ${entry.label}
            </div>
          </else>
          <else>
            <div
              ...api().getItemProps({ value, disabled: entry.disabled })
              data-slot="context-menu-item"
              data-inset=entry.inset || undefined
              data-variant=entry.variant ?? "default"
              class="mu-context-menu-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              ${entry.label}
              <if=entry.shortcut>
                <span data-slot="context-menu-shortcut" class="mu-context-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
        </for>
      </div>
    </div>
  </if>
</zag-portal>
