// Guide: /docs/creating-components · adapter internals: /docs/zag-adapter
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as dialogMachine from "@zag-js/dialog";
import type { MachineInput } from "marko-zag";
import Button from "../button/button.marko";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"div", dialogMachine.Props> & {
  openChange?: (open: boolean) => void;
  trigger?: Marko.Body<[Record<string, unknown>]>;
  title?: Marko.Body;
  description?: Marko.Body;
  content?: Marko.Body;
  footer?: Marko.Body;
  /** Show the top-right close button. Defaults to true. */
  showCloseButton?: boolean;
};

<machine-props/machineProps from=input pick=dialogMachine.props
  role="dialog"
  onOpenChange(details: dialogMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => dialogMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  dialogMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    dialogMachine.splitProps(input)[1],
    "class",
    "openChange",
    "trigger",
    "title",
    "description",
    "content",
    "footer",
    "showCloseButton",
  )
>
<const/showCloseButton=input.showCloseButton ?? true/>

<if=input.trigger>
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "dialog-trigger" })/>
</if>
// NOTE: upstream shadcn sets data-slot="dialog-portal" on Radix's Portal,
// which renders a real element. marko-zag's <portal> renders a
// `display:contents` host and does not forward attributes, so the
// marker never reached the DOM — it was inert, and nothing in this
// repo's CSS, tests or tooling reads it. Dropped rather than left as
// dead markup; restore it if <portal> gains attribute forwarding.
<portal>
  <if=api().open>
    <div
      ...api().getBackdropProps()
      data-slot="dialog-overlay"
      class="mu-dialog-overlay fixed inset-0 z-50"
    />
    <div ...api().getPositionerProps() data-slot="dialog-positioner" class="fixed inset-0 z-50 flex items-center justify-center">
      <div
        ...nativeAttrs()
        ...api().getContentProps()
        data-slot="dialog-content"
        class=cn(
          "mu-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none",
          input.class,
        )
      >
        <if=input.title || input.description>
          <div data-slot="dialog-header" class="mu-dialog-header flex flex-col">
            <if=input.title>
              <h2 ...api().getTitleProps() data-slot="dialog-title" class="mu-dialog-title mu-font-heading">
                <${input.title}/>
              </h2>
            </if>
            <if=input.description>
              <p ...api().getDescriptionProps() data-slot="dialog-description" class="mu-dialog-description">
                <${input.description}/>
              </p>
            </if>
          </div>
        </if>
        <if=input.content>
          <${input.content}/>
        </if>
        <if=input.footer>
          <div data-slot="dialog-footer" class="mu-dialog-footer flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <${input.footer}/>
          </div>
        </if>
        <if=showCloseButton>
          <Button
            ...api().getCloseTriggerProps()
            variant="ghost"
            size="icon-sm"
            data-slot="dialog-close"
            class="mu-dialog-close"
          >
            <Icon name="XIcon"/>
            <span class="sr-only">Close</span>
          </Button>
        </if>
      </div>
    </div>
  </if>
</portal>

<return=api>
