import * as clipboardMachine from "@zag-js/clipboard";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { clipboard as styles } from "./classes.ts";

export type Input = MachineInput<"input", clipboardMachine.Props> & {
  valueChange?: (value: string) => void;
  statusChange?: (copied: boolean) => void;
  label?: string;
};

<zag/api=() => clipboardMachine from=input
  onStatusChange(details: clipboardMachine.CopyStatusDetails) {
    input.onStatusChange?.(details);
    input.statusChange?.(details.copied);
  }
/>

// `contextProps` is constrained `Props extends ClipboardProps`, where `id` is
// REQUIRED — but `MachineInput` deliberately makes `id` optional (the
// <zag> tag generates one). The call only partitions keys by name
// and never reads the id's value, so pass a definite one to satisfy the
// constraint. The value is inert here: `getInputProps()` below sets the real
// id on the element after this spread.
<const/nativeAttrs=() =>
  stripOwnProps(
    clipboardMachine.contextProps({ ...input, id: input.id ?? "" })[1],
    "class",
    "valueChange",
    "statusChange",
    "label",
  )
>

<div ...api().getRootProps() data-slot="clipboard-root" class=cn(styles.root, input.class)>
  <if=input.label>
    <label ...api().getLabelProps() data-slot="clipboard-label" class=styles.label>
      ${input.label}
    </label>
  </if>
  <div ...api().getControlProps() data-slot="clipboard-control" class=styles.control>
    <input
      ...nativeAttrs()
      ...api().getInputProps()
      data-slot="clipboard-input"
      readonly
      class=styles.input
    />
    <button
      ...api().getTriggerProps()
      data-slot="clipboard-trigger"
      type="button"
      class=styles.trigger
    >
      <span ...api().getIndicatorProps({ copied: api().copied }) data-slot="clipboard-indicator">
        <if=api().copied>
          <Icon name="Check"/>
        </if>
        <else>
          <Icon name="Copy"/>
        </else>
      </span>
      <span class=styles.srOnly>Copy</span>
    </button>
  </div>
</div>

<return=api>
