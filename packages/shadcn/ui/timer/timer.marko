// Countdown / stopwatch timer.
// Guide: /docs/creating-components · authoring rules: notes/component-authoring.md
import * as timerMachine from "@zag-js/timer";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { timer as styles } from "./classes.ts";

export type Input = MachineInput<"div", timerMachine.Props> & {
  tickChange?: (details: timerMachine.TickDetails) => void;
  complete?: () => void;
  /** Time parts to render as digit segments, in order. */
  parts?: timerMachine.TimePart[];
};

static const defaultParts: timerMachine.TimePart[] = ["hours", "minutes", "seconds"];

<zag/api=() => timerMachine from=input
  onTick(details: timerMachine.TickDetails) {
    input.onTick?.(details);
    input.tickChange?.(details);
  }
  onComplete() {
    input.onComplete?.();
    input.complete?.();
  }
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    timerMachine.splitProps(input)[1],
    "class",
    "tickChange",
    "complete",
    "parts",
  )
>

<const/timeParts=input.parts || defaultParts>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="timer"
  class=cn(styles.root, input.class)
>
  <div ...api().getAreaProps() data-slot="timer-area" class=styles.area>
    <for|part, index| of=timeParts>
      <if=index>
        <span ...api().getSeparatorProps() data-slot="timer-separator" class=styles.separator>:</span>
      </if>
      <div ...api().getItemProps({ type: part }) data-slot="timer-item" class=styles.item>
        <span
          ...api().getItemValueProps({ type: part })
          data-slot="timer-item-value"
          class=styles.itemValue
        >
          ${api().formattedTime[part]}
        </span>
        <span
          ...api().getItemLabelProps({ type: part })
          data-slot="timer-item-label"
          class=styles.itemLabel
        >
          ${part}
        </span>
      </div>
    </for>
  </div>
  <div ...api().getControlProps() data-slot="timer-control" class=styles.control>
    <if=!api().running && !api().paused>
      <button
        ...api().getActionTriggerProps({ action: "start" })
        data-slot="timer-action"
        type="button"
        class=styles.actionPrimary
      >
        Start
      </button>
    </if>
    <if=api().running>
      <button
        ...api().getActionTriggerProps({ action: "pause" })
        data-slot="timer-action"
        type="button"
        class=styles.actionSecondary
      >
        Pause
      </button>
    </if>
    <if=api().paused>
      <button
        ...api().getActionTriggerProps({ action: "resume" })
        data-slot="timer-action"
        type="button"
        class=styles.actionPrimary
      >
        Resume
      </button>
    </if>
    <button
      ...api().getActionTriggerProps({ action: "reset" })
      data-slot="timer-action"
      type="button"
      class=styles.actionSecondary
    >
      Reset
    </button>
  </div>
</div>

<return=api>
