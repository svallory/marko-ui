// Toaster: the Zag toast *group* region.
//
// Architecture (Zag v1 toast is a group store + per-toast child services):
//
//   store.ts        module-level createStore() — the trigger API, never
//                   reactive state, never tag input, so never serialized.
//   <Toaster>       one group <zag-machine>/connect() whose only machine prop is
//                   { id, store }. The store reaches it through a template
//                   closure (`groupProps`), not through tag input.
//   <toast-item>    one child <service> per visible toast, spawned by <for>.
//                   Marko gives each <for> iteration its own component
//                   instance and therefore its own <lifecycle>, which is
//                   exactly the per-toast machine lifetime Zag wants.
//
// SSR renders the region with zero toasts (toasts are user-triggered), so no
// toast-item and no Zag service ever exists on the server. Hydration resumes an
// empty region; the group service starts on mount and subscribes to the store.
import * as toastMachine from "@zag-js/toast";
import { connect, type ZagModule } from "marko-zag";
import { toaster } from "./store.ts";
import { cn } from "#lib/utils.ts";
import ToastItem from "./toast-item.marko";

export interface Input extends Marko.Input<"div"> {
  /** Accessible label for the notification region. @default "Notifications" */
  label?: string;
  /**
   * Text direction passed to the group machine.
   *
   * Typed as the full HTML `dir` surface, not just `"ltr" | "rtl"`: this Input
   * extends `Marko.Input<"div">`, and re-declaring `dir` more narrowly than
   * the attribute it inherits makes every `...rest` spread from a div-shaped
   * parent (e.g. `sonner.marko`) a type error. `"auto"` and the absent values
   * are normalized away below, since Zag's group machine accepts only the two
   * concrete directions.
   */
  dir?: Marko.Input<"div">["dir"];
  /**
   * Extra class(es) applied to every toast's root element. The zag-native
   * equivalent of sonner's `toastOptions.classNames.toast`. `sonner.marko`
   * passes the `mu-toast` style hook through here, mirroring upstream
   * `sonner.tsx`'s `toastOptions={{ classNames: { toast: "cn-toast" } }}`.
   */
  toastClass?: string;
}

<const/{ class: className, label, dir, toastClass, ...rest }=input/>

<id/regionId/>
// Zag's group machine takes `"ltr" | "rtl"` only, so `"auto"` (and the absent
// values HTML allows) fall back to undefined and let the machine default.
<const/machineDir=(dir === "ltr" || dir === "rtl" ? dir : undefined)/>
// `toastMachine.group` has no runtime `props` export (unlike every other zag
// module) — its GroupProps is a TS-only type, so it doesn't structurally
// satisfy `ZagModule` even though `<zag-machine>`'s `props=` verbatim mode
// (no `from=`) never actually reads `.props`. Widen the getter's return type
// to bridge that gap; `props` is never read here.
<const/groupModule=() => toastMachine.group as unknown as typeof toastMachine.group & ZagModule/>
<const/groupProps=() => ({ id: regionId, store: toaster, dir: machineDir })/>
<zag-machine/service=groupModule props=groupProps/>
<const/api=() => connect(groupModule(), service())/>

// The group service must be handed to each child machine as `parent`. It is
// passed as a GETTER closure created here in the template: the closure is
// serializable, the running service it returns never is tag input itself.
// `service()` always returns a real MarkoService — a never-started throwaway
// on the server and before mount, the running instance after — so no null
// guard is needed here.
<const/getParentService=service/>

<div
  ...rest
  ...api().getGroupProps({ label })
  data-slot="toaster"
  class=cn("outline-none", className)
>
  // `ToastProps["id"]` is optional only as *creation input*: the store assigns
  // `data.id ?? uuid()` before a toast is ever stored, so every entry returned
  // by getToasts() carries a real id. The fallback keeps the key a string
  // without inventing a value that could collide with a caller-supplied id.
  <for|toastOptions, index| of=api().getToasts() by=(item, index) => item.id ?? `toast:index:${index}`>
    <ToastItem
      options=() => toastOptions
      parent=getParentService
      index=index
      group=service
      toastClass=toastClass
    />
  </for>
</div>
