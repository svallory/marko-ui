import Separator from "../separator/separator.marko";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {}

<const/{ class: className, content, ...rest }=input/>

<div
  data-slot="field-separator"
  data-content=(content ? "true" : undefined)
  class=cn("mu-field-separator relative", className)
  ...rest
>
  <Separator class="absolute inset-0 top-1/2"/>
  <if=content>
    <span
      data-slot="field-separator-content"
      class="mu-field-separator-content relative mx-auto block w-fit bg-background"
    >
      <${content}/>
    </span>
  </if>
</div>
