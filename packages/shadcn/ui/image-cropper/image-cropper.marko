// Image crop tool built on the REAL @zag-js/image-cropper machine:
// draggable/resizable crop selection with eight handles, rule-of-thirds grid,
// aspect-ratio lock, zoom, rotation and flip.
// Reference implementation: packages/shadcn/ui/switch/switch.marko
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as imageCropperMachine from "@zag-js/image-cropper";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { imageCropper as styles } from "./classes.ts";

export type Input = MachineInput<"div", imageCropperMachine.Props> & {
  /** Source of the image to crop. */
  src?: string;
  /** Accessible description of the image being cropped. */
  alt?: string;
  /** Hide the rule-of-thirds grid drawn inside the crop selection. */
  hideGrid?: boolean;
  /** Sugar for onZoomChange — receives the plain zoom, enables `zoom:=state`. */
  zoomChange?: (zoom: number) => void;
  /** Sugar for onRotationChange — receives the plain rotation in degrees. */
  rotationChange?: (rotation: number) => void;
  /** Sugar for onFlipChange — receives the plain flip state. */
  flipChange?: (flip: imageCropperMachine.FlipState) => void;
  /** Sugar for onCropChange — receives the plain crop rect. */
  cropChange?: (crop: imageCropperMachine.CropChangeDetails["crop"]) => void;
};

// The eight resize handles, in the order Zag exports them.
static const HANDLE_POSITIONS = imageCropperMachine.handles;

// <zag> wires the machine in one tag and returns `api` as a GETTER — call it
// at every use site. Getters are the serializable currency of Marko's
// resumability: the api object itself must never become reactive state. See
// /docs/creating-components.
<zag/api=() => imageCropperMachine from=input/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, src, alt, hideGrid, the xxxChange sugar) passes through to the
// root element: aria-*, data-*...
<const/nativeAttrs=() =>
  stripOwnProps(
    imageCropperMachine.splitProps(input)[1],
    "class",
    "src",
    "alt",
    "hideGrid",
    "zoomChange",
    "rotationChange",
    "flipChange",
    "cropChange",
  )
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="image-cropper"
  class=cn(styles.root, input.class)
>
  <div
    ...api().getViewportProps()
    data-slot="image-cropper-viewport"
    class=styles.viewport
  >
    <img
      ...api().getImageProps()
      src=input.src
      alt=input.alt
      data-slot="image-cropper-image"
      class=styles.image
    />
    <div
      ...api().getSelectionProps()
      data-slot="image-cropper-selection"
      class=styles.selection
    >
      <if=!input.hideGrid>
        <div
          ...api().getGridProps({ axis: "horizontal" })
          data-slot="image-cropper-grid"
          class=styles.gridHorizontal
        />
        <div
          ...api().getGridProps({ axis: "vertical" })
          data-slot="image-cropper-grid"
          class=styles.gridVertical
        />
      </if>
      <for|position| of=HANDLE_POSITIONS>
        <div
          ...api().getHandleProps({ position })
          data-slot="image-cropper-handle"
          class=styles.handle
        />
      </for>
    </div>
  </div>
</div>

// Parents can receive the api getter: <ImageCropper/cropperApi/> then
// `cropperApi().getCroppedImage()` — it stays live across machine updates.
<return=api>
