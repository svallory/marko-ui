import * as angleSliderMachine from "@zag-js/angle-slider";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { angleSlider as styles } from "./classes.ts";

export type Input = MachineInput<"div", angleSliderMachine.Props> & {
  valueChange?: (value: number) => void;
};

<zag/api=() => angleSliderMachine from=input/>

<const/nativeAttrs=() =>
  stripOwnProps(angleSliderMachine.splitProps(input)[1], "class", "valueChange")
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="angle-slider"
  class=cn(styles.root, input.class)
>
  <label ...api().getLabelProps() data-slot="angle-slider-label" class=styles.label>
    Angle
  </label>
  <div
    ...api().getControlProps()
    data-slot="angle-slider-control"
    class=styles.control
  >
    <input ...api().getHiddenInputProps()>
    <div
      ...api().getThumbProps()
      data-slot="angle-slider-thumb"
      class=styles.thumb
    >
      <span data-slot="angle-slider-thumb-knob" class=styles.thumbKnob></span>
    </div>
  </div>
  <span
    ...api().getValueTextProps()
    data-slot="angle-slider-value-text"
    class=styles.valueText
  >
    ${api().value}&deg;
  </span>
</div>

<return=api>
