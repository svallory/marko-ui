import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {}

<const/{ class: className, content, ...rest }=input/>

// No role="list" (shadcn deviation): Item renders no role="listitem" — it is
// also used standalone — so a list role here would own zero listitems, which
// ARIA forbids (axe: aria-required-children). A plain div is honest markup
// for a visual stack.
<div data-slot="item-group" ...rest class=cn("mu-item-group group/item-group flex w-full flex-col", className)>
  <${content}/>
</div>
