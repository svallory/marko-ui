import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  align?: "start" | "end";
}

<const/{ align = "start", class: className, content, ...rest }=input/>

<div
  data-slot="message"
  data-align=align
  class=cn(
    "mu-message group/message relative flex w-full min-w-0 data-[align=end]:flex-row-reverse",
    className,
  )
  ...rest
>
  <${content}/>
</div>
