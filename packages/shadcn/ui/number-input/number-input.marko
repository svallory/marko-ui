import * as numberInputMachine from "@zag-js/number-input";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";

export type Input = MachineInput<"input", numberInputMachine.Props> & {
  valueChange?: (value: string) => void;
};

<machine-props/machineProps from=input pick=numberInputMachine.props
  onValueChange(details: numberInputMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => numberInputMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  numberInputMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() => {
  const { class: ownClass, valueChange: ownChangeHandler, ...native } =
    numberInputMachine.splitProps(input)[1];
  return native;
}>

<div
  ...api().getRootProps()
  data-slot="number-input"
  class=cn(
    "border-input dark:bg-input/30 flex h-9 w-fit items-stretch overflow-hidden rounded-md border shadow-xs transition-[color,box-shadow]",
    "has-[input:focus-visible]:border-ring has-[input:focus-visible]:ring-ring/50 has-[input:focus-visible]:ring-[3px]",
    "has-[input:disabled]:pointer-events-none has-[input:disabled]:opacity-50",
    "has-[input[aria-invalid=true]]:ring-destructive/20 dark:has-[input[aria-invalid=true]]:ring-destructive/40 has-[input[aria-invalid=true]]:border-destructive",
    input.class,
  )
>
  <button
    ...api().getDecrementTriggerProps()
    data-slot="number-input-decrement"
    class="text-muted-foreground hover:bg-accent hover:text-accent-foreground flex w-8 shrink-0 items-center justify-center border-r border-input transition-colors disabled:pointer-events-none disabled:opacity-50"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="M5 12h14"/>
    </svg>
  </button>
  <div ...api().getControlProps() data-slot="number-input-control" class="relative flex-1">
    <input
      ...nativeAttrs()
      ...api().getInputProps()
      data-slot="number-input-field"
      class="file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground flex h-full w-full min-w-0 bg-transparent px-3 py-1 text-center text-base outline-none disabled:cursor-not-allowed md:text-sm"
    />
    <div
      ...api().getScrubberProps()
      data-slot="number-input-scrubber"
      class="absolute inset-x-0 bottom-0 z-10 h-1.5 data-[disabled]:hidden"
    />
  </div>
  <button
    ...api().getIncrementTriggerProps()
    data-slot="number-input-increment"
    class="text-muted-foreground hover:bg-accent hover:text-accent-foreground flex w-8 shrink-0 items-center justify-center border-l border-input transition-colors disabled:pointer-events-none disabled:opacity-50"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
      <path d="M5 12h14"/>
      <path d="M12 5v14"/>
    </svg>
  </button>
</div>

<return=api>
