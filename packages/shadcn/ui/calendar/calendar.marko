import * as datePickerMachine from "@zag-js/date-picker";
import { CalendarDate, createCalendar, toCalendar, type CalendarIdentifier, type DateValue } from "@internationalized/date";
import type { MachineInput } from "marko-zag";
import { normalizeProps, ssrService } from "marko-zag";
import { buttonVariants } from "../button/variants.ts";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

/** Plain, serializable stand-in for a `DateValue` — the calendar-system id is a string, never the `Calendar` class instance itself. */
export interface PlainDate {
  year: number;
  month: number;
  day: number;
  /**
   * `@internationalized/date` calendar identifier (e.g. `"gregory"`,
   * `"persian"`, `"islamic-umalqura"`) resolved via `createCalendar()`.
   * Omit for the default Gregorian calendar.
   */
  calendar?: CalendarIdentifier;
}

// Calendar is an inline, always-open date-picker: `open`/`inline`/
// `closeOnSelect` are fixed by this component, not exposed to callers.
// `value`/`valueChange`/`focusedValue`/`defaultFocusedValue` use plain
// { year, month, day, calendar? } objects instead of Zag's DateValue so
// consumers don't need @internationalized/date, AND so a non-Gregorian
// date never crosses the SSR->hydration wire as a live `DateValue` class
// instance (its `.calendar` field is itself a class instance with methods
// — Marko's tag-input serializer rejects it outright: "Unable to
// serialize ... Values referenced in the browser must be serializable").
// The real DateValue is reconstructed from the plain primitive inside
// machineProps's closure below, independently on server and client, the
// same way value/min/max already are.
export type Input = Omit<
  MachineInput<"div", datePickerMachine.Props>,
  "open" | "inline" | "closeOnSelect" | "value" | "min" | "max" | "focusedValue" | "defaultFocusedValue"
> & {
  /** Selected date(s) as plain objects — one entry per selected date (single mode uses a one-element array). */
  value?: { year: number; month: number; day: number }[];
  /** Fires with the full selection as plain date objects whenever it changes; enables `value:=` two-way binding. */
  valueChange?: (value: { year: number; month: number; day: number }[]) => void;
  /** Earliest selectable date (inclusive); days before it render disabled. */
  min?: { year: number; month: number; day: number };
  /** Latest selectable date (inclusive); days after it render disabled. */
  max?: { year: number; month: number; day: number };
  /** Controlled visible-month focus, as a plain (optionally non-Gregorian) date. */
  focusedValue?: PlainDate;
  /**
   * Initial visible-month focus, as a plain (optionally non-Gregorian)
   * date. Pins the SSR-rendered month instead of falling back to the
   * browser's wall-clock "today" (`getTodayDate`), which would otherwise
   * make SSR and hydrated markup diverge near midnight or across
   * timezones.
   */
  defaultFocusedValue?: PlainDate;
  /**
   * Caption presentation. `"label"` (default) shows the visible range as a
   * plain view-trigger button; `"dropdown"` swaps it for native month and year
   * `<select>` controls. Component-owned — not forwarded to the machine.
   */
  captionLayout?: "label" | "dropdown";
};

static function toDateValue(date: { year: number; month: number; day: number }): DateValue {
  return new CalendarDate(date.year, date.month, date.day);
}

static function toPlain(date: DateValue) {
  return { year: date.year, month: date.month, day: date.day };
}

// Reconstructs a real (possibly non-Gregorian) DateValue from a PlainDate
// every time it's called — never stored as a static const or passed by
// reference, so server and client each independently derive the same
// value from the same serializable primitive instead of one instance
// resuming across the SSR boundary (see PlainDate's doc comment above).
static function toFocusedDateValue(date: PlainDate): DateValue {
  const calendar = date.calendar ? createCalendar(date.calendar) : undefined;
  const gregorian = new CalendarDate(date.year, date.month, date.day);
  return calendar ? toCalendar(gregorian, calendar) : gregorian;
}

// Stateless helper — takes the `<service>` handle and returns a FRESH
// connected api every call, exactly like `<connect>`'s own SSR-fallback
// body. Declared `static` (module-level, no per-instance closure capture)
// so it's a plain helper function rather than a Marko custom tag; see the
// long comment at its call site below for why this exists instead of a
// `<const>`/`<let>`-based mirror.
static function connectFresh(handle: {
  service: Parameters<typeof datePickerMachine.connect>[0] | null;
  machine: () => datePickerMachine.Machine;
  props: () => Partial<datePickerMachine.Props>;
}) {
  return datePickerMachine.connect(handle.service ?? ssrService(handle.machine(), handle.props), normalizeProps);
}

<machine-props/pickedProps from=input pick=datePickerMachine.props
  open=true
  inline=true
  closeOnSelect=false
  onValueChange(details: datePickerMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value.map(toPlain));
  }/>
<const/machineProps=() => ({
  ...pickedProps(),
  value: input.value?.map(toDateValue),
  min: input.min ? toDateValue(input.min) : undefined,
  max: input.max ? toDateValue(input.max) : undefined,
  focusedValue: input.focusedValue ? toFocusedDateValue(input.focusedValue) : undefined,
  defaultFocusedValue: input.defaultFocusedValue ? toFocusedDateValue(input.defaultFocusedValue) : undefined,
})/>
<service/service machine=() => datePickerMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  datePickerMachine.connect(service, normalizeProps)
  service=service
/>

// `connectFresh(service)` (declared above, module-level) is called
// everywhere in this component's render tree below in place of `api()`.
// Works around a Marko-core walk-order defect: when this component is
// mounted via dynamic-tag-content (Popover's `<${input.content}/>`)
// nested inside Popover's own `<portal><if=api().open>`, THIS component's
// walk-time reads of its own `api()` (a `<const>`) fire before
// `<const/api>`'s own deferred signal has ever computed on this
// freshly-created scope — throwing `TypeError: $scope._.<api> is not a
// function` merely from opening the composing Popover. Confirmed
// empirically through several iterations (full account in
// notes/bug-marko-dynamic-tag-hydration-crash.md):
// - mirroring individual call sites just moved the crash to the next
//   walk-time `api()` read in source order;
// - wrapping the mirror in its own `<const/ui=() => uiValue/>` still
//   crashed (a `<const>` is lazy regardless of what its body does);
// - populating a `<let>` mirror from inside a `<script>` block also
//   crashed (a `<script>` body is deferred to the same signal-firing pass
//   as `<const>`);
// - even `<let/uiValue=api()/>` — despite `<let>` initializers normally
//   running eagerly at scope construction — still crashed, because the
//   compiler fuses an initializer that CALLS a `<const>` (`api()`) into
//   that const's own deferred resume chain;
// - AND, discovered only by running the DEV server (a production preview
//   alone did not catch this): a `<let>`-held mirror of the live api
//   object breaks SSR outright — `<let>` is Marko reactive state that
//   gets serialized for resume, and the connected api is a live object
//   with methods (unserializable per the SSR-safe Zag pattern), throwing
//   `Unable to serialize "uiValue" ... (reading <method>)`.
// `connectFresh` is therefore a plain `static function` (module-level,
// parameterized — no per-instance closure capture, so it isn't Marko
// reactive state at all) that calls `datePickerMachine.connect()`
// directly against the raw service, exactly like `<connect>`'s own SSR
// fallback does. Every call recomputes fresh: nothing to compute lazily,
// nothing ever stored for serialization to trip over. The mirror rule is
// "no `<const>`/`<let>` — direct OR indirect — anywhere near the
// connected api in a component mounted via dynamic-tag-content nested in
// an ancestor's own portal; call `machine.connect()` fresh instead."

// `value`/`min`/`max`/`focusedValue`/`defaultFocusedValue` are deliberately
// remapped to plain objects on this component's public Input (see the notes
// above), so `input` does not satisfy `splitProps`'s `Partial<DatePickerProps>`
// constraint. All five are machine-owned keys that `splitProps` would strip
// from the leftover anyway — drop them first and the call type-checks on the
// keys it actually partitions. `toDateValue()`/`toFocusedDateValue()` are
// what feed real DateValues to the machine.
<const/splitSource=() => {
  const { value, min, max, focusedValue, defaultFocusedValue, ...rest } = input;
  return rest;
}/>
<const/nativeAttrs=() =>
  stripOwnProps(
    datePickerMachine.splitProps(splitSource())[1],
    "class",
    "valueChange",
    "captionLayout",
  )
>

<const/captionLayout=(input.captionLayout ?? "label")/>

// Visible month's short name, matching the month <select>'s option labels.
// Calls `connectFresh(service)` fresh (not `uiValue`/`api()`) — see the
// long comment above the walk-order-defect mirror for why.
<const/monthLabel=() => {
  const ui = connectFresh(service);
  const month = ui.visibleRange.start.month;
  return ui.getMonths({ format: "short" }).find((m) => m.value === month)?.label ?? String(month);
}/>

<const/weeks=() =>
  connectFresh(service).weeks.map((week) =>
    week.map((date) => ({
      cell: connectFresh(service).getDayTableCellProps({ value: date }),
      trigger: connectFresh(service).getDayTableCellTriggerProps({ value: date }),
      label: String(date.day),
    })),
  )
/>

<div
  ...nativeAttrs()
  ...connectFresh(service).getRootProps()
  data-slot="calendar"
  class=cn(
    "mu-calendar group/calendar bg-background in-data-[slot=card-content]:bg-transparent in-data-[slot=popover-content]:bg-transparent",
    input.class,
  )
>
  <div ...connectFresh(service).getContentProps() data-slot="calendar-content" class="relative flex flex-col gap-4">
    <div class="absolute inset-x-0 top-0 flex w-full items-center justify-between gap-1">
      <button
        ...connectFresh(service).getPrevTriggerProps()
        data-slot="calendar-prev-trigger"
        class=cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "size-(--cell-size) p-0 select-none aria-disabled:opacity-50")
      >
        <Icon name="ChevronLeft" class="mu-rtl-flip"/>
        <span class="sr-only">Previous</span>
      </button>
      <if=captionLayout === "dropdown">
        <div
          data-slot="calendar-dropdowns"
          class="flex h-(--cell-size) w-full items-center justify-center gap-1.5 text-sm font-medium"
        >
          <div
            data-slot="calendar-dropdown-root"
            class="mu-calendar-dropdown-root relative rounded-(--cell-radius)"
          >
            <select
              ...connectFresh(service).getMonthSelectProps()
              data-slot="calendar-month-select"
              class="absolute inset-0 bg-popover opacity-0"
            >
              <for|month| of=connectFresh(service).getMonths({ format: "short" })>
                <option value=month.value disabled=month.disabled>${month.label}</option>
              </for>
            </select>
            <span
              aria-hidden="true"
              data-slot="calendar-caption-label"
              class="mu-calendar-caption-label flex items-center gap-1 rounded-(--cell-radius) text-sm font-medium select-none [&>svg]:size-3.5 [&>svg]:text-muted-foreground"
            >
              ${monthLabel()}
              <Icon name="ChevronDown"/>
            </span>
          </div>
          <div
            data-slot="calendar-dropdown-root"
            class="mu-calendar-dropdown-root relative rounded-(--cell-radius)"
          >
            <select
              ...connectFresh(service).getYearSelectProps()
              data-slot="calendar-year-select"
              class="absolute inset-0 bg-popover opacity-0"
            >
              <for|year| of=connectFresh(service).getYears()>
                <option value=year.value disabled=year.disabled>${year.label}</option>
              </for>
            </select>
            <span
              aria-hidden="true"
              data-slot="calendar-caption-label"
              class="mu-calendar-caption-label flex items-center gap-1 rounded-(--cell-radius) text-sm font-medium select-none [&>svg]:size-3.5 [&>svg]:text-muted-foreground"
            >
              ${String(connectFresh(service).visibleRange.start.year)}
              <Icon name="ChevronDown"/>
            </span>
          </div>
        </div>
      </if>
      <else>
        <button
          ...connectFresh(service).getViewTriggerProps()
          data-slot="calendar-view-trigger"
          class="mu-calendar-caption text-sm font-medium select-none"
        >
          ${connectFresh(service).visibleRangeText.formatted}
        </button>
      </else>
      <button
        ...connectFresh(service).getNextTriggerProps()
        data-slot="calendar-next-trigger"
        class=cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "size-(--cell-size) p-0 select-none aria-disabled:opacity-50")
      >
        <Icon name="ChevronRight" class="mu-rtl-flip"/>
        <span class="sr-only">Next</span>
      </button>
    </div>
    <table ...connectFresh(service).getTableProps() data-slot="calendar-table" class="w-full border-collapse">
      <thead ...connectFresh(service).getTableHeadProps() data-slot="calendar-table-head">
        <tr class="flex">
          <for|weekDay| of=connectFresh(service).weekDays>
            <th class="w-(--cell-size) flex-1 rounded-(--cell-radius) text-[0.8rem] font-normal text-muted-foreground select-none">
              ${weekDay.narrow}
              <span class="sr-only">${weekDay.long}</span>
            </th>
          </for>
        </tr>
      </thead>
      <tbody ...connectFresh(service).getTableBodyProps() data-slot="calendar-table-body">
        <for|week, i| of=weeks() by=(_, i) => `week:${i}`>
          <tr class="mt-2 flex w-full">
            <for|day, j| of=week by=(_, j) => `day:${j}`>
              <td
                ...day.cell
                data-slot="calendar-cell"
                class="group/day relative aspect-square h-full w-full rounded-(--cell-radius) p-0 text-center select-none [&:has([data-in-range])]:bg-muted first:[&:has([data-in-range])]:rounded-l-(--cell-radius) last:[&:has([data-in-range])]:rounded-r-(--cell-radius)"
              >
                <button
                  ...day.trigger
                  data-slot="calendar-day"
                  class="mu-calendar-day-button relative isolate z-10 flex aspect-square size-auto w-full min-w-(--cell-size) flex-col gap-1 border-0 leading-none font-normal text-foreground data-[today]:bg-muted data-[outside-range]:text-muted-foreground data-[outside-range]:opacity-50 group-data-[focus]/day:relative group-data-[focus]/day:z-10 group-data-[focus]/day:border-ring group-data-[focus]/day:ring-[3px] group-data-[focus]/day:ring-ring/50 data-[range-end]:rounded-(--cell-radius) data-[range-end]:rounded-r-(--cell-radius) data-[range-end]:bg-primary data-[range-end]:text-primary-foreground data-[in-range]:rounded-none data-[in-range]:bg-muted data-[in-range]:text-foreground data-[range-start]:rounded-(--cell-radius) data-[range-start]:rounded-l-(--cell-radius) data-[range-start]:bg-primary data-[range-start]:text-primary-foreground data-selected:bg-primary data-selected:text-primary-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 dark:hover:text-foreground"
                >
                  ${day.label}
                </button>
              </td>
            </for>
          </tr>
        </for>
      </tbody>
    </table>
  </div>
</div>

<return=api>
