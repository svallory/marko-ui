import * as sliderMachine from "@zag-js/slider";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"div", sliderMachine.Props> & {
  valueChange?: (value: number[]) => void;
};

<zag/api=() => sliderMachine from=input/>

<const/nativeAttrs=() =>
  stripOwnProps(sliderMachine.splitProps(input)[1], "class", "valueChange")
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="slider"
  class=cn("mu-slider relative flex w-full touch-none items-center select-none data-[disabled]:opacity-50 data-[orientation=vertical]:h-full data-[orientation=vertical]:w-auto data-[orientation=vertical]:flex-col", input.class)
>
  // zag-required control wrapper (no upstream counterpart; style CSS never
  // targets it). Mirrors the root's orientation utilities so vertical works
  // through the extra layer.
  <div ...api().getControlProps() data-slot="slider-control" class="relative flex grow touch-none items-center select-none data-[orientation=vertical]:h-full data-[orientation=vertical]:flex-col">
    <div ...api().getTrackProps() data-slot="slider-track" class="mu-slider-track relative grow overflow-hidden data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full">
      <div ...api().getRangeProps() data-slot="slider-range" class="mu-slider-range absolute select-none data-[orientation=horizontal]:h-full data-[orientation=vertical]:w-full"></div>
    </div>
    <for|_, i| of=api().value>
      <input ...api().getHiddenInputProps({ index: i })>
      <div ...api().getThumbProps({ index: i }) data-slot="slider-thumb" class="mu-slider-thumb block shrink-0 select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50"></div>
    </for>
  </div>
</div>

<return=api>
