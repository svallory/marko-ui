// Framework-agnostic port of shadcn/ui's multi-library icon system
// (registry/icons/*.tsx + create-icon-loader.tsx). shadcn resolves an
// abstract icon name against the CURRENT icon-library React component
// (IconLucide/IconTabler/IconHugeicons/IconPhosphor/IconRemixicon), each
// lazily importing a generated `__<library>__.ts` name -> icon-component
// map. This port has no React and no per-icon components to lazy-import;
// instead tooling/build-icons.ts generates per-library
// maps of abstract name -> raw SVG inner-markup (or, for hugeicons, an
// [tag, attrs][] node array — the same shape shadcn's own HugeiconsIcon
// consumes), and ./lib/render.ts resolves (name, library) to wrapper attrs
// + inner markup for both this component's SSR output AND the /create
// preview iframe's client-side icon-library swap (see that route's header
// comment — Marko has no React-style context re-render, so switching
// iconLibrary on an already-mounted page needs a manual DOM patch reusing
// this exact same data; render.ts is the single source of truth so the two
// never drift).
//
// SSR-first: markup is interpolated with `$!{}` (unescaped) at render time,
// not injected client-side via .innerHTML (see the create-page-fixes
// lesson in notes/ — client-side innerHTML injection breaks hydration and
// is exactly the anti-pattern this component avoids for its own render).
// The interpolated content is build-time-generated from trusted npm
// packages, never user input. `data-icon-name`/`data-icon-library` markers
// let the preview iframe's OWN opt-in re-render script (not this
// component) find and patch icons after the initial SSR paint.
//
// Environments (perf/icon-chunks). Marko compiles a template's module-level
// imports into BOTH bundles, so a plain `import` of resolve.ts (all 5
// libraries' maps, ~360KB source) shipped every map to every route that
// renders an <icon>. A subtree first created in the BROWSER (an overlay body
// opened after hydration, an <if> branch never true at SSR) re-runs this
// whole template client-side, so the client needs a resolver too — just not
// resolve.ts. `resolveInitialInner` is assigned once per environment:
// - server: resolve.ts's resolveIconInner (all 5 libraries; SSR output is
//   unchanged).
// - client: resolve-client.ts, synchronous for the default library (lucide,
//   the only map the client bundle carries), a placeholder glyph otherwise.
//   For a non-default library the <script> below then loads that library's
//   map through resolve-client.ts's dynamic import() and patches the <svg>,
//   so a client-mounted icon never stays empty.
// `marko-ui add` rewrites resolve.ts AND resolve-client.ts to import the one
// configured library (packages/marko-ui/src/utils/icon-library.ts), where
// both sides resolve synchronously and loadClientIconInner returns undefined.
import { cn } from "#lib/utils.ts";
import { ICON_WRAPPER_ATTRS } from "./render.ts";
import type { IconLibraryName, IconName } from "./icon-names.ts";
import { icon as styles } from "./classes.ts";
import { resolveIconLibrary } from "./resolve-client.ts";
server import { resolveIconInner } from "./resolve.ts";
client import { resolveClientIconInner, loadClientIconInner } from "./resolve-client.ts";

static let resolveInitialInner: (name: string, library: IconLibraryName) => string;

server {
  resolveInitialInner = resolveIconInner;
}

client {
  resolveInitialInner = resolveClientIconInner;
}

export interface Input extends Omit<Marko.HTMLAttributes<Element>, "lang"> {
  /** Abstract icon name, e.g. "SearchIcon" — shared across all 5 libraries. */
  name: IconName | string;
  /** Which icon library to render from. Defaults to "lucide". */
  library?: IconLibraryName;
  class?: string;
  /**
   * Suppress the default `size-4` class so the emitted <svg> carries no
   * `size-*` utility at all.
   *
   * The 8 style layers size icons through shadcn's vendored
   * `[&_svg:not([class*='size-'])]:size-N` escape hatch, which only reaches
   * an <svg> that has NO size class. Upstream shadcn's icon loader emits no
   * default size for exactly this reason; this component adds `size-4` as a
   * convenience, which silently disables that hatch. Set `unsized` at any
   * call site whose size is owned by an ancestor's `mu-*` style rule.
   */
  unsized?: boolean;
}

// `input.library` is typed as IconLibraryName, but every call site that
// actually matters (icon-placeholder.marko, preview-blocks/lib/icon.marko)
// derives it from `$global.url.searchParams.get("iconLibrary")` with only a
// TS `as IconLibraryName` cast — no runtime check. A malformed/stale/typo'd
// `?iconLibrary=` query value would otherwise reach `ICON_WRAPPER_ATTRS[library]`
// as `undefined` and throw on `wrapperAttrs.viewBox` below, crashing SSR for
// the whole request. resolveIconLibrary is the single choke point every icon
// render passes through. In a project set up with `marko-ui add` it is
// rewritten to always return the components.json `iconLibrary`.
<const/library=resolveIconLibrary(input.library)/>
<const/{ name, library: _library, class: className, unsized, ...rest }=input/>
<const/wrapperAttrs=ICON_WRAPPER_ATTRS[library]/>

<svg/svgEl
  ...rest
  xmlns="http://www.w3.org/2000/svg"
  viewBox=wrapperAttrs.viewBox
  width="24"
  height="24"
  fill=wrapperAttrs.fill
  stroke=wrapperAttrs.stroke
  stroke-width=wrapperAttrs["stroke-width"]
  stroke-linecap=wrapperAttrs["stroke-linecap"]
  stroke-linejoin=wrapperAttrs["stroke-linejoin"]
  class=cn(unsized ? undefined : styles.sized, className) || undefined
  data-icon-name=name
  data-icon-library=library
>
  $!{resolveInitialInner(name, library)}
</svg>

<!--
  Client-only, once per mount (name/library are non-reactive at every real
  call site). loadClientIconInner returns undefined when resolveInitialInner
  already produced the real markup (default library, or a single-library
  copy), so this only acts for a non-default library first mounted in the
  browser, where the sync pass rendered the placeholder glyph. The write is
  guarded: it only lands while the <svg> is connected and still carries this
  icon's own data-icon-library.
-->
<script>
  loadClientIconInner(name, library)?.then((inner) => {
    const svg = svgEl();
    // Skip when the icon was unmounted, or claimed by another library while
    // this load was in flight (the /create/preview picker swaps
    // data-icon-library synchronously, then patches the markup itself).
    if (!svg.isConnected || svg.getAttribute("data-icon-library") !== library) return;
    svg.innerHTML = inner;
  });
</script>
