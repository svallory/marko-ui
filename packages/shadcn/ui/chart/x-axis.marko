// XAxis ticks — recharts-parity SVG partial (internal; ctx threaded by the
// chart tags). Tick <text> carries literal fill="#666" — the container's
// [&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground restyles it.
// No axis line / tick lines: shadcn demos always pass tickLine={false}
// axisLine={false}, so we simply never render them. Any tickFormatter is
// applied by the CALLER before passing `ticks`.
import { xTicks, type CartesianCtx, type XTick } from "./math.ts";
import { xAxis as styles } from "./classes.ts";

export interface Input {
  ctx: CartesianCtx;
  ticks?: XTick[];
  tickMargin?: number;
}

<const/{ ctx, tickMargin = 8 }=input/>
<const/ticks=(input.ticks ?? xTicks(ctx))/>
<const/tickY=(ctx.plot.y + ctx.plot.height + tickMargin)/>

<g class=styles.root>
  <g class=styles.ticks>
    <for|tick| of=ticks>
      <g class=styles.tick>
        <text
          stroke="none"
          fill="#666"
          class=styles.tickText
          x=tick.x
          y=tickY
          text-anchor="middle"
        ><tspan x=tick.x dy="0.71em">${tick.value}</tspan></text>
      </g>
    </for>
  </g>
</g>
