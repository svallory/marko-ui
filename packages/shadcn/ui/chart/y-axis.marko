// YAxis ticks — recharts-parity SVG partial (internal; PLAIN geometry
// threaded by the chart tags — see grid.marko's header note on why this
// can never take the live CartesianCtx). Only rendered when a chart tag
// gets `yAxis` (default off, matching the shadcn demos). Literal
// fill="#666" — restyled by the container's fill-muted-foreground
// selector. No axis/tick lines.
import type { PlotGeometry, YTick } from "./math.ts";
import { yAxis as styles } from "./classes.ts";

export interface Input {
  plot: PlotGeometry;
  ticks: YTick[];
  tickMargin?: number;
}

<const/{ plot, ticks, tickMargin = 8 }=input/>
<const/tickX=(plot.x - tickMargin)/>

<g class=styles.root>
  <g class=styles.ticks>
    <for|tick| of=ticks>
      <g class=styles.tick>
        <text
          stroke="none"
          fill="#666"
          class=styles.tickText
          x=tickX
          y=tick.y
          text-anchor="end"
        ><tspan x=tickX dy="0.355em">${tick.value}</tspan></text>
      </g>
    </for>
  </g>
</g>
