// ChartContainer — Marko port of shadcn's <ChartContainer> (chart.tsx).
// Emits the EXACT same wrapper: data-slot="chart", data-chart id, the
// verbatim shadcn class string (whose selectors target recharts-* classes
// and literal default attributes our SVG partials reproduce), and the
// <ChartStyle> inline <style> that scopes --color-<key> vars per THEMES.
import { chartStyleCss, type ChartConfig } from "./config.ts";
import { cn } from "#lib/utils.ts";
import { chart as styles } from "./classes.ts";

export interface Input extends Marko.Input<"div"> {
  config: ChartConfig;
  content?: Marko.Body;
}

<const/{ config, class: className, content, id: idAttr, ...rest }=input/>
<id/uid/>
<const/chartId=(`chart-${idAttr ?? uid}`)/>
<const/styleCss=chartStyleCss(chartId, config)/>

<div
  ...rest
  data-slot="chart"
  data-chart=chartId
  class=cn(styles.root, className)
>
  <if=styleCss>
    <${"style"}>$!{styleCss}</>
  </if>
  <div
    class=styles.responsiveContainer
    style={ width: "100%", height: "100%" }
  >
    <${content}/>
  </div>
</div>
