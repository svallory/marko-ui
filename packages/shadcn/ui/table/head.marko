import { cn } from "#lib/utils.ts";
import { head as styles } from "./classes.ts";

export interface Input extends Marko.Input<"th"> {
  content?: Marko.Body;
}

<const/{ class: className, content, scope, ...rest }=input/>

<th
  ...rest
  scope=(scope ?? "col")
