// Port of shadcn's `direction.tsx`, which itself just re-exports Base UI's
// (nee Radix's) `Direction.DirectionProvider` + `useDirection` hook.
//
// SIMPLIFICATION FROM SOURCE: Base UI's DirectionProvider is a pure React
// Context provider — it renders NO DOM element of its own; `dir` only ever
// reaches descendants through `useDirection()` reading context, never
// through an attribute in the DOM. Marko has no context primitive (per the
// project's stated gotchas: "React context -> pass values down as attrs
// from a container tag"), so this port renders a real wrapping element and
// sets `dir` on it directly. Descendants read direction via the CSS
// `dir` inheritance (the browser's own attribute-inheritance mechanism)
// rather than via a JS context lookup — `getDirection()` in `direction.ts`
// resolves the *effective* value the same way `useDirection()` would,
// by walking up to the nearest ancestor `[dir]` element via `closest()`.
//
// This means the DOM gains one wrapper element the source never rendered.
// That is a deliberate, documented deviation from byte-for-byte DOM parity,
// forced by the absence of a React-context equivalent in Marko; every
// class string / data-slot / CSS variable rule from HARD PARITY still
// applies to everything else in this registry.
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  /** Text direction propagated to descendants. */
  dir?: "ltr" | "rtl";
  /** Alias for `dir`, matching the shadcn source's extra `direction` prop. */
  direction?: "ltr" | "rtl";
}

<const/{ class: className, dir, direction, content, ...rest }=input/>

<div
  ...rest
  dir=(direction ?? dir)
  data-slot="direction-provider"
  class=cn(className)
>
  <${content}/>
</div>
