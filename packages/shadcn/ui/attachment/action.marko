import { buttonVariants, type ButtonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import { action as styles } from "./classes.ts";

export interface Input extends Marko.Input<"button">, ButtonVariants {}

<const/{ variant, size = "icon-xs", class: className, content, ...rest }=input/>
<const/resolvedVariant=variant ?? "ghost"/>

<button
  data-slot="attachment-action"
  class=cn(buttonVariants({ variant: resolvedVariant, size }), styles.root, className)
  ...rest
>
  <${content}/>
</button>
