import * as popoverMachine from "@zag-js/popover";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Popover open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object. Align/sideOffset are NOT separate props —
// zag exposes them via `positioning.align` / `positioning.gutter`
// (@zag-js/popper `PositioningOptions`), already forwarded through
// `popoverMachine.props`.
export type Input = MachineInput<"div", popoverMachine.Props> & {
  /** Trigger render-prop — the element that opens the popover. */
  trigger: Marko.Body<[Record<string, unknown>]>;
  /** Popover content shown when open. */
  content: Marko.Body;
  /** Extra class for the content panel. */
  class?: string;
  openChange?: (open: boolean) => void;
};

<zag/api=() => popoverMachine from=input/>

<div data-slot="popover">
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "popover-trigger" })/>
  // NOTE: upstream shadcn sets data-slot="popover-portal" on Radix's Portal,
  // which renders a real element. marko-zag's <zag-portal> renders a
  // `display:contents` host and does not forward attributes, so the
  // marker never reached the DOM — it was inert, and nothing in this
  // repo's CSS, tests or tooling reads it. Dropped rather than left as
  // dead markup; restore it if <zag-portal> gains attribute forwarding.
  <zag-portal>
    <if=api().open>
      <div ...api().getPositionerProps() style=positionerStyle data-slot="popover-positioner">
        <div
          ...api().getContentProps()
          data-slot="popover-content"
          class=cn(
            "mu-popover-content z-50 w-72 origin-(--radix-popover-content-transform-origin) outline-hidden",
            input.class,
          )
        >
          <${input.content}/>
        </div>
      </div>
    </if>
  </zag-portal>
</div>

<return=api>
