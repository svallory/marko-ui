// Port of shadcn's `message-scroller.tsx`'s `MessageScrollerButton`. Wraps
// `@shadcn/react/message-scroller`'s `MessageScroller.Button`, a
// `useRender`-based polymorphic trigger that subscribes to the controller's
// scrollable-state store (`useSyncExternalStore`) to compute `active`, and
// scrolls to the given `direction`'s edge on click when active.
//
// SIMPLIFICATION FROM SOURCE: `useRender`'s generic `render` prop (letting a
// caller swap the rendered element/component entirely) has no established
// idiom yet in this registry (grep across every existing port turns up no
// `render=` usage) — this port always renders our `<Button>` component
// directly, matching the SOURCE'S OWN DEFAULT (`render={render ?? <Button
// variant={variant} size={size} />}`) exactly. `type="button"`,
// `inert`/`tabIndex` gating, and the click handler's active-guard +
// `blur()` + direction dispatch are all preserved.
//
// The store subscription itself (`useSyncExternalStore` in the source)
// becomes a `<let>` seeded from the controller's synchronous snapshot and
// kept live via `stateStore.subscribe` in a `<lifecycle>` — Marko's
// reactive-local equivalent of a store subscription hook.
import Button from "../button/button.marko";
import Icon from "../icon/icon.marko";
import type { ButtonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import type { MessageScrollerControllerGetter } from "./lib/controller.ts";

export interface Input extends Marko.Input<"button">, Pick<ButtonVariants, "variant" | "size"> {
  /** Controller getter provided by the nearest `<message-scroller-provider>`. */
  controller: MessageScrollerControllerGetter;
  /** Native scroll behavior when clicked. Defaults to "smooth". */
  behavior?: ScrollBehavior;
  /** Transcript edge to scroll toward. Defaults to "end". */
  direction?: "start" | "end";
}

<const/{
  controller,
  behavior = "smooth",
  direction = "end",
  variant = "secondary",
  size = "icon-sm",
  class: className,
  content,
  onClick,
  type,
  tabindex,
  ...rest
}=input/>

// Seeded false: the controller only exists in the browser (calling the getter
// during SSR would create — and then fail to serialize — it), and the store's
// initial scrollable snapshot is all-false anyway. onMount syncs immediately.
<let/active=false/>

<lifecycle
  onMount() {
    const stateStore = controller().stateStore;
    const sync = () => {
      const snapshot = stateStore.getSnapshot();
      active = direction === "start" ? snapshot.start : snapshot.end;
    };
    sync();
    // Marko merges onMount's RETURNED OBJECT into `this` (returning the bare
    // unsubscribe function is silently ignored) — onDestroy reads it back.
    return { unsubscribe: stateStore.subscribe(sync) };
  }
  onDestroy() {
    this.unsubscribe?.();
  }
/>

<Button
  ...rest
  variant=variant
  size=size
  type=(type ?? "button")
  inert=(!active)
  tabindex=(active ? tabindex : -1)
  data-slot="message-scroller-button"
  data-direction=direction
  data-variant=variant
  data-size=size
  data-active=String(active)
  class=cn(
    "mu-message-scroller-button absolute inset-s-1/2 -translate-x-1/2 border-border bg-background text-foreground transition-[translate,scale,opacity] duration-200 hover:bg-muted hover:text-foreground data-[active=false]:pointer-events-none data-[active=false]:scale-95 data-[active=false]:opacity-0 data-[active=false]:duration-400 data-[active=false]:ease-[cubic-bezier(0.7,0,0.84,0)] data-[active=true]:translate-y-0 data-[active=true]:scale-100 data-[active=true]:opacity-100 data-[active=true]:ease-[cubic-bezier(0.23,1,0.32,1)] data-[direction=end]:bottom-4 data-[direction=end]:data-[active=false]:translate-y-full data-[direction=start]:top-4 data-[direction=start]:data-[active=false]:-translate-y-full rtl:translate-x-1/2 data-[direction=start]:[&_svg]:rotate-180",
    className,
  )
  // No hand-written parameter annotations: Marko infers `onClick`'s real
  // signature for a <button> (a PointerEvent plus the bound element).
  // Annotating them `MouseEvent`/`HTMLElement` widened away that type and
  // made forwarding to the caller's own onClick a type error.
  onClick(event, target) {
    if (!active) return;

    // Marko types event attrs as `handler | false | undefined` (`false`
    // disables the handler), so this must be a callability check, not `?.` —
    // a consumer passing `onClick=false` would otherwise crash here.
    if (typeof onClick === "function") onClick(event, target);

    if (!event.defaultPrevented) {
      // event.currentTarget is unsupported in Marko's delegated events —
      // the handler's 2nd argument is the element the handler is bound to.
      target?.blur();

      if (direction === "start") {
        controller().scrollToStart({ behavior });
      } else {
        controller().scrollToEnd({ behavior });
      }
    }
  }
>
  <if=content>
    <${content}/>
  </if>
  <else>
    <Icon name="ArrowDownIcon"/>
    <span class="sr-only">${direction === "end" ? "Scroll to end" : "Scroll to start"}</span>
  </else>
</Button>
