import * as menu from "@zag-js/menu";
import { positionerStyle } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import type { DropdownMenuItem } from "../dropdown-menu/dropdown-menu.marko";
import Submenu from "./submenu.marko";

// Attr-tag form of DropdownMenuItem. A SINGLE attr tag name (`item`) carries
// all kinds (discriminated by `type`) rather than separate `item`/
// `separator`/`label`/`checkbox`/`radio` attr tags: Marko collects each
// attr-tag NAME into its own independent iterable on `input` with no shared
// ordering between differently-named siblings, so distinct tag names could
// not preserve call-site interleaving. One name with a `type` discriminant
// keeps document order intact by construction (same design as
// dropdown-menu.marko). `content` lets an item or label carry a markup
// body; the plain `label` string renders as the fallback when no body is
// supplied.
//
// `inset` (upstream new styling attr, rule 5) and the checkbox/radio kinds
// are additive here — `DropdownMenuItem` doesn't carry them yet (dropdown-menu
// is a separate re-baseline task), so they're declared locally rather than
// added to the shared type.
export interface MenubarItemAttrs extends DropdownMenuItem {
  content?: Marko.Body;
  /** Upstream styling attr — indents the item to align with checkbox/radio items. */
  inset?: boolean;
  /** `type: "checkbox" | "radio"` checked state (checkbox) or selected value match (radio). */
  checked?: boolean;
  /** Groups radio items — required for `type: "radio"` entries. */
  radioGroup?: string;
  /** `type: "radio"` entries only — this entry's value within its `radioGroup`. */
  radioValue?: string;
  /** `type: "sub"` entries only — the nested submenu's own item list. */
  subEntries?: MenubarItemAttrs[];
}

export interface Input {
  trigger: Marko.Body<[Record<string, unknown>]>;
  items?: DropdownMenuItem[];
  item?: Marko.AttrTag<MenubarItemAttrs>;
  select?: (value: string) => void;
  /** Fires when a checkbox item's checked state changes; receives its value and new checked state. */
  checkedChange?: (value: string, checked: boolean) => void;
  /** Fires when a radio group's selected value changes; receives the group name and new value. */
  radioChange?: (group: string, value: string) => void;
  class?: string;
}

// Walk-safe replacement for a `<const/{ class: className, trigger }=input/>`
// destructure + `<const/entries=...>` derivation — identical shape/rationale
// to dropdown-menu.marko's own fix (see that file's header comment for the
// full walk-order RCA and notes/bug-marko-dynamic-tag-hydration-crash.md).
// This component can be mounted via dynamic-tag-content the same way
// dropdown-menu.marko is (a `<for>`-loop-captured `<@item>` composition),
// which races any `<const>` read at walk time in the `<for>`/`<if>` below
// against its own deferred signal on a freshly-created scope. `entries`
// derives purely from `input`, so a module-level `static function` computes
// it fresh at each use site — no scope-property read to race the walk.
static function menuEntries(input: Input): MenubarItemAttrs[] {
  const attrItems = [...(input.item ?? [])];
  return attrItems.length > 0
    ? attrItems
    : (input.items ?? []).map((item) => ({ ...item, content: undefined as Marko.Body | undefined }));
}

<machine-props/machineProps from=input pick=menu.props
  onSelect(details: menu.SelectionDetails) {
    input.select?.(details.value);
  }/>
<service/service machine=() => menu.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  menu.connect(service, normalizeProps)
  service=service
/>

// Getter handed to each <Submenu> child so it can call `setParent` on this
// menu's raw service (see submenu.marko for the full wiring rationale).
<const/getOwnService=() => service.service/>

// Trigger is a render-prop (the caller owns the `<button>` markup), so the
// anchor class is offered through the props object like upstream's own
// className default — callers spread it onto their element same as any
// other prop; a caller-supplied `class` in their own JSX wins because it's
// applied after the spread, matching how every other render-prop trigger in
// this registry (popover, hover-card) hands back props without dictating
// element ownership.
<${input.trigger}({ ...api().getTriggerProps(), "data-slot": "menubar-trigger", class: "mu-menubar-trigger flex items-center outline-hidden select-none" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="menubar-positioner">
      <div
        ...api().getContentProps()
        data-slot="menubar-content"
        class=cn(
          "mu-menubar-content mu-menu-target mu-menu-translucent z-50 origin-(--radix-menubar-content-transform-origin) overflow-hidden",
          input.class,
        )
      >
        <for|entry, index| of=menuEntries(input)>
          <const/value=entry.value ?? `item-${index}`/>
          <if=entry.type === "separator">
            <div ...api().getSeparatorProps() data-slot="menubar-separator" class="mu-menubar-separator -mx-1 my-1 h-px"/>
          </if>
          <else if=entry.type === "label">
            <div data-slot="menubar-label" data-inset=entry.inset || undefined class="mu-menubar-label">
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
            </div>
          </else>
          <else if=entry.type === "checkbox">
            <div
              ...api().getOptionItemProps({
                type: "checkbox",
                value,
                checked: entry.checked ?? false,
                disabled: entry.disabled,
                onCheckedChange: (checked) => input.checkedChange?.(value, checked),
              })
              data-slot="menubar-checkbox-item"
              data-inset=entry.inset || undefined
              class="mu-menubar-checkbox-item relative flex cursor-default items-center outline-hidden select-none data-[disabled]:pointer-events-none [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span
                ...api().getItemIndicatorProps({ value, checked: entry.checked ?? false })
                data-slot="menubar-checkbox-item-indicator"
                class="mu-menubar-checkbox-item-indicator pointer-events-none absolute flex items-center justify-center"
              >
                <Icon name="Check" aria-hidden="true"/>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="menubar-shortcut" class="mu-menubar-shortcut ml-auto">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else if=entry.type === "radio">
            <div
              ...api().getOptionItemProps({
                type: "radio",
                value: entry.radioValue ?? value,
                checked: entry.checked ?? false,
                disabled: entry.disabled,
                onCheckedChange: () => input.radioChange?.(entry.radioGroup ?? "", entry.radioValue ?? value),
              })
              data-slot="menubar-radio-item"
              data-inset=entry.inset || undefined
              class="mu-menubar-radio-item relative flex cursor-default items-center outline-hidden select-none data-[disabled]:pointer-events-none [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span
                ...api().getItemIndicatorProps({ value: entry.radioValue ?? value, checked: entry.checked ?? false })
                data-slot="menubar-radio-item-indicator"
                class="mu-menubar-radio-item-indicator pointer-events-none absolute flex items-center justify-center"
              >
                <Icon name="Check" aria-hidden="true"/>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="menubar-shortcut" class="mu-menubar-shortcut ml-auto">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else if=entry.type === "sub">
            <Submenu
              entries=entry.subEntries ?? []
              label=entry.label
              disabled=entry.disabled
              inset=entry.inset
              parent=getOwnService
              onChildReady=(childService) => api().setChild(childService)
            >
              <@trigger|childApi|>
                <div
                  ...api().getTriggerItemProps(childApi())
                  data-slot="menubar-sub-trigger"
                  data-inset=entry.inset || undefined
                  class="mu-menubar-sub-trigger flex cursor-default items-center outline-none select-none"
                >
                  ${entry.label}
                  <Icon name="ChevronRight" class="mu-rtl-flip ml-auto size-4" aria-hidden="true"/>
                </div>
              </@trigger>
            </Submenu>
          </else>
          <else>
            <div
              ...api().getItemProps({ value, disabled: entry.disabled })
              data-slot="menubar-item"
              data-inset=entry.inset || undefined
              data-variant=entry.variant ?? "default"
              class="mu-menubar-item group/menubar-item relative flex cursor-default items-center outline-hidden select-none data-[disabled]:pointer-events-none [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="menubar-shortcut" class="mu-menubar-shortcut ml-auto">${entry.shortcut}</span>
              </if>
            </div>
          </else>
        </for>
      </div>
    </div>
  </if>
</portal>

<return=api>
