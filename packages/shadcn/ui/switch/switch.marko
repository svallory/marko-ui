// Reference implementation of a marko-ui component.
// Guide: /docs/creating-components · adapter internals: /docs/zag-adapter
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as switchMachine from "@zag-js/switch";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { switchStyles as styles } from "./classes.ts";

// MachineInput = native <input> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `checkedChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Switch checked:=myState/>); Zag's own `onCheckedChange` also works and
// receives the details object.
export type Input = MachineInput<"input", switchMachine.Props> & {
  checkedChange?: (checked: boolean) => void;
  /**
   * Label text rendered after the control (Zag's `label` part), which also
   * becomes the accessible name of the hidden checkbox. Without it, pass
   * `aria-label` instead — a switch must have a name.
   */
  content?: Marko.Body;
  /**
   * Control size. Upstream (shadcn) styling API; the zag switch machine has
   * no `size` prop, so this is purely presentational — forwarded as
   * `data-size` on the control, not to the machine.
   */
  size?: "sm" | "default";
};

// <zag> wires the machine in one tag and returns `api` as a GETTER —
// call it at every use site. Getters are the serializable currency of
// Marko's resumability: the api object itself must never become reactive
// state. See /docs/creating-components.
<zag/api=() => switchMachine from=input/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, checkedChange) passes through to the hidden input: aria-*,
// data-*, form attributes...
<const/nativeAttrs=(): Marko.HTMLAttributes<HTMLInputElement> =>
  stripOwnProps(
    switchMachine.splitProps(input)[1],
    "class",
    "checkedChange",
    "content",
    "size",
  )
>

// Zag always points the hidden input's aria-labelledby at the label part's
// id; when no label content is rendered that reference dangles and the
// switch ends up with NO accessible name (axe: label). Keep the reference
// only when the label part actually exists.
<const/hiddenInputProps=() => api().getHiddenInputProps()/>

<label
  ...api().getRootProps()
  data-slot="switch-label"
  class=styles.label
>
  <span
    ...api().getControlProps()
    data-slot="switch"
    data-size=(input.size ?? "default")
    class=cn(styles.control, input.class)
  >
    <span
      ...api().getThumbProps()
      data-slot="switch-thumb"
      class=styles.thumb
    />
  </span>
  <if=input.content>
    <span
      ...api().getLabelProps()
      data-slot="switch-text"
      class=styles.text
    >
      <${input.content}/>
    </span>
  </if>
  <input
    ...nativeAttrs()
    ...hiddenInputProps()
    aria-labelledby=(input.content ? hiddenInputProps()["aria-labelledby"] : undefined)
  >
</label>

// Parents can receive the api getter: <Switch/switchApi/> then
// `switchApi().checked` — it stays live across machine updates.
<return=api>
