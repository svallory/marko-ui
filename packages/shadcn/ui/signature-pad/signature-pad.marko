import * as signaturePadMachine from "@zag-js/signature-pad";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { buttonVariants } from "../button/variants.ts";
import { signaturePad as styles } from "./classes.ts";

export type Input = MachineInput<"input", signaturePadMachine.Props> & {
  drawChange?: (paths: string[]) => void;
  drawEndChange?: (paths: string[]) => void;
};

<zag/api=() => signaturePadMachine from=input
  onDraw(details: signaturePadMachine.DrawDetails) {
    input.onDraw?.(details);
    input.drawChange?.(details.paths);
  }
  onDrawEnd(details: signaturePadMachine.DrawEndDetails) {
    input.onDrawEnd?.(details);
    input.drawEndChange?.(details.paths);
  }
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    signaturePadMachine.splitProps(input)[1],
    "class",
    "drawChange",
    "drawEndChange",
  )
>
<const/clearTriggerVariant=buttonVariants({ variant: "ghost", size: "icon" })/>

<div
  ...api().getRootProps()
  data-slot="signature-pad"
  class=cn(styles.root, input.class)
>
  <label ...api().getLabelProps() data-slot="signature-pad-label" class=styles.label>
    Sign here
  </label>

  <div
    ...api().getControlProps()
    data-slot="signature-pad-control"
    class=styles.control
  >
    <svg ...api().getSegmentProps() data-slot="signature-pad-segment">
      <for|path| of=api().paths>
        <path ...api().getSegmentPathProps({ path }) data-slot="signature-pad-segment-path"/>
      </for>
      <if=api().currentPath>
        <path ...api().getSegmentPathProps({ path: api().currentPath as string }) data-slot="signature-pad-segment-path"/>
      </if>
    </svg>

    <button
      ...api().getClearTriggerProps()
      data-slot="signature-pad-clear-trigger"
      class=cn(clearTriggerVariant, styles.clearTrigger)
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class=styles.clearIcon
      >
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
      <span class=styles.srOnly>Clear signature</span>
    </button>

    <div ...api().getGuideProps() data-slot="signature-pad-guide" class=styles.guide/>
  </div>

  <input/hiddenInput
    ...nativeAttrs()
    ...api().getHiddenInputProps({ value: JSON.stringify(api().paths) })
    data-slot="signature-pad-hidden-input"
  >
</div>

<script>
  // Marko patches `value` as the input's default-value ATTRIBUTE, not the
  // live DOM property forms actually submit. Set the property imperatively
  // whenever the committed paths change so form submission stays correct.
  hiddenInput().value = JSON.stringify(api().paths);
</script>

<return=api>
