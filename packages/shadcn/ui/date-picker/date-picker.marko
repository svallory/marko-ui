import * as datePickerMachine from "@zag-js/date-picker";
import { parse } from "@zag-js/date-picker";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { datePicker as styles } from "./classes.ts";

// `value`/`valueChange`/`focusedValue`/`defaultFocusedValue` use plain ISO
// date strings instead of Zag's DateValue so consumers don't need
// @internationalized/date, AND so no live DateValue class instance ever
// crosses Marko's SSR->hydration resume boundary as a component Input
// value — a `DateValue`'s own `.calendar` field is a class instance with
// methods, which Marko's tag-input serializer rejects outright ("Unable to
// serialize ... input ... reading defaultFocusedValue"). The real DateValue
// is reconstructed via `parse()` inside machineProps's closure below,
// independently on server and client, the same way `value` already is —
// see calendar.marko's `PlainDate`/`toFocusedDateValue()` for the identical
// pattern (calendar-hijri.marko).
export type Input = Omit<MachineInput<"div", datePickerMachine.Props>, "value" | "focusedValue" | "defaultFocusedValue"> & {
  /** The selected date as an ISO date string (`YYYY-MM-DD`). */
  value?: string;
  /** Function called when the value changes. Receives the new ISO date string, or `undefined` when cleared. */
  valueChange?: (value: string | undefined) => void;
  /** Controlled visible-month focus, as an ISO date string (`YYYY-MM-DD`). */
  focusedValue?: string;
  /**
   * Initial visible-month focus, as an ISO date string (`YYYY-MM-DD`).
   * Pins the SSR-rendered month instead of falling back to the browser's
   * wall-clock "today" (`getTodayDate`), which would otherwise make SSR
   * and hydrated markup diverge near midnight or across timezones.
   */
  defaultFocusedValue?: string;
};

<zag/api=() => datePickerMachine from=input props=(picked) => ({
  ...picked,
  value: input.value ? [parse(input.value)] : undefined,
  focusedValue: input.focusedValue ? parse(input.focusedValue) : undefined,
  defaultFocusedValue: input.defaultFocusedValue ? parse(input.defaultFocusedValue) : undefined,
})
  onValueChange(details: datePickerMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value[0]?.toString());
  }
/>

// `value`/`focusedValue`/`defaultFocusedValue` are deliberately remapped to
// ISO date strings on this component's public Input, so `input` does not
// satisfy `splitProps`'s `Partial<DatePickerProps>` constraint. All three
// are machine-owned keys that `splitProps` would strip from the leftover
// anyway — drop them first and the call type-checks on the keys it
// actually partitions.
<const/splitSource=() => {
  const { value, focusedValue, defaultFocusedValue, ...rest } = input;
  return rest;
}/>
<const/nativeAttrs=() =>
  stripOwnProps(
    datePickerMachine.splitProps(splitSource())[1],
    "class",
    "valueChange",
  )
>

<const/weeks=() =>
  api().weeks.map((week) =>
    week.map((date) => {
      const cellState = api().getDayTableCellState({ value: date });
      return {
        cell: api().getDayTableCellProps({ value: date }),
        trigger: api().getDayTableCellTriggerProps({ value: date }),
        label: String(date.day),
        selected: cellState.selected,
        today: cellState.today,
        outsideRange: cellState.outsideRange,
        disabled: cellState.disabled,
        unavailable: cellState.unavailable,
      };
    }),
  )
/>

<div ...nativeAttrs() ...api().getRootProps() data-slot="date-picker" class=cn(input.class)>
  <div ...api().getControlProps() data-slot="date-picker-control" class=styles.control>
    <input
      ...api().getInputProps()
      data-slot="date-picker-input"
      class=styles.input
    />
    <button
      ...api().getTriggerProps()
      data-slot="date-picker-trigger"
      class=styles.trigger
    >
      <Icon name="Calendar"/>
      <span class=styles.srOnly>Open calendar</span>
    </button>
  </div>
  <zag-portal>
    <if=api().open>
      <div ...api().getPositionerProps() style=positionerStyle data-slot="date-picker-positioner" class=styles.positioner>
        <div
          ...api().getContentProps()
          data-slot="date-picker-content"
          class=styles.content
        >
          <div ...api().getViewControlProps() data-slot="date-picker-view-control" class=styles.viewControl>
            <button
              ...api().getPrevTriggerProps()
              data-slot="date-picker-prev-trigger"
              class=styles.navTrigger
            >
              <Icon name="ChevronLeft"/>
              <span class=styles.srOnly>Previous</span>
            </button>
            <button
              ...api().getViewTriggerProps()
              data-slot="date-picker-view-trigger"
              class=styles.viewTrigger
            >
              ${api().visibleRangeText.start}
            </button>
            <button
              ...api().getNextTriggerProps()
              data-slot="date-picker-next-trigger"
              class=styles.navTrigger
            >
              <Icon name="ChevronRight"/>
              <span class=styles.srOnly>Next</span>
            </button>
          </div>
          <table ...api().getTableProps() data-slot="date-picker-table" class=styles.table>
            <thead ...api().getTableHeadProps() data-slot="date-picker-table-head">
              <tr>
                <for|weekDay| of=api().weekDays>
                  <th class=styles.tableHeadCell>
                    ${weekDay.narrow}
                    <span class=styles.srOnly>${weekDay.long}</span>
                  </th>
                </for>
              </tr>
            </thead>
            <tbody ...api().getTableBodyProps() data-slot="date-picker-table-body">
              <for|week, i| of=weeks() by=(_, i) => `week:${i}`>
                <tr>
                  <for|day, j| of=week by=(_, j) => `day:${j}`>
                    <td
                      ...day.cell
                      data-slot="date-picker-cell"
                      class=styles.cell
                    >
                      <button
                        ...day.trigger
                        data-slot="date-picker-day"
                        class=styles.day
                      >
                        ${day.label}
                      </button>
                    </td>
                  </for>
                </tr>
              </for>
            </tbody>
          </table>
        </div>
      </div>
    </if>
  </zag-portal>
</div>

<return=api>
