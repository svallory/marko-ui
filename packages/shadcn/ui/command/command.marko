import * as commandMachine from "@zag-js/combobox";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { command as styles } from "./classes.ts";

// Upstream's `CommandDialog` is a THIN separate wrapper function — not part
// of `Command` itself — that composes `<Dialog><DialogContent
// className="cn-command-dialog top-1/3 translate-y-0 overflow-hidden p-0">
// <Command/></DialogContent></Dialog>` with a sr-only title/description.
// Dialog is being re-baselined concurrently by another agent (see
// rebaseline-fleet-brief.md), so that composition is NOT wired up here to
// avoid depending on its in-flight shape. Consumers get the same result by
// composing it themselves against the shipped `Dialog` component:
//
// check-classes: this component is now migrated to classes.ts. Two of its
// checks are both whole-file and comment-blind: check-classes.ts's
// class-context scan (contract point 3, "no string literal in a class
// position") matches the literal two-character sequence "class" then "="
// then a quote ANYWHERE in the file, and merge-classes.ts's per-style
// hollow-registry guard (contract point 6) throws if any non-allowlisted
// mu-* token survives anywhere in the file. This comment used to compose an
// example of a CONSUMER wiring up upstream's CommandDialog wrapper against
// the shipped Dialog component, spelled as literal markup with that
// attribute and the reserved token — which trips both checks now that this
// file has a classes.ts, even though the example is prose describing
// caller code, not this file's own template. So it is described in words
// instead of markup below, and the reserved class string itself was moved
// into classes.ts's `dialog` export (see that file's own comment) — the
// only place left it can legally exist; check-anchors.ts's mu- stem scan
// covers classes.ts too, so parity with the upstream `cn-command-dialog`
// hook still holds.
//
// The consumer renders a Dialog whose close button is hidden, giving it the
// class string from classes.ts's `dialog` export; wraps a title attr tag
// reading "Command Palette" and a description attr tag reading "Search for
// a command to run...", both styled screen-reader-only; and nests a Command
// with its groups prop set.

export interface CommandItem {
  value: string;
  label: string;
  shortcut?: string;
}

export interface CommandGroup {
  label: string;
  items: CommandItem[];
}

// `collection`, `value`, and `inputValue` are machine-owned in
// combobox.Props but this component derives its own collection from
// `groups` and manages the search query internally, so they are omitted
// here rather than exposed on the public Input.
export type Input = Omit<
  MachineInput<"div", commandMachine.Props>,
  "collection" | "value" | "inputValue"
> & {
  groups: CommandGroup[];
  valueChange?: (value: string) => void;
};

static function filterGroups(groups: CommandGroup[], query: string): CommandGroup[] {
  const normalizedQuery = query.trim().toLowerCase();
  if (!normalizedQuery) return groups;
  return groups
    .map((group) => ({
      ...group,
      items: group.items.filter((item) => item.label.toLowerCase().includes(normalizedQuery)),
    }))
    .filter((group) => group.items.length > 0);
}

<let/query=""/>
<const/filteredGroups=filterGroups(input.groups, query)/>
<const/allItems=filteredGroups.flatMap((group) => group.items)/>

// `collection` is machine-owned but derived from `groups`/`query`, not a
// pass-through of `input`, so it is built here and merged in via `props=`
// rather than passed as a plain tag-input override — a Zag collection
// carries methods that would fail serialization if it crossed that boundary.
<zag/api=() => commandMachine from=input props=(picked) => ({
  ...picked,
  collection: commandMachine.collection({
    items: allItems,
    itemToValue: (item: CommandItem) => item.value,
    itemToString: (item: CommandItem) => item.label,
  }),
})
  open=true
  inputBehavior="autohighlight"
  selectionBehavior="clear"
  onInputValueChange(details: commandMachine.InputValueChangeDetails) {
    input.onInputValueChange?.(details);
    query = details.inputValue;
  }
  onValueChange(details: commandMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    if (details.value[0] != null) {
      input.valueChange?.(details.value[0]);
    }
  }
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    commandMachine.splitProps(input)[1],
    "class",
    "groups",
    "valueChange",
  )
>

<div ...nativeAttrs() ...api().getRootProps() data-slot="command" class=cn(styles.root, input.class)>
  <div data-slot="command-input-wrapper" class=styles.inputWrapper>
    <div ...api().getControlProps() data-slot="command-input-group" class=styles.inputGroup>
      <input
        ...api().getInputProps()
        data-slot="command-input"
        placeholder=input.placeholder
        class=styles.input
      />
      <div data-slot="command-input-addon" class=styles.inputAddon>
        <Icon name="Search" data-slot="command-input-icon" class=styles.inputIcon/>
      </div>
    </div>
  </div>
  <div ...api().getContentProps() data-slot="command-list" class=styles.list>
    <if=(allItems.length === 0)>
      <div data-slot="command-empty" class=styles.empty>No results found.</div>
    </if>
    <else>
      <for|group, groupIndex| of=filteredGroups>
        <if=(groupIndex > 0)>
          <div data-slot="command-separator" class=styles.separator></div>
        </if>
        <div ...api().getItemGroupProps({ id: `group-${groupIndex}` }) data-slot="command-group" class=styles.group>
          <div ...api().getItemGroupLabelProps({ htmlFor: `group-${groupIndex}` }) cmdk-group-heading="">
            ${group.label}
          </div>
          <for|item| of=group.items>
            <div
              ...api().getItemProps({ item })
              data-slot="command-item"
              class=styles.item
            >
              <span>${item.label}</span>
              <if=item.shortcut>
                <span data-slot="command-shortcut" class=styles.shortcut>${item.shortcut}</span>
              </if>
              <Icon
                name="Check"
                data-slot="command-item-indicator"
                class=styles.itemIndicator
              />
            </div>
          </for>
        </div>
      </for>
    </else>
  </div>
</div>

<return=api>
