import * as toggleGroupMachine from "@zag-js/toggle-group";
import { mergeProps, type MachineInput } from "marko-zag";
import { toggleVariants, type ToggleVariants } from "../toggle/variants.ts";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export interface ToggleGroupItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface ToggleGroupItemAttrs {
  value: string;
  disabled?: boolean;
  content?: Marko.Body;
}

// Dual API: compound attr tags (`<@item>`) are the primary, Marko-idiomatic
// form; `items=` remains as sugar for the data-driven case. If both are
// supplied, attr tags win (see agent/reports/compound-tag-dx.md).
//
// `spacing`/`orientation` mirror upstream's ToggleGroupContext defaults
// (spacing=2, orientation="horizontal"); zag's own `orientation` prop drives
// keyboard nav, so it is read back out of the resolved machine props rather
// than duplicated.
export type Input = MachineInput<"div", toggleGroupMachine.Props> &
  ToggleVariants & {
    items?: ToggleGroupItem[];
    item?: Marko.AttrTag<ToggleGroupItemAttrs>;
    spacing?: number;
    valueChange?: (value: string[]) => void;
  };

// Normalize BOTH sources into ONE explicit common shape (mirrors
// radio-group.marko) so the render path below never branches on the source
// and needs no casts: `content` carries the attr-tag markup body, `label`
// the items= string fallback. Attr tags win if both are present.
<const/itemTags=[...(input.item ?? [])].map((item) => ({ value: item.value, disabled: item.disabled, label: undefined as string | undefined, content: item.content }))/>
<const/items=(itemTags.length > 0 ? itemTags : (input.items ?? []).map((item) => ({ value: item.value, disabled: item.disabled, label: item.label as string | undefined, content: undefined as Marko.Body | undefined })))/>

<machine-props/machineProps from=input pick=toggleGroupMachine.props
  onValueChange(details: toggleGroupMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => toggleGroupMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  toggleGroupMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    toggleGroupMachine.splitProps(input)[1],
    "class",
    "items",
    "item",
    "variant",
    "size",
    "spacing",
    "valueChange",
  )
>

<const/spacing=input.spacing ?? 2/>

<div
  ...nativeAttrs()
  ...mergeProps(api().getRootProps(), { style: { "--gap": spacing } })
  data-slot="toggle-group"
  data-variant=(input.variant ?? "default")
  data-size=(input.size ?? "default")
  data-spacing=spacing
  class=cn(
    "mu-toggle-group group/toggle-group flex w-fit flex-row items-center gap-[--spacing(var(--gap))] data-vertical:flex-col data-vertical:items-stretch",
    input.class
  )
>
  <for|item| of=items by=(item) => item.value>
    <button
      ...api().getItemProps({ value: item.value, disabled: item.disabled })
      data-slot="toggle-group-item"
      data-variant=(input.variant ?? "default")
      data-size=(input.size ?? "default")
      data-spacing=spacing
      class=cn(
        "mu-toggle-group-item shrink-0 focus:z-10 focus-visible:z-10 group-data-horizontal/toggle-group:data-[spacing=0]:data-[variant=outline]:border-l-0 group-data-vertical/toggle-group:data-[spacing=0]:data-[variant=outline]:border-t-0 group-data-horizontal/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-l group-data-vertical/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-t",
        toggleVariants({ variant: input.variant, size: input.size })
      )
    >
      <if=item.content>
        <${item.content}/>
      </if>
      <else>
        ${item.label}
      </else>
    </button>
  </for>
</div>

<return=api>
