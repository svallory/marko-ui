// Full color picker built on the REAL @zag-js/color-picker machine:
// saturation/brightness area, channel sliders, channel inputs, eyedropper,
// format switching and swatch presets.
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as colorPickerMachine from "@zag-js/color-picker";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { colorPicker as styles } from "./classes.ts";

export type Input = Omit<
  MachineInput<"div", colorPickerMachine.Props>,
  "value" | "defaultValue"
> & {
  /** Color value — a CSS color string or a Zag `Color` object. */
  value?: string | colorPickerMachine.Color;
  /** Initial color value — a CSS color string or a Zag `Color` object. */
  defaultValue?: string | colorPickerMachine.Color;
  /** Sugar for onValueChange — receives the color as a string, enables `value:=state`. */
  valueChange?: (valueAsString: string) => void;
  /** Sugar for onValueChangeEnd — fires when the user stops dragging. */
  valueChangeEnd?: (valueAsString: string) => void;
  /** Sugar for onOpenChange — receives the plain boolean, enables `open:=state`. */
  openChange?: (open: boolean) => void;
  /** Sugar for onFormatChange — receives the plain format. */
  formatChange?: (format: colorPickerMachine.ColorFormat) => void;
  /** Visible label rendered above the control. */
  label?: Marko.Body;
  /** Preset swatch colors rendered under the channel inputs. */
  swatches?: string[];
  /** Hide the eyedropper button even where the browser supports it. */
  hideEyeDropper?: boolean;
  /** Hide the format select shown next to the channel inputs. */
  hideFormatSelect?: boolean;
};

static const FORMATS = ["rgba", "hsla", "hsba"] as const;

// Which channel inputs to render for the active format. `hex` + `alpha` is the
// compact default the shadcn visual language wants; the other formats expose
// their three numeric channels plus alpha.
static const CHANNELS_BY_FORMAT: Record<string, string[]> = {
  rgba: ["hex", "alpha"],
  hsla: ["hue", "saturation", "lightness", "alpha"],
  hsba: ["hue", "saturation", "brightness", "alpha"],
};

// `value`/`defaultValue` are widened to accept CSS color strings, but the
// machine only understands `Color` objects — and a `Color` may never cross tag
// input (it is not Marko-serializable). Parsing therefore happens INSIDE this
// props closure, which <zag> calls rather than serializes.
// The keys must be OMITTED rather than set to undefined when unset: the
// machine spreads the caller's props over its own defaults, so an explicit
// `defaultValue: undefined` would clobber Zag's DEFAULT_COLOR and crash.
<zag/api=() => colorPickerMachine from=input props=(picked) => {
  const resolved: Record<string, unknown> = { ...picked };
  for (const key of ["value", "defaultValue"]) {
    const raw = resolved[key];
    if (raw === undefined) delete resolved[key];
    else if (typeof raw === "string") resolved[key] = colorPickerMachine.parse(raw);
  }
  return resolved;
}
  onValueChange(details: colorPickerMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.valueAsString);
  }
  onValueChangeEnd(details: colorPickerMachine.ValueChangeDetails) {
    input.onValueChangeEnd?.(details);
    input.valueChangeEnd?.(details.valueAsString);
  }
/>

// Whatever is neither machine-owned (splitProps) nor component-owned passes
// through to the hidden input: aria-*, data-*, form attributes... Leaking a
// component-owned prop here would stringify it into a bogus DOM attribute.
// `value`/`defaultValue` are deliberately widened to `string | Color` on this
// component's public Input (callers may pass a CSS color string), so `input` does not
// satisfy `splitProps`'s `Partial<ColorPickerProps>` constraint. It is a
// Both are machine-owned keys that `splitProps` would strip from the leftover
// anyway — drop them first and the call type-checks on the keys it partitions.
<const/splitSource=() => {
  const { value, defaultValue, ...rest } = input;
  return rest;
}/>
<const/nativeAttrs=() =>
  stripOwnProps(
    colorPickerMachine.splitProps(splitSource())[1],
    "class",
    "valueChange",
    "valueChangeEnd",
    "openChange",
    "formatChange",
    "label",
    "swatches",
    "hideEyeDropper",
    "hideFormatSelect",
  )
>

<const/channels=() => CHANNELS_BY_FORMAT[api().format] ?? CHANNELS_BY_FORMAT.rgba>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="color-picker"
  class=cn(styles.root, input.class)
>
  <if=input.label>
    <label
      ...api().getLabelProps()
      data-slot="color-picker-label"
      class=styles.label
    >
      <${input.label}/>
    </label>
  </if>

  <div
    ...api().getControlProps()
    data-slot="color-picker-control"
    class=styles.control
  >
    // Render-prop-free trigger: this button IS the swatch, so it owns no
    // caller content and cannot nest another button.
    <button
      ...api().getTriggerProps()
      data-slot="color-picker-trigger"
      class=styles.trigger
    >
      <div ...api().getTransparencyGridProps({ size: "8px" }) data-slot="color-picker-transparency-grid"/>
      <div
        ...api().getSwatchProps({ value: api().value })
        data-slot="color-picker-swatch"
        class=styles.triggerSwatch
      />
    </button>
    <span
      ...api().getValueTextProps()
      data-slot="color-picker-value-text"
      class=styles.valueText
    >
      ${api().valueAsString}
    </span>
  </div>

  <input ...api().getHiddenInputProps()>

  <zag-portal>
    <if=api().open>
      <div ...api().getPositionerProps() style=positionerStyle data-slot="color-picker-positioner">
        <div
          ...api().getContentProps()
          data-slot="color-picker-content"
          class=styles.content
        >
          // Zag owns the gradient/position styles on the area parts — no style
          // attribute of our own may go on them.
          <div
            ...api().getAreaProps()
            data-slot="color-picker-area"
            class=styles.area
          >
            <div
              ...api().getAreaBackgroundProps()
              data-slot="color-picker-area-background"
              class=styles.areaBackground
            />
            <div
              ...api().getAreaThumbProps()
              data-slot="color-picker-area-thumb"
              class=styles.areaThumb
            />
          </div>

          <div class=styles.row>
            <if=!input.hideEyeDropper>
              <button
                ...api().getEyeDropperTriggerProps()
                data-slot="color-picker-eye-dropper-trigger"
                class=styles.eyeDropperTrigger
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class=styles.eyeDropperIcon
                >
                  <path d="m2 22 1-1h3l9-9"/>
                  <path d="M3 21v-3l9-9"/>
                  <path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z"/>
                </svg>
              </button>
            </if>

            <div class=styles.channelSlidersWrapper>
              <div
                ...api().getChannelSliderProps({ channel: "hue", format: "hsla" })
                data-slot="color-picker-channel-slider"
                class=styles.channelSlider
              >
                <div
                  ...api().getChannelSliderTrackProps({ channel: "hue", format: "hsla" })
                  data-slot="color-picker-channel-slider-track"
                  class=styles.channelSliderTrack
                />
                <div
                  ...api().getChannelSliderThumbProps({ channel: "hue", format: "hsla" })
                  data-slot="color-picker-channel-slider-thumb"
                  class=styles.channelSliderThumb
                />
              </div>
              <div
                ...api().getChannelSliderProps({ channel: "alpha" })
                data-slot="color-picker-channel-slider"
                class=styles.channelSlider
              >
                <div ...api().getTransparencyGridProps({ size: "8px" }) data-slot="color-picker-transparency-grid" class=styles.transparencyGridRounded/>
                <div
                  ...api().getChannelSliderTrackProps({ channel: "alpha" })
                  data-slot="color-picker-channel-slider-track"
                  class=styles.channelSliderTrack
                />
                <div
                  ...api().getChannelSliderThumbProps({ channel: "alpha" })
                  data-slot="color-picker-channel-slider-thumb"
                  class=styles.channelSliderThumb
                />
              </div>
            </div>
          </div>

          <div class=styles.row>
            <if=!input.hideFormatSelect>
              <select
                ...api().getFormatSelectProps()
                data-slot="color-picker-format-select"
                class=styles.formatSelect
              >
                <for|format| of=FORMATS>
                  <option value=format>${format.toUpperCase()}</option>
                </for>
              </select>
            </if>
            <for|channel| of=channels()>
              <div class=styles.channelInputWrapper>
                <input
                  ...api().getChannelInputProps({
                    channel: channel as colorPickerMachine.ExtendedColorChannel,
                  })
                  data-slot="color-picker-channel-input"
                  class=styles.channelInput
                >
                <span class=styles.channelInputLabel>
                  ${channel === "hex" ? "hex" : channel.slice(0, 1)}
                </span>
              </div>
            </for>
          </div>

          <if=input.swatches?.length>
            <div
              ...api().getSwatchGroupProps()
              data-slot="color-picker-swatch-group"
              class=styles.swatchGroup
            >
              <for|swatchValue| of=input.swatches ?? []>
                <button
                  ...api().getSwatchTriggerProps({ value: swatchValue })
                  data-slot="color-picker-swatch-trigger"
                  class=styles.swatchTrigger
                >
                  <div
                    ...api().getSwatchProps({ value: swatchValue })
                    data-slot="color-picker-swatch"
                    class=styles.swatch
                  >
                    <div
                      ...api().getSwatchIndicatorProps({ value: swatchValue })
                      data-slot="color-picker-swatch-indicator"
                      class=styles.swatchIndicator
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class=styles.swatchIndicatorIcon
                      >
                        <path d="M20 6 9 17l-5-5"/>
                      </svg>
                    </div>
                  </div>
                </button>
              </for>
            </div>
          </if>
        </div>
      </div>
    </if>
  </zag-portal>
</div>

<return=api>
