// Reference implementation of a marko-ui component.
// Guide: /docs/creating-components · adapter internals: /docs/zag-adapter
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as stepsMachine from "@zag-js/steps";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { steps as styles } from "./classes.ts";

export interface StepItem {
  title: string;
  description?: string;
}

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `stepChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<Steps step:=myState/>); Zag's own `onStepChange` also works and
// receives the details object.
export type Input = MachineInput<"div", stepsMachine.Props> & {
  items: StepItem[];
  content?: Marko.Body<[number]>;
  completedContent?: Marko.Body;
  stepChange?: (step: number) => void;
};

<const/{ items, content, completedContent }=input/>

// <zag> wires the machine in one tag and returns `api` as a GETTER —
// call it at every use site. Getters are the serializable currency of
// Marko's resumability: the api object itself must never become reactive
// state. See /docs/creating-components.
<zag/api=() => stepsMachine from=input
  count=input.count ?? items.length
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, items, content, completedContent, stepChange) passes through to
// the root div.
<const/nativeAttrs=() =>
  stripOwnProps(
    stepsMachine.splitProps(input)[1],
    "class",
    "items",
    "content",
    "completedContent",
    "stepChange",
  )
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="steps"
  class=cn(styles.root, input.class)
>
  <div ...api().getListProps() data-slot="steps-list" class=styles.list>
    <for|item, index| of=items>
      <const/itemState=api().getItemState({ index })>
      // The item wrapper sits between the tablist and its tabs, which ARIA
      // forbids unless the wrapper is presentational. Zag also puts
      // aria-current on this wrapper, but a global aria attribute would void
      // role="presentation" (presentational-roles conflict resolution), so
      // aria-current moves onto the tab trigger instead.
      // No `as Record<string, unknown>`: that cast erased `aria-current` to
      // `unknown`, which then failed to satisfy the <button>'s real
      // `aria-current` union. Zag's own prop type already carries it.
      <const/itemProps=(() => {
        const { "aria-current": ariaCurrent, ...rest } = api().getItemProps({ index });
        return { rest, ariaCurrent };
      })()>
      <div ...itemProps.rest role="presentation" data-slot="steps-item" class=styles.item>
        <button
          ...api().getTriggerProps({ index })
          aria-current=itemProps.ariaCurrent
          data-slot="steps-trigger"
          class=styles.trigger
        >
          <div
            ...api().getIndicatorProps({ index })
            data-slot="steps-indicator"
            class=styles.indicator
          >
            <if=itemState.completed>
              // The shared <Icon> hardcodes the lucide wrapper's stroke-width
              // of 2; this indicator has always been drawn at 2.5, so the
              // override rides in as a Tailwind arbitrary property on `class`
              // (a `stroke-width=` attribute would be clobbered — icon.marko
              // spreads `...rest` BEFORE its own stroke-width attribute).
              // Same approach as checkbox.marko's indicator.
              <Icon name="Check" class=styles.indicatorIcon/>
            </if>
            <else>
              ${index + 1}
            </else>
          </div>
          <span class=styles.labelWrapper>
            <span class=cn(styles.title, itemState.incomplete && styles.titleIncomplete)>
              ${item.title}
            </span>
            <if=item.description>
              <span class=styles.description>${item.description}</span>
            </if>
          </span>
        </button>
        <div ...api().getSeparatorProps({ index }) data-slot="steps-separator" class=styles.separator/>
      </div>
    </for>
  </div>

  <div class=styles.contentWrapper>
    <for|item, index| of=items>
      <div ...api().getContentProps({ index }) data-slot="steps-content">
        <${content}(index)/>
      </div>
    </for>
    <div ...api().getContentProps({ index: items.length }) data-slot="steps-completed-content">
      <${completedContent}/>
    </div>

    <div data-slot="steps-actions" class=styles.actions>
      <button
        ...api().getPrevTriggerProps()
        data-slot="steps-prev-trigger"
        class=styles.prevTrigger
      >
        Previous
      </button>
      <button
        ...api().getNextTriggerProps()
        data-slot="steps-next-trigger"
        class=styles.nextTrigger
      >
        Next
      </button>
    </div>
  </div>
</div>

// Parents can receive the api getter: <Steps/stepsApi/> then
// `stepsApi().value` — it stays live across machine updates.
<return=api>
