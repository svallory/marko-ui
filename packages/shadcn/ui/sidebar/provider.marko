import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  /** Controlled open state. Uncontrolled default: true. */
  open?: boolean;
  openChange?: (open: boolean) => void;
  /** CSS length for --sidebar-width, default 16rem. */
  width?: string;
  /** CSS length for --sidebar-width-icon, default 3rem. */
  widthIcon?: string;
  /** Sidebar panel content (header/content/footer parts). */
  sidebar?: Marko.Body<[{ open: boolean; toggle: () => void }]>;
  /** Main content area, rendered next to the sidebar. */
  main?: Marko.Body<[{ open: boolean; toggle: () => void }]>;
}

<let/open=input.open ?? true/>
<script>
  if (input.open !== undefined) open = input.open;
</script>
<const/{
  open: _open,
  openChange,
  width,
  widthIcon,
  sidebar,
  class: className,
  main,
  ...rest
}=input/>

<const/toggle=() => {
  open = !open;
  openChange?.(open);
}/>

<div
  ...rest
  data-slot="sidebar-wrapper"
  style={
    "--sidebar-width": width ?? "16rem",
    "--sidebar-width-icon": widthIcon ?? "3rem",
  }
  class=cn("group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar", className)
>
  <if=sidebar>
    <${sidebar}({ open, toggle })/>
  </if>
  <if=main>
    <${main}({ open, toggle })/>
  </if>
</div>
