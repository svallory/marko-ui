import * as select from "@zag-js/select";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

export interface SelectItem {
  value: string;
  label: string;
  disabled?: boolean;
}

// Optional grouping — mirrors command.marko's group shape. When `groups` is
// given it drives rendering instead of the flat `items`/`option` lists; the
// generated `collection` is still built from the flattened item set (zag has
// no native group concept — see select.props.mjs — so grouping is display
// only, matching the shadcn bases-radix `SelectGroup`/`SelectLabel` slots).
export interface SelectGroup {
  label: string;
  items: SelectItem[];
}

// `items`/`value` are narrowed vs. the raw machine Props: `items` drives the
// generated `collection`, and `value` is typed as the plain string[] the
// caller works with (the machine's own `value` type matches already).
//
// `option` is the attr-tag compound API (flat: no per-item render-prop needed
// since select items are plain strings today). When present it is normalized
// into the same SelectItem[] shape `items` already uses, and that normalized
// array feeds buildCollection/serviceProps and both <for> loops unchanged —
// `items=` keeps working as-is for the data-driven case.
export type Input = Omit<MachineInput<"div", select.Props<SelectItem>>, "collection"> & {
  items?: SelectItem[];
  groups?: SelectGroup[];
  option?: Marko.AttrTag<SelectItem>;
  valueChange?: (value: string[]) => void;
  placeholder?: string;
  /** Field label rendered above the trigger (NOT the shadcn listbox group
   * label — see `select-label` note on the group label below). */
  label?: string;
  size?: "default" | "sm";
};

<const/{ placeholder, label, size, class: className }=input/>
<const/optionTags=[...(input.option ?? [])]/>
<const/groups=input.groups/>
<const/items=(optionTags.length > 0 ? optionTags : groups ? groups.flatMap((g) => g.items) : (input.items ?? []))/>

<const/buildCollection=(list: SelectItem[]) =>
  select.collection({
    items: list,
    itemToValue: (item: SelectItem) => item.value,
    itemToString: (item: SelectItem) => item.label,
    isItemDisabled: (item: SelectItem) => !!item.disabled,
  })
/>

<machine-props/machineProps from=input pick=select.props
  onValueChange(details: select.ValueChangeDetails<SelectItem>) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
// `collection` is derived state (rebuilt whenever `items` changes), not a
// plain input field, so it cannot be picked/overridden inside <machine-props>
// (that tag's overrides are evaluated eagerly at the tag-input boundary).
// Wrap machineProps in a closure that layers it in for <service>.
<const/serviceProps=() => ({ ...machineProps(), collection: buildCollection(items) })/>
<service/service machine=() => select.machine props=serviceProps/>
<connect/api=(service, normalizeProps) =>
  select.connect(service, normalizeProps)
  service=service
/>

<const/scrollViewport=(e: Event, delta: number) => {
  const target = e.currentTarget as HTMLElement;
  const viewport = target.closest("[data-slot='select-content']")?.querySelector<HTMLElement>("[data-slot='select-viewport']");
  viewport?.scrollBy({ top: delta, behavior: "smooth" });
}>

<const/nativeAttrs=() => {
  const {
    class: ownClass,
    valueChange: ownChangeHandler,
    items: ownItems,
    groups: ownGroups,
    option: ownOption,
    placeholder: ownPlaceholder,
    label: ownLabel,
    size: ownSize,
    ...native
  } = select.splitProps(input)[1];
  return native;
}>

<div ...nativeAttrs() ...api().getRootProps() data-slot="select" class=cn(className)>
  // RULE 9 TRAP: upstream `select-label` is the LISTBOX GROUP LABEL rendered
  // inside the content (see `<div data-slot="select-label">` further below,
  // under each group). This element is OUR field label above the trigger —
  // same concept shadcn's `Field`/`Label` primitives cover elsewhere, not
  // the thing upstream's `mu-select-label` hook targets. It intentionally
  // carries NO mu- anchor (an unstyled `select-field-label` slot) so it
  // never collides with the group-label anchor reserved below.
  <if=label>
    <label ...api().getLabelProps() data-slot="select-field-label" class="text-sm font-medium">${label}</label>
  </if>
  <else>
    <label ...api().getLabelProps() data-slot="select-field-label" class="sr-only">${placeholder || "Select an option"}</label>
  </else>
  <div ...api().getControlProps() data-slot="select-control">
    <button
      ...api().getTriggerProps()
      data-slot="select-trigger"
      data-size=(size ?? "default")
      class="mu-select-trigger flex w-fit items-center justify-between whitespace-nowrap outline-none disabled:cursor-not-allowed disabled:opacity-50 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center [&_svg]:pointer-events-none [&_svg]:shrink-0"
    >
      <span data-slot="select-value">${api().valueAsString || placeholder}</span>
      <svg ...api().getIndicatorProps() xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mu-select-trigger-icon pointer-events-none">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>
  </div>
  <select ...api().getHiddenSelectProps() data-slot="select-hidden-select">
    <for|entry| of=items>
      <option value=entry.value disabled=entry.disabled>${entry.label}</option>
    </for>
  </select>
  <portal>
    <if=api().open>
      <div ...api().getPositionerProps() data-slot="select-positioner" style=positionerStyle>
        <div
          ...api().getContentProps()
          data-slot="select-content"
          class="mu-select-content mu-menu-target mu-menu-translucent relative z-50 max-h-(--available-height) overflow-x-hidden overflow-y-auto origin-(--transform-origin) data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[side=bottom]:translate-y-1 data-[side=left]:-translate-x-1 data-[side=right]:translate-x-1 data-[side=top]:-translate-y-1"
        >
          <button type="button" data-slot="select-scroll-up-button" class="mu-select-scroll-up-button" on-click(e: Event) { scrollViewport(e, -40); }>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
              <path d="m18 15-6-6-6 6"/>
            </svg>
          </button>
          <div data-slot="select-viewport" class="mu-select-viewport">
            <if=groups>
              <for|group, groupIndex| of=groups>
                <div data-slot="select-group" class="mu-select-group">
                  <div ...api().getItemGroupLabelProps({ htmlFor: `group-${groupIndex}` }) data-slot="select-label" class="mu-select-label">${group.label}</div>
                  <for|entry| of=group.items>
                    <div
                      ...api().getItemProps({ item: entry })
                      data-slot="select-item"
                      class="mu-select-item relative flex w-full cursor-default items-center outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
                    >
                      <span ...api().getItemIndicatorProps({ item: entry }) data-slot="select-item-indicator" class="mu-select-item-indicator">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mu-select-item-indicator-icon pointer-events-none">
                          <path d="M20 6 9 17l-5-5"/>
                        </svg>
                      </span>
                      <span ...api().getItemTextProps({ item: entry }) data-slot="select-item-text">${entry.label}</span>
                    </div>
                  </for>
                </div>
                <if=(groupIndex < groups.length - 1)>
                  <div data-slot="select-separator" class="mu-select-separator pointer-events-none"></div>
                </if>
              </for>
            </if>
            <else>
              <for|entry| of=items>
                <div
                  ...api().getItemProps({ item: entry })
                  data-slot="select-item"
                  class="mu-select-item relative flex w-full cursor-default items-center outline-hidden select-none data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
                >
                  <span ...api().getItemIndicatorProps({ item: entry }) data-slot="select-item-indicator" class="mu-select-item-indicator">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mu-select-item-indicator-icon pointer-events-none">
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  </span>
                  <span ...api().getItemTextProps({ item: entry }) data-slot="select-item-text">${entry.label}</span>
                </div>
              </for>
            </else>
          </div>
          <button type="button" data-slot="select-scroll-down-button" class="mu-select-scroll-down-button" on-click(e: Event) { scrollViewport(e, 40); }>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </if>
  </portal>
</div>

<script>
  // Restore keyboard control when the listbox is opened BY MOUSE.
  //
  // Zag's `setInitialFocus` is an ACTION that schedules its DOM read with a
  // single `raf()`. Every framework adapter Zag ships renders synchronously on
  // a state write, so the content element exists by that frame. Marko batches:
  // the machine's `notify()` bumps its rev on a microtask and the render lands
  // a frame later, so on the mouse path Zag's raf fires while the content is
  // still absent (verified live: Zag's raf at +350ms with content=null, content
  // mounts at +399ms). `element?.focus()` then no-ops, focus stays on the
  // trigger, and arrow keys do nothing. The keyboard path happens to win the
  // race because its keydown route reaches the machine a tick later.
  //
  // Reading `api().open` makes this block re-run on every open/close. The
  // double rAF matches the deferral marko-ui already applies to machine
  // effects, which is the point at which the portalled content is committed.
  const isOpen = api().open;
  if (isOpen) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const content = document.getElementById(api().getContentProps().id);
        // Only intervene if Zag's own attempt lost the race; never steal focus
        // from an element inside the content the user has already reached.
        if (!content || content.contains(document.activeElement)) return;
        // Mirrors @zag-js/dom-query getInitialFocus(): an explicit autofocus
        // target wins, otherwise the content itself (it carries tabindex=0 and
        // select items are intentionally not tabbable).
        const target = content.querySelector<HTMLElement>("[data-autofocus],[autofocus]") ?? content;
        target.focus({ preventScroll: true });
      });
    });
  }
</script>

<return=api>
