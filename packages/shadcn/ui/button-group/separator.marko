import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div"> {
  orientation?: "horizontal" | "vertical";
}

<const/{ orientation = "vertical", class: className, content, ...rest }=input/>

<div
  data-slot="button-group-separator"
  role="separator"
  data-orientation=orientation
  ...rest
  class=cn(
    "mu-button-group-separator relative self-stretch data-[orientation=horizontal]:mx-px data-[orientation=horizontal]:w-auto data-[orientation=vertical]:my-px data-[orientation=vertical]:h-auto",
    className,
  )
>
  <${content}/>
</div>
