import { markerVariants, type MarkerVariants } from "./variants.ts";
import { cn } from "#lib/utils.ts";

export interface Input extends Marko.Input<"div">, MarkerVariants {
  /**
   * shadcn's source renders via Radix `Slot.Root` when `asChild` is set, so
   * the marker's own attrs/class merge onto the single child element instead
   * of wrapping it in a `<div>`. Marko has no equivalent runtime slot-merge
   * primitive, so `asChild` is accepted for API parity but is a no-op here:
   * we always render the wrapping `<div>`. Content still renders normally.
   */
  asChild?: boolean;
}

<const/{ variant = "default", class: className, asChild, content, ...rest }=input/>

<div
  data-slot="marker"
  data-variant=variant
  class=cn(markerVariants({ variant, className }))
  ...rest
>
  <${content}/>
</div>
