import * as pinInputMachine from "@zag-js/pin-input";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

// MachineInput = native <div> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `valueChange` and
// `valueCompleteChange` are additive sugar enabling Marko's two-way bind
// shorthand; Zag's own `onValueChange`/`onValueComplete` also work and
// receive the details object.
export type Input = MachineInput<"div", pinInputMachine.Props> & {
  valueChange?: (value: string[]) => void;
  valueCompleteChange?: (value: string[]) => void;
  groupSize?: number;
  // Sugar alias for the machine's `count` prop.
  length?: number;
};

<machine-props/machineProps from=input pick=pinInputMachine.props
  count=input.count ?? input.length
  onValueChange(details: pinInputMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }
  onValueComplete(details: pinInputMachine.ValueChangeDetails) {
    input.onValueComplete?.(details);
    input.valueCompleteChange?.(details.value);
  }/>
<service/service machine=() => pinInputMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  pinInputMachine.connect(service, normalizeProps)
  service=service
/>

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, valueChange, valueCompleteChange, groupSize, length) passes
// through to the root div: aria-*, data-*, form attributes...
<const/nativeAttrs=() =>
  stripOwnProps(
    pinInputMachine.splitProps(input)[1],
    "class",
    "valueChange",
    "valueCompleteChange",
    "groupSize",
    "length",
  )
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="input-otp"
  class=cn("mu-input-otp flex items-center has-disabled:opacity-50", input.class)
>
  <input ...api().getHiddenInputProps()>
  <div data-slot="input-otp-group" class="mu-input-otp-group flex items-center">
    <for|index| of=api().items>
      <if=(input.groupSize && index > 0 && index % input.groupSize === 0)>
        // No inline `[&_svg:not([class*='size-'])]:size-N` here: every style
        // layer's rule for the separator anchor below already carries one
        // (sera 3.5, the other 7 → 4). An inline copy would shadow it on
        // BOTH paths — on the import path by equal-specificity source order,
        // and on the copy path because apply-style-map merges as
        // `twMerge(mapped, original)` so an authored utility beats the
        // injected one. Upstream's InputOTPSeparator likewise carries no
        // classes; all sizing is the style layer's job.
        <div data-slot="input-otp-separator" class="mu-input-otp-separator flex items-center">
          // `unsized`: the style layer sizes this icon through shadcn's
          // `[&_svg:not([class*='size-'])]` hatch, which only reaches an
          // <svg> that has NO size class. Icon's default `size-4` would
          // silently disable it (upstream's lucide-react MinusIcon emits no
          // size class, which is why the hatch works there).
          <Icon name="Minus" unsized/>
        </div>
      </if>
      <div data-slot="input-otp-slot" class="mu-input-otp-slot relative flex items-center justify-center has-focus:z-10">
        <input
          ...api().getInputProps({ index })
          data-slot="input-otp-input"
          class="mu-input-otp-input peer border-input size-9 rounded-md border text-center text-sm shadow-xs outline-none focus:ring-[3px] focus:ring-ring/50 focus:border-ring disabled:cursor-not-allowed caret-transparent"
        />
        <div class="mu-input-otp-caret pointer-events-none absolute inset-0 hidden items-center justify-center peer-[:focus:not([data-filled])]:flex">
          <div class="mu-input-otp-caret-line animate-caret-blink bg-foreground h-4 w-px duration-1000"></div>
        </div>
      </div>
    </for>
  </div>
</div>

// Parents can receive the api getter: <InputOtp/inputOtpApi/> then
// `inputOtpApi().value` — it stays live across machine updates.
<return=api>
