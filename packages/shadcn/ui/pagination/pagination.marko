import * as paginationMachine from "@zag-js/pagination";
import type { MachineInput } from "marko-zag";
import { buttonVariants } from "../button/variants.ts";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"nav", paginationMachine.Props> & {
  pageChange?: (page: number) => void;
};

<machine-props/machineProps from=input pick=paginationMachine.props
  onPageChange(details: paginationMachine.PageChangeDetails) {
    input.onPageChange?.(details);
    input.pageChange?.(details.page);
  }/>
<service/service machine=() => paginationMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  paginationMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() =>
  stripOwnProps(paginationMachine.splitProps(input)[1], "class", "pageChange")
>

<nav
  ...nativeAttrs()
  ...api().getRootProps()
  role="navigation"
  aria-label="pagination"
  data-slot="pagination"
  class=cn("mu-pagination mx-auto flex w-full justify-center", input.class)
>
  <ul data-slot="pagination-content" class="mu-pagination-content flex items-center">
    <li data-slot="pagination-item">
      <button
        ...api().getPrevTriggerProps()
        data-slot="pagination-link"
        aria-label="Go to previous page"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "mu-pagination-link mu-pagination-previous")
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mu-rtl-flip"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="mu-pagination-previous-text hidden sm:block">Previous</span>
      </button>
    </li>
    <for|item, index| of=api().pages by=(item, index) => item.type === "page" ? `page-${item.value}` : `ellipsis-${index}`>
      <if=item.type === "page">
        <const/isActive=item.value === api().page>
        <li data-slot="pagination-item">
          <button
            ...api().getItemProps({ type: "page", value: item.value })
            data-slot="pagination-link"
            aria-current=(isActive ? "page" : undefined)
            data-active=(isActive ? "true" : undefined)
            class=cn(buttonVariants({ variant: isActive ? "outline" : "ghost", size: "icon" }), "mu-pagination-link")
          >
            ${item.value}
          </button>
        </li>
      </if>
      <else>
        <li data-slot="pagination-item">
          <span
            ...api().getEllipsisProps({ index })
            aria-hidden="true"
            data-slot="pagination-ellipsis"
            class="mu-pagination-ellipsis flex items-center justify-center"
          >
            &hellip;
            <span class="sr-only">More pages</span>
          </span>
        </li>
      </else>
    </for>
    <li data-slot="pagination-item">
      <button
        ...api().getNextTriggerProps()
        data-slot="pagination-link"
        aria-label="Go to next page"
        class=cn(buttonVariants({ variant: "ghost", size: "default" }), "mu-pagination-link mu-pagination-next")
      >
        <span class="mu-pagination-next-text hidden sm:block">Next</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mu-rtl-flip"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </li>
  </ul>
</nav>

<return=api>
