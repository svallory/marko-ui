// Built on the REAL @zag-js/drawer machine (drag-to-dismiss, snap points,
// swipe-to-open areas) — not the dialog machine.
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as drawerMachine from "@zag-js/drawer";
import type { MachineInput } from "marko-zag";
import Button from "../button/button.marko";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"div", drawerMachine.Props> & {
  /** Sugar for onOpenChange — receives the plain boolean, enables `open:=state`. */
  openChange?: (open: boolean) => void;
  /** Sugar for onSnapPointChange — receives the plain snap point. */
  snapPointChange?: (snapPoint: drawerMachine.SnapPoint | null) => void;
  /** Sugar for onTriggerValueChange — receives the plain trigger value. */
  triggerValueChange?: (value: string | null) => void;
  /** Render-prop trigger: `<@trigger|props|><Button ...props/></@trigger>`. */
  trigger?: Marko.Body<[Record<string, unknown>]>;
  title?: Marko.Body;
  description?: Marko.Body;
  content?: Marko.Body;
  footer?: Marko.Body;
  /** Hide the vaul-style grab handle (dragging the content body still works). */
  hideGrabber?: boolean;
  /** Whether the content body itself is draggable, or only the grabber. */
  draggable?: boolean;
  /** Render an edge swipe area that opens the drawer by swiping inward. */
  swipeArea?: boolean;
  /** Show the top-right close button. */
  hideCloseTrigger?: boolean;
};

<zag/api=() => drawerMachine from=input
  onTriggerValueChange(details: drawerMachine.TriggerValueChangeDetails) {
    input.onTriggerValueChange?.(details);
    input.triggerValueChange?.(details.value);
  }
/>

// Everything that is neither machine-owned (splitProps) nor component-owned
// passes through to the root wrapper. Leaking a component-owned prop here
// would render it as a bogus DOM attribute.
<const/nativeAttrs=() =>
  stripOwnProps(
    drawerMachine.splitProps(input)[1],
    "class",
    "openChange",
    "snapPointChange",
    "triggerValueChange",
    "trigger",
    "title",
    "description",
    "content",
    "footer",
    "hideGrabber",
    "draggable",
    "swipeArea",
    "hideCloseTrigger",
  )
>

// The machine resolves logical `start`/`end` against `dir`, so the physical
// direction that drives our layout classes must be read back off the api.
<const/contentProps=() => api().getContentProps({ draggable: input.draggable ?? true })>
<const/swipeDirection=() =>
  contentProps()["data-swipe-direction"] as "up" | "down" | "left" | "right">

<div ...nativeAttrs() data-slot="drawer">
  <if=input.trigger>
    <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "drawer-trigger" })/>
  </if>

  <if=input.swipeArea>
    <div
      ...api().getSwipeAreaProps()
      data-slot="drawer-swipe-area"
      class="fixed z-40 data-[swipe-direction=down]:inset-x-0 data-[swipe-direction=down]:bottom-0 data-[swipe-direction=down]:h-6 data-[swipe-direction=up]:inset-x-0 data-[swipe-direction=up]:top-0 data-[swipe-direction=up]:h-6 data-[swipe-direction=left]:inset-y-0 data-[swipe-direction=left]:left-0 data-[swipe-direction=left]:w-6 data-[swipe-direction=right]:inset-y-0 data-[swipe-direction=right]:right-0 data-[swipe-direction=right]:w-6"
    />
  </if>

  // NOTE: upstream shadcn sets data-slot="drawer-portal" on Radix's Portal,
  // which renders a real element. marko-zag's <zag-portal> renders a
  // `display:contents` host and does not forward attributes, so the
  // marker never reached the DOM — it was inert, and nothing in this
  // repo's CSS, tests or tooling reads it. Dropped rather than left as
  // dead markup; restore it if <zag-portal> gains attribute forwarding.
  <zag-portal>
    <if=api().open>
      <div
        ...api().getBackdropProps()
        data-slot="drawer-overlay"
        class="mu-drawer-overlay fixed inset-0 z-50 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0"
      />
      <div
        ...api().getPositionerProps()
        data-slot="drawer-positioner"
        class="fixed inset-0 z-50"
      >
        // No style= attribute on this element, ever: Zag owns its inline
        // transform and every --drawer-* custom property here.
        <div
          ...contentProps()
          data-slot="drawer-content"
          class=cn(
            "mu-drawer-content group/drawer-content fixed z-50 flex outline-none",
            "data-[swipe-direction=down]:inset-x-0 data-[swipe-direction=down]:bottom-0 data-[swipe-direction=down]:mt-24 data-[swipe-direction=down]:max-h-[80vh] data-[swipe-direction=down]:flex-col data-[swipe-direction=down]:sm:mx-auto data-[swipe-direction=down]:sm:max-w-lg",
            "data-[swipe-direction=up]:inset-x-0 data-[swipe-direction=up]:top-0 data-[swipe-direction=up]:mb-24 data-[swipe-direction=up]:max-h-[80vh] data-[swipe-direction=up]:flex-col-reverse data-[swipe-direction=up]:sm:mx-auto data-[swipe-direction=up]:sm:max-w-lg",
            "data-[swipe-direction=left]:inset-y-0 data-[swipe-direction=left]:left-0 data-[swipe-direction=left]:w-3/4 data-[swipe-direction=left]:flex-row-reverse data-[swipe-direction=left]:sm:max-w-sm",
            "data-[swipe-direction=right]:inset-y-0 data-[swipe-direction=right]:right-0 data-[swipe-direction=right]:w-3/4 data-[swipe-direction=right]:flex-row data-[swipe-direction=right]:sm:max-w-sm",
            input.class,
          )
        >
          <if=!input.hideGrabber>
            <div
              ...api().getGrabberProps()
              data-slot="drawer-grabber"
              class="group/grabber shrink-0 cursor-grab touch-none active:cursor-grabbing data-[swipe-direction=down]:flex data-[swipe-direction=down]:justify-center data-[swipe-direction=down]:pt-4 data-[swipe-direction=down]:pb-2 data-[swipe-direction=up]:flex data-[swipe-direction=up]:justify-center data-[swipe-direction=up]:pt-2 data-[swipe-direction=up]:pb-4 data-[swipe-direction=left]:flex data-[swipe-direction=left]:flex-col data-[swipe-direction=left]:justify-center data-[swipe-direction=left]:pr-2 data-[swipe-direction=left]:pl-4 data-[swipe-direction=right]:flex data-[swipe-direction=right]:flex-col data-[swipe-direction=right]:justify-center data-[swipe-direction=right]:pr-4 data-[swipe-direction=right]:pl-2"
            >
              <div
                ...api().getGrabberIndicatorProps()
                data-slot="drawer-grabber-indicator"
                class="mu-drawer-handle bg-muted rounded-full transition-colors group-active/grabber:bg-muted-foreground/40 data-[swipe-direction=down]:h-2 data-[swipe-direction=down]:w-[100px] data-[swipe-direction=up]:h-2 data-[swipe-direction=up]:w-[100px] data-[swipe-direction=left]:h-[100px] data-[swipe-direction=left]:w-2 data-[swipe-direction=right]:h-[100px] data-[swipe-direction=right]:w-2"
              />
            </div>
          </if>

          // Inner column so header/body/footer stack the same way regardless of
          // which axis the outer content flexes along for the grabber.
          <div class="flex min-h-0 min-w-0 flex-1 flex-col">
            <if=input.title || input.description>
              <div
                data-slot="drawer-header"
                class="mu-drawer-header flex flex-col group-data-[swipe-direction=down]/drawer-content:text-center group-data-[swipe-direction=up]/drawer-content:text-center"
              >
                <if=input.title>
                  <h2
                    ...api().getTitleProps()
                    data-slot="drawer-title"
                    class="mu-drawer-title mu-font-heading"
                  >
                    <${input.title}/>
                  </h2>
                </if>
                <if=input.description>
                  <p
                    ...api().getDescriptionProps()
                    data-slot="drawer-description"
                    class="mu-drawer-description"
                  >
                    <${input.description}/>
                  </p>
                </if>
              </div>
            </if>

            <if=input.content>
              <div data-slot="drawer-body" class="min-h-0 flex-1 overflow-auto px-4">
                <${input.content}/>
              </div>
            </if>

            <if=input.footer>
              <div
                data-slot="drawer-footer"
                class="mu-drawer-footer mt-auto flex flex-col gap-2 p-4"
              >
                <${input.footer}/>
              </div>
            </if>
          </div>

          <if=!input.hideCloseTrigger>
            <Button
              ...api().getCloseTriggerProps()
              variant="ghost"
              size="icon-sm"
              data-slot="drawer-close"
              class="absolute top-4 right-4"
            >
              <Icon name="XIcon"/>
              <span class="sr-only">Close</span>
            </Button>
          </if>
        </div>
      </div>
    </if>
  </zag-portal>
</div>

<return=api>
