// Reference implementation: packages/registry/default/ui/switch/switch.marko
// Guide: /docs/creating-components · Authoring rules: v2 pattern
import * as avatarMachine from "@zag-js/avatar";
import type { MachineInput } from "marko-zag";
import { normalizeProps, ssrService } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

// Stateless helper — takes the `<service>` handle and returns a FRESH
// connected api every call, exactly like `<connect>`'s own SSR-fallback
// body. Declared `static` (module-level, no per-instance closure capture)
// so it's a plain helper function rather than a Marko custom tag; see the
// long comment at its call site below for why this exists instead of a
// `<const>`/`<let>`-based mirror.
static function connectFresh(handle: {
  service: Parameters<typeof avatarMachine.connect>[0] | null;
  machine: () => avatarMachine.Machine;
  props: () => Partial<avatarMachine.Props>;
}) {
  return avatarMachine.connect(handle.service ?? ssrService(handle.machine(), handle.props), normalizeProps);
}

export type Input = MachineInput<"span", avatarMachine.Props> & {
  src?: string;
  alt?: string;
  fallback?: string;
  content?: Marko.Body;
  /** Renders an `AvatarBadge` (or any markup) as a root-level sibling of the image/fallback, per upstream's Composition tree — never inside the fallback span. */
  badge?: Marko.Body;
  statusChange?: (status: avatarMachine.LoadStatus) => void;
  /** Size variant — also exposed as `data-size` for group/badge styling. */
  size?: "default" | "sm" | "lg";
};

// The three-tag wiring (see /docs/creating-components):
// 1. <machine-props> picks the machine's props out of `input` by name and
//    merges the attributes written on it — callback adaptations live HERE,
//    visibly, because they are this component's public contract.
// 2. <service> creates and owns the running machine (client-only; SSR
//    renders from a throwaway never-started instance).
// 3. <connect> returns `api` as a GETTER — call it at every use site.
//    Getters are the serializable currency of Marko's resumability: the
//    api object itself must never become reactive state.
<machine-props/machineProps from=input pick=avatarMachine.props
  onStatusChange(details: avatarMachine.StatusChangeDetails) {
    input.onStatusChange?.(details);
    input.statusChange?.(details.status);
  }/>
<service/service machine=() => avatarMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  avatarMachine.connect(service, normalizeProps)
  service=service
/>

// `connectFresh(service)` (declared above, module-level) is called
// everywhere in this component's render tree below in place of `api()`.
// Works around a Marko-core walk-order defect: when this component is
// mounted as `<for>`-loop-captured attr-tag content (e.g. `<@item>`'s
// body in a `<for|person| of=PEOPLE>` loop) that is itself mounted via
// dynamic-tag-content inside an ANCESTOR's own `<portal><if=api().open>`
// (dropdown-menu.marko's `<${entry.content}/>`), walk-time reads of THIS
// component's own `api()` (a `<const>`) fire before `<const/api>`'s own
// deferred signal has ever computed on this freshly-created scope. Same
// root cause and same underlying fix as calendar.marko (see that file's
// longer comment and notes/bug-marko-dynamic-tag-hydration-crash.md for
// the full account of what was tried and ruled out).
//
// CRITICAL: the mirror MUST live entirely OUTSIDE Marko's reactive/
// serialization system. `<let>` (even indirectly, via a `<const>`
// wrapping it) is reactive state Marko attempts to serialize for resume
// — and the connected api is a live object with methods (unserializable
// per the SSR-safe Zag pattern this whole file otherwise follows). A
// `<let>`-held mirror broke SSR outright in dev (`Unable to serialize
// "uiValue" ... (reading setSrc)`) even though it happened to survive a
// production build — a real regression, only caught by running the dev
// server, not a production preview alone. `connectFresh` is a plain
// `static function` (module-level, parameterized — no per-instance
// closure capture, so it isn't Marko reactive state at all) that calls
// `avatarMachine.connect()` directly against the raw service, exactly
// like `<connect>`'s own SSR fallback does. This has no signal/resume
// identity whatsoever: every call recomputes fresh, so there is nothing
// to compute lazily and nothing is ever stored for serialization to trip
// over.

// Whatever is neither machine-owned (splitProps) nor component-owned
// (class, src, alt, fallback, content, statusChange, size) passes through
// to the root span: aria-*, data-*...
<const/nativeAttrs=() =>
  stripOwnProps(
    avatarMachine.splitProps(input)[1],
    "class",
    "src",
    "alt",
    "fallback",
    "content",
    "badge",
    "statusChange",
    "size",
  )
>
<const/size=(input.size ?? "default")>

<span
  data-slot="avatar"
  data-size=size
  ...nativeAttrs()
  ...connectFresh(service).getRootProps()
  class=cn(
    "mu-avatar group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten",
    input.class,
  )
>
  <if=input.src>
    <img
      ...connectFresh(service).getImageProps()
      src=input.src
      alt=input.alt
      data-slot="avatar-image"
      class="mu-avatar-image aspect-square size-full object-cover"
    />
  </if>
  <span
    ...connectFresh(service).getFallbackProps()
    data-slot="avatar-fallback"
    class="mu-avatar-fallback flex size-full items-center justify-center group-data-[size=sm]/avatar:text-xs"
  >
    <if=input.content>
      <${input.content}/>
    </if>
    <else>
      ${input.fallback}
    </else>
  </span>
  <if=input.badge>
    <${input.badge}/>
  </if>
</span>

// Parents can receive the api getter: <Avatar/avatarApi/> then
// `avatarApi().loaded` — it stays live across machine updates.
<return=api>
