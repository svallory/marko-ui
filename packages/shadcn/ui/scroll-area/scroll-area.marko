// Built on the REAL @zag-js/scroll-area machine (synthetic draggable thumb,
// auto-hiding scrollbars) — not native browser scrollbars re-skinned.
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as scrollAreaMachine from "@zag-js/scroll-area";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { scrollArea as styles } from "./classes.ts";

export type Input = MachineInput<"div", scrollAreaMachine.Props> & {
  content?: Marko.Body;
  /** Render a horizontal scrollbar + thumb. Defaults to false. */
  horizontal?: boolean;
  /**
   * Render a vertical scrollbar + thumb. Defaults to true, matching Radix
   * ScrollArea's implicit vertical-only behavior when no <ScrollBar> is
   * given. Set to false for horizontal-only rails (e.g. a category nav)
   * where a vertical scrollbar/thumb would render as a stray pill even
   * though the container never scrolls vertically.
   */
  vertical?: boolean;
};

// scroll-area has no onXxxChange callbacks in its Props — nothing to adapt.
<zag/api=() => scrollAreaMachine from=input/>

// Everything that is neither machine-owned (splitProps) nor component-owned
// (class, content, horizontal) passes through to the root wrapper.
<const/nativeAttrs=() =>
  stripOwnProps(
    scrollAreaMachine.splitProps(input)[1],
    "class",
    "content",
    "horizontal",
    "vertical",
  )
>

// root/scrollbar/thumb/corner all carry Zag-owned reactive `style` objects
// (imperative --corner-width/--thumb-height CSS vars, absolute positioning) —
// do NOT add a style attribute of our own to any of them; only `class`.
<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="scroll-area"
  class=cn(styles.root, input.class)
>
  <div
    ...api().getViewportProps()
    data-slot="scroll-area-viewport"
    // Keyboard users must be able to scroll: a scrollable region with no
    // focusable content needs to be focusable itself (axe:
    // scrollable-region-focusable). Matches shadcn's Viewport tabIndex={0} —
    // the focus-visible ring classes below assume it.
    tabindex="0"
    class=styles.viewport
  >
    <div ...api().getContentProps()>
      <${input.content}/>
    </div>
  </div>

  // Radix's ScrollAreaScrollbar renders nothing at all when its axis has no
  // overflow (verified against registry/new-york-v4/ui/scroll-area.tsx — the
  // upstream port target). @zag-js/scroll-area's getScrollbarProps() has no
  // equivalent: it always returns real props, and hiddenState is exposed
  // only through JS state (getScrollbarState().hidden) and the
  // `data-overflow-x`/`data-overflow-y` data attributes it puts on the
  // scrollbar/thumb/viewport/content/corner elements — never as a DOM-gate
  // signal. Gating the scrollbar/thumb's presence in the template on that
  // JS state (as this file used to) makes SSR and hydration render a
  // DIFFERENT PART COUNT: hiddenState starts as "not hidden" until the
  // machine's first (always-async — see scroll-area.machine's
  // ResizeObserver + setTimeout) measurement runs, so a never-overflowing
  // rail renders its scrollbar+thumb during SSR (where the measurement
  // never runs at all) and again briefly on first client render, then
  // removes them once the real measurement lands — a genuine SSR/hydration
  // DOM mismatch, not just a visual flash (broke
  // packages/shadcn/tests/hydration-invariant.test.ts's scroll-area case).
  //
  // Fixed by keeping the DOM identical between SSR and every client
  // render — scrollbar/thumb are ALWAYS mounted per axis flag — and hiding
  // the no-overflow case purely via CSS, keyed off the same
  // `data-overflow-x`/`data-overflow-y` attributes getScrollbarProps()
  // already emits (present when that axis overflows, absent otherwise —
  // see mu-scroll-area-scrollbar's `not-data-[overflow-y]:hidden` /
  // `not-data-[overflow-x]:hidden` per style layer). The thumb's own
  // flex-none sizing (see classes.ts) still matters independently: it's
  // what keeps an unmeasured/zero-size thumb from visually filling the
  // track for the one frame between mount and the first real measurement,
  // on an axis that WILL end up overflowing.
  <if=input.vertical ?? true>
    <div
      ...api().getScrollbarProps({ orientation: "vertical" })
      data-slot="scroll-area-scrollbar"
      class=styles.scrollbar
    >
      <div
        ...api().getThumbProps({ orientation: "vertical" })
        data-slot="scroll-area-thumb"
        class=styles.thumb
      />
    </div>
  </if>

  <if=input.horizontal>
    <div
      ...api().getScrollbarProps({ orientation: "horizontal" })
      data-slot="scroll-area-scrollbar"
      class=styles.scrollbar
    >
      <div
        ...api().getThumbProps({ orientation: "horizontal" })
        data-slot="scroll-area-thumb"
        class=styles.thumb
      />
    </div>
  </if>

  <div ...api().getCornerProps()/>
</div>

<return=api>
