// Draggable, resizable desktop-app style floating panel.
// Built on the REAL @zag-js/floating-panel machine (drag via header, edge and
// corner resize handles, minimize/maximize/restore stages, viewport clamping).
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as floatingPanelMachine from "@zag-js/floating-panel";
import type { MachineInput } from "marko-zag";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { floatingPanel as styles } from "./classes.ts";

export type Input = Omit<
  MachineInput<"div", floatingPanelMachine.Props>,
  "title"
> & {
  /** Sugar for onOpenChange — receives the plain boolean, enables `open:=state`. */
  openChange?: (open: boolean) => void;
  /** Sugar for onPositionChange — receives the plain point. */
  positionChange?: (position: floatingPanelMachine.Point) => void;
  /** Sugar for onPositionChangeEnd — receives the plain point. */
  positionEndChange?: (position: floatingPanelMachine.Point) => void;
  /** Sugar for onSizeChange — receives the plain size. */
  sizeChange?: (size: floatingPanelMachine.Size) => void;
  /** Sugar for onSizeChangeEnd — receives the plain size. */
  sizeEndChange?: (size: floatingPanelMachine.Size) => void;
  /** Sugar for onStageChange — receives the plain stage. */
  stageChange?: (stage: floatingPanelMachine.Stage) => void;
  /** Render-prop trigger: `<@trigger|props|><Button ...props/></@trigger>`. */
  trigger?: Marko.AttrTag<{ content: Marko.Body<[Record<string, unknown>]> }>;
  /** Header title content. */
  title?: Marko.Body;
  /** Panel body content. */
  content?: Marko.Body;
  /** Extra controls rendered before the stage/close buttons in the header. */
  actions?: Marko.Body;
  /** Hide the minimize/maximize/restore stage buttons. */
  hideStageTriggers?: boolean;
  /** Hide the close button. */
  hideCloseTrigger?: boolean;
};

<zag/api=() => floatingPanelMachine from=input
  onPositionChangeEnd(details: floatingPanelMachine.PositionChangeDetails) {
    input.onPositionChangeEnd?.(details);
    input.positionEndChange?.(details.position);
  }
  onSizeChangeEnd(details: floatingPanelMachine.SizeChangeDetails) {
    input.onSizeChangeEnd?.(details);
    input.sizeEndChange?.(details.size);
  }
/>

// Everything that is neither machine-owned (splitProps) nor component-owned
// passes through to the panel content. Leaking a component-owned prop here
// would render it as a bogus DOM attribute.
<const/nativeAttrs=() =>
  stripOwnProps(
    floatingPanelMachine.splitProps(input)[1],
    "class",
    "openChange",
    "positionChange",
    "positionEndChange",
    "sizeChange",
    "sizeEndChange",
    "stageChange",
    "trigger",
    "title",
    "content",
    "actions",
    "hideStageTriggers",
    "hideCloseTrigger",
  )
>

<if=input.trigger>
  // The panel content only exists in the DOM while open, so the trigger's
  // aria-controls would dangle when closed (axe: aria-valid-attr-value) —
  // include it only while its target is rendered.
  <const/triggerProps=(() => {
    const { "aria-controls": ariaControls, ...rest } = api().getTriggerProps() as Record<string, unknown>;
    return api().open ? { ...rest, "aria-controls": ariaControls } : rest;
  })()>
  <${input.trigger.content}({
    ...triggerProps,
    "data-slot": "floating-panel-trigger",
  })/>
</if>
<zag-portal>
  <if=api().open>
    // The positioner owns --x/--y/--width/--height plus `position` in its own
    // reactive style object; the content owns width/height/overflow. Adding a
    // style attribute of our own on either part would wipe them.
    <div ...api().getPositionerProps() data-slot="floating-panel-positioner" class=styles.positioner>
      <div
        ...nativeAttrs()
        ...api().getContentProps()
        data-slot="floating-panel"
        class=cn(styles.content, input.class)
      >
        <div
          ...api().getHeaderProps()
          data-slot="floating-panel-header"
          class=styles.header
        >
          // The drag trigger owns cursor/user-select/touch-action styles.
          <div
            ...api().getDragTriggerProps()
            data-slot="floating-panel-drag-trigger"
            class=styles.dragTrigger
          >
            <h2
              ...api().getTitleProps()
              data-slot="floating-panel-title"
              class=styles.title
            >
              <if=input.title>
                <${input.title}/>
              </if>
            </h2>
          </div>
          <div
            ...api().getControlProps()
            data-slot="floating-panel-control"
            class=styles.control
          >
            <if=input.actions>
              <${input.actions}/>
            </if>
            <if=!input.hideStageTriggers>
              <button
                ...api().getStageTriggerProps({ stage: "minimized" })
                data-slot="floating-panel-stage-trigger"
                class=styles.stageTrigger
              >
                <Icon name="Minus" class=styles.stageIcon aria-hidden="true"/>
              </button>
              <button
                ...api().getStageTriggerProps({ stage: "maximized" })
                data-slot="floating-panel-stage-trigger"
                class=styles.stageTrigger
              >
                // Deliberately still hand-inlined, unlike every other icon in
                // this file: this is a custom 16x16-at-(4,4) rounded square, the
                // desktop-window "maximize" glyph. Lucide has no equivalent —
                // its `SquareIcon` is 18x18 at (3,3) (visibly larger inside the
                // same 24 viewBox) and `MaximizeIcon` is a four-corner-brackets
                // shape, not a square. Swapping in either would change what the
                // button looks like, so it stays raw rather than being made
                // icon-library-swappable with a different glyph.
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=styles.stageIcon aria-hidden="true">
                  <rect width="16" height="16" x="4" y="4" rx="2"/>
                </svg>
              </button>
              <button
                ...api().getStageTriggerProps({ stage: "default" })
                data-slot="floating-panel-stage-trigger"
                class=styles.stageTrigger
              >
                <Icon name="MinimizeIcon" class=styles.stageIcon aria-hidden="true"/>
              </button>
            </if>
            <if=!input.hideCloseTrigger>
              <button
                ...api().getCloseTriggerProps()
                data-slot="floating-panel-close-trigger"
                class=styles.stageTrigger
              >
                <Icon name="X" class=styles.stageIcon aria-hidden="true"/>
                <span class=styles.srOnly>Close</span>
              </button>
            </if>
          </div>
        </div>
        <div
          ...api().getBodyProps()
          data-slot="floating-panel-body"
          class=styles.body
        >
          <if=input.content>
            <${input.content}/>
          </if>
        </div>
        // Resize handles own position/cursor/touch-action plus their per-axis
        // offsets in the machine's style object — only sizing classes here.
        <for|axis| of=floatingPanelMachine.resizeTriggerAxes>
          <div
            ...api().getResizeTriggerProps({ axis })
            data-slot="floating-panel-resize-trigger"
            class=styles.resizeTrigger
          />
        </for>
      </div>
    </div>
  </if>
</zag-portal>

<return=api>
