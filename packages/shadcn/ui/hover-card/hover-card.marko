import * as hoverCardMachine from "@zag-js/hover-card";
import type { MachineInput } from "marko-zag";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";

// MachineInput = native <span> attributes ∩ the machine's full Props, with
// `id` made optional (generated below, overridable). `openChange` is
// additive sugar enabling Marko's two-way bind shorthand
// (<HoverCard open:=myState/>); Zag's own `onOpenChange` also works and
// receives the details object.
export type Input = MachineInput<"span", hoverCardMachine.Props> & {
  /** Trigger render-prop — typically a link. */
  trigger: Marko.Body<[Record<string, unknown>]>;
  /** Card content shown when open. */
  content: Marko.Body;
  /** Extra class for the content panel. */
  class?: string;
  /** Fires when the open state changes; receives the plain open value. */
  openChange?: (open: boolean) => void;
};

<machine-props/machineProps from=input pick=hoverCardMachine.props
  onOpenChange(details: hoverCardMachine.OpenChangeDetails) {
    input.onOpenChange?.(details);
    input.openChange?.(details.open);
  }/>
<service/service machine=() => hoverCardMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  hoverCardMachine.connect(service, normalizeProps)
  service=service
/>

<span data-slot="hover-card">
  <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "hover-card-trigger" })/>
  <portal data-slot="hover-card-portal">
    <if=api().open>
      <div ...api().getPositionerProps() style=positionerStyle data-slot="hover-card-positioner">
        <div
          ...api().getContentProps()
          data-slot="hover-card-content"
          class=cn(
            "mu-hover-card-content z-50 origin-(--radix-hover-card-content-transform-origin) outline-hidden",
            input.class,
          )
        >
          <${input.content}/>
        </div>
      </div>
    </if>
  </portal>
</span>

<return=api>
