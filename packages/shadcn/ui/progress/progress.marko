import * as progressMachine from "@zag-js/progress";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";
import { progress as styles } from "./classes.ts";

export type Input = MachineInput<"div", progressMachine.Props> & {
  valueChange?: (value: number | null) => void;
  label?: string;
};

<zag/api=() => progressMachine from=input/>

<const/nativeAttrs=() =>
  stripOwnProps(
    progressMachine.splitProps(input)[1],
    "class",
    "valueChange",
    "label",
  )
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="progress"
  class=cn(styles.root, input.class)
>
  <if=input.label>
    <div class=styles.labelRow>
      <span ...api().getLabelProps() data-slot="progress-label" class=styles.label>${input.label}</span>
      <span ...api().getValueTextProps() data-slot="progress-value" class=styles.value>${api().valueAsString}</span>
    </div>
  </if>
  <div ...api().getTrackProps() data-slot="progress-track" class=styles.track>
    <div
      ...api().getRangeProps()
      data-slot="progress-indicator"
      class=styles.indicator
    />
  </div>
</div>

<return=api>
