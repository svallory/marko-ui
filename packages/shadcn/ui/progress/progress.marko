import * as progressMachine from "@zag-js/progress";
import type { MachineInput } from "marko-zag";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"div", progressMachine.Props> & {
  valueChange?: (value: number | null) => void;
  label?: string;
};

<machine-props/machineProps from=input pick=progressMachine.props
  onValueChange(details: progressMachine.ValueChangeDetails) {
    input.onValueChange?.(details);
    input.valueChange?.(details.value);
  }/>
<service/service machine=() => progressMachine.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  progressMachine.connect(service, normalizeProps)
  service=service
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    progressMachine.splitProps(input)[1],
    "class",
    "valueChange",
    "label",
  )
>

<div
  ...nativeAttrs()
  ...api().getRootProps()
  data-slot="progress"
  class=cn("mu-progress relative flex w-full items-center overflow-x-hidden flex-col gap-2", input.class)
>
  <if=input.label>
    <div class="flex items-center justify-between text-sm">
      <span ...api().getLabelProps() data-slot="progress-label" class="text-sm font-medium">${input.label}</span>
      <span ...api().getValueTextProps() data-slot="progress-value" class="text-muted-foreground ml-auto text-sm tabular-nums">${api().valueAsString}</span>
    </div>
  </if>
  <div ...api().getTrackProps() data-slot="progress-track" class="bg-muted relative h-2 w-full overflow-hidden rounded-full">
    <div
      ...api().getRangeProps()
      data-slot="progress-indicator"
      class="mu-progress-indicator size-full flex-1 transition-all"
    />
  </div>
</div>

<return=api>
