import * as menu from "@zag-js/menu";
import { positionerStyle } from "marko-zag";
import { cn } from "#lib/utils.ts";
import Icon from "../icon/icon.marko";
import Submenu from "./submenu.marko";

export interface DropdownMenuItem {
  type?: "item" | "separator" | "label" | "checkbox" | "radio" | "sub";
  value?: string;
  label?: string;
  disabled?: boolean;
  shortcut?: string;
  /** Upstream `variant: "default" | "destructive"`, emitted as `data-variant`. */
  variant?: "default" | "destructive";
  /** Emits `data-inset` — indents the entry to align with icon-bearing siblings. */
  inset?: boolean;
  /** Checked state for `type="checkbox"` and `type="radio"` entries. */
  checked?: boolean;
  /** Groups radio items — required for `type: "radio"` entries. */
  radioGroup?: string;
  /** `type: "radio"` entries only — this entry's value within its `radioGroup`. */
  radioValue?: string;
  /**
   * `type: "sub"` entries only — the nested submenu's own item list. One
   * level deep: a `type: "sub"` entry inside a submenu's own `subEntries` is
   * not wired (same limit as menubar's submenu).
   */
  subEntries?: DropdownMenuItem[];
}

// Attr-tag form of DropdownMenuItem. A SINGLE attr tag name (`item`) carries
// all five kinds (discriminated by `type`) rather than separate per-kind
// attr tags: Marko collects each attr-tag NAME into its own independent
// iterable on `input` with no shared ordering between differently-named
// siblings, so `<@item>`/`<@separator>`/`<@label>` as distinct tag names
// could not preserve call-site interleaving. One name with a `type`
// discriminant keeps document order intact by construction (same design as
// context-menu.marko). `content` lets an item or label carry a markup body;
// the plain `label` string renders as the fallback when no body is supplied.
export interface DropdownMenuItemAttrs extends DropdownMenuItem {
  content?: Marko.Body;
}

export interface Input {
  trigger: Marko.Body<[Record<string, unknown>]>;
  items?: DropdownMenuItem[];
  item?: Marko.AttrTag<DropdownMenuItemAttrs>;
  select?: (value: string) => void;
  class?: string;
}

<machine-props/machineProps from=input pick=menu.props
  onSelect(details: menu.SelectionDetails) {
    input.select?.(details.value);
  }/>
<service/service machine=() => menu.machine props=machineProps/>
<connect/api=(service, normalizeProps) =>
  menu.connect(service, normalizeProps)
  service=service
/>

<const/{ class: className, trigger }=input/>
// Normalize whichever source was supplied into ONE entries list so the
// render path below never branches. Attr tags win when present (compound is
// primary per the compound-tag-dx report); `items=` is the fallback.
// `items=` entries never carry a body, so each is mapped into the
// DropdownMenuItemAttrs shape with an explicit undefined `content` — no
// casts needed (mirrors accordion/toggle-group).
<const/attrItems=[...(input.item ?? [])]/>
<const/entries=(attrItems.length > 0 ? attrItems : (input.items ?? []).map((item) => ({ ...item, content: undefined as Marko.Body | undefined })))/>

// Getter handed to each <Submenu> child so it can call `setParent` on this
// menu's raw service (see submenu.marko for the full wiring rationale).
<const/getOwnService=() => service.service/>

<${trigger}({ ...api().getTriggerProps(), "data-slot": "dropdown-menu-trigger" })/>
<portal>
  <if=api().open>
    <div ...api().getPositionerProps() style=positionerStyle data-slot="dropdown-menu-positioner">
      <div
        ...api().getContentProps()
        data-slot="dropdown-menu-content"
        class=cn(
          "mu-dropdown-menu-content mu-menu-target mu-menu-translucent z-50 max-h-(--radix-dropdown-menu-content-available-height) w-(--radix-dropdown-menu-trigger-width) origin-(--radix-dropdown-menu-content-transform-origin) overflow-x-hidden overflow-y-auto data-closed:overflow-hidden",
          className,
        )
      >
        <for|entry, index| of=entries>
          <if=entry.type === "separator">
            <div ...api().getSeparatorProps() data-slot="dropdown-menu-separator" class="mu-dropdown-menu-separator"/>
          </if>
          <else if=entry.type === "label">
            <div data-slot="dropdown-menu-label" data-inset=entry.inset || undefined class="mu-dropdown-menu-label">
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
            </div>
          </else>
          <else if=entry.type === "checkbox">
            <div
              ...api().getOptionItemProps({ type: "checkbox", value: entry.value ?? `item-${index}`, checked: entry.checked ?? false, disabled: entry.disabled })
              data-slot="dropdown-menu-checkbox-item"
              data-inset=entry.inset || undefined
              class="mu-dropdown-menu-checkbox-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span ...api().getItemIndicatorProps({ value: entry.value ?? `item-${index}`, checked: entry.checked ?? false }) data-slot="dropdown-menu-checkbox-item-indicator" class="mu-dropdown-menu-item-indicator pointer-events-none">
                <if=entry.checked>
                  <Icon name="Check"/>
                </if>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="dropdown-menu-shortcut" class="mu-dropdown-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else if=entry.type === "radio">
            <div
              ...api().getOptionItemProps({ type: "radio", value: entry.value ?? `item-${index}`, checked: entry.checked ?? false, disabled: entry.disabled })
              data-slot="dropdown-menu-radio-item"
              data-inset=entry.inset || undefined
              class="mu-dropdown-menu-radio-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <span ...api().getItemIndicatorProps({ value: entry.value ?? `item-${index}`, checked: entry.checked ?? false }) data-slot="dropdown-menu-radio-item-indicator" class="mu-dropdown-menu-item-indicator pointer-events-none">
                <if=entry.checked>
                  <Icon name="Check"/>
                </if>
              </span>
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="dropdown-menu-shortcut" class="mu-dropdown-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
          <else if=entry.type === "sub">
            <Submenu
              entries=entry.subEntries ?? []
              label=entry.label
              disabled=entry.disabled
              inset=entry.inset
              parent=getOwnService
              onChildReady=(childService) => api().setChild(childService)
            >
              <@trigger|childApi|>
                <div
                  ...api().getTriggerItemProps(childApi())
                  data-slot="dropdown-menu-sub-trigger"
                  data-inset=entry.inset || undefined
                  class="mu-dropdown-menu-sub-trigger flex cursor-default items-center outline-hidden select-none [&_svg]:pointer-events-none [&_svg]:shrink-0"
                >
                  ${entry.label}
                  <Icon name="ChevronRight" class="mu-rtl-flip ml-auto"/>
                </div>
              </@trigger>
            </Submenu>
          </else>
          <else>
            <div
              ...api().getItemProps({ value: entry.value ?? `item-${index}`, disabled: entry.disabled })
              data-slot="dropdown-menu-item"
              data-inset=entry.inset || undefined
              data-variant=entry.variant ?? "default"
              class="mu-dropdown-menu-item group/dropdown-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
            >
              <if=entry.content>
                <${entry.content}/>
              </if>
              <else>
                ${entry.label}
              </else>
              <if=entry.shortcut>
                <span data-slot="dropdown-menu-shortcut" class="mu-dropdown-menu-shortcut">${entry.shortcut}</span>
              </if>
            </div>
          </else>
        </for>
      </div>
    </div>
  </if>
</portal>

<return=api>
