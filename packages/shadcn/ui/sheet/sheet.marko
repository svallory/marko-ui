// Guide: /docs/creating-components · adapter internals: /docs/zag-adapter
// Authoring rules: notes/component-authoring.md (v2 pattern)
import * as dialogMachine from "@zag-js/dialog";
import type { MachineInput } from "marko-zag";
import Button from "../button/button.marko";
import Icon from "../icon/icon.marko";
import { cn } from "#lib/utils.ts";
import { stripOwnProps } from "#lib/native-attrs.ts";

export type Input = MachineInput<"div", dialogMachine.Props> & {
  openChange?: (open: boolean) => void;
  trigger?: Marko.Body<[Record<string, unknown>]>;
  title?: Marko.Body;
  description?: Marko.Body;
  content?: Marko.Body;
  footer?: Marko.Body;
  /** `"top" | "right" | "bottom" | "left"` — which edge the sheet slides in from. */
  side?: "top" | "right" | "bottom" | "left";
  /** Show the top-right close button. Defaults to true. */
  showCloseButton?: boolean;
};

<zag/api=() => dialogMachine from=input
  role="dialog"
/>

<const/nativeAttrs=() =>
  stripOwnProps(
    dialogMachine.splitProps(input)[1],
    "class",
    "openChange",
    "trigger",
    "title",
    "description",
    "content",
    "footer",
    "side",
    "showCloseButton",
  )
>
<const/side=input.side ?? "right"/>
<const/showCloseButton=input.showCloseButton ?? true/>

<div ...nativeAttrs() data-slot="sheet">
  <if=input.trigger>
    <${input.trigger}({ ...api().getTriggerProps(), "data-slot": "sheet-trigger" })/>
  </if>
  // NOTE: upstream shadcn sets data-slot="sheet-portal" on Radix's Portal,
  // which renders a real element. marko-zag's <zag-portal> renders a
  // `display:contents` host and does not forward attributes, so the
  // marker never reached the DOM — it was inert, and nothing in this
  // repo's CSS, tests or tooling reads it. Dropped rather than left as
  // dead markup; restore it if <zag-portal> gains attribute forwarding.
  <zag-portal>
    <if=api().open>
      <div
        ...api().getBackdropProps()
        data-slot="sheet-overlay"
        class="mu-sheet-overlay fixed inset-0 z-50 duration-100 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0"
      />
      <div ...api().getPositionerProps() data-slot="sheet-positioner" class="contents">
        <div
          ...api().getContentProps()
          data-slot="sheet-content"
          data-side=side
          class=cn(
            "mu-sheet-content data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[side=bottom]:data-[state=open]:slide-in-from-bottom-10 data-[side=left]:data-[state=open]:slide-in-from-left-10 data-[side=right]:data-[state=open]:slide-in-from-right-10 data-[side=top]:data-[state=open]:slide-in-from-top-10 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[side=bottom]:data-[state=closed]:slide-out-to-bottom-10 data-[side=left]:data-[state=closed]:slide-out-to-left-10 data-[side=right]:data-[state=closed]:slide-out-to-right-10 data-[side=top]:data-[state=closed]:slide-out-to-top-10",
            input.class,
          )
        >
          <if=input.title || input.description>
            <div data-slot="sheet-header" class="mu-sheet-header flex flex-col">
              <if=input.title>
                <h2 ...api().getTitleProps() data-slot="sheet-title" class="mu-sheet-title mu-font-heading">
                  <${input.title}/>
                </h2>
              </if>
              <if=input.description>
                <p ...api().getDescriptionProps() data-slot="sheet-description" class="mu-sheet-description">
                  <${input.description}/>
                </p>
              </if>
            </div>
          </if>
          <${input.content}/>
          <if=input.footer>
            <div data-slot="sheet-footer" class="mu-sheet-footer mt-auto flex flex-col">
              <${input.footer}/>
            </div>
          </if>
          <if=showCloseButton>
            <Button
              ...api().getCloseTriggerProps()
              variant="ghost"
              size="icon-sm"
              data-slot="sheet-close"
              class="mu-sheet-close"
            >
              <Icon name="XIcon"/>
              <span class="sr-only">Close</span>
            </Button>
          </if>
        </div>
      </div>
    </if>
  </zag-portal>
</div>

<return=api>
