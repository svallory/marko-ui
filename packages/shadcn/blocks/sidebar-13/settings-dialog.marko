import Dialog from "@marko-ui/shadcn/ui/dialog/dialog.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Breadcrumb from "@marko-ui/shadcn/ui/breadcrumb/breadcrumb.marko";
import BreadcrumbItem from "@marko-ui/shadcn/ui/breadcrumb/item.marko";
import BreadcrumbLink from "@marko-ui/shadcn/ui/breadcrumb/link.marko";
import BreadcrumbSeparator from "@marko-ui/shadcn/ui/breadcrumb/separator.marko";
import BreadcrumbPage from "@marko-ui/shadcn/ui/breadcrumb/page.marko";
import SidebarProvider from "@marko-ui/shadcn/ui/sidebar/provider.marko";
import Sidebar from "@marko-ui/shadcn/ui/sidebar/sidebar.marko";
import SidebarContent from "@marko-ui/shadcn/ui/sidebar/content.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";

static const PLACEHOLDER_TILES = Array.from({ length: 10 });

static const NAV_ITEMS: { name: string; icon: string }[] = [
  { name: "Notifications", icon: "bell" },
  { name: "Navigation", icon: "menu" },
  { name: "Home", icon: "home" },
  { name: "Appearance", icon: "paintbrush" },
  { name: "Messages & media", icon: "message-circle" },
  { name: "Language & region", icon: "globe" },
  { name: "Accessibility", icon: "keyboard" },
  { name: "Mark as read", icon: "check" },
  { name: "Audio & video", icon: "video" },
  { name: "Connected accounts", icon: "link" },
  { name: "Privacy & visibility", icon: "lock" },
  { name: "Advanced", icon: "settings" },
];

<let/open=true/>

<Dialog
  open=open
  openChange(isOpen: boolean) {
    open = isOpen;
  }
>
  <@trigger|triggerProps|>
    <Button ...triggerProps size="sm">Open Dialog</Button>
  </@trigger>
  <@title><span class="sr-only">Settings</span></@title>
  <@description><span class="sr-only">Customize your settings here.</span></@description>
  <div class="overflow-hidden p-0 md:max-h-[500px] md:max-w-[700px] lg:max-w-[800px] -m-6">
    <SidebarProvider class="items-start">
      <@sidebar>
        <Sidebar open=true class="hidden md:flex">
          <SidebarContent>
            <SidebarGroup>
              <SidebarMenu>
                <for|item| of=NAV_ITEMS by=(item) => item.name>
                  <SidebarMenuItem>
                    <SidebarMenuButton href="#" active=(item.name === "Messages & media")>
                      <if=item.icon === "bell">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                        </svg>
                      </if>
                      <if=item.icon === "menu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 12h16"/>
                          <path d="M4 18h16"/>
                          <path d="M4 6h16"/>
                        </svg>
                      </if>
                      <if=item.icon === "home">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                          <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        </svg>
                      </if>
                      <if=item.icon === "paintbrush">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 19.9V16h3a2 2 0 0 0 2-2v-2H5v2c0 1.1.9 2 2 2h3v3.9a2 2 0 1 0 4 0Z"/>
                          <path d="M6 12V2h12v10"/>
                          <path d="M14 2v4"/>
                          <path d="M10 2v2"/>
                        </svg>
                      </if>
                      <if=item.icon === "message-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
                        </svg>
                      </if>
                      <if=item.icon === "globe">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                          <path d="M2 12h20"/>
                        </svg>
                      </if>
                      <if=item.icon === "keyboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M10 8h.01"/>
                          <path d="M12 12h.01"/>
                          <path d="M14 8h.01"/>
                          <path d="M16 12h.01"/>
                          <path d="M18 8h.01"/>
                          <path d="M6 8h.01"/>
                          <path d="M7 16h10"/>
                          <path d="M8 12h.01"/>
                          <rect width="20" height="16" x="2" y="4" rx="2"/>
                        </svg>
                      </if>
                      <if=item.icon === "check">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 6 9 17l-5-5"/>
                        </svg>
                      </if>
                      <if=item.icon === "video">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/>
                          <rect x="2" y="6" width="14" height="12" rx="2"/>
                        </svg>
                      </if>
                      <if=item.icon === "link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M9 17H7A5 5 0 0 1 7 7h2"/>
                          <path d="M15 7h2a5 5 0 1 1 0 10h-2"/>
                          <line x1="8" x2="16" y1="12" y2="12"/>
                        </svg>
                      </if>
                      <if=item.icon === "lock">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                      </if>
                      <if=item.icon === "settings">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                          <circle cx="12" cy="12" r="3"/>
                        </svg>
                      </if>
                      <span>${item.name}</span>
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                </for>
              </SidebarMenu>
            </SidebarGroup>
          </SidebarContent>
        </Sidebar>
      </@sidebar>
      <@main>
        <main class="flex h-[480px] flex-1 flex-col overflow-hidden">
          <header class="flex h-16 shrink-0 items-center gap-2 transition-[width,height] ease-linear">
            <div class="flex items-center gap-2 px-4">
              <Breadcrumb>
                <BreadcrumbItem class="hidden md:block">
                  <BreadcrumbLink href="#">Settings</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator class="hidden md:block"/>
                <BreadcrumbItem>
                  <BreadcrumbPage>Messages & media</BreadcrumbPage>
                </BreadcrumbItem>
              </Breadcrumb>
            </div>
          </header>
          <div class="flex flex-1 flex-col gap-4 overflow-y-auto p-4 pt-0">
            <for|_tile, index| of=PLACEHOLDER_TILES by=(_tile, tileIndex) => tileIndex>
              <div class="aspect-video max-w-3xl rounded-xl bg-muted/50"></div>
            </for>
          </div>
        </main>
      </@main>
    </SidebarProvider>
  </div>
</Dialog>
