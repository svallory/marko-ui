import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Popover from "@marko-ui/shadcn/ui/popover/popover.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";

// NOTE: shadcn nests a full <Sidebar collapsible="none"> inside the popover
// to reuse its menu chrome. Our Sidebar renders a fixed-height <aside>
// meant for the page's primary sidebar, so it is not embeddable here;
// SidebarGroup/SidebarMenu are composed directly instead. Deviation from
// the source, noted per block-porting rules.

export interface ActionItem {
  id: string;
  label: string;
}

static const ACTION_GROUPS: ActionItem[][] = [
  [
    { id: "customize-page", label: "Customize Page" },
    { id: "turn-into-wiki", label: "Turn into wiki" },
  ],
  [
    { id: "copy-link", label: "Copy Link" },
    { id: "duplicate", label: "Duplicate" },
    { id: "move-to", label: "Move to" },
    { id: "move-to-trash", label: "Move to Trash" },
  ],
  [
    { id: "undo", label: "Undo" },
    { id: "view-analytics", label: "View analytics" },
    { id: "version-history", label: "Version History" },
    { id: "show-delete-pages", label: "Show delete pages" },
    { id: "notifications", label: "Notifications" },
  ],
  [
    { id: "import", label: "Import" },
    { id: "export", label: "Export" },
  ],
];

<let/starred=false/>

<div class="flex items-center gap-2 text-sm">
  <div class="hidden font-medium text-muted-foreground md:inline-block">Edit Oct 08</div>
  <Button
    variant="ghost"
    size="icon"
    class="h-7 w-7"
    onClick() {
      starred = !starred;
    }
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill=(starred ? "currentColor" : "none")
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
      />
    </svg>
  </Button>
  <Popover defaultOpen=true class="w-56 overflow-hidden rounded-lg p-0">
    <@trigger|attrs|>
      <Button ...attrs variant="ghost" size="icon" class="h-7 w-7 data-[state=open]:bg-accent">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="1"/>
          <circle cx="19" cy="12" r="1"/>
          <circle cx="5" cy="12" r="1"/>
        </svg>
      </Button>
    </@trigger>
    <@content>
      <div class="flex flex-col bg-transparent">
        <for|group, groupIndex| of=ACTION_GROUPS by=(group, groupIndex) => groupIndex>
          <SidebarGroup class="border-b p-0 py-2 last:border-none">
            <SidebarMenu>
              <for|item| of=group by=(item) => item.id>
                <SidebarMenuItem>
                  <SidebarMenuButton>${item.label}</SidebarMenuButton>
                </SidebarMenuItem>
              </for>
            </SidebarMenu>
          </SidebarGroup>
        </for>
      </div>
    </@content>
  </Popover>
</div>
