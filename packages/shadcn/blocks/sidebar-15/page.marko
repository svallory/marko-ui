import SidebarProvider from "@marko-ui/shadcn/ui/sidebar/provider.marko";
import SidebarTrigger from "@marko-ui/shadcn/ui/sidebar/trigger.marko";
import Separator from "@marko-ui/shadcn/ui/separator/separator.marko";
import Breadcrumb from "@marko-ui/shadcn/ui/breadcrumb/breadcrumb.marko";
import BreadcrumbItem from "@marko-ui/shadcn/ui/breadcrumb/item.marko";
import BreadcrumbPage from "@marko-ui/shadcn/ui/breadcrumb/page.marko";
import SidebarLeft from "./sidebar-left.marko";
import SidebarRight from "./sidebar-right.marko";

// NOTE: shadcn's SidebarInset (a <main> variant that insets/rounds the
// content area) has no dedicated equivalent among our sidebar sub-parts,
// so the content region is a plain flex <div>, matching the precedent in
// blocks/dashboard-01/page.marko and blocks/sidebar-07/page.marko.
//
// The right sidebar is `collapsible="none"` in the source (always
// visible on desktop, independent of the provider's open/toggle state),
// so it is rendered as a sibling inside `@main` rather than through
// the provider's single `@sidebar` slot, which only supports one panel.

<SidebarProvider width="16rem">
  <@sidebar|{ open }|>
    <SidebarLeft open=open/>
  </@sidebar>
  <@main|{ open, toggle }|>
    <div class="flex min-w-0 flex-1">
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 flex h-14 shrink-0 items-center gap-2 bg-background">
          <div class="flex flex-1 items-center gap-2 px-3">
            <SidebarTrigger open=open toggle=toggle/>
            <Separator orientation="vertical" class="mr-2 h-4"/>
            <Breadcrumb>
              <BreadcrumbItem>
                <BreadcrumbPage class="line-clamp-1">Project Management & Task Tracking</BreadcrumbPage>
              </BreadcrumbItem>
            </Breadcrumb>
          </div>
        </header>
        <div class="flex flex-1 flex-col gap-4 p-4">
          <div class="mx-auto h-24 w-full max-w-3xl rounded-xl bg-muted/50"></div>
          <div class="mx-auto h-[100vh] w-full max-w-3xl rounded-xl bg-muted/50"></div>
        </div>
      </div>
      <SidebarRight/>
    </div>
  </@main>
</SidebarProvider>
