import Sidebar from "@marko-ui/shadcn/ui/sidebar/sidebar.marko";
import SidebarHeader from "@marko-ui/shadcn/ui/sidebar/header.marko";
import SidebarContent from "@marko-ui/shadcn/ui/sidebar/content.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";
import Collapsible from "@marko-ui/shadcn/ui/collapsible/collapsible.marko";
import SearchForm from "./search-form.marko";

export interface Input {
  open?: boolean;
}

// NOTE: shadcn's SidebarRail (a hover/drag handle on the sidebar's right
// edge for resizing/toggling) has no equivalent in our sidebar sub-parts
// yet, so it is omitted here. SidebarTrigger in the page header covers
// open/close. Deviation from the source, noted per block-porting rules.

export interface NavLeafItem {
  id: string;
  title: string;
  url: string;
  active?: boolean;
}

export interface NavGroup {
  id: string;
  title: string;
  url: string;
  items: NavLeafItem[];
}

// This is sample data.
static const NAV_MAIN: NavGroup[] = [
  {
    id: "getting-started",
    title: "Getting Started",
    url: "#",
    items: [
      { id: "installation", title: "Installation", url: "#" },
      { id: "project-structure", title: "Project Structure", url: "#" },
    ],
  },
  {
    id: "build-your-application",
    title: "Build Your Application",
    url: "#",
    items: [
      { id: "routing", title: "Routing", url: "#" },
      { id: "data-fetching", title: "Data Fetching", url: "#", active: true },
      { id: "rendering", title: "Rendering", url: "#" },
      { id: "caching", title: "Caching", url: "#" },
      { id: "styling", title: "Styling", url: "#" },
      { id: "optimizing", title: "Optimizing", url: "#" },
      { id: "configuring", title: "Configuring", url: "#" },
      { id: "testing", title: "Testing", url: "#" },
      { id: "authentication", title: "Authentication", url: "#" },
      { id: "deploying", title: "Deploying", url: "#" },
      { id: "upgrading", title: "Upgrading", url: "#" },
      { id: "examples", title: "Examples", url: "#" },
    ],
  },
  {
    id: "api-reference",
    title: "API Reference",
    url: "#",
    items: [
      { id: "components", title: "Components", url: "#" },
      { id: "file-conventions", title: "File Conventions", url: "#" },
      { id: "functions", title: "Functions", url: "#" },
      { id: "next-config-js-options", title: "next.config.js Options", url: "#" },
      { id: "cli", title: "CLI", url: "#" },
      { id: "edge-runtime", title: "Edge Runtime", url: "#" },
    ],
  },
  {
    id: "architecture",
    title: "Architecture",
    url: "#",
    items: [
      { id: "accessibility", title: "Accessibility", url: "#" },
      { id: "fast-refresh", title: "Fast Refresh", url: "#" },
      { id: "nextjs-compiler", title: "Next.js Compiler", url: "#" },
      { id: "supported-browsers", title: "Supported Browsers", url: "#" },
      { id: "turbopack", title: "Turbopack", url: "#" },
    ],
  },
  {
    id: "community",
    title: "Community",
    url: "#",
    items: [{ id: "contribution-guide", title: "Contribution Guide", url: "#" }],
  },
