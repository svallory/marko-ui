// Port of shadcn's data-table.tsx (rendered as <DocumentsTable> here to
// avoid a name clash with the generic ui/data-table/data-table.marko
// registry part, which this file intentionally does NOT use — it composes
// raw Table/Tabs/Select/DropdownMenu/Checkbox/Drawer parts directly so the
// rendered DOM/classes match data-table.tsx's bespoke markup instead of the
// generic part's simplified column-driven shape).
//
// DEVIATIONS (registry/dependency gaps — noted, not silently dropped):
// - Drag-to-reorder (@dnd-kit/core + @dnd-kit/sortable + @dnd-kit/utilities
//   + @dnd-kit/modifiers in the source) has no equivalent dependency in
//   this package. The drag-handle column and its button are reproduced
//   verbatim (same classes/icon/sr-only text) but are inert — dragging
//   does not reorder rows. Row order is otherwise static.
// - Row selection, per-row target/limit edits, and the reviewer <Select>
//   are wired to local state (rowSelection map / editable inputs) but
//   nothing is persisted — same as the source, which also never persists
//   (its onSubmit just fires a toast).
// - Column visibility and pagination are plain local <let> state rather
//   than routed through @tanstack/table-core: the source's table has no
//   sorting/filtering, so constructTable's row model would sit unused
//   between this state and the manual render below — the sliced/filtered
//   array here IS the row model, just without the extra machinery.
// - The "Header" cell's <TableCellViewer> drawer reproduces the source's
//   non-mobile chart + form content using our Chart/AreaChart parts and
//   Drawer part.
// - Our dropdown-menu registry part has no DropdownMenuCheckboxItem
//   equivalent (a menuitemcheckbox row with a check-indicator, no visible
//   input). The column-visibility list renders a real <Checkbox> inside
//   each <@item>'s content instead — same toggle behavior, different
//   internal markup (an actual checkbox control, not an indicator icon).
import Tabs from "@marko-ui/shadcn/ui/tabs/tabs.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";
import Badge from "@marko-ui/shadcn/ui/badge/badge.marko";
import Checkbox from "@marko-ui/shadcn/ui/checkbox/checkbox.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";
import Separator from "@marko-ui/shadcn/ui/separator/separator.marko";
import Table from "@marko-ui/shadcn/ui/table/table.marko";
import TableHeader from "@marko-ui/shadcn/ui/table/header.marko";
import TableBody from "@marko-ui/shadcn/ui/table/body.marko";
import TableRow from "@marko-ui/shadcn/ui/table/row.marko";
import TableHead from "@marko-ui/shadcn/ui/table/head.marko";
import TableCell from "@marko-ui/shadcn/ui/table/cell.marko";
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import Drawer from "@marko-ui/shadcn/ui/drawer/drawer.marko";
import Chart from "@marko-ui/shadcn/ui/chart/chart.marko";
import AreaChart from "@marko-ui/shadcn/ui/chart/area.marko";
import { buttonVariants } from "@marko-ui/shadcn/ui/button/variants.ts";
import { cn } from "#lib/utils.ts";
import documentsData from "./data.json";

export interface DocumentRow {
  id: number;
  header: string;
  type: string;
  status: string;
  target: string;
  limit: string;
  reviewer: string;
}

static const data = documentsData as DocumentRow[];


static const columnIds = ["type", "status", "target", "limit", "reviewer"] as const;

static const viewItems = [
  { value: "outline", label: "Outline" },
  { value: "past-performance", label: "Past Performance" },
  { value: "key-personnel", label: "Key Personnel" },
  { value: "focus-documents", label: "Focus Documents" },
];

static const typeItems = [
  "Table of Contents",
  "Executive Summary",
  "Technical Approach",
  "Design",
  "Capabilities",
  "Focus Documents",
  "Narrative",
  "Cover Page",
].map((label) => ({ value: label, label }));

static const statusItems = ["Done", "In Progress", "Not Started"].map((label) => ({ value: label, label }));

static const reviewerItems = [
  { value: "Eddie Lake", label: "Eddie Lake" },
  { value: "Jamik Tashpulatov", label: "Jamik Tashpulatov" },
  { value: "Emily Whalen", label: "Emily Whalen" },
];

static const assignReviewerItems = [
  { value: "Eddie Lake", label: "Eddie Lake" },
  { value: "Jamik Tashpulatov", label: "Jamik Tashpulatov" },
];

static const chartData = [
  { month: "January", desktop: 186, mobile: 80 },
  { month: "February", desktop: 305, mobile: 200 },
  { month: "March", desktop: 237, mobile: 120 },
  { month: "April", desktop: 73, mobile: 190 },
  { month: "May", desktop: 209, mobile: 130 },
  { month: "June", desktop: 214, mobile: 140 },
];
static const drawerChartConfig = {
  desktop: { label: "Desktop", color: "var(--primary)" },
  mobile: { label: "Mobile", color: "var(--primary)" },
};

<let/rowSelection={} as Record<string, boolean>/>
<let/columnVisibility={} as Record<string, boolean>/>
<let/pagination={ pageIndex: 0, pageSize: 10 }/>
<let/currentView="outline"/>

<const/pageRows=(() => {
  const start = pagination.pageIndex * pagination.pageSize;
  return data.slice(start, start + pagination.pageSize);
})()/>
<const/pageCount=Math.max(1, Math.ceil(data.length / pagination.pageSize))/>
<const/selectedCount=Object.values(rowSelection).filter(Boolean).length/>
<const/allPageSelected=(pageRows.length > 0 && pageRows.every((row) => rowSelection[String(row.id)]))/>
<const/somePageSelected=(pageRows.some((row) => rowSelection[String(row.id)]) && !allPageSelected)/>

<const/toggleAllPageRows=(checked: boolean) => {
  const next = { ...rowSelection };
  for (const row of pageRows) {
    if (checked) next[String(row.id)] = true;
    else delete next[String(row.id)];
  }
  rowSelection = next;
}/>

<const/toggleRow=(id: number, checked: boolean) => {
  const key = String(id);
  const next = { ...rowSelection };
  if (checked) next[key] = true;
  else delete next[key];
  rowSelection = next;
}/>

<const/isColumnVisible=(id: string) => columnVisibility[id] !== false/>
<const/toggleColumn=(id: string, visible: boolean) => {
  columnVisibility = { ...columnVisibility, [id]: visible };
}/>

// The source's toolbar row (view <Select>, <TabsList>, column-visibility
// DropdownMenu + Add Section button) is three flex children sharing one
// row, with the middle child being the SAME <TabsList> that also switches
// panels below. Our <Tabs> part renders its trigger list as a fixed first
// child with no slot for siblings in that row, so it is called here with
// NO <@trigger> tags (only <@panel> tags drive the content), and the
// visual trigger list is rebuilt manually from the returned `tabsApi`
// getter using `tabsApi().getTriggerProps(...)` — same underlying machine,
// same data-slot="tabs-trigger" class string as the part's own list, just
// laid out inline with the Select/DropdownMenu/Button per the source.
<Tabs value:=currentView class="w-full flex-col justify-start gap-6">
<Tabs/tabsApi/>

  <div class="flex items-center justify-between px-4 lg:px-6">
    <Label for="view-selector" class="sr-only">View</Label>
    <Select
      items=viewItems
      value=[currentView]
      valueChange=(value) => { currentView = value[0] ?? "outline"; }
      class="flex w-fit @4xl/main:hidden"
      id="view-selector"
      placeholder="Select a view"
    />
    <div class="hidden **:data-[slot=badge]:size-5 **:data-[slot=badge]:rounded-full **:data-[slot=badge]:bg-muted-foreground/30 **:data-[slot=badge]:px-1 @4xl/main:flex" ...tabsApi().getListProps() data-slot="tabs-list">
      <button ...tabsApi().getTriggerProps({ value: "outline" }) data-slot="tabs-trigger" class="data-[selected]:bg-background data-[selected]:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 data-[selected]:shadow-sm">Outline</button>
      <button ...tabsApi().getTriggerProps({ value: "past-performance" }) data-slot="tabs-trigger" class="data-[selected]:bg-background data-[selected]:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 data-[selected]:shadow-sm">Past Performance <Badge variant="secondary">3</Badge></button>
      <button ...tabsApi().getTriggerProps({ value: "key-personnel" }) data-slot="tabs-trigger" class="data-[selected]:bg-background data-[selected]:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 data-[selected]:shadow-sm">Key Personnel <Badge variant="secondary">2</Badge></button>
      <button ...tabsApi().getTriggerProps({ value: "focus-documents" }) data-slot="tabs-trigger" class="data-[selected]:bg-background data-[selected]:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 inline-flex flex-1 items-center justify-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 data-[selected]:shadow-sm">Focus Documents</button>
    </div>
    <div class="flex items-center gap-2">
      <DropdownMenu class="w-56">
        <@trigger|props|>
          <button
            ...props
            type="button"
            data-slot="button"
            class=cn(buttonVariants({ variant: "outline", size: "sm" }))
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="7" x="3" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="14" rx="1"/>
              <rect width="7" height="7" x="3" y="14" rx="1"/>
            </svg>
            <span class="hidden lg:inline">Customize Columns</span>
            <span class="lg:hidden">Columns</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
        </@trigger>
        <for|columnId| of=columnIds>
          <@item type="item" value=columnId>
            <Checkbox
              checked=isColumnVisible(columnId)
              checkedChange=(checked) => toggleColumn(columnId, !!checked)
              class="capitalize w-full"
            >${columnId}</Checkbox>
          </@item>
        </for>
      </DropdownMenu>
      <button type="button" data-slot="button" class=buttonVariants({ variant: "outline", size: "sm" })>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/>
          <path d="M12 5v14"/>
        </svg>
        <span class="hidden lg:inline">Add Section</span>
      </button>
    </div>
  </div>

  <@panel value="outline">
    <div class="relative flex flex-col gap-4 overflow-auto px-4 lg:px-6">
      <div class="overflow-hidden rounded-lg border">
        <Table>
          <TableHeader class="sticky top-0 z-10 bg-muted">
            <TableRow>
              <TableHead class="w-8"></TableHead>
              <TableHead class="w-8">
                <div class="flex items-center justify-center">
                  <Checkbox
                    checked=(allPageSelected || (somePageSelected && "indeterminate"))
                    checkedChange=(checked) => toggleAllPageRows(!!checked)
                    aria-label="Select all"
                  />
                </div>
              </TableHead>
              <TableHead>Header</TableHead>
              <if=isColumnVisible("type")>
                <TableHead>Section Type</TableHead>
              </if>
              <if=isColumnVisible("status")>
                <TableHead>Status</TableHead>
              </if>
              <if=isColumnVisible("target")>
                <TableHead class="text-right">Target</TableHead>
              </if>
              <if=isColumnVisible("limit")>
                <TableHead class="text-right">Limit</TableHead>
              </if>
              <if=isColumnVisible("reviewer")>
                <TableHead>Reviewer</TableHead>
              </if>
              <TableHead></TableHead>
            </TableRow>
          </TableHeader>
          <TableBody class="**:data-[slot=table-cell]:first:w-8">
            <if=pageRows.length === 0>
              <TableRow>
                <TableCell colspan=8 class="h-24 text-center">No results.</TableCell>
              </TableRow>
            </if>
            <else>
              <for|row| of=pageRows by=(row) => row.id>
                <TableRow data-state=(rowSelection[String(row.id)] ? "selected" : undefined) class="relative z-0">
                  <TableCell>
                    <button
                      type="button"
                      data-slot="button"
                      class=cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-7 text-muted-foreground hover:bg-transparent")
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3 text-muted-foreground">
                        <circle cx="9" cy="5" r="1"/>
                        <circle cx="9" cy="12" r="1"/>
                        <circle cx="9" cy="19" r="1"/>
                        <circle cx="15" cy="5" r="1"/>
                        <circle cx="15" cy="12" r="1"/>
                        <circle cx="15" cy="19" r="1"/>
                      </svg>
                      <span class="sr-only">Drag to reorder</span>
                    </button>
                  </TableCell>
                  <TableCell>
                    <div class="flex items-center justify-center">
                      <Checkbox
                        checked=!!rowSelection[String(row.id)]
                        checkedChange=(checked) => toggleRow(row.id, !!checked)
                        aria-label="Select row"
                      />
                    </div>
                  </TableCell>
                  <TableCell>
                    <Drawer>
                      <@trigger|props|>
                        <button
                          ...props
                          type="button"
                          data-slot="button"
                          class=cn(buttonVariants({ variant: "link" }), "w-fit px-0 text-left text-foreground")
                        >
                          ${row.header}
                        </button>
                      </@trigger>
                      <@title>${row.header}</@title>
                      <@description>Showing total visitors for the last 6 months</@description>
                      <@content>
                        <div class="flex flex-col gap-4 text-sm">
                          <Chart config=drawerChartConfig>
                            <AreaChart
                              data=chartData
                              config=drawerChartConfig
                              xKey="month"
                              margin={ left: 0, right: 10 }
                              indicator="dot"
                              cursor=false
                            >
                              <@series dataKey="mobile" type="natural" stackId="a" fillOpacity=0.6/>
                              <@series dataKey="desktop" type="natural" stackId="a" fillOpacity=0.4/>
                            </AreaChart>
                          </Chart>
                          <Separator/>
                          <div class="grid gap-2">
                            <div class="flex gap-2 leading-none font-medium">
                              Trending up by 5.2% this month
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                                <path d="M16 7h6v6"/>
                                <path d="m22 7-8.5 8.5-5-5L2 17"/>
                              </svg>
                            </div>
                            <div class="text-muted-foreground">
                              Showing total visitors for the last 6 months. This is just
                              some random text to test the layout. It spans multiple lines
                              and should wrap around.
                            </div>
                          </div>
                          <Separator/>
                          <form class="flex flex-col gap-4">
                            <div class="flex flex-col gap-3">
                              <Label for=`${row.id}-header`>Header</Label>
                              <Input id=`${row.id}-header` value=row.header/>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                              <div class="flex flex-col gap-3">
                                <Label for=`${row.id}-type`>Type</Label>
                                <Select items=typeItems value=[row.type] placeholder="Select a type" class="w-full"/>
                              </div>
                              <div class="flex flex-col gap-3">
                                <Label for=`${row.id}-status`>Status</Label>
                                <Select items=statusItems value=[row.status] placeholder="Select a status" class="w-full"/>
                              </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                              <div class="flex flex-col gap-3">
                                <Label for=`${row.id}-target`>Target</Label>
                                <Input id=`${row.id}-target` value=row.target/>
                              </div>
                              <div class="flex flex-col gap-3">
                                <Label for=`${row.id}-limit`>Limit</Label>
                                <Input id=`${row.id}-limit` value=row.limit/>
                              </div>
                            </div>
                            <div class="flex flex-col gap-3">
                              <Label for=`${row.id}-reviewer`>Reviewer</Label>
                              <Select items=reviewerItems value=[row.reviewer] placeholder="Select a reviewer" class="w-full"/>
                            </div>
                          </form>
                        </div>
                      </@content>
                      <@footer>
                        <button type="submit" data-slot="button" class=buttonVariants({})>Submit</button>
                        <button type="button" data-slot="button" class=buttonVariants({ variant: "outline" })>Done</button>
                      </@footer>
                    </Drawer>
                  </TableCell>
                  <if=isColumnVisible("type")>
                    <TableCell>
                      <div class="w-32">
                        <Badge variant="outline" class="px-1.5 text-muted-foreground">${row.type}</Badge>
                      </div>
                    </TableCell>
                  </if>
                  <if=isColumnVisible("status")>
                    <TableCell>
                      <Badge variant="outline" class="px-1.5 text-muted-foreground">
                        <if=row.status === "Done">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="fill-green-500 dark:fill-green-400">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <path d="m9 11 3 3L22 4" fill="none" stroke="var(--background)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </if>
                        <else>
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                          </svg>
                        </else>
                        ${row.status}
                      </Badge>
                    </TableCell>
                  </if>
                  <if=isColumnVisible("target")>
                    <TableCell>
                      <form class="flex justify-end">
                        <Label for=`${row.id}-target-cell` class="sr-only">Target</Label>
                        <Input
                          class="h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30 dark:focus-visible:bg-input/30"
                          value=row.target
                          id=`${row.id}-target-cell`
                        />
                      </form>
                    </TableCell>
                  </if>
                  <if=isColumnVisible("limit")>
                    <TableCell>
                      <form class="flex justify-end">
                        <Label for=`${row.id}-limit-cell` class="sr-only">Limit</Label>
                        <Input
                          class="h-8 w-16 border-transparent bg-transparent text-right shadow-none hover:bg-input/30 focus-visible:border focus-visible:bg-background dark:bg-transparent dark:hover:bg-input/30 dark:focus-visible:bg-input/30"
                          value=row.limit
                          id=`${row.id}-limit-cell`
                        />
                      </form>
                    </TableCell>
                  </if>
                  <if=isColumnVisible("reviewer")>
                    <TableCell>
                      <if=row.reviewer !== "Assign reviewer">
                        ${row.reviewer}
                      </if>
                      <else>
                        <Label for=`${row.id}-reviewer-cell` class="sr-only">Reviewer</Label>
                        <Select
                          items=assignReviewerItems
                          placeholder="Assign reviewer"
                          class="w-38"
                          id=`${row.id}-reviewer-cell`
                        />
                      </else>
                    </TableCell>
                  </if>
                  <TableCell>
                    <DropdownMenu class="w-32">
                      <@trigger|props|>
                        <button
                          ...props
                          type="button"
                          data-slot="button"
                          class=cn(buttonVariants({ variant: "ghost", size: "icon" }), "flex size-8 text-muted-foreground data-[state=open]:bg-muted")
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="1"/>
                            <circle cx="19" cy="12" r="1"/>
                            <circle cx="5" cy="12" r="1"/>
                          </svg>
                          <span class="sr-only">Open menu</span>
                        </button>
                      </@trigger>
                      <@item type="item" value="edit" label="Edit"/>
                      <@item type="item" value="copy" label="Make a copy"/>
                      <@item type="item" value="favorite" label="Favorite"/>
                      <@item type="separator"/>
                      <@item type="item" value="delete" label="Delete" danger/>
                    </DropdownMenu>
                  </TableCell>
                </TableRow>
              </for>
            </else>
          </TableBody>
        </Table>
      </div>
      <div class="flex items-center justify-between px-4">
        <div class="hidden flex-1 text-sm text-muted-foreground lg:flex">
          ${selectedCount} of ${data.length} row(s) selected.
        </div>
        <div class="flex w-full items-center gap-8 lg:w-fit">
          <div class="hidden items-center gap-2 lg:flex">
            <Label for="rows-per-page" class="text-sm font-medium">Rows per page</Label>
            <Select
              items=[
                { value: "10", label: "10" },
                { value: "20", label: "20" },
                { value: "30", label: "30" },
                { value: "40", label: "40" },
                { value: "50", label: "50" },
              ]
              value=[String(pagination.pageSize)]
              valueChange=(value) => {
                pagination = { ...pagination, pageSize: Number(value[0] ?? 10), pageIndex: 0 };
              }
              class="w-20"
              id="rows-per-page"
            />
          </div>
          <div class="flex w-fit items-center justify-center text-sm font-medium">
            Page ${pagination.pageIndex + 1} of ${pageCount}
          </div>
          <div class="ml-auto flex items-center gap-2 lg:ml-0">
            <button
              type="button"
              data-slot="button"
              class=cn(buttonVariants({ variant: "outline" }), "hidden h-8 w-8 p-0 lg:flex")
              disabled=(pagination.pageIndex === 0)
              onClick() { pagination = { ...pagination, pageIndex: 0 }; }
            >
              <span class="sr-only">Go to first page</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m11 17-5-5 5-5"/>
                <path d="m18 17-5-5 5-5"/>
              </svg>
            </button>
            <button
              type="button"
              data-slot="button"
              class=cn(buttonVariants({ variant: "outline", size: "icon" }), "size-8")
              disabled=(pagination.pageIndex === 0)
              onClick() { pagination = { ...pagination, pageIndex: Math.max(0, pagination.pageIndex - 1) }; }
            >
              <span class="sr-only">Go to previous page</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </button>
            <button
              type="button"
              data-slot="button"
              class=cn(buttonVariants({ variant: "outline", size: "icon" }), "size-8")
              disabled=(pagination.pageIndex >= pageCount - 1)
              onClick() { pagination = { ...pagination, pageIndex: Math.min(pageCount - 1, pagination.pageIndex + 1) }; }
            >
              <span class="sr-only">Go to next page</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>
            <button
              type="button"
              data-slot="button"
              class=cn(buttonVariants({ variant: "outline", size: "icon" }), "hidden size-8 lg:flex")
              disabled=(pagination.pageIndex >= pageCount - 1)
              onClick() { pagination = { ...pagination, pageIndex: pageCount - 1 }; }
            >
              <span class="sr-only">Go to last page</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 17 5-5-5-5"/>
                <path d="m13 17 5-5-5-5"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </@panel>

  <@panel value="past-performance">
    <div class="flex flex-col px-4 lg:px-6">
      <div class="aspect-video w-full flex-1 rounded-lg border border-dashed"></div>
    </div>
  </@panel>
  <@panel value="key-personnel">
    <div class="flex flex-col px-4 lg:px-6">
      <div class="aspect-video w-full flex-1 rounded-lg border border-dashed"></div>
    </div>
  </@panel>
  <@panel value="focus-documents">
    <div class="flex flex-col px-4 lg:px-6">
      <div class="aspect-video w-full flex-1 rounded-lg border border-dashed"></div>
    </div>
  </@panel>
</Tabs>
