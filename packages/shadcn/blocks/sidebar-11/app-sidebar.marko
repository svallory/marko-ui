import Sidebar from "@marko-ui/shadcn/ui/sidebar/sidebar.marko";
import SidebarContent from "@marko-ui/shadcn/ui/sidebar/content.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/shadcn/ui/sidebar/group-label.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";
import Collapsible from "@marko-ui/shadcn/ui/collapsible/collapsible.marko";

export interface Input {
  open?: boolean;
}

export interface ChangedFile {
  file: string;
  state: string;
}

// A tree node is either a leaf file name or [folderName, ...children].
// A self-referencing `type TreeNode = string | TreeNode[]` alias also trips
// the parser (same landmine class as a bare top-level generic — see
// blocks/dashboard-01/documents-table.marko), and a bare (non-exported)
// `interface`/`type` at top level is rejected too (only `export interface`
// parses). So the recursive shape is left untyped here (`any`) and cast at
// each read site inside <Tree>.
export type TreeNode = any;

static const CHANGES: ChangedFile[] = [
  { file: "README.md", state: "M" },
  { file: "api/hello/route.ts", state: "U" },
  { file: "app/layout.tsx", state: "M" },
];

static const FILE_TREE: TreeNode[] = [
  [
    "app",
    ["api", ["hello", ["route.ts"]], "page.tsx", "layout.tsx", ["blog", ["page.tsx"]]],
  ],
  ["components", ["ui", "button.tsx", "card.tsx"], "header.tsx", "footer.tsx"],
  ["lib", ["util.ts"]],
  ["public", "favicon.ico", "vercel.svg"],
  ".eslintrc.json",
  ".gitignore",
  "next.config.js",
  "tailwind.config.js",
  "package.json",
  "README.md",
];

<define/FileIcon>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
  </svg>
</define>

<define/FolderIcon>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
  </svg>
</define>

<define/ChevronRightIcon|{ class: className }: { class?: string }|>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class=className
  >
    <path d="m9 18 6-6-6-6"/>
  </svg>
</define>

// Recursive file/folder tree, following the same recursive <define> pattern
// as ui/tree-view/tree-view.marko. Our sidebar sub-parts have no
// SidebarMenuSub equivalent yet, so nested levels are composed here from
// Collapsible + a plain <ul> indent wrapper (same deviation noted in
// blocks/sidebar-08/nav-main.marko).
<define/Tree|{ node }: { node: TreeNode }|>
  <const/parts=(Array.isArray(node) ? node : [node]) as TreeNode[]/>
  <const/name=parts[0] as string/>
  <const/children=parts.slice(1)/>

  <if=children.length === 0>
    <SidebarMenuButton active=(name === "button.tsx") class="data-[active=true]:bg-transparent">
      <FileIcon/>
      ${name}
    </SidebarMenuButton>
  </if>
  <else>
    <SidebarMenuItem>
      <Collapsible defaultOpen=(name === "components" || name === "ui") class="group/collapsible">
        <@trigger|attrs|>
          <SidebarMenuButton ...attrs>
            <ChevronRightIcon class="transition-transform group-data-[state=open]/collapsible:rotate-90"/>
            <FolderIcon/>
            ${name}
          </SidebarMenuButton>
        </@trigger>
        <@content>
          <ul class="mx-3.5 flex min-w-0 translate-x-px flex-col gap-1 border-l border-sidebar-border px-2.5 py-0.5">
            <for|childNode| of=children by=(_child, index) => index>
              <li class="group/menu-sub-item relative">
                <Tree node=childNode/>
              </li>
            </for>
          </ul>
        </@content>
      </Collapsible>
    </SidebarMenuItem>
  </else>
</define>

<Sidebar open=input.open>
  <@content>
    <SidebarContent>
      <SidebarGroup>
        <SidebarGroupLabel>Changes</SidebarGroupLabel>
        <div>
          <SidebarMenu>
            <for|item| of=CHANGES by=(entry) => entry.file>
              <SidebarMenuItem>
                <SidebarMenuButton>
                  <FileIcon/>
                  ${item.file}
                </SidebarMenuButton>
                // No SidebarMenuBadge equivalent yet — composed inline,
                // matching menu-button's own layout conventions.
                <div class="pointer-events-none absolute top-1.5 right-1 flex h-5 min-w-5 items-center justify-center rounded-md px-1 text-xs font-medium tabular-nums text-sidebar-foreground select-none">
                  ${item.state}
                </div>
              </SidebarMenuItem>
            </for>
          </SidebarMenu>
        </div>
      </SidebarGroup>
      <SidebarGroup>
        <SidebarGroupLabel>Files</SidebarGroupLabel>
        <div>
          <SidebarMenu>
            <for|node| of=FILE_TREE by=(_node, treeIndex) => treeIndex>
              <Tree node=node/>
            </for>
          </SidebarMenu>
        </div>
      </SidebarGroup>
    </SidebarContent>
  </@content>
</Sidebar>
