import VersionSwitcher from "./version-switcher.marko";
import SearchForm from "./search-form.marko";

export interface Input {
  open?: boolean;
}

export interface NavItem {
  title: string;
  url: string;
  active?: boolean;
}

export interface NavGroup {
  title: string;
  items: NavItem[];
}

static const VERSIONS = ["1.0.1", "1.1.0-alpha", "2.0.0-beta1"];

static const NAV_MAIN: NavGroup[] = [
  {
    title: "Getting Started",
    items: [
      { title: "Installation", url: "#" },
      { title: "Project Structure", url: "#" },
    ],
  },
  {
    title: "Build Your Application",
    items: [
      { title: "Routing", url: "#" },
      { title: "Data Fetching", url: "#", active: true },
      { title: "Rendering", url: "#" },
      { title: "Caching", url: "#" },
      { title: "Styling", url: "#" },
      { title: "Optimizing", url: "#" },
      { title: "Configuring", url: "#" },
      { title: "Testing", url: "#" },
      { title: "Authentication", url: "#" },
      { title: "Deploying", url: "#" },
      { title: "Upgrading", url: "#" },
      { title: "Examples", url: "#" },
    ],
  },
  {
    title: "API Reference",
    items: [
      { title: "Components", url: "#" },
      { title: "File Conventions", url: "#" },
      { title: "Functions", url: "#" },
      { title: "marko.config.js Options", url: "#" },
      { title: "CLI", url: "#" },
      { title: "Edge Runtime", url: "#" },
    ],
  },
  {
    title: "Architecture",
    items: [
