      { title: "Fast Refresh", url: "#" },
      { title: "Marko Compiler", url: "#" },
      { title: "Supported Browsers", url: "#" },
      { title: "Turbopack", url: "#" },
    ],
  },
];

<Sidebar open=input.open>
  <@content>
    <SidebarHeader>
      <VersionSwitcher versions=VERSIONS defaultVersion=VERSIONS[0]/>
      <SearchForm/>
    </SidebarHeader>
    <SidebarContent>
      <for|group| of=NAV_MAIN by=(group) => group.title>
        <SidebarGroup>
          <SidebarGroupLabel>${group.title}</SidebarGroupLabel>
          <SidebarMenu>
            <for|item| of=group.items by=(item) => item.title>
              <SidebarMenuItem>
                <SidebarMenuButton href=item.url active=item.active>${item.title}</SidebarMenuButton>
              </SidebarMenuItem>
            </for>
          </SidebarMenu>
        </SidebarGroup>
      </for>
    </SidebarContent>
  </@content>
</Sidebar>
