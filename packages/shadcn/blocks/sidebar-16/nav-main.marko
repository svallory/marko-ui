import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/shadcn/ui/sidebar/group-label.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";
import Collapsible from "@marko-ui/shadcn/ui/collapsible/collapsible.marko";

export interface NavMainLeafItem {
  id: string;
  title: string;
  url: string;
}

export interface NavMainItem {
  id: string;
  title: string;
  url: string;
  /** SVG path `d` attribute(s) for a 24x24 lucide-style icon, rendered inline. */
  icon: string;
  isActive?: boolean;
  items: NavMainLeafItem[];
}

export interface Input {
  items: NavMainItem[];
}

// NOTE: our sidebar sub-parts have no SidebarMenuSub / SidebarMenuSubButton
// equivalents yet, so the indented sub-menu list is composed here from
// Collapsible + plain markup, following the pattern established in
// blocks/sidebar-07/nav-main.marko. Deviation from the source, noted per
// block-porting rules.
//
// Our SidebarMenuButton also has no `tooltip` prop (the source's
// icon-only-collapsed hover tooltip), so it is omitted here.

<SidebarGroup>
  <SidebarGroupLabel>Platform</SidebarGroupLabel>
  <SidebarMenu>
    <for|item| of=input.items by=(item) => item.id>
      <Collapsible defaultOpen=(!!item.isActive) class="group/collapsible">
        <@trigger|attrs|>
          <SidebarMenuItem>
            <SidebarMenuButton ...attrs>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d=item.icon/>
              </svg>
              <span>${item.title}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-auto transition-transform duration-200 group-data-[state=open]/collapsible:rotate-90"
              >
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </@trigger>
        <ul
          class="mx-3.5 flex min-w-0 translate-x-px flex-col gap-1 border-l border-sidebar-border px-2.5 py-0.5"
        >
          <for|leaf| of=item.items by=(leaf) => leaf.id>
            <li class="group/menu-sub-item relative">
              <a
                href=leaf.url
                class="flex h-7 min-w-0 -translate-x-px items-center gap-2 overflow-hidden rounded-md px-2 text-sm text-sidebar-foreground outline-none ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground"
              >
                <span>${leaf.title}</span>
              </a>
            </li>
          </for>
        </ul>
      </Collapsible>
    </for>
  </SidebarMenu>
</SidebarGroup>
