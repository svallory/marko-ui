import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";

export interface NavMainLeafItem {
  id: string;
  title: string;
  url: string;
}

export interface NavMainItem {
  id: string;
  title: string;
  url: string;
  isActive?: boolean;
  items?: NavMainLeafItem[];
}

export interface Input {
  items: NavMainItem[];
}

// NOTE: shadcn's nav-main.tsx renders each sub-item as a real `<a href>`
// (via `DropdownMenuItem asChild`). Our DropdownMenu's items-array API has
// no per-item body/slot for arbitrary markup — its DropdownMenuItem always
// renders a non-semantic `<div>` — so a real anchor cannot be produced
// through this API. To keep sub-items keyed uniquely (by leaf.id, not the
// shared "#" placeholder url) and still navigable, each leaf's `value` is
// its own id and a `select` handler performs the navigation. Deviation from
// the source noted per block-porting rules; see NavMainLeafItem.id.

<SidebarGroup>
  <SidebarMenu>
    <for|item| of=input.items by=(item) => item.id>
      <const/leafById=new Map((item.items ?? []).map((leaf) => [leaf.id, leaf]))/>
      <const/dropdownItems=(item.items ?? []).map((leaf) => ({
        type: "item" as const,
        value: leaf.id,
        label: leaf.title,
      }))/>
      <SidebarMenuItem>
        <if=dropdownItems.length !== 0>
          <DropdownMenu
            items=dropdownItems
            select(value) {
              const leaf = leafById.get(value);
              if (leaf) {
                window.location.href = leaf.url;
              }
            }
          >
            <@trigger|triggerProps|>
              <SidebarMenuButton
                ...triggerProps
                class="data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground"
              >
                ${item.title}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-auto"
                >
                  <circle cx="12" cy="12" r="1"/>
                  <circle cx="19" cy="12" r="1"/>
                  <circle cx="5" cy="12" r="1"/>
                </svg>
              </SidebarMenuButton>
            </@trigger>
          </DropdownMenu>
        </if>
        <else>
          <SidebarMenuButton href=item.url>
            ${item.title}
          </SidebarMenuButton>
        </else>
      </SidebarMenuItem>
    </for>
  </SidebarMenu>
</SidebarGroup>
