{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#lib/*": ["./lib/*"]
    }
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.marko",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.marko",
    "../../tooling/style-map.ts",
    "../../tooling/apply-style-map.ts",
    "../../tooling/class-context-scan.ts",
    "../../tooling/resolve-classes.ts",
    "../../tooling/merge-classes.ts",
    "../../tooling/transform-component.ts",
    "../../tooling/check-classes.ts",
    "../../tooling/fs-utils.ts",
    "../../tooling/parity/harnesses/shadcn/upstream-shadcn.ts"
  ],
  // Imports the CLI transform from packages/marko-ui (its @/src alias pulls
  // that package's source graph, which this project does not list). Vitest
  // still runs it from the root config, which aliases @/src.
  "exclude": ["tests/icon-client-render.test.ts"]
}
