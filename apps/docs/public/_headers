# Response headers for the static docs deploy (Workers static assets).
#
# Parsed by Workers, never served as an asset itself. Two things to know
# before editing:
#   - Limits: 100 rules, 2,000 characters per line.
#   - These rules do NOT apply to responses generated by the Worker script
#     (apps/docs/worker/index.ts) — that code sets its own headers. The only
#     Worker-generated response here is the /no-js-form POST.
#
# Baseline for comparison: the Node deploy this replaces sent no CSP and no
# security headers at all, and served /r/*.json as `public, max-age=600`.

# ---------------------------------------------------------------------------
# Site-wide security headers.
#
# New relative to the Node deploy (which sent none). Deliberately limited to
# headers that cannot break a working page: no CSP is declared here, because
# this site inlines styles and scripts (Marko's resume payload, the
# theme-before-paint <html-script>) and a wrong CSP would silently break
# hydration. Adding one is worth doing, but as its own change with the report
# -only pass that needs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ---------------------------------------------------------------------------
# Hashed build output — JS, CSS and the woff2 font faces all land in /assets
# with a content hash in the filename, so the content at a given URL can never
# change. Immutable is safe and is the whole point of the hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# The registry the CLI installs from.
#
# `marko-ui add <component>` fetches these, so they must not be stale for long
# after a deploy, but they are also the hottest path on the site. 5 minutes
# fresh, then a day of serving stale while revalidating in the background.
/r/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# ---------------------------------------------------------------------------
# The two extensionless GET handler outputs (see
# apps/docs/scripts/prerender-handlers.ts).
#
# Content-Type is normally inferred from the file extension at upload time,
# and these files deliberately have none: they are written at the literal
# request path because Cloudflare matches non-HTML assets by exact pathname
# and has no index-file resolution for anything but .html. So the type MUST be
# declared here — without these rules both would be served as a download of
# unknown type rather than as CSS/Markdown.
/typeset/css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/docs/components/*/md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# The canonical markdown URL. `.md` IS a known extension, so the type is
# already right; this only pins the cacheability to match its /md twin and the
# HTML page it mirrors.
/docs/components/*.md
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
# HTML pages: always revalidate, so a deploy is visible immediately.
# This matches the Cloudflare default, stated explicitly so it survives any
# future change to that default.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
