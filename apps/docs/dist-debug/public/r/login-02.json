  "files": [
    {
      "path": "blocks/login-02/login-form.marko",
      "type": "registry:file",
      "target": "~/src/routes/login-02/login-form.marko",
      "content": "import Button from \"../../components/ui/button/button.marko\";\nimport FieldGroup from \"../../components/ui/field/field-group.marko\";\nimport Field from \"../../components/ui/field/field.marko\";\nimport FieldLabel from \"../../components/ui/field/field-label.marko\";\nimport FieldDescription from \"../../components/ui/field/field-description.marko\";\nimport FieldSeparator from \"../../components/ui/field/field-separator.marko\";\nimport TextField from \"../../components/ui/input/input.marko\";\nimport { cn } from \"../../lib/utils.ts\";\n\nexport interface Input extends Marko.Input<\"form\"> {}\n\n<const/{ class: className, content: _content, ...rest }=input/>\n\n<form ...rest class=cn(\"flex flex-col gap-6\", className)>\n  <FieldGroup>\n    <div class=\"flex flex-col items-center gap-1 text-center\">\n      <h1 class=\"text-2xl font-bold\">Login to your account</h1>\n      <p class=\"text-sm text-balance text-muted-foreground\">\n        Enter your email below to login to your account\n      </p>\n    </div>\n    <Field>\n      <FieldLabel for=\"login-email\">Email</FieldLabel>\n      <TextField id=\"login-email\" name=\"email\" type=\"email\" placeholder=\"m@example.com\" required/>\n    </Field>\n    <Field>\n      <div class=\"flex items-center\">\n        <FieldLabel for=\"login-password\">Password</FieldLabel>\n        <a href=\"#\" class=\"ml-auto text-sm underline-offset-4 hover:underline\">\n          Forgot your password?\n        </a>\n      </div>\n      <TextField id=\"login-password\" name=\"password\" type=\"password\" required/>\n    </Field>\n    <Field>\n      <Button type=\"submit\">Login</Button>\n    </Field>\n    <FieldSeparator>Or continue with</FieldSeparator>\n    <Field>\n      <Button variant=\"outline\" type=\"button\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" class=\"size-4\">\n          <path\n            d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\"\n            fill=\"currentColor\"\n          />\n        </svg>\n        Login with GitHub\n      </Button>\n      <FieldDescription class=\"text-center\">\n        Don't have an account?\n        <a href=\"#\" class=\"underline underline-offset-4\">Sign up</a>\n      </FieldDescription>\n    </Field>\n  </FieldGroup>\n</form>\n"
    },
    {
      "path": "blocks/login-02/page.marko",
      "type": "registry:file",
      "target": "~/src/routes/login-02/+page.marko",
      "content": "import LoginForm from \"./login-form.marko\";\n\n<div class=\"grid min-h-svh lg:grid-cols-2\">\n  <div class=\"flex flex-col gap-4 p-6 md:p-10\">\n    <div class=\"flex justify-center gap-2 md:justify-start\">\n      <a href=\"#\" class=\"flex items-center gap-2 font-medium\">\n        <div class=\"flex size-6 items-center justify-center rounded-md bg-primary text-primary-foreground\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"size-4\"\n          >\n            <path d=\"M7 2h10\"/>\n            <path d=\"M5 6h14\"/>\n            <rect width=\"18\" height=\"12\" x=\"3\" y=\"10\" rx=\"2\"/>\n          </svg>\n        </div>\n        Acme Inc.\n      </a>\n    </div>\n    <div class=\"flex flex-1 items-center justify-center\">\n      <div class=\"w-full max-w-xs\">\n        <LoginForm/>\n      </div>\n    </div>\n  </div>\n  <div class=\"relative hidden bg-muted lg:block\">\n    <img\n      src=\"/placeholder.svg\"\n      alt=\"Image\"\n      class=\"absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale\"\n    />\n  </div>\n</div>\n"
    }
  ]
}