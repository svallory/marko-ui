{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "date-picker",
  "type": "registry:ui",
  "title": "Date Picker",
  "description": "A popover-style date field that combines a text input and a calendar for selecting a date.",
  "dependencies": [
    "@internationalized/date",
    "@zag-js/date-picker",
    "marko-zag"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json",
    "http://localhost:3000/r/styles/luma/icon.json"
  ],
  "files": [
    {
      "path": "ui/date-picker/date-picker.marko",
      "type": "registry:file",
      "target": "~/src/components/ui/date-picker/date-picker.marko",
      "content": "import * as datePickerMachine from \"@zag-js/date-picker\";\nimport { parse } from \"@zag-js/date-picker\";\nimport type { MachineInput } from \"marko-zag\";\nimport { positionerStyle } from \"marko-zag\";\nimport Icon from \"../icon/icon.marko\";\nimport { cn } from \"../../../lib/utils.ts\";\nimport { stripOwnProps } from \"../../../lib/native-attrs.ts\";\n\n// `value`/`valueChange` use a plain ISO string instead of Zag's DateValue so\n// consumers don't need @internationalized/date.\nexport type Input = Omit<MachineInput<\"div\", datePickerMachine.Props>, \"value\"> & {\n  /** The selected date as an ISO date string (`YYYY-MM-DD`). */\n  value?: string;\n  /** Function called when the value changes. Receives the new ISO date string, or `undefined` when cleared. */\n  valueChange?: (value: string | undefined) => void;\n};\n\n<machine-props/pickedProps from=input pick=datePickerMachine.props\n  onValueChange(details: datePickerMachine.ValueChangeDetails) {\n    input.onValueChange?.(details);\n    input.valueChange?.(details.value[0]?.toString());\n  }/>\n<const/machineProps=() => ({\n  ...pickedProps(),\n  value: input.value ? [parse(input.value)] : undefined,\n})/>\n<service/service machine=() => datePickerMachine.machine props=machineProps/>\n<connect/api=(service, normalizeProps) =>\n  datePickerMachine.connect(service, normalizeProps)\n  service=service\n/>\n\n// `value` is deliberately remapped to an ISO date string on this component's\n// public Input, so `input` does not satisfy `splitProps`'s\n// `Partial<DatePickerProps>` constraint. It is a machine-owned key that\n// `splitProps` would strip from the leftover anyway — drop it first and the\n// call type-checks on the keys it actually partitions.\n<const/splitSource=() => {\n  const { value, ...rest } = input;\n  return rest;\n}/>\n<const/nativeAttrs=() =>\n  stripOwnProps(\n    datePickerMachine.splitProps(splitSource())[1],\n    \"class\",\n    \"valueChange\",\n  )\n>\n\n<const/weeks=() =>\n  api().weeks.map((week) =>\n    week.map((date) => {\n      const cellState = api().getDayTableCellState({ value: date });\n      return {\n        cell: api().getDayTableCellProps({ value: date }),\n        trigger: api().getDayTableCellTriggerProps({ value: date }),\n        label: String(date.day),\n        selected: cellState.selected,\n        today: cellState.today,\n        outsideRange: cellState.outsideRange,\n        disabled: cellState.disabled,\n        unavailable: cellState.unavailable,\n      };\n    }),\n  )\n/>\n\n<div ...nativeAttrs() ...api().getRootProps() data-slot=\"date-picker\" class=cn(input.class)>\n  <div ...api().getControlProps() data-slot=\"date-picker-control\" class=\"flex gap-2\">\n    <input\n      ...api().getInputProps()\n      data-slot=\"date-picker-input\"\n      class=\"file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 border-input flex h-9 w-[240px] min-w-0 rounded-md border bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive\"\n    />\n    <button\n      ...api().getTriggerProps()\n      data-slot=\"date-picker-trigger\"\n      class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 size-9\"\n    >\n      <Icon name=\"Calendar\"/>\n      <span class=\"sr-only\">Open calendar</span>\n    </button>\n  </div>\n  <portal>\n    <if=api().open>\n      <div ...api().getPositionerProps() style=positionerStyle data-slot=\"date-picker-positioner\" class=\"z-50\">\n        <div\n          ...api().getContentProps()\n          data-slot=\"date-picker-content\"\n          class=\"bg-popover text-popover-foreground rounded-md border p-3 shadow-md z-50\"\n        >\n          <div ...api().getViewControlProps() data-slot=\"date-picker-view-control\" class=\"flex items-center justify-between pb-2\">\n            <button\n              ...api().getPrevTriggerProps()\n              data-slot=\"date-picker-prev-trigger\"\n              class=\"inline-flex size-7 items-center justify-center rounded-md border bg-transparent p-0 opacity-70 hover:opacity-100 disabled:pointer-events-none disabled:opacity-30\"\n            >\n              <Icon name=\"ChevronLeft\"/>\n              <span class=\"sr-only\">Previous</span>\n            </button>\n            <button\n              ...api().getViewTriggerProps()\n              data-slot=\"date-picker-view-trigger\"\n              class=\"text-sm font-medium hover:underline\"\n            >\n              ${api().visibleRangeText.start}\n            </button>\n            <button\n              ...api().getNextTriggerProps()\n              data-slot=\"date-picker-next-trigger\"\n              class=\"inline-flex size-7 items-center justify-center rounded-md border bg-transparent p-0 opacity-70 hover:opacity-100 disabled:pointer-events-none disabled:opacity-30\"\n            >\n              <Icon name=\"ChevronRight\"/>\n              <span class=\"sr-only\">Next</span>\n            </button>\n          </div>\n          <table ...api().getTableProps() data-slot=\"date-picker-table\" class=\"w-full border-collapse space-y-1\">\n            <thead ...api().getTableHeadProps() data-slot=\"date-picker-table-head\">\n              <tr>\n                <for|weekDay| of=api().weekDays>\n                  <th class=\"text-muted-foreground w-9 rounded-md text-[0.8rem] font-normal\">\n                    ${weekDay.narrow}\n                    <span class=\"sr-only\">${weekDay.long}</span>\n                  </th>\n                </for>\n              </tr>\n            </thead>\n            <tbody ...api().getTableBodyProps() data-slot=\"date-picker-table-body\">\n              <for|week, i| of=weeks() by=(_, i) => `week:${i}`>\n                <tr>\n                  <for|day, j| of=week by=(_, j) => `day:${j}`>\n                    <td\n                      ...day.cell\n                      data-slot=\"date-picker-cell\"\n                      class=\"p-0 text-center text-sm relative\"\n                    >\n                      <button\n                        ...day.trigger\n                        data-slot=\"date-picker-day\"\n                        class=cn(\n                          \"size-8 rounded-md p-0 text-sm font-normal transition-colors hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-50\",\n                          \"data-[selected]:bg-primary data-[selected]:text-primary-foreground data-[selected]:hover:bg-primary data-[selected]:hover:text-primary-foreground\",\n                          \"data-[today]:bg-accent data-[today]:text-accent-foreground\",\n                          \"data-[outside-range]:text-muted-foreground\",\n                        )\n                      >\n                        ${day.label}\n                      </button>\n                    </td>\n                  </for>\n                </tr>\n              </for>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </if>\n  </portal>\n</div>\n\n<return=api>\n"
    }
  ]
}