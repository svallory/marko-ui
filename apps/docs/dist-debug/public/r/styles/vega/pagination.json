{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pagination",
  "type": "registry:ui",
  "title": "Pagination",
  "description": "Pagination with page navigation, next and previous links.",
  "dependencies": [
    "@zag-js/pagination",
    "class-variance-authority",
    "marko-ui",
    "marko-zag"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json",
    "http://localhost:3000/r/styles/vega/button.json"
  ],
  "files": [
    {
      "path": "ui/pagination/pagination.marko",
      "type": "registry:file",
      "target": "~/src/components/ui/pagination/pagination.marko",
      "content": "import * as paginationMachine from \"@zag-js/pagination\";\nimport type { MachineInput } from \"marko-zag\";\nimport { buttonVariants } from \"../button/variants.ts\";\nimport { cn } from \"../../../lib/utils.ts\";\nimport { stripOwnProps } from \"../../../lib/native-attrs.ts\";\n\nexport type Input = MachineInput<\"nav\", paginationMachine.Props> & {\n  pageChange?: (page: number) => void;\n};\n\n<machine-props/machineProps from=input pick=paginationMachine.props\n  onPageChange(details: paginationMachine.PageChangeDetails) {\n    input.onPageChange?.(details);\n    input.pageChange?.(details.page);\n  }/>\n<service/service machine=() => paginationMachine.machine props=machineProps/>\n<connect/api=(service, normalizeProps) =>\n  paginationMachine.connect(service, normalizeProps)\n  service=service\n/>\n\n<const/nativeAttrs=() =>\n  stripOwnProps(paginationMachine.splitProps(input)[1], \"class\", \"pageChange\")\n>\n\n<nav\n  ...nativeAttrs()\n  ...api().getRootProps()\n  role=\"navigation\"\n  aria-label=\"pagination\"\n  data-slot=\"pagination\"\n  class=cn(\"mx-auto flex w-full justify-center\", input.class)\n>\n  <ul data-slot=\"pagination-content\" class=\"gap-1 flex items-center\">\n    <li data-slot=\"pagination-item\">\n      <button\n        ...api().getPrevTriggerProps()\n        data-slot=\"pagination-link\"\n        aria-label=\"Go to previous page\"\n        class=cn(buttonVariants({ variant: \"ghost\", size: \"default\" }), \"pl-2!\")\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"24\"\n          height=\"24\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"mu-rtl-flip\"\n        >\n          <path d=\"m15 18-6-6 6-6\"/>\n        </svg>\n        <span class=\"hidden sm:block\">Previous</span>\n      </button>\n    </li>\n    <for|item, index| of=api().pages by=(item, index) => item.type === \"page\" ? `page-${item.value}` : `ellipsis-${index}`>\n      <if=item.type === \"page\">\n        <const/isActive=item.value === api().page>\n        <li data-slot=\"pagination-item\">\n          <button\n            ...api().getItemProps({ type: \"page\", value: item.value })\n            data-slot=\"pagination-link\"\n            aria-current=(isActive ? \"page\" : undefined)\n            data-active=(isActive ? \"true\" : undefined)\n            class=cn(buttonVariants({ variant: isActive ? \"outline\" : \"ghost\", size: \"icon\" }), \"\")\n          >\n            ${item.value}\n          </button>\n        </li>\n      </if>\n      <else>\n        <li data-slot=\"pagination-item\">\n          <span\n            ...api().getEllipsisProps({ index })\n            aria-hidden=\"true\"\n            data-slot=\"pagination-ellipsis\"\n            class=\"size-9 [&_svg:not([class*='size-'])]:size-4 flex items-center justify-center\"\n          >\n            &hellip;\n            <span class=\"sr-only\">More pages</span>\n          </span>\n        </li>\n      </else>\n    </for>\n    <li data-slot=\"pagination-item\">\n      <button\n        ...api().getNextTriggerProps()\n        data-slot=\"pagination-link\"\n        aria-label=\"Go to next page\"\n        class=cn(buttonVariants({ variant: \"ghost\", size: \"default\" }), \"pr-2!\")\n      >\n        <span class=\"hidden sm:block\">Next</span>\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"24\"\n          height=\"24\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"mu-rtl-flip\"\n        >\n          <path d=\"m9 18 6-6-6-6\"/>\n        </svg>\n      </button>\n    </li>\n  </ul>\n</nav>\n\n<return=api>\n"
    }
  ]
}