{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "number-input",
  "type": "registry:ui",
  "title": "Number Input",
  "description": "A number input with increment/decrement steppers, min/max/step constraints, and a scrub area.",
  "dependencies": [
    "@zag-js/number-input",
    "marko-zag"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json",
    "http://localhost:3000/r/styles/nova/icon.json"
  ],
  "files": [
    {
      "path": "ui/number-input/number-input.marko",
      "type": "registry:file",
      "target": "~/src/components/ui/number-input/number-input.marko",
      "content": "import * as numberInputMachine from \"@zag-js/number-input\";\nimport type { MachineInput } from \"marko-zag\";\nimport Icon from \"../icon/icon.marko\";\nimport { cn } from \"../../../lib/utils.ts\";\nimport { stripOwnProps } from \"../../../lib/native-attrs.ts\";\n\nexport type Input = MachineInput<\"input\", numberInputMachine.Props> & {\n  valueChange?: (value: string) => void;\n};\n\n<machine-props/machineProps from=input pick=numberInputMachine.props\n  onValueChange(details: numberInputMachine.ValueChangeDetails) {\n    input.onValueChange?.(details);\n    input.valueChange?.(details.value);\n  }/>\n<service/service machine=() => numberInputMachine.machine props=machineProps/>\n<connect/api=(service, normalizeProps) =>\n  numberInputMachine.connect(service, normalizeProps)\n  service=service\n/>\n\n<const/nativeAttrs=() =>\n  stripOwnProps(\n    numberInputMachine.splitProps(input)[1],\n    \"class\",\n    \"valueChange\",\n  )\n>\n\n<div\n  ...api().getRootProps()\n  data-slot=\"number-input\"\n  class=cn(\n    \"border-input dark:bg-input/30 flex h-9 w-fit items-stretch overflow-hidden rounded-md border shadow-xs transition-[color,box-shadow]\",\n    \"has-[input:focus-visible]:border-ring has-[input:focus-visible]:ring-ring/50 has-[input:focus-visible]:ring-[3px]\",\n    \"has-[input:disabled]:pointer-events-none has-[input:disabled]:opacity-50\",\n    \"has-[input[aria-invalid=true]]:ring-destructive/20 dark:has-[input[aria-invalid=true]]:ring-destructive/40 has-[input[aria-invalid=true]]:border-destructive\",\n    input.class,\n  )\n>\n  <button\n    ...api().getDecrementTriggerProps()\n    data-slot=\"number-input-decrement\"\n    class=\"text-muted-foreground hover:bg-accent hover:text-accent-foreground flex w-8 shrink-0 items-center justify-center border-r border-input transition-colors disabled:pointer-events-none disabled:opacity-50\"\n  >\n    <Icon name=\"Minus\" class=\"size-4\"/>\n  </button>\n  <div ...api().getControlProps() data-slot=\"number-input-control\" class=\"relative flex-1\">\n    <input\n      ...nativeAttrs()\n      ...api().getInputProps()\n      data-slot=\"number-input-field\"\n      class=\"file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground flex h-full w-full min-w-0 bg-transparent px-3 py-1 text-center text-base outline-none disabled:cursor-not-allowed md:text-sm\"\n    />\n    <div\n      ...api().getScrubberProps()\n      data-slot=\"number-input-scrubber\"\n      class=\"absolute inset-x-0 bottom-0 z-10 h-1.5 data-[disabled]:hidden\"\n    />\n  </div>\n  <button\n    ...api().getIncrementTriggerProps()\n    data-slot=\"number-input-increment\"\n    class=\"text-muted-foreground hover:bg-accent hover:text-accent-foreground flex w-8 shrink-0 items-center justify-center border-l border-input transition-colors disabled:pointer-events-none disabled:opacity-50\"\n  >\n    <Icon name=\"Plus\" class=\"size-4\"/>\n  </button>\n</div>\n\n<return=api>\n"
    }
  ]
}