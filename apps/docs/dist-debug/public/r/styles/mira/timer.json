{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "timer",
  "type": "registry:ui",
  "title": "Timer",
  "description": "A countdown or stopwatch timer with segmented digit display and start/pause/resume/reset controls.",
  "dependencies": [
    "@zag-js/timer",
    "marko-zag"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json"
  ],
  "files": [
    {
      "path": "ui/timer/timer.marko",
      "type": "registry:file",
      "target": "~/src/components/ui/timer/timer.marko",
      "content": "// Countdown / stopwatch timer.\n// Guide: /docs/creating-components · authoring rules: notes/component-authoring.md\nimport * as timerMachine from \"@zag-js/timer\";\nimport type { MachineInput } from \"marko-zag\";\nimport { cn } from \"../../../lib/utils.ts\";\nimport { stripOwnProps } from \"../../../lib/native-attrs.ts\";\n\nexport type Input = MachineInput<\"div\", timerMachine.Props> & {\n  tickChange?: (details: timerMachine.TickDetails) => void;\n  complete?: () => void;\n  /** Time parts to render as digit segments, in order. */\n  parts?: timerMachine.TimePart[];\n};\n\nstatic const defaultParts: timerMachine.TimePart[] = [\"hours\", \"minutes\", \"seconds\"];\n\n<machine-props/machineProps from=input pick=timerMachine.props\n  onTick(details: timerMachine.TickDetails) {\n    input.onTick?.(details);\n    input.tickChange?.(details);\n  }\n  onComplete() {\n    input.onComplete?.();\n    input.complete?.();\n  }/>\n<service/service machine=() => timerMachine.machine props=machineProps/>\n<connect/api=(service, normalizeProps) =>\n  timerMachine.connect(service, normalizeProps)\n  service=service\n/>\n\n<const/nativeAttrs=() =>\n  stripOwnProps(\n    timerMachine.splitProps(input)[1],\n    \"class\",\n    \"tickChange\",\n    \"complete\",\n    \"parts\",\n  )\n>\n\n<const/timeParts=input.parts || defaultParts>\n\n<div\n  ...nativeAttrs()\n  ...api().getRootProps()\n  data-slot=\"timer\"\n  class=cn(\"flex flex-col items-center gap-4 rounded-xl border bg-card py-6 text-card-foreground shadow-sm\", input.class)\n>\n  <div ...api().getAreaProps() data-slot=\"timer-area\" class=\"flex items-center gap-1\">\n    <for|part, index| of=timeParts>\n      <if=index>\n        <span ...api().getSeparatorProps() data-slot=\"timer-separator\" class=\"pb-4 text-2xl font-semibold text-muted-foreground\">:</span>\n      </if>\n      <div ...api().getItemProps({ type: part }) data-slot=\"timer-item\" class=\"flex flex-col items-center gap-1\">\n        <span\n          ...api().getItemValueProps({ type: part })\n          data-slot=\"timer-item-value\"\n          class=\"flex h-14 min-w-14 items-center justify-center rounded-md border bg-muted px-2 font-mono text-3xl font-semibold tabular-nums text-foreground\"\n        >\n          ${api().formattedTime[part]}\n        </span>\n        <span\n          ...api().getItemLabelProps({ type: part })\n          data-slot=\"timer-item-label\"\n          class=\"text-xs font-medium uppercase tracking-wide text-muted-foreground\"\n        >\n          ${part}\n        </span>\n      </div>\n    </for>\n  </div>\n  <div ...api().getControlProps() data-slot=\"timer-control\" class=\"flex items-center gap-2\">\n    <if=!api().running && !api().paused>\n      <button\n        ...api().getActionTriggerProps({ action: \"start\" })\n        data-slot=\"timer-action\"\n        type=\"button\"\n        class=\"inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50\"\n      >\n        Start\n      </button>\n    </if>\n    <if=api().running>\n      <button\n        ...api().getActionTriggerProps({ action: \"pause\" })\n        data-slot=\"timer-action\"\n        type=\"button\"\n        class=\"inline-flex h-9 items-center justify-center rounded-md border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50\"\n      >\n        Pause\n      </button>\n    </if>\n    <if=api().paused>\n      <button\n        ...api().getActionTriggerProps({ action: \"resume\" })\n        data-slot=\"timer-action\"\n        type=\"button\"\n        class=\"inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50\"\n      >\n        Resume\n      </button>\n    </if>\n    <button\n      ...api().getActionTriggerProps({ action: \"reset\" })\n      data-slot=\"timer-action\"\n      type=\"button\"\n      class=\"inline-flex h-9 items-center justify-center rounded-md border bg-background px-4 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50\"\n    >\n      Reset\n    </button>\n  </div>\n</div>\n\n<return=api>\n"
    }
  ]
}