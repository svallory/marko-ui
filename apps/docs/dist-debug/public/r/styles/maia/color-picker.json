{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "color-picker",
  "type": "registry:ui",
  "title": "Color Picker",
  "description": "A color picker with a saturation area, channel sliders, channel inputs, an eyedropper and preset swatches.",
  "dependencies": [
    "@zag-js/color-picker",
    "marko-zag"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json"
  ],
  "files": [
    {
      "path": "ui/color-picker/color-picker.marko",
      "type": "registry:file",
      "target": "~/src/components/ui/color-picker/color-picker.marko",
      "content": "// Full color picker built on the REAL @zag-js/color-picker machine:\n// saturation/brightness area, channel sliders, channel inputs, eyedropper,\n// format switching and swatch presets.\n// Authoring rules: notes/component-authoring.md (v2 pattern)\nimport * as colorPickerMachine from \"@zag-js/color-picker\";\nimport type { MachineInput } from \"marko-zag\";\nimport { positionerStyle } from \"marko-zag\";\nimport { cn } from \"../../../lib/utils.ts\";\nimport { stripOwnProps } from \"../../../lib/native-attrs.ts\";\n\nexport type Input = Omit<\n  MachineInput<\"div\", colorPickerMachine.Props>,\n  \"value\" | \"defaultValue\"\n> & {\n  /** Color value — a CSS color string or a Zag `Color` object. */\n  value?: string | colorPickerMachine.Color;\n  /** Initial color value — a CSS color string or a Zag `Color` object. */\n  defaultValue?: string | colorPickerMachine.Color;\n  /** Sugar for onValueChange — receives the color as a string, enables `value:=state`. */\n  valueChange?: (valueAsString: string) => void;\n  /** Sugar for onValueChangeEnd — fires when the user stops dragging. */\n  valueChangeEnd?: (valueAsString: string) => void;\n  /** Sugar for onOpenChange — receives the plain boolean, enables `open:=state`. */\n  openChange?: (open: boolean) => void;\n  /** Sugar for onFormatChange — receives the plain format. */\n  formatChange?: (format: colorPickerMachine.ColorFormat) => void;\n  /** Visible label rendered above the control. */\n  label?: Marko.Body;\n  /** Preset swatch colors rendered under the channel inputs. */\n  swatches?: string[];\n  /** Hide the eyedropper button even where the browser supports it. */\n  hideEyeDropper?: boolean;\n  /** Hide the format select shown next to the channel inputs. */\n  hideFormatSelect?: boolean;\n};\n\nstatic const FORMATS = [\"rgba\", \"hsla\", \"hsba\"] as const;\n\n// Which channel inputs to render for the active format. `hex` + `alpha` is the\n// compact default the shadcn visual language wants; the other formats expose\n// their three numeric channels plus alpha.\nstatic const CHANNELS_BY_FORMAT: Record<string, string[]> = {\n  rgba: [\"hex\", \"alpha\"],\n  hsla: [\"hue\", \"saturation\", \"lightness\", \"alpha\"],\n  hsba: [\"hue\", \"saturation\", \"brightness\", \"alpha\"],\n};\n\n<machine-props/machineProps from=input pick=colorPickerMachine.props\n  onValueChange(details: colorPickerMachine.ValueChangeDetails) {\n    input.onValueChange?.(details);\n    input.valueChange?.(details.valueAsString);\n  }\n  onValueChangeEnd(details: colorPickerMachine.ValueChangeDetails) {\n    input.onValueChangeEnd?.(details);\n    input.valueChangeEnd?.(details.valueAsString);\n  }\n  onOpenChange(details: colorPickerMachine.OpenChangeDetails) {\n    input.onOpenChange?.(details);\n    input.openChange?.(details.open);\n  }\n  onFormatChange(details: colorPickerMachine.FormatChangeDetails) {\n    input.onFormatChange?.(details);\n    input.formatChange?.(details.format);\n  }/>\n// `value`/`defaultValue` are widened to accept CSS color strings, but the\n// machine only understands `Color` objects — and a `Color` may never cross tag\n// input (it is not Marko-serializable). Parsing therefore happens INSIDE this\n// props closure, which <service> calls rather than serializes.\n// The keys must be OMITTED rather than set to undefined when unset: the\n// machine spreads the caller's props over its own defaults, so an explicit\n// `defaultValue: undefined` would clobber Zag's DEFAULT_COLOR and crash.\n<const/colorProps=() => {\n  const resolved: Record<string, unknown> = { ...machineProps() };\n  for (const key of [\"value\", \"defaultValue\"]) {\n    const raw = resolved[key];\n    if (raw === undefined) delete resolved[key];\n    else if (typeof raw === \"string\") resolved[key] = colorPickerMachine.parse(raw);\n  }\n  return resolved;\n}>\n<service/service machine=() => colorPickerMachine.machine props=colorProps/>\n<connect/api=(service, normalizeProps) =>\n  colorPickerMachine.connect(service, normalizeProps)\n  service=service\n/>\n\n// Whatever is neither machine-owned (splitProps) nor component-owned passes\n// through to the hidden input: aria-*, data-*, form attributes... Leaking a\n// component-owned prop here would stringify it into a bogus DOM attribute.\n// `value`/`defaultValue` are deliberately widened to `string | Color` on this\n// component's public Input (callers may pass a CSS color string), so `input` does not\n// satisfy `splitProps`'s `Partial<ColorPickerProps>` constraint. It is a\n// Both are machine-owned keys that `splitProps` would strip from the leftover\n// anyway — drop them first and the call type-checks on the keys it partitions.\n<const/splitSource=() => {\n  const { value, defaultValue, ...rest } = input;\n  return rest;\n}/>\n<const/nativeAttrs=() =>\n  stripOwnProps(\n    colorPickerMachine.splitProps(splitSource())[1],\n    \"class\",\n    \"valueChange\",\n    \"valueChangeEnd\",\n    \"openChange\",\n    \"formatChange\",\n    \"label\",\n    \"swatches\",\n    \"hideEyeDropper\",\n    \"hideFormatSelect\",\n  )\n>\n\n<const/channels=() => CHANNELS_BY_FORMAT[api().format] ?? CHANNELS_BY_FORMAT.rgba>\n\n<div\n  ...nativeAttrs()\n  ...api().getRootProps()\n  data-slot=\"color-picker\"\n  class=cn(\"flex w-56 flex-col gap-2\", input.class)\n>\n  <if=input.label>\n    <label\n      ...api().getLabelProps()\n      data-slot=\"color-picker-label\"\n      class=\"text-sm leading-none font-medium select-none data-[disabled]:opacity-50\"\n    >\n      <${input.label}/>\n    </label>\n  </if>\n\n  <div\n    ...api().getControlProps()\n    data-slot=\"color-picker-control\"\n    class=\"flex items-center gap-2\"\n  >\n    // Render-prop-free trigger: this button IS the swatch, so it owns no\n    // caller content and cannot nest another button.\n    <button\n      ...api().getTriggerProps()\n      data-slot=\"color-picker-trigger\"\n      class=\"border-input focus-visible:border-ring focus-visible:ring-ring/50 relative size-9 shrink-0 overflow-hidden rounded-md border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50\"\n    >\n      <div ...api().getTransparencyGridProps({ size: \"8px\" }) data-slot=\"color-picker-transparency-grid\"/>\n      <div\n        ...api().getSwatchProps({ value: api().value })\n        data-slot=\"color-picker-swatch\"\n        class=\"absolute inset-0 size-full\"\n      />\n    </button>\n    <span\n      ...api().getValueTextProps()\n      data-slot=\"color-picker-value-text\"\n      class=\"text-foreground truncate font-mono text-sm tabular-nums\"\n    >\n      ${api().valueAsString}\n    </span>\n  </div>\n\n  <input ...api().getHiddenInputProps()>\n\n  <portal>\n    <if=api().open>\n      <div ...api().getPositionerProps() style=positionerStyle data-slot=\"color-picker-positioner\">\n        <div\n          ...api().getContentProps()\n          data-slot=\"color-picker-content\"\n          class=\"bg-popover text-popover-foreground z-50 flex w-64 flex-col gap-3 rounded-md border p-3 shadow-md outline-hidden data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95\"\n        >\n          // Zag owns the gradient/position styles on the area parts — no style\n          // attribute of our own may go on them.\n          <div\n            ...api().getAreaProps()\n            data-slot=\"color-picker-area\"\n            class=\"h-32 w-full overflow-hidden rounded-md\"\n          >\n            <div\n              ...api().getAreaBackgroundProps()\n              data-slot=\"color-picker-area-background\"\n              class=\"size-full\"\n            />\n            <div\n              ...api().getAreaThumbProps()\n              data-slot=\"color-picker-area-thumb\"\n              class=\"ring-ring/50 size-4 rounded-full border-2 border-white shadow-sm outline-none focus-visible:ring-[3px]\"\n            />\n          </div>\n\n          <div class=\"flex items-center gap-2\">\n            <if=!input.hideEyeDropper>\n              <button\n                ...api().getEyeDropperTriggerProps()\n                data-slot=\"color-picker-eye-dropper-trigger\"\n                class=\"border-input hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 inline-flex size-8 shrink-0 items-center justify-center rounded-md border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50\"\n              >\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"24\"\n                  height=\"24\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  class=\"size-4\"\n                >\n                  <path d=\"m2 22 1-1h3l9-9\"/>\n                  <path d=\"M3 21v-3l9-9\"/>\n                  <path d=\"m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z\"/>\n                </svg>\n              </button>\n            </if>\n\n            <div class=\"flex min-w-0 flex-1 flex-col gap-2\">\n              <div\n                ...api().getChannelSliderProps({ channel: \"hue\", format: \"hsla\" })\n                data-slot=\"color-picker-channel-slider\"\n                class=\"h-3 w-full\"\n              >\n                <div\n                  ...api().getChannelSliderTrackProps({ channel: \"hue\", format: \"hsla\" })\n                  data-slot=\"color-picker-channel-slider-track\"\n                  class=\"h-3 w-full rounded-full\"\n                />\n                <div\n                  ...api().getChannelSliderThumbProps({ channel: \"hue\", format: \"hsla\" })\n                  data-slot=\"color-picker-channel-slider-thumb\"\n                  class=\"ring-ring/50 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white shadow-sm outline-none focus-visible:ring-[3px]\"\n                />\n              </div>\n              <div\n                ...api().getChannelSliderProps({ channel: \"alpha\" })\n                data-slot=\"color-picker-channel-slider\"\n                class=\"h-3 w-full\"\n              >\n                <div ...api().getTransparencyGridProps({ size: \"8px\" }) data-slot=\"color-picker-transparency-grid\" class=\"rounded-full\"/>\n                <div\n                  ...api().getChannelSliderTrackProps({ channel: \"alpha\" })\n                  data-slot=\"color-picker-channel-slider-track\"\n                  class=\"h-3 w-full rounded-full\"\n                />\n                <div\n                  ...api().getChannelSliderThumbProps({ channel: \"alpha\" })\n                  data-slot=\"color-picker-channel-slider-thumb\"\n                  class=\"ring-ring/50 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white shadow-sm outline-none focus-visible:ring-[3px]\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"flex items-center gap-2\">\n            <if=!input.hideFormatSelect>\n              <select\n                ...api().getFormatSelectProps()\n                data-slot=\"color-picker-format-select\"\n                class=\"border-input bg-transparent focus-visible:border-ring focus-visible:ring-ring/50 h-8 shrink-0 rounded-md border px-1.5 text-xs uppercase shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px]\"\n              >\n                <for|format| of=FORMATS>\n                  <option value=format>${format.toUpperCase()}</option>\n                </for>\n              </select>\n            </if>\n            <for|channel| of=channels()>\n              <div class=\"flex min-w-0 flex-1 flex-col gap-1\">\n                <input\n                  ...api().getChannelInputProps({\n                    channel: channel as colorPickerMachine.ExtendedColorChannel,\n                  })\n                  data-slot=\"color-picker-channel-input\"\n                  class=\"border-input focus-visible:border-ring focus-visible:ring-ring/50 h-8 w-full min-w-0 rounded-md border bg-transparent px-2 text-center font-mono text-xs shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                <span class=\"text-muted-foreground text-center text-[10px] uppercase\">\n                  ${channel === \"hex\" ? \"hex\" : channel.slice(0, 1)}\n                </span>\n              </div>\n            </for>\n          </div>\n\n          <if=input.swatches?.length>\n            <div\n              ...api().getSwatchGroupProps()\n              data-slot=\"color-picker-swatch-group\"\n              class=\"flex flex-wrap gap-1.5\"\n            >\n              <for|swatchValue| of=input.swatches ?? []>\n                <button\n                  ...api().getSwatchTriggerProps({ value: swatchValue })\n                  data-slot=\"color-picker-swatch-trigger\"\n                  class=\"border-input focus-visible:border-ring focus-visible:ring-ring/50 size-6 overflow-hidden rounded-md border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50\"\n                >\n                  <div\n                    ...api().getSwatchProps({ value: swatchValue })\n                    data-slot=\"color-picker-swatch\"\n                    class=\"size-full\"\n                  >\n                    <div\n                      ...api().getSwatchIndicatorProps({ value: swatchValue })\n                      data-slot=\"color-picker-swatch-indicator\"\n                      class=\"flex size-full items-center justify-center text-white mix-blend-difference\"\n                    >\n                      <svg\n                        xmlns=\"http://www.w3.org/2000/svg\"\n                        width=\"24\"\n                        height=\"24\"\n                        viewBox=\"0 0 24 24\"\n                        fill=\"none\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"3\"\n                        stroke-linecap=\"round\"\n                        stroke-linejoin=\"round\"\n                        class=\"size-3.5\"\n                      >\n                        <path d=\"M20 6 9 17l-5-5\"/>\n                      </svg>\n                    </div>\n                  </div>\n                </button>\n              </for>\n            </div>\n          </if>\n        </div>\n      </div>\n    </if>\n  </portal>\n</div>\n\n<return=api>\n"
    }
  ]
}