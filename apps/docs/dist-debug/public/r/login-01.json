{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-01",
  "type": "registry:block",
  "title": "Login 01",
  "description": "A simple login form on a centered card.",
  "categories": [
    "authentication",
    "login"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json",
    "http://localhost:3000/r/button.json",
    "http://localhost:3000/r/card.json",
    "http://localhost:3000/r/input.json",
    "http://localhost:3000/r/label.json"
  ],
  "files": [
    {
      "path": "blocks/login-01/login-form.marko",
      "type": "registry:file",
      "target": "~/src/routes/login-01/login-form.marko",
      "content": "import Button from \"../../components/ui/button/button.marko\";\nimport Card from \"../../components/ui/card/card.marko\";\nimport CardHeader from \"../../components/ui/card/header.marko\";\nimport CardTitle from \"../../components/ui/card/title.marko\";\nimport CardDescription from \"../../components/ui/card/description.marko\";\nimport CardContent from \"../../components/ui/card/content.marko\";\nimport TextField from \"../../components/ui/input/input.marko\";\nimport Label from \"../../components/ui/label/label.marko\";\nimport { cn } from \"../../lib/utils.ts\";\n\nexport interface Input extends Marko.Input<\"div\"> {}\n\n<const/{ class: className, content: _content, ...rest }=input/>\n\n<div ...rest class=cn(\"flex flex-col gap-6\", className)>\n  <Card>\n    <CardHeader>\n      <CardTitle>Login to your account</CardTitle>\n      <CardDescription>Enter your email below to login to your account</CardDescription>\n    </CardHeader>\n    <CardContent>\n      <form class=\"flex flex-col gap-6\">\n        <div class=\"grid gap-2\">\n          <Label for=\"login-email\">Email</Label>\n          <TextField id=\"login-email\" name=\"email\" type=\"email\" placeholder=\"m@example.com\" required/>\n        </div>\n        <div class=\"grid gap-2\">\n          <div class=\"flex items-center\">\n            <Label for=\"login-password\">Password</Label>\n            <a\n              href=\"#\"\n              class=\"ml-auto inline-block text-sm underline-offset-4 hover:underline\"\n            >\n              Forgot your password?\n            </a>\n          </div>\n          <TextField id=\"login-password\" name=\"password\" type=\"password\" required/>\n        </div>\n        <div class=\"flex flex-col gap-3\">\n          <Button type=\"submit\">Login</Button>\n          <Button variant=\"outline\" type=\"button\">Login with Google</Button>\n        </div>\n        <p class=\"text-center text-sm text-muted-foreground\">\n          Don't have an account?\n          <a href=\"#\" class=\"underline underline-offset-4\">Sign up</a>\n        </p>\n      </form>\n    </CardContent>\n  </Card>\n</div>\n"
    },
    {
      "path": "blocks/login-01/page.marko",
      "type": "registry:file",
      "target": "~/src/routes/login-01/+page.marko",
      "content": "import LoginForm from \"./login-form.marko\";\n\n<div class=\"flex min-h-svh w-full items-center justify-center bg-muted/40 p-6 md:p-10\">\n  <div class=\"w-full max-w-sm\">\n    <LoginForm/>\n  </div>\n</div>\n"
    }
  ]
}