{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-13",
  "type": "registry:block",
  "title": "Sidebar 13",
  "description": "A settings dialog with a static navigation sidebar and a scrollable content pane.",
  "categories": [
    "sidebar",
    "dialog"
  ],
  "registryDependencies": [
    "http://localhost:3000/r/utils.json",
    "http://localhost:3000/r/sidebar.json",
    "http://localhost:3000/r/dialog.json",
    "http://localhost:3000/r/breadcrumb.json",
    "http://localhost:3000/r/button.json"
  ],
  "files": [
    {
      "path": "blocks/sidebar-13/page.marko",
      "type": "registry:file",
      "target": "~/src/routes/sidebar-13/+page.marko",
      "content": "import SettingsDialog from \"./settings-dialog.marko\";\n\n<div class=\"flex h-svh items-center justify-center\">\n  <SettingsDialog/>\n</div>\n"
    },
    {
      "path": "blocks/sidebar-13/settings-dialog.marko",
      "type": "registry:file",
      "target": "~/src/routes/sidebar-13/settings-dialog.marko",
      "content": "import Dialog from \"../../components/ui/dialog/dialog.marko\";\nimport Button from \"../../components/ui/button/button.marko\";\nimport Breadcrumb from \"../../components/ui/breadcrumb/breadcrumb.marko\";\nimport BreadcrumbItem from \"../../components/ui/breadcrumb/item.marko\";\nimport BreadcrumbLink from \"../../components/ui/breadcrumb/link.marko\";\nimport BreadcrumbSeparator from \"../../components/ui/breadcrumb/separator.marko\";\nimport BreadcrumbPage from \"../../components/ui/breadcrumb/page.marko\";\nimport SidebarProvider from \"../../components/ui/sidebar/provider.marko\";\nimport Sidebar from \"../../components/ui/sidebar/sidebar.marko\";\nimport SidebarContent from \"../../components/ui/sidebar/content.marko\";\nimport SidebarGroup from \"../../components/ui/sidebar/group.marko\";\nimport SidebarMenu from \"../../components/ui/sidebar/menu.marko\";\nimport SidebarMenuItem from \"../../components/ui/sidebar/menu-item.marko\";\nimport SidebarMenuButton from \"../../components/ui/sidebar/menu-button.marko\";\n\nstatic const PLACEHOLDER_TILES = Array.from({ length: 10 });\n\nstatic const NAV_ITEMS: { name: string; icon: string }[] = [\n  { name: \"Notifications\", icon: \"bell\" },\n  { name: \"Navigation\", icon: \"menu\" },\n  { name: \"Home\", icon: \"home\" },\n  { name: \"Appearance\", icon: \"paintbrush\" },\n  { name: \"Messages & media\", icon: \"message-circle\" },\n  { name: \"Language & region\", icon: \"globe\" },\n  { name: \"Accessibility\", icon: \"keyboard\" },\n  { name: \"Mark as read\", icon: \"check\" },\n  { name: \"Audio & video\", icon: \"video\" },\n  { name: \"Connected accounts\", icon: \"link\" },\n  { name: \"Privacy & visibility\", icon: \"lock\" },\n  { name: \"Advanced\", icon: \"settings\" },\n];\n\n<let/open=true/>\n\n<Dialog\n  open=open\n  openChange(isOpen: boolean) {\n    open = isOpen;\n  }\n>\n  <@trigger|triggerProps|>\n    <Button ...triggerProps size=\"sm\">Open Dialog</Button>\n  </@trigger>\n  <@title><span class=\"sr-only\">Settings</span></@title>\n  <@description><span class=\"sr-only\">Customize your settings here.</span></@description>\n  <@content>\n    <div class=\"overflow-hidden p-0 md:max-h-[500px] md:max-w-[700px] lg:max-w-[800px] -m-6\">\n      <SidebarProvider class=\"items-start\">\n        <@sidebar>\n          <Sidebar open=true class=\"hidden md:flex\">\n            <@content>\n              <SidebarContent>\n                <SidebarGroup>\n                  <@content>\n                    <SidebarMenu>\n                      <for|item| of=NAV_ITEMS by=(item) => item.name>\n                        <SidebarMenuItem>\n                          <SidebarMenuButton href=\"#\" active=(item.name === \"Messages & media\")>\n                            <if=item.icon === \"bell\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/>\n                                <path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"menu\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M4 12h16\"/>\n                                <path d=\"M4 18h16\"/>\n                                <path d=\"M4 6h16\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"home\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/>\n                                <path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"paintbrush\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M14 19.9V16h3a2 2 0 0 0 2-2v-2H5v2c0 1.1.9 2 2 2h3v3.9a2 2 0 1 0 4 0Z\"/>\n                                <path d=\"M6 12V2h12v10\"/>\n                                <path d=\"M14 2v4\"/>\n                                <path d=\"M10 2v2\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"message-circle\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"globe\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                <path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"/>\n                                <path d=\"M2 12h20\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"keyboard\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M10 8h.01\"/>\n                                <path d=\"M12 12h.01\"/>\n                                <path d=\"M14 8h.01\"/>\n                                <path d=\"M16 12h.01\"/>\n                                <path d=\"M18 8h.01\"/>\n                                <path d=\"M6 8h.01\"/>\n                                <path d=\"M7 16h10\"/>\n                                <path d=\"M8 12h.01\"/>\n                                <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"check\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20 6 9 17l-5-5\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"video\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"/>\n                                <rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"link\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M9 17H7A5 5 0 0 1 7 7h2\"/>\n                                <path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"/>\n                                <line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"lock\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"/>\n                                <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>\n                              </svg>\n                            </if>\n                            <if=item.icon === \"settings\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"/>\n                                <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n                              </svg>\n                            </if>\n                            <span>${item.name}</span>\n                          </SidebarMenuButton>\n                        </SidebarMenuItem>\n                      </for>\n                    </SidebarMenu>\n                  </@content>\n                </SidebarGroup>\n              </SidebarContent>\n            </@content>\n          </Sidebar>\n        </@sidebar>\n        <@content>\n          <main class=\"flex h-[480px] flex-1 flex-col overflow-hidden\">\n            <header class=\"flex h-16 shrink-0 items-center gap-2 transition-[width,height] ease-linear\">\n              <div class=\"flex items-center gap-2 px-4\">\n                <Breadcrumb>\n                  <BreadcrumbItem class=\"hidden md:block\">\n                    <BreadcrumbLink href=\"#\">Settings</BreadcrumbLink>\n                  </BreadcrumbItem>\n                  <BreadcrumbSeparator class=\"hidden md:block\"/>\n                  <BreadcrumbItem>\n                    <BreadcrumbPage>Messages & media</BreadcrumbPage>\n                  </BreadcrumbItem>\n                </Breadcrumb>\n              </div>\n            </header>\n            <div class=\"flex flex-1 flex-col gap-4 overflow-y-auto p-4 pt-0\">\n              <for|_tile, index| of=PLACEHOLDER_TILES by=(_tile, tileIndex) => tileIndex>\n                <div class=\"aspect-video max-w-3xl rounded-xl bg-muted/50\"></div>\n              </for>\n            </div>\n          </main>\n        </@content>\n      </SidebarProvider>\n    </div>\n  </@content>\n</Dialog>\n"
    }
  ]
}