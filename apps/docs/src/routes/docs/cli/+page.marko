// command reference below is GENERATED from the CLI's own `manifest`
// command via apps/docs/scripts/build-cli-manifest.ts (src/lib/cli-manifest.ts
// is the committed output), so it cannot drift from the real surface.
// The shadcn-CLI interop section stays: the registry remains shadcn-format.
import "../../../tags/docs/docs-article.marko";
import "../../../tags/docs/code-block.marko";
import { CLI_MANIFEST, type CliCommand } from "../../../lib/cli-manifest";

static const COMMANDS = CLI_MANIFEST.commands;

static const TOC = [
  { id: "overview", label: "Overview" },
  { id: "quickstart", label: "Quickstart" },
  { id: "commands", label: "Command Reference" },
  ...COMMANDS.map((cmd) => ({ id: `cmd-${cmd.name}`, label: cmd.name })),
  { id: "exit-codes", label: "Exit Codes" },
  { id: "agents", label: "For Agents" },
  { id: "shadcn-interop", label: "shadcn CLI Interop" },
  { id: "urls", label: "Registry URLs" },
];

static const QUICKSTART = `bunx marko-ui init          # components.json + base theme
bunx marko-ui add button    # install a component as source
bunx marko-ui doctor        # health checks (exit 3 on failure)`;

static const INIT_CMD = `bunx marko-ui@latest init https://marko-ui.saulo.tech/r/style.json`;

static const ADD_CMD = `bunx marko-ui@latest add https://marko-ui.saulo.tech/r/dialog.json`;

static const REGISTRY_INDEX = `curl -s https://marko-ui.saulo.tech/r/registry.json | jq '.items[].name'`;

static function commandUsage(cmd: CliCommand, parent?: string) {
  const args = cmd.arguments
    .map((arg) => {
      const name = arg.variadic ? `${arg.name}...` : arg.name;
      return arg.required ? `<${name}>` : `[${name}]`;
    })
    .join(" ");
  const scope = parent ? `${parent} ` : "";
  return `marko-ui ${scope}${cmd.name}${cmd.options.length ? " [options]" : ""}${args ? ` ${args}` : ""}`;
}

static function optionLines(cmd: CliCommand) {
  return cmd.options
    .map((option) => `${option.flags.padEnd(24)} ${option.description}`)
    .join("\n");
}

<docs-article
  title="CLI"
  description="Install and manage marko-ui components with the marko-ui CLI — or any tool that speaks the shadcn registry protocol."
  href="/docs/cli"
  toc=TOC
>
  <h2 id="overview">Overview</h2>

  <p>
    <code>marko-ui</code> installs components as readable Marko source into your project —
    there is no runtime component package. It is a fork of the MIT-licensed shadcn CLI's registry
    mechanics, adapted for Marko projects (framework detection, Tailwind v4 CSS-first, no React
    codemods) and an agent-first output surface.
  </p>

  <p>
    Bare names like <code>button</code> resolve through the built-in <code>@marko-ui</code>
    registry. Additional registries are configured in <code>components.json</code> — the same wire
    format the shadcn CLI uses. Our discovery index only lists registries that declare
    <code>target: "marko"</code>, so React registries never sneak in through auto-discovery.
  </p>

  <p>
    <strong>Note:</strong> the <code>marko-ui</code> adapter package is not yet published to npm.
    Component files always install fine; the dependency step prints the manual command it could
    not run. <code>marko-ui doctor</code> tells you exactly where you stand.
  </p>

  <h2 id="quickstart">Quickstart</h2>

  <code-block language="bash" code=QUICKSTART/>

  <h2 id="commands">Command Reference</h2>

  <p>
    Generated from the CLI's own <code>manifest</code> command (version
    ${CLI_MANIFEST.cliVersion}) — this reference cannot drift from the installed tool. Run
    <code>marko-ui manifest</code> for the same data as JSON.
  </p>

  <for|cmd| of=COMMANDS>
    <h3 id=`cmd-${cmd.name}`>
      ${cmd.name}
      <if=cmd.aliases.length>
        <span class="text-muted-foreground text-base font-normal">
          (alias: ${cmd.aliases.join(", ")})
        </span>
      </if>
    </h3>

    <p>${cmd.description}</p>

    <code-block language="text" code=commandUsage(cmd)/>

    <if=cmd.options.length>
      <code-block language="text" code=optionLines(cmd)/>
    </if>

    <if=cmd.subcommands?.length>
      <for|sub| of=(cmd.subcommands ?? [])>
        <h4>${cmd.name} ${sub.name}</h4>
        <p>${sub.description}</p>
        <code-block language="text" code=commandUsage(sub, cmd.name)/>
        <if=sub.options.length>
          <code-block language="text" code=optionLines(sub)/>
        </if>
      </for>
    </if>
  </for>

