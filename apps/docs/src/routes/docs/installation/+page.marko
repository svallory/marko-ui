<Button variant="outline">Click me</Button>`;

static const IMPORT_CSS_ENTRY = `@import "tailwindcss";
@import "@marko-ui/shadcn/styles/globals.css";
@import "@marko-ui/shadcn/styles/style-vega.css" layer(components);

/* Required so data-open:/data-state-*: variant classes on mu-* components
   compile to real CSS instead of silently emitting nothing. */
@custom-variant style-vega (&:where(.style-vega *));`;

static const IMPORT_CSS_BROKEN = `/* Missing layer(components) — silently wins over
