  --warning-foreground: oklch(0.98 0 0);
}

/* Expose it to Tailwind so bg-warning / text-warning-foreground exist. */
@theme inline {
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
}`;

