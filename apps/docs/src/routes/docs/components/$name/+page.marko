// Fallback for /docs/components/<name> when <name> has no generated static
// route. Every documented component gets a generated static route
// (src/routes/docs/components/<name>/+page.marko, built by
// scripts/build-demos-manifest.ts) whose client bundle carries only that
// component's demos; this dynamic route only ever renders the "Component not
// documented" state for names without one.
//
// Route params live on $global, not on `input` (see marko-run docs).
import "../../../../tags/docs/component-page.marko";

<component-page name=$global.params.name/>
