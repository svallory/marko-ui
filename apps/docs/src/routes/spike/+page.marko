// M0 spike page: S1-S8 (see notes/specs/marko-ui/design.md)
static function delay<T>(ms: number, value: T): Promise<T> {
  return new Promise((resolve) => setTimeout(() => resolve(value), ms));
}

<let/controlled="two"/>

<main class="mx-auto max-w-2xl space-y-8 p-8">
  <h1 class="text-2xl font-bold">marko-ui M0 spike</h1>

  <section class="space-y-2">
    <h2 class="font-semibold">Tabs (uncontrolled)</h2>
    <spike-tabs/>
  </section>

  <section class="space-y-2">
    <h2 class="font-semibold">Tabs (controlled, S8) — parent value: ${controlled}</h2>
    <button
      class="rounded bg-gray-200 px-2 py-1 text-sm"
      onClick() { controlled = controlled === "two" ? "three" : "two" }
    >
      Toggle parent value
    </button>
    <spike-tabs value=controlled valueChange(v: string) { controlled = v }/>
  </section>

  <section class="space-y-2">
    <h2 class="font-semibold">Dialog (S5 without portal yet)</h2>
    <spike-dialog/>
  </section>

  <section class="space-y-2">
    <h2 class="font-semibold">Streamed tabs below await boundary (S6)</h2>
    <try>
      <await|label|=delay(800, "streamed")>
        <p class="text-xs text-gray-500">resolved: ${label}</p>
        <spike-tabs/>
      </await>
      <@placeholder>
        <p class="text-xs text-gray-500">streaming…</p>
      </@placeholder>
    </try>
  </section>
</main>
