import Default from "../../../demos/toggle-group/default.marko";
import Multiple from "../../../demos/toggle-group/multiple.marko";
import Outline from "../../../demos/toggle-group/outline.marko";
import Sizes from "../../../demos/toggle-group/sizes.marko";
import Disabled from "../../../demos/toggle-group/disabled.marko";
import Controlled from "../../../demos/toggle-group/controlled.marko";

<component-page title="Toggle Group" description="A set of two-state buttons that can be toggled on or off.">
  <div class="rounded-lg border bg-muted/30 p-4 text-sm text-muted-foreground">
    <p class="font-medium text-foreground">Array-driven API</p>
    <p class="mt-1">
      Like <code>RadioGroup</code>, this component takes a single
      <code>items: {"{"} value, label, disabled? {"}"}[]</code> input and renders every item
      internally, avoiding passing the Zag API across a tag boundary. Pass <code>multiple</code>
      to allow more than one pressed item at once, and <code>value</code> / <code>valueChange</code>
      for controlled use.
    </p>
  </div>

  <demo-box title="Default (single selection)">
    <Default/>
  </demo-box>

  <demo-box title="Multiple selection">
    <Multiple/>
  </demo-box>

  <demo-box title="Outline variant">
    <Outline/>
  </demo-box>

  <demo-box title="Sizes">
    <Sizes/>
  </demo-box>

  <demo-box title="Disabled">
    <Disabled/>
  </demo-box>

  <demo-box title="Controlled">
    <Controlled/>
  </demo-box>
</component-page>
