import Tabs from "@marko-ui/registry/ui/tabs/index.marko";

static const ACCOUNT_TABS = [
  { value: "account", label: "Account" },
  { value: "password", label: "Password" },
];

static const STATUS_TABS = [
  { value: "active", label: "Active" },
  { value: "pending", label: "Pending" },
  { value: "archived", label: "Archived", disabled: true },
];

<let/controlledValue="active"/>

<component-page title="Tabs" description="A set of layered sections of content—known as tab panels—that are displayed one at a time.">
  <demo-box title="Default">
    <Tabs|value| items=ACCOUNT_TABS class="w-[400px]">
      <if=(value === "account")>
        <p class="text-muted-foreground text-sm">
          Make changes to your account here. Click save when you're done.
        </p>
      </if>
      <if=(value === "password")>
        <p class="text-muted-foreground text-sm">Change your password here. After saving, you'll be logged out.</p>
      </if>
    </Tabs>
  </demo-box>
  <demo-box title="Disabled tab">
    <Tabs|value| items=STATUS_TABS class="w-[400px]">
      <p class="text-muted-foreground text-sm">Showing ${value} items.</p>
    </Tabs>
  </demo-box>
  <demo-box title="Controlled">
    <p class="text-muted-foreground mb-4 text-sm">Selected: ${controlledValue}</p>
    <Tabs|value|
      items=STATUS_TABS
      value=controlledValue
      valueChange(value) { controlledValue = value; }
      class="w-[400px]"
    >
      <p class="text-muted-foreground text-sm">Showing ${value} items.</p>
    </Tabs>
  </demo-box>
</component-page>
