import Pagination from "@marko-ui/registry/ui/pagination/index.marko";

<let/controlledPage=3/>

<component-page title="Pagination" description="Pagination with page navigation, next and previous links.">
  <demo-box title="Default">
    <Pagination count=100 pageSize=10 page=1/>
  </demo-box>

  <demo-box title="Sibling count">
    <p class="text-muted-foreground mb-4 text-sm">
      <code>siblingCount</code> controls how many pages are shown around the active page.
    </p>
    <Pagination count=500 pageSize=10 page=10 siblingCount=2/>
  </demo-box>

  <demo-box title="Few pages (no ellipsis)">
    <Pagination count=30 pageSize=10 page=2/>
  </demo-box>

  <demo-box title="Controlled">
    <p class="text-muted-foreground mb-4 text-sm">Current page: ${controlledPage}</p>
    <Pagination
      count=200
      pageSize=10
      page=controlledPage
      pageChange(details) { controlledPage = details.page; }
    />
  </demo-box>
</component-page>
