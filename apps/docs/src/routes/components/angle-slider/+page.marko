import AngleSlider from "@marko-ui/registry/ui/angle-slider/angle-slider.marko";

<let/controlledValue=90/>

<component-page title="Angle Slider" description="A circular dial slider for selecting an angle value, controlled by arrow keys or dragging the thumb around the track.">
  <demo-box title="Default">
    <AngleSlider defaultValue=45/>
  </demo-box>
  <demo-box title="Step">
    <AngleSlider defaultValue=0 step=15/>
  </demo-box>
  <demo-box title="Disabled">
    <AngleSlider defaultValue=120 disabled/>
  </demo-box>
  <demo-box title="Controlled">
    <p class="text-muted-foreground mb-4 text-sm">
      Value: ${controlledValue}&deg;
    </p>
    <AngleSlider
      value=controlledValue
      valueChange(value) { controlledValue = value; }
    />
  </demo-box>
</component-page>
