import FileUpload from "@marko-ui/registry/ui/file-upload/index.marko";

<let/lastFiles=[] as { name: string; size: number; type: string }[]/>

<component-page title="File Upload" description="A dropzone and file picker for uploading files.">
  <demo-box title="Default">
    <FileUpload/>
  </demo-box>
  <demo-box title="Accept images only, max 3 files">
    <FileUpload accept="image/*" maxFiles=3/>
  </demo-box>
  <demo-box title="Max file size (1 MB)">
    <FileUpload maxFileSize=1000000/>
  </demo-box>
  <demo-box title="With change callback">
    <p class="text-muted-foreground mb-4 text-sm">
      Files: ${lastFiles.map((f) => f.name).join(", ") || "none"}
    </p>
    <FileUpload filesChange(files) { lastFiles = files; }/>
  </demo-box>
</component-page>
