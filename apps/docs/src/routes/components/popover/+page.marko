import Popover from "@marko-ui/registry/ui/popover/index.marko";
import Button from "@marko-ui/registry/ui/button/index.marko";

<let/open=false/>

<component-page title="Popover" description="Displays rich content in a portal, triggered by a button.">
  <demo-box title="Default">
    <Popover>
      <@trigger|props|>
        <Button ...props variant="outline">Open popover</Button>
      </@trigger>
      <@content>
        <div class="grid gap-2">
          <h4 class="leading-none font-medium">Dimensions</h4>
          <p class="text-muted-foreground text-sm">
            Set the dimensions for the layer.
          </p>
        </div>
      </@content>
    </Popover>
  </demo-box>
  <demo-box title="Placement">
    <Popover positioning={ placement: "right-start" }>
      <@trigger|props|>
        <Button ...props variant="outline">Right start</Button>
      </@trigger>
      <@content>
        <p class="text-sm">Positioned to the right of the trigger.</p>
      </@content>
    </Popover>
  </demo-box>
  <demo-box title="Controlled">
    <div class="flex items-center gap-4">
      <Popover open=open openChange=(o) => { open = o; }>
        <@trigger|props|>
          <Button ...props variant="outline">${open ? "Close" : "Open"}</Button>
        </@trigger>
        <@content>
          <p class="text-sm">Controlled popover content.</p>
        </@content>
      </Popover>
      <span class="text-sm text-muted-foreground">open: ${open}</span>
    </div>
  </demo-box>
</component-page>
