import SignaturePad from "@marko-ui/registry/ui/signature-pad/signature-pad.marko";

<let/lastDrawEndPaths=[] as string[]/>

<component-page title="Signature Pad" description="A draw-to-sign pad for capturing handwritten signatures via pointer input.">
  <demo-box title="Default">
    <SignaturePad/>
  </demo-box>
  <demo-box title="With name (form value)">
    <SignaturePad name="signature"/>
  </demo-box>
  <demo-box title="Disabled">
    <SignaturePad disabled/>
  </demo-box>
  <demo-box title="Controlled draw-end">
    <div class="flex flex-col gap-2">
      <SignaturePad drawEndChange=(paths) => { lastDrawEndPaths = paths; }/>
      <span class="text-sm text-muted-foreground">
        committed strokes: ${lastDrawEndPaths.length}
      </span>
    </div>
  </demo-box>
</component-page>
