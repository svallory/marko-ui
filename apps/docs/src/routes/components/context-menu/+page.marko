import ContextMenu from "@marko-ui/registry/ui/context-menu/context-menu.marko";

static const DEFAULT_ITEMS = [
  { value: "back", label: "Back", shortcut: "⌘[" },
  { value: "forward", label: "Forward", shortcut: "⌘]", disabled: true },
  { value: "reload", label: "Reload", shortcut: "⌘R" },
  { type: "separator" },
  { type: "label", label: "More Tools" },
  { value: "save", label: "Save Page As...", shortcut: "⌘S" },
  { value: "cast", label: "Cast..." },
  { type: "separator" },
  { value: "delete", label: "Delete", danger: true },
];

static const SIMPLE_ITEMS = [
  { value: "copy", label: "Copy" },
  { value: "paste", label: "Paste" },
  { type: "separator" },
  { value: "delete", label: "Delete", danger: true },
];

<let/selected=""/>

<component-page title="Context Menu" description="Displays a menu to the user — such as a set of actions or functions — triggered by right click.">
  <demo-box title="Default">
    <ContextMenu items=DEFAULT_ITEMS select(value) { selected = value; }>
      <@content>
        <div class="flex h-[150px] w-[300px] items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground">
          Right click here
        </div>
      </@content>
    </ContextMenu>
  </demo-box>
  <demo-box title="Simple">
    <div class="flex items-center gap-4">
      <ContextMenu items=SIMPLE_ITEMS select(value) { selected = value; }>
        <@content>
          <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground">
            Right click here
          </div>
        </@content>
      </ContextMenu>
      <span class="text-muted-foreground text-sm">selected: ${selected || "none"}</span>
    </div>
  </demo-box>
</component-page>
