import Alert from "@marko-ui/registry/ui/alert/alert.marko";
import AlertTitle from "@marko-ui/registry/ui/alert/title.marko";
import AlertDescription from "@marko-ui/registry/ui/alert/description.marko";

<component-page title="Alert" description="Displays a callout for user attention.">
  <demo-box title="Default">
    <Alert>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2 L22 20 L2 20 Z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <AlertTitle>Heads up!</AlertTitle>
      <AlertDescription>You can add components to your app using the CLI.</AlertDescription>
    </Alert>
  </demo-box>
  <demo-box title="Without icon">
    <Alert>
      <AlertTitle>Deployment scheduled</AlertTitle>
      <AlertDescription>Your changes will go live in the next release window.</AlertDescription>
    </Alert>
  </demo-box>
  <demo-box title="Destructive">
    <Alert variant="destructive">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <AlertTitle>Unable to process your payment.</AlertTitle>
      <AlertDescription>
        <p>Please verify your billing information and try again.</p>
        <p>If the issue persists, please contact support.</p>
      </AlertDescription>
    </Alert>
  </demo-box>
</component-page>
