import Dialog from "@marko-ui/registry/ui/dialog/index.marko";
import Button from "@marko-ui/registry/ui/button/index.marko";

<component-page title="Dialog" description="A window overlaid on either the primary window or another dialog window, rendering the content underneath inert.">
  <demo-box title="Default">
    <Dialog
      title="Edit profile"
      description="Make changes to your profile here. Click save when you're done."
    >
      <@trigger|props|>
        <Button ...props>Edit Profile</Button>
      </@trigger>
      <@content>
        <div class="grid gap-2">
          <label class="text-sm font-medium" for="name">Name</label>
          <input id="name" class="border-input rounded-md border px-3 py-2 text-sm" value="Pedro Duarte" />
        </div>
      </@content>
      <@footer>
        <button class="bg-primary text-primary-foreground rounded-md px-4 py-2 text-sm font-medium">
          Save changes
        </button>
      </@footer>
    </Dialog>
  </demo-box>

  <demo-box title="Without footer">
    <Dialog title="Are you absolutely sure?" description="This action cannot be undone. This will permanently delete your account and remove your data from our servers.">
      <@trigger|props|>
        <Button ...props variant="destructive">Delete account</Button>
      </@trigger>
    </Dialog>
  </demo-box>
</component-page>
