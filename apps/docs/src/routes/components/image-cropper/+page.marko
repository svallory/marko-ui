import ImageCropper from "@marko-ui/registry/ui/image-cropper/image-cropper.marko";

// Bundled sample image: an inline SVG data URI, so the demo never makes a
// network request and stays CSP-safe.
static const SAMPLE_IMAGE =
  "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='640' height='480' viewBox='0 0 640 480'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%23f59e0b'/%3E%3Cstop offset='0.5' stop-color='%23ec4899'/%3E%3Cstop offset='1' stop-color='%236366f1'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='640' height='480' fill='url(%23g)'/%3E%3Ccircle cx='160' cy='130' r='70' fill='%23fef3c7' opacity='0.9'/%3E%3Cpath d='M0 480 L180 260 L320 400 L470 210 L640 480 Z' fill='%23134e4a' opacity='0.75'/%3E%3Cpath d='M0 480 L140 330 L300 480 Z' fill='%23042f2e' opacity='0.7'/%3E%3Cg fill='%23ffffff' opacity='0.85'%3E%3Crect x='30' y='30' width='60' height='4'/%3E%3Crect x='30' y='30' width='4' height='60'/%3E%3Crect x='550' y='446' width='60' height='4'/%3E%3Crect x='606' y='390' width='4' height='60'/%3E%3C/g%3E%3C/svg%3E";

static const BUTTON_CLASS =
  "border-input bg-background hover:bg-accent hover:text-accent-foreground inline-flex h-8 items-center rounded-md border px-3 text-sm font-medium transition-colors";

<let/controlledZoom=1/>
<let/controlledRotation=0/>

<component-page title="Image Cropper" description="An image editor with a draggable, resizable crop region, aspect-ratio lock, zoom, rotation and flip.">
  <demo-box title="Default">
    <ImageCropper
      class="max-w-md h-72"
      src=SAMPLE_IMAGE
      alt="Sample landscape"
      initialCrop={ x: 60, y: 50, width: 220, height: 160 }
    />
  </demo-box>

  <demo-box title="Locked 1:1 aspect ratio, circular crop">
    <ImageCropper
      class="max-w-md h-72"
      src=SAMPLE_IMAGE
      alt="Sample landscape"
      aspectRatio=1
      cropShape="circle"
      hideGrid
      initialCrop={ x: 90, y: 40, width: 180, height: 180 }
    />
  </demo-box>

  <demo-box title="Fixed crop area (pan and zoom only)">
    <ImageCropper
      class="max-w-md h-72"
      src=SAMPLE_IMAGE
      alt="Sample landscape"
      fixedCropArea
      hideGrid
      initialCrop={ x: 80, y: 50, width: 240, height: 160 }
    />
  </demo-box>

  <demo-box title="Controlled zoom and rotation">
    <div class="flex w-full flex-col gap-3">
      <ImageCropper
        class="max-w-md h-72"
        src=SAMPLE_IMAGE
        alt="Sample landscape"
        zoom=controlledZoom
        rotation=controlledRotation
        zoomChange(zoom) { controlledZoom = zoom; }
        rotationChange(rotation) { controlledRotation = rotation; }
        initialCrop={ x: 60, y: 50, width: 220, height: 160 }
      />
      <div class="flex flex-wrap items-center gap-2">
        <button
          id="zoom-in"
          class=BUTTON_CLASS
          onClick() { controlledZoom = Math.min(5, controlledZoom + 0.25); }
        >
          Zoom in
        </button>
        <button
          id="zoom-out"
          class=BUTTON_CLASS
          onClick() { controlledZoom = Math.max(1, controlledZoom - 0.25); }
        >
          Zoom out
        </button>
        <button
          id="rotate"
          class=BUTTON_CLASS
          onClick() { controlledRotation = (controlledRotation + 90) % 360; }
        >
          Rotate 90°
        </button>
        <button
          id="reset-transform"
          class=BUTTON_CLASS
          onClick() { controlledZoom = 1; controlledRotation = 0; }
        >
          Reset
        </button>
      </div>
      <p class="text-muted-foreground text-sm" id="transform-readout">
        Zoom: ${controlledZoom.toFixed(2)} · Rotation: ${controlledRotation}°
      </p>
    </div>
  </demo-box>
</component-page>
