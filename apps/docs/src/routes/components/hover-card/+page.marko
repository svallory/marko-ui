import HoverCard from "@marko-ui/registry/ui/hover-card/hover-card.marko";

<component-page title="Hover Card" description="For sighted users to preview content available behind a link.">
  <demo-box title="Default">
    <HoverCard>
      <@trigger|props|>
        <a ...props href="#" class="text-sm font-medium underline underline-offset-4">@marko-ui</a>
      </@trigger>
      <@content>
        <div class="flex justify-between gap-4">
          <div class="space-y-1">
            <h4 class="text-sm font-semibold">@marko-ui</h4>
            <p class="text-sm text-muted-foreground">
              A shadcn-inspired component registry for Marko 6.
            </p>
          </div>
        </div>
      </@content>
    </HoverCard>
  </demo-box>
  <demo-box title="Custom delays">
    <HoverCard openDelay=100 closeDelay=100>
      <@trigger|props|>
        <a ...props href="#" class="text-sm font-medium underline underline-offset-4">Fast hover</a>
      </@trigger>
      <@content>
        <p class="text-sm">This card opens and closes quickly.</p>
      </@content>
    </HoverCard>
  </demo-box>
</component-page>
