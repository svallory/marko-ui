import AspectRatio from "@marko-ui/registry/ui/aspect-ratio/aspect-ratio.marko";

<component-page title="Aspect Ratio" description="Displays content within a desired ratio.">
  <demo-box title="16 / 9 (default image)">
    <div class="w-full max-w-md">
      <AspectRatio ratio=(16 / 9)>
        <img
          src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
          alt="Photo by Drew Beamer"
          class="h-full w-full rounded-md object-cover"
        />
      </AspectRatio>
    </div>
  </demo-box>
  <demo-box title="1 / 1 (square, default ratio)">
    <div class="w-full max-w-xs">
      <AspectRatio>
        <div class="flex h-full w-full items-center justify-center rounded-md bg-muted text-muted-foreground">
          1:1
        </div>
      </AspectRatio>
    </div>
  </demo-box>
  <demo-box title="4 / 3 (content card)">
    <div class="w-full max-w-sm">
      <AspectRatio ratio=(4 / 3)>
        <div class="flex h-full w-full flex-col items-center justify-center gap-1 rounded-md border border-border bg-card text-card-foreground">
          <span class="text-sm font-medium">4:3 content</span>
          <span class="text-xs text-muted-foreground">Video thumbnail placeholder</span>
        </div>
      </AspectRatio>
    </div>
  </demo-box>
  <demo-box title="21 / 9 (ultrawide banner)">
    <div class="w-full max-w-lg">
      <AspectRatio ratio=(21 / 9)>
        <div class="flex h-full w-full items-center justify-center rounded-md bg-primary text-primary-foreground">
          21:9 banner
        </div>
      </AspectRatio>
    </div>
  </demo-box>
</component-page>
