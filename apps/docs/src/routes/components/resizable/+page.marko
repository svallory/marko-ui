import Resizable from "@marko-ui/registry/ui/resizable/index.marko";

static const TWO_PANELS = [
  { id: "one", defaultSize: 50 },
  { id: "two", defaultSize: 50 },
];

static const THREE_PANELS = [
  { id: "one", defaultSize: 25, minSize: 15 },
  { id: "two", defaultSize: 50, minSize: 15 },
  { id: "three", defaultSize: 25, minSize: 15 },
];

<component-page title="Resizable" description="Accessible resizable panel groups and layouts with keyboard support.">
  <demo-box title="Horizontal">
    <Resizable panels=TWO_PANELS class="h-64 rounded-lg border">
      <@content|panel|>
        <div class="flex h-full items-center justify-center p-6">
          <span class="font-semibold">${panel.id === "one" ? "One" : "Two"}</span>
        </div>
      </@content>
    </Resizable>
  </demo-box>
  <demo-box title="Vertical">
    <Resizable panels=TWO_PANELS orientation="vertical" class="h-64 rounded-lg border">
      <@content|panel|>
        <div class="flex h-full items-center justify-center p-6">
          <span class="font-semibold">${panel.id === "one" ? "One" : "Two"}</span>
        </div>
      </@content>
    </Resizable>
  </demo-box>
  <demo-box title="With handle and three panels">
    <Resizable panels=THREE_PANELS class="h-64 rounded-lg border">
      <@content|panel, index|>
        <div class="flex h-full items-center justify-center p-6">
          <span class="font-semibold">Panel ${index + 1}</span>
        </div>
      </@content>
    </Resizable>
  </demo-box>
</component-page>
