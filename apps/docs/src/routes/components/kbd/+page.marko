import Kbd from "@marko-ui/registry/ui/kbd/index.marko";
import KbdGroup from "@marko-ui/registry/ui/kbd/group.marko";

<component-page title="Kbd" description="Used to display textual user input from keyboard.">
  <demo-box title="Default">
    <Kbd>⌘</Kbd>
  </demo-box>
  <demo-box title="Multiple keys">
    <KbdGroup>
      <Kbd>Ctrl</Kbd>
      <Kbd>B</Kbd>
    </KbdGroup>
  </demo-box>
  <demo-box title="With text">
    <p class="text-sm">
      Press
      <Kbd>⌘K</Kbd>
      to open the command menu.
    </p>
  </demo-box>
  <demo-box title="In a sentence">
    <div class="flex items-center gap-2 text-sm">
      <span>Save your changes with</span>
      <KbdGroup>
        <Kbd>Ctrl</Kbd>
        <Kbd>S</Kbd>
      </KbdGroup>
    </div>
  </demo-box>
</component-page>
