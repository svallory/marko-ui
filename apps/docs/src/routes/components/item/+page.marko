import Item from "@marko-ui/registry/ui/item/index.marko";
import ItemGroup from "@marko-ui/registry/ui/item/group.marko";
import ItemSeparator from "@marko-ui/registry/ui/item/separator.marko";
import ItemMedia from "@marko-ui/registry/ui/item/media.marko";
import ItemContent from "@marko-ui/registry/ui/item/content.marko";
import ItemTitle from "@marko-ui/registry/ui/item/title.marko";
import ItemDescription from "@marko-ui/registry/ui/item/description.marko";
import ItemActions from "@marko-ui/registry/ui/item/actions.marko";
import ItemHeader from "@marko-ui/registry/ui/item/header.marko";
import ItemFooter from "@marko-ui/registry/ui/item/footer.marko";
import Button from "@marko-ui/registry/ui/button/index.marko";
import Badge from "@marko-ui/registry/ui/badge/index.marko";

<component-page title="Item" description="A flexible component for displaying content in a structured item layout.">
  <demo-box title="Default">
    <Item style="width: 400px;">
      <ItemContent>
        <ItemTitle>Basic Item</ItemTitle>
        <ItemDescription>A simple item with just a title and description.</ItemDescription>
      </ItemContent>
    </Item>
  </demo-box>

  <demo-box title="Variants">
    <div style="display: flex; flex-direction: column; gap: 12px; width: 400px;">
      <Item variant="default">
        <ItemContent>
          <ItemTitle>Default variant</ItemTitle>
          <ItemDescription>Transparent background, no border.</ItemDescription>
        </ItemContent>
      </Item>
      <Item variant="outline">
        <ItemContent>
          <ItemTitle>Outline variant</ItemTitle>
          <ItemDescription>Has a visible border around it.</ItemDescription>
        </ItemContent>
      </Item>
      <Item variant="muted">
        <ItemContent>
          <ItemTitle>Muted variant</ItemTitle>
          <ItemDescription>Subtle muted background fill.</ItemDescription>
        </ItemContent>
      </Item>
    </div>
  </demo-box>

  <demo-box title="Sizes">
    <div style="display: flex; flex-direction: column; gap: 12px; width: 400px;">
      <Item variant="outline" size="default">
        <ItemContent>
          <ItemTitle>Default size</ItemTitle>
          <ItemDescription>Standard padding and gap.</ItemDescription>
        </ItemContent>
      </Item>
      <Item variant="outline" size="sm">
        <ItemContent>
          <ItemTitle>Small size</ItemTitle>
          <ItemDescription>Reduced padding for compact lists.</ItemDescription>
        </ItemContent>
      </Item>
    </div>
  </demo-box>

  <demo-box title="With icon media">
    <Item variant="outline" style="width: 400px;">
      <ItemMedia variant="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
      </ItemMedia>
      <ItemContent>
        <ItemTitle>New feature available</ItemTitle>
        <ItemDescription>Check out the latest update to your dashboard.</ItemDescription>
      </ItemContent>
      <ItemActions>
        <Button variant="outline" size="sm">View</Button>
      </ItemActions>
    </Item>
  </demo-box>

  <demo-box title="With image media">
    <Item variant="outline" style="width: 400px;">
      <ItemMedia variant="image">
        <img src="https://github.com/shadcn.png" alt="Avatar" />
      </ItemMedia>
      <ItemContent>
        <ItemTitle>shadcn</ItemTitle>
        <ItemDescription>Pushed 3 commits to marko-ui/registry</ItemDescription>
      </ItemContent>
      <ItemActions>
        <Badge variant="secondary">2h ago</Badge>
      </ItemActions>
    </Item>
  </demo-box>

  <demo-box title="With header and footer">
    <Item variant="outline" style="width: 420px;">
      <ItemHeader>
        <ItemTitle>Invoice #1029</ItemTitle>
        <Badge>Paid</Badge>
      </ItemHeader>
      <ItemContent>
        <ItemDescription>Billed to Acme Corp on Aug 3, 2026.</ItemDescription>
      </ItemContent>
      <ItemFooter>
        <span class="text-muted-foreground text-sm">$1,240.00</span>
        <Button variant="outline" size="sm">Download</Button>
      </ItemFooter>
    </Item>
  </demo-box>

  <demo-box title="Group with separators">
    <ItemGroup style="width: 400px; border: 1px solid var(--border); border-radius: 0.5rem; overflow: hidden;">
      <Item>
        <ItemMedia variant="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
        </ItemMedia>
        <ItemContent>
          <ItemTitle>Profile updated</ItemTitle>
          <ItemDescription>Your profile picture was changed.</ItemDescription>
        </ItemContent>
      </Item>
      <ItemSeparator/>
      <Item>
        <ItemMedia variant="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </ItemMedia>
        <ItemContent>
          <ItemTitle>New message</ItemTitle>
          <ItemDescription>You received a message from support.</ItemDescription>
        </ItemContent>
      </Item>
      <ItemSeparator/>
      <Item>
        <ItemMedia variant="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </ItemMedia>
        <ItemContent>
          <ItemTitle>Task completed</ItemTitle>
          <ItemDescription>Deployment finished successfully.</ItemDescription>
        </ItemContent>
      </Item>
    </ItemGroup>
  </demo-box>

  <demo-box title="As link">
    <a href="#" style="text-decoration: none; display: block; width: 400px;">
      <Item variant="outline">
        <ItemContent>
          <ItemTitle>Clickable item</ItemTitle>
          <ItemDescription>This entire item acts as a link.</ItemDescription>
        </ItemContent>
      </Item>
    </a>
  </demo-box>
</component-page>
