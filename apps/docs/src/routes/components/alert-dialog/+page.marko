import AlertDialog from "@marko-ui/registry/ui/alert-dialog/index.marko";
import Button from "@marko-ui/registry/ui/button/index.marko";

<let/open=false/>

<component-page title="Alert Dialog" description="A modal dialog that interrupts the user with important content and expects a response.">
  <demo-box title="Default">
    <AlertDialog>
      <@trigger|props|>
        <Button ...props variant="outline">Show Dialog</Button>
      </@trigger>
      <@title>Are you absolutely sure?</@title>
      <@description>
        This action cannot be undone. This will permanently delete your account and remove your data from our servers.
      </@description>
    </AlertDialog>
  </demo-box>
  <demo-box title="Custom text and action">
    <AlertDialog
      cancelText="No, keep it"
      actionText="Yes, delete it"
      action=() => { console.log("deleted"); }
    >
      <@trigger|props|>
        <Button ...props variant="destructive">Delete account</Button>
      </@trigger>
      <@title>Delete account</@title>
      <@description>
        This will permanently delete your account. This action is irreversible.
      </@description>
    </AlertDialog>
  </demo-box>
  <demo-box title="Controlled">
    <div class="flex items-center gap-4">
      <AlertDialog open=open openChange=(o) => { open = o; }>
        <@trigger|props|>
          <Button ...props variant="outline">${open ? "Close" : "Open"}</Button>
        </@trigger>
        <@title>Controlled alert dialog</@title>
        <@description>The open state is controlled by the parent component.</@description>
      </AlertDialog>
      <span class="text-sm text-muted-foreground">open: ${open}</span>
    </div>
  </demo-box>
</component-page>
