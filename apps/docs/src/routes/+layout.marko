import "../app.css";
import "../tags/site/site-header.marko";
import "../tags/site/site-footer.marko";

// Block previews under /blocks/view/ render chrome-free: each block IS a
// full page, so site header/footer would frame it wrongly inside the
// gallery's preview iframes (mirrors shadcn's isolated /view route).
// Resolved from the request URL server-side so the chrome is absent from
// the SSR payload rather than hidden after hydration.
<const/isBlockPreview=$global.url.pathname.startsWith("/blocks/view/")/>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>marko-ui</title>
    <html-script>
      (function () {
        var storedTheme = null;
        try {
          storedTheme = localStorage.getItem("theme");
        } catch (error) {}
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = storedTheme ? storedTheme === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </html-script>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <if=!isBlockPreview>
      <site-header/>
    </if>
    <div class="flex-1">
      <${input.content}/>
    </div>
    <if=!isBlockPreview>
      <site-footer/>
    </if>
  </body>
</html>
