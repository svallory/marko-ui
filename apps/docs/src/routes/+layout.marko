import "../app.css";
import "../tags/site/site-header.marko";
import "../tags/site/site-footer.marko";
import {
  resolveMeta,
  SITE_NAME,
  SITE_LOCALE,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_WIDTH,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_ALT,
} from "../lib/site-meta.ts";

// Block previews under /blocks/view/, the /create theme-builder's own
// preview iframe target (/create/preview), and /typeset's specimen iframe
// target (/typeset/preview) render chrome-free: each is a full page meant
// to be embedded in an <iframe> or screenshotted in isolation, so site
// header/footer would frame it wrongly (mirrors shadcn's isolated /view
// and /preview routes, both chrome-free in the source too). Resolved from
// the request URL server-side so the chrome is absent from the SSR
// payload rather than hidden after hydration.
//
// The visual-parity harness's blank per-demo render route used to live
// here too (/parity/<demo>), but moved to its own standalone app —
// tooling/parity/harnesses/marko-ui/ — so this docs app ships no test
// routes. See tooling/parity/PROTOCOL.md.
<const/isBlockPreview=(
  $global.url.pathname.startsWith("/blocks/view/") ||
  $global.url.pathname.startsWith("/create/preview") ||
  $global.url.pathname.startsWith("/typeset/preview")
)/>

// Per-route title/description/canonical/OG, looked up by pathname. See
// ../lib/site-meta.ts for why this is a lookup table rather than a
// page-supplied prop (@marko/run layouts don't receive one).
<const/meta=resolveMeta($global.url.pathname)/>

<!doctype html>
<html
  lang="en"
  class="[--header-height:calc(var(--spacing)*14)] lg:[--header-height:calc(var(--spacing)*16)]"
>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${meta.title}</title>
    <meta name="description" content=meta.description>
    <link rel="canonical" href=meta.canonical>

    // Keep the iframe targets out of the index. Every `isBlockPreview` route
    // is a chrome-free fragment meant to be embedded, not a page to land on,
    // and none has a ROUTE_META entry — so resolveMeta gives each a
    // SELF-referential canonical, which would invite indexing rather than
    // prevent it. That matters most for /create/preview/<item>: those three
    // documents exist only so the static build can emit one file per showcase
    // item (the canonical URL is /create/preview?item=<item>), so indexing
    // them would publish three duplicates of a page that already exists.
    <if=isBlockPreview>
      <meta name="robots" content="noindex">
    </if>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <meta property="og:title" content=meta.title>
    <meta property="og:description" content=meta.description>
    <meta property="og:type" content=meta.ogType>
    <meta property="og:url" content=meta.canonical>
    <meta property="og:site_name" content=SITE_NAME>
    <meta property="og:locale" content=SITE_LOCALE>
    <meta property="og:image" content=DEFAULT_OG_IMAGE>
    <meta property="og:image:width" content=`${DEFAULT_OG_IMAGE_WIDTH}`>
    <meta property="og:image:height" content=`${DEFAULT_OG_IMAGE_HEIGHT}`>
    <meta property="og:image:alt" content=DEFAULT_OG_IMAGE_ALT>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content=meta.title>
    <meta name="twitter:description" content=meta.description>
    <meta name="twitter:image" content=DEFAULT_OG_IMAGE>
    <meta name="twitter:image:alt" content=DEFAULT_OG_IMAGE_ALT>

    <html-script>
      (function () {
        var storedTheme = null;
        try {
          storedTheme = localStorage.getItem("theme");
        } catch (error) {}
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = storedTheme ? storedTheme === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";

        var storedPalette = null;
        try {
          storedPalette = localStorage.getItem("chart-palette");
        } catch (error) {}
        document.documentElement.classList.toggle("theme-marko", storedPalette === "marko");

        // Cross-tab sync, mirroring next-themes: the storage event fires in
        // every OTHER same-origin tab/window when a tab explicitly sets
        // "theme" (this tab's own localStorage.setItem call never fires its
        // own storage event, only other tabs'), so switching the theme in
        // one tab updates every other open tab without a reload. We have no
        // "system" mode to re-sync on OS-preference change (unlike
        // next-themes, which also listens to matchMedia's own change event
        // when the stored theme is "system") — our toggle only ever stores
        // the literal "dark"/"light" (see theme-toggle.marko), so mirroring
        // "what we support" means storage-event sync only, not a matchMedia
        // listener for a mode that doesn't exist here.
        window.addEventListener("storage", function (event) {
          if (event.key !== "theme" && event.key !== null) return;
          var nextTheme = null;
          try {
            nextTheme = localStorage.getItem("theme");
          } catch (error) {}
          var nextIsDark = nextTheme
            ? nextTheme === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", nextIsDark);
          document.documentElement.style.colorScheme = nextIsDark ? "dark" : "light";
        });
      })();
    </html-script>

    // Docs sidebar active-into-view: on load, scroll the docs sidebar's OWN
    // scroll container ([data-slot="sidebar-content"], set overflow-auto by
    // packages/shadcn/ui/sidebar/content.marko) so the active item is
    // visible, without moving the page/window. Matches upstream shadcn's
    // apps/v4/lib/docs-sidebar-scroll.ts: sets container.scrollTop directly
    // rather than element.scrollIntoView() (which can walk up and scroll
    // ancestors, including the window) — mathematically confined to the one
    // container. Runs as a blocking inline script in <head>, before the
    // sidebar's own markup has even been parsed yet, so a MutationObserver
    // (same as upstream) watches the document until the container appears
    // and has real layout height, then applies and disconnects — this is
    // what makes it run before first paint with no visible jump/animation,
    // and it's why prefers-reduced-motion needs no special-case: an instant
    // scrollTop assignment has no animation to reduce. Not ported: upstream's
    // sessionStorage scroll-position restore — out of scope here (issue #76
    // only asks for active-item visibility on load).
    <html-script>
      (function () {
        if (!location.pathname.startsWith("/docs")) return;

        function centerActiveItem(container) {
          var active = container.querySelector('[data-active="true"]');
          if (!active) return;

          var containerRect = container.getBoundingClientRect();
          var activeRect = active.getBoundingClientRect();
          if (activeRect.top >= containerRect.top && activeRect.bottom <= containerRect.bottom) return;

          container.scrollTop +=
            activeRect.top - containerRect.top - (container.clientHeight - activeRect.height) / 2;
        }

        function run() {
          var containers = document.querySelectorAll('[data-slot="sidebar-content"]');
          var ready = containers.length > 0;
          for (var i = 0; i < containers.length; i++) {
            if (!containers[i].clientHeight) {
              ready = false;
              continue;
            }
            centerActiveItem(containers[i]);
          }
          return ready;
        }

        if (run()) return;

        var observer = new MutationObserver(function () {
          if (run()) observer.disconnect();
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });

        if (document.readyState === "loading") {
          document.addEventListener(
            "DOMContentLoaded",
            function () {
              run();
              observer.disconnect();
            },
            { once: true },
          );
        }
      })();
    </html-script>
  </head>
  <body class="group/body style-nova theme-default overscroll-none antialiased [--footer-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]">
    <div data-slot="layout" class="group/layout relative z-10 flex min-h-svh flex-col bg-background has-data-[slot=designer]:h-svh has-data-[slot=designer]:overflow-hidden">
      <if=!isBlockPreview>
        <site-header/>
      </if>
      <main class="flex min-h-0 flex-1 flex-col">
        <${input.content}/>
      </main>
      <if=!isBlockPreview>
        <site-footer/>
      </if>
    </div>
  </body>
</html>
