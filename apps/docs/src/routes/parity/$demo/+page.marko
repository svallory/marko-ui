// Blank-page, chrome-free render of ONE of our demos by name, for the
// visual-parity harness (tooling/parity/visual.ts). Mirrors the upstream
// React harness's route shape (tooling/parity/harness-react's
// `/demo/<name>` — see that app's src/App.tsx) so both sides can be driven
// identically by the runner: same URL shape convention (`/parity/<name>`
// vs `/demo/<name>`), same `[data-parity-demo]` screenshot-target selector.
//
// Resolves the URL's `<name>` segment against the demos-manifest (built by
// build-demos-manifest.ts) at request time, by SEARCHING every component's
// `demos` object for a matching key — never hardcode demo names here, the
// manifest is regenerated by another agent currently renaming demo files.
// A resolvable name gives us a `demoId` (e.g. "drawer/drawer-demo") to pass
// straight to demo-renderer.marko, which dispatches via a static if-chain
// instead of a dynamic tag — Marko 6.3.34 crashes hydration on a
// runtime-resolved dynamic tag (see
// notes/bug-marko-dynamic-tag-hydration-crash.md). Do NOT replace this with
// `<${SomeDynamicTag}/>`.
import "../../../tags/docs/demo-renderer.marko";
import { DEMOS } from "../../../demos/demos-manifest.ts";

static function resolveDemoId(demoName: string): string | null {
  for (const component of Object.values(DEMOS)) {
    const entry = component.demos[demoName];
    if (entry) return entry.demoId;
  }
  return null;
}

<const/demoName=$global.params.demo/>
<const/demoId=resolveDemoId(demoName)/>

<if=!demoId>
  <div data-parity-demo=demoName style="padding:24px;font-family:monospace">
    unknown demo "${demoName}" — no demos-manifest.ts entry with this key
  </div>
</if>
<else>
  <div
    data-parity-demo=demoName
    style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:32px"
  >
    <demo-renderer demoId=demoId/>
  </div>
</else>
