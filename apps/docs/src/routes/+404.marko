// 404 page. @marko/run only allows +404.marko at the routes root, and it
// still renders through this directory's +layout.marko, so it automatically
// gets the site header/footer/theme script like every other page — no
// separate chrome to maintain here.
import { COMPONENTS } from "../lib/components-list.ts";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

<main class="mx-auto flex max-w-2xl flex-1 flex-col items-center justify-center gap-6 px-4 py-24 text-center sm:px-6 lg:px-8">
  <p class="font-mono text-sm text-muted-foreground">404</p>
  <div class="space-y-2">
    <h1 class="text-3xl font-bold tracking-tight text-foreground">Page not found</h1>
    <p class="text-muted-foreground">
      The page you're looking for doesn't exist or may have moved.
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-3">
    <a href="/">
      <Button class="rounded-lg">
        Back home
      </Button>
    </a>
    <a href="/docs">
      <Button variant="outline" class="rounded-lg">
        Browse the docs
      </Button>
    </a>
  </div>

  <p class="text-sm text-muted-foreground">
    Looking for a component? There are ${COMPONENTS.length} in the registry — try
    <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">/docs/components/&lt;name&gt;</code>,
    e.g. <a href="/docs/components/button" class="font-medium text-foreground underline underline-offset-4">button</a>
    or <a href="/docs/components/dialog" class="font-medium text-foreground underline underline-offset-4">dialog</a>.
  </p>
</main>
