// The /create preview iframe target. Ported from shadcn's
// app/(view)/preview/[base]/[name]/page.tsx — a chrome-free route that
// renders shadcn's real preview showcase content, themed by CSS vars the
// parent window pushes in via postMessage.
//
// Real shadcn /create shows exactly TWO purpose-built dashboard-style
// showcase pages, switched by the bottom-right "01"/"02" pager
// (components/preview-switcher.tsx): registry items `preview-02` (their
// default — search-params.ts: parseAsString.withDefault("preview-02")) and
// `preview`. A third `preview-03` exists on disk there but is dead code
// (not in PREVIEW_ITEMS), so it is not ported. This port uses
// position-based item names instead of shadcn's registry names:
// preview-page-1 (ports shadcn's preview-02, the default), preview-page-2
// (ports shadcn's preview), preview-page-3 (our own marko-ui-unique
// showcase). The earlier phase's 28-block/12-demo `block:`/`component:`
// if-chain was an invention and is replaced by this scheme.
//
// The item pick is a static <if>/<else> — dynamic tags (`<${Component}/>`)
// crash production DOM hydration, see
// notes/bug-marko-dynamic-tag-hydration-crash.md.
//
// Theme sync: the iframe-side half of hooks/use-iframe-sync.tsx +
// components/preview-style.tsx + the DOM-effect logic in
// design-system-provider.tsx. It listens for `design-system-params`
// postMessages from the parent (../../../tags/create/preview.marko) and
// writes the same #design-system-theme-vars <style> + body classes +
// --font-sans/--font-heading vars design-system.marko writes on the host
// document, so the identical DOM-effect logic runs in both places.
import {
  DEFAULT_CONFIG,
  buildRegistryTheme,
  POINTER_CURSOR_SELECTOR,
  type DesignSystemConfig,
  BASES,
  STYLES,
  THEMES,
  BASE_COLORS,
  iconLibraries,
  MENU_ACCENTS,
  MENU_COLORS,
  RADII,
} from "../../../tags/create/lib/registry-config.ts";
import { FONTS } from "../../../tags/create/lib/fonts.ts";
import type { DesignSystemSearchParams } from "../../../tags/create/lib/search-params.ts";
import { ICON_WRAPPER_ATTRS } from "@marko-ui/shadcn/ui/icon/render.ts";
// client-swap.ts, not resolve.ts: resolve.ts statically imports all 5
// generated icon maps for SSR's synchronous render (fine server-side, never
// shipped to the browser); this route runs in the browser and must lazily
// `import()` only the library actually being switched to, mirroring
// shadcn's own create-icon-loader.tsx per-library React.lazy — see
// client-swap.ts's header comment. Using resolve.ts here would defeat the
// whole point and bundle every library's ~360KB combined into this page's
// client chunk.
import {
  resolveIconInnerAsync,
  preloadAllIconLibraries,
} from "@marko-ui/shadcn/ui/icon/client-swap.ts";
import type { IconLibraryName } from "@marko-ui/shadcn/ui/icon/icon-names.ts";

import PreviewPage1 from "../../../tags/create/preview-blocks/preview-page-1/index.marko";
import PreviewPage2 from "../../../tags/create/preview-blocks/preview-page-2/index.marko";
import PreviewPage3 from "../../../tags/create/preview-blocks/preview-page-3/index.marko";

static const THEME_STYLE_ELEMENT_ID = "design-system-theme-vars";
static const MANAGED_BODY_CLASS_PREFIXES = ["style-", "base-color-"] as const;

// Build allowed value sets from registry config for validation
static const ALLOWED_BASES = new Set(BASES.map((b) => b.name));
static const ALLOWED_STYLES = new Set(STYLES.map((s) => s.name));
static const ALLOWED_THEMES = new Set(THEMES.map((t) => t.name));
static const ALLOWED_BASE_COLORS = new Set(BASE_COLORS.map((b) => b.name));
static const ALLOWED_ICON_LIBRARIES = new Set(Object.keys(iconLibraries));
static const ALLOWED_MENU_ACCENTS = new Set(MENU_ACCENTS.map((a) => a.value));
static const ALLOWED_MENU_COLORS = new Set(MENU_COLORS.map((m) => m.value));
static const ALLOWED_RADII = new Set(RADII.map((r) => r.name));
static const ALLOWED_FONTS = new Set(FONTS.map((f) => f.value));
static const ALLOWED_FONT_HEADINGS = new Set(["inherit", ...FONTS.map((f) => f.value)]);

static function validateDesignSystemParams(
  payload: unknown
): boolean {
  // Check payload type and basic shape
  if (!payload || typeof payload !== "object") {
    console.warn("[create/preview] incoming postMessage payload is not an object", payload);
    return false;
  }

  const data = payload as Record<string, unknown>;

  // Check message type
  if (data.type !== "design-system-params") {
    console.warn("[create/preview] incoming message type is not 'design-system-params'", data.type);
    return false;
  }

  // Check params shape
  if (!data.data || typeof data.data !== "object") {
    console.warn("[create/preview] incoming message.data is not an object", data.data);
    return false;
  }

  const params = data.data as Record<string, unknown>;

  // Validate known fields against their allowed values (where available)
  const fieldValidations: Array<[string, Set<string> | null]> = [
    ["base", ALLOWED_BASES],
    ["style", ALLOWED_STYLES],
    ["theme", ALLOWED_THEMES],
    ["baseColor", ALLOWED_BASE_COLORS],
    ["chartColor", ALLOWED_THEMES], // chartColor uses theme names
    ["iconLibrary", ALLOWED_ICON_LIBRARIES],
    ["menuAccent", ALLOWED_MENU_ACCENTS],
    ["menuColor", ALLOWED_MENU_COLORS],
    ["radius", ALLOWED_RADII],
    ["font", ALLOWED_FONTS],
    ["fontHeading", ALLOWED_FONT_HEADINGS],
  ];

  for (const [field, allowedSet] of fieldValidations) {
    if (field in params && params[field] !== undefined && params[field] !== null) {
      const value = params[field];
      if (typeof value !== "string" || (allowedSet && !allowedSet.has(value))) {
        console.warn(
          `[create/preview] invalid value for field '${field}'`,
          value,
          `expected one of: ${Array.from(allowedSet || new Set()).join(", ")}`
        );
        return false;
      }
    }
  }

  // Validate boolean fields
  for (const field of ["__isDark", "rtl", "pointer"]) {
    if (field in params && params[field] !== undefined && params[field] !== null) {
      if (typeof params[field] !== "boolean") {
        console.warn(`[create/preview] invalid value for boolean field '${field}'`, params[field]);
        return false;
      }
    }
  }

  // Validate numeric fields
  for (const field of ["size"]) {
    if (field in params && params[field] !== undefined && params[field] !== null) {
      if (typeof params[field] !== "number") {
        console.warn(`[create/preview] invalid value for numeric field '${field}'`, params[field]);
        return false;
      }
    }
  }

  return true;
}

static function removeManagedBodyClasses(body: Element) {
  for (const className of Array.from(body.classList)) {
    if (MANAGED_BODY_CLASS_PREFIXES.some((prefix) => className.startsWith(prefix))) {
      body.classList.remove(className);
    }
  }
}

static function buildCssRule(selector: string, cssVars?: Record<string, string>) {
  const declarations = Object.entries(cssVars ?? {})
    .filter(([, value]) => Boolean(value))
    .map(([key, value]) => `  --${key}: ${value};`)
    .join("\n");
  if (!declarations) return `${selector} {}\n`;
  return `${selector} {\n${declarations}\n}\n`;
}

static const POINTER_CURSOR_CSS = `@layer base {
  ${POINTER_CURSOR_SELECTOR} {
    cursor: pointer;
  }
}
`;

static function applyParams(params: DesignSystemSearchParams) {
  const { style, theme, font, fontHeading, baseColor, radius, menuAccent, pointer } = params;

  if (style && theme && font && baseColor) {
    const body = document.body;
    removeManagedBodyClasses(body);
    body.classList.add(`style-${style}`, `base-color-${baseColor}`);

    const selectedFont = FONTS.find((option) => option.value === font);
    const selectedHeadingFont =
      fontHeading === "inherit" || fontHeading === font
        ? selectedFont
        : FONTS.find((option) => option.value === fontHeading);

    if (selectedFont) {
      document.documentElement.style.setProperty("--font-sans", selectedFont.font.style.fontFamily);
    }
    if (selectedHeadingFont) {
      document.documentElement.style.setProperty("--font-heading", selectedHeadingFont.font.style.fontFamily);
    }

    for (const option of [selectedFont, selectedHeadingFont]) {
      if (!option || !option.font.googleFontsUrl) continue;
      const id = `design-system-font-${option.value}`;
      if (!document.getElementById(id)) {
        const link = document.createElement("link");
        link.id = id;
        link.rel = "stylesheet";
        link.href = option.font.googleFontsUrl;
        document.head.appendChild(link);
      }
    }
  }

  const effectiveRadius = style === "lyra" ? "none" : radius;
  if (baseColor && theme && menuAccent && effectiveRadius) {
    const config = {
      ...DEFAULT_CONFIG,
      baseColor,
      theme,
      chartColor: params.chartColor,
      menuAccent,
      radius: effectiveRadius,
    } as DesignSystemConfig;

    // buildRegistryTheme throws on a baseColor/theme it doesn't recognize.
    // This handler runs directly off an unvalidated postMessage payload
    // (see the message listener below), so a malformed/stale message must
    // not throw uncaught out of the listener and silently kill the rest of
    // this event's processing (e.g. the dark-class toggle that already ran).
    let registryTheme: ReturnType<typeof buildRegistryTheme> | null = null;
    try {
      registryTheme = buildRegistryTheme(config);
    } catch (error) {
      console.error("[create/preview] failed to build theme", error);
    }
    if (registryTheme?.cssVars) {
      let styleElement = document.getElementById(THEME_STYLE_ELEMENT_ID) as HTMLStyleElement | null;
      if (!styleElement) {
        styleElement = document.createElement("style");
        styleElement.id = THEME_STYLE_ELEMENT_ID;
        document.head.appendChild(styleElement);
      }
      styleElement.textContent = [
        buildCssRule(":root", { ...(registryTheme.cssVars.theme ?? {}), ...(registryTheme.cssVars.light ?? {}) }),
        buildCssRule(".dark", registryTheme.cssVars.dark),
        pointer ? POINTER_CURSOR_CSS : "",
      ]
        .filter(Boolean)
        .join("\n");
    }
  }
}

// Swaps every rendered icon's markup + wrapper attrs to the newly-selected
// library, in place — the manual-DOM-patch half of the icon-library picker
// (see packages/registry/default/ui/icon/icon.marko's header comment: SSR
// renders the initial iconLibrary from the URL, and this is the ONLY path
// that updates it afterward, since re-keying the iframe src would reload
// and flash/lose state — same tradeoff as every other design-system param
// here). `[data-icon-name]`/`[data-icon-library]` are written by icon.marko
// specifically so this loop can find and patch them; resolveIconInnerAsync/
// ICON_WRAPPER_ATTRS are the exact same generated, trusted (non-user-input)
// data icon.marko's own SSR render uses (via resolve.ts server-side, via
// client-swap.ts's lazy import() here), so this can never drift from it.
// Async because client-swap.ts dynamically imports the target library's map
// on first use (code-splitting — see that file's header); each icon is
// patched as soon as its own resolution resolves rather than waiting for
// the slowest one, so already-loaded libraries (e.g. switching back to one
// used earlier this session) still feel instant.
static let latestRequestedLibrary: IconLibraryName | null = null;

static async function applyIconLibrary(iconLibrary: IconLibraryName) {
  // `iconLibrary` arrives via postMessage from the parent frame, which only
  // ever TS-casts it (design-system.marko's decoded URL/preset state) — no
  // runtime check. An unrecognized value must not reach ICON_WRAPPER_ATTRS[]
  // as undefined (would throw on `.viewBox` below); fall back to lucide,
  // matching icon.marko's own SSR-side guard for the same untrusted input.
  if (!(iconLibrary in ICON_WRAPPER_ATTRS)) {
    iconLibrary = "lucide";
  }
  latestRequestedLibrary = iconLibrary;
  const attrs = ICON_WRAPPER_ATTRS[iconLibrary];
  const icons = document.querySelectorAll<SVGSVGElement>("[data-icon-name]");
  await Promise.all(
    Array.from(icons).map(async (svg) => {
      if (svg.getAttribute("data-icon-library") === iconLibrary) return;
      const name = svg.getAttribute("data-icon-name");
      if (!name) return;

      const inner = await resolveIconInnerAsync(name, iconLibrary);
      // A newer picker change may have superseded this in-flight request
      // (fast repeated hover-preview) — bail so a slow-resolving stale
      // swap can't clobber a more recent one.
      if (latestRequestedLibrary !== iconLibrary) return;

      svg.setAttribute("viewBox", attrs.viewBox);
      for (const attr of ["fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"] as const) {
        if (attrs[attr]) {
          svg.setAttribute(attr, attrs[attr]!);
        } else {
          svg.removeAttribute(attr);
        }
      }
      svg.innerHTML = inner;
      svg.setAttribute("data-icon-library", iconLibrary);
    })
  );
}

// No `Input.item`/`Input.base`: marko-run route files don't map query-string
// params onto a page's `input`. Read the query string from `$global.url`,
// matching how `+handler.ts` files in this app already do it. Default
// mirrors shadcn's parseAsString.withDefault("preview-02") — our
// position-named equivalent is preview-page-1; unknown values fall back to
// it exactly like an unmatched dynamic route would 404 to the default there.
<const/rawItem=$global.url.searchParams.get("item")/>
<const/item=(
  rawItem === "preview-page-2" || rawItem === "preview-page-3" ? rawItem : "preview-page-1"
)/>

// `base` (registry base name — "radix", "base", "aria", see
// ../../../tags/create/lib/registry-config.ts's BASES) is read the same way
// and threaded onto <body data-base> below. Unlike every other design-system
// param, base is NOT part of the postMessage-synced theme — switching base
// changes the iframe `src` itself (../../../tags/create/preview.marko keys
// the src by base + item, mirroring shadcn's `key={params.base + params.item}`
// on its <iframe>), so a base change is a genuine full iframe reload here,
// not a live re-theme. This registry has ONE unified zag.js implementation
// backing every base — bases only differ in shadcn's *upstream* React
// primitive library (Radix UI / Base UI / React Aria), which has no
// equivalent axis in our zag-based components — so the reloaded document is
// byte-identical markup regardless of which base is selected. The reload
// (and matching loading-skeleton flash) is preserved anyway for interaction
// parity with the source, not because the markup actually differs.
<const/rawBase=$global.url.searchParams.get("base")/>
<const/base=(rawBase ?? DEFAULT_CONFIG.base)/>

// No own <!doctype html>/<html>/<head>/<body>: this route renders inside
// ../../../routes/+layout.marko like every other page (that layout supplies
// the document shell and excludes header/footer chrome for this path
// prefix — see its `isBlockPreview` check, extended to also match
// `/create/preview/`).
<div class="bg-background text-foreground antialiased" data-preview-item=item>
  <if=(item === "preview-page-2")>
    <PreviewPage2/>
  </if>
  <else if=(item === "preview-page-3")>
    <PreviewPage3/>
  </else>
  <else>
    <PreviewPage1/>
  </else>
</div>

<let/mounted=false/>
<script>
  if (!mounted && typeof window !== "undefined") {
    mounted = true;

    // Record which base this document was loaded for — see the `base`
    // const's header comment above: this is diagnostic only (no selector in
    // this app's CSS reads `[data-base]`), documenting that the reload was
    // real and its markup is base-invariant by design, not covering for a
    // per-base markup difference that doesn't exist.
    document.body.setAttribute("data-base", base);

    // Warm every icon library's module cache in the background (mirrors
    // shadcn's icon-placeholder.tsx: `void import(...)` for all 5 libraries
    // unconditionally on mount) so the first picker switch is instant.
    preloadAllIconLibraries();

    window.addEventListener("message", (event: MessageEvent) => {
      // Validate incoming message payload shape and field values
      if (!validateDesignSystemParams(event.data)) return;

      const data = event.data.data as DesignSystemSearchParams & { __isDark?: boolean };
      document.documentElement.classList.toggle("dark", Boolean(data.__isDark));
      applyParams(data);
      if (data.iconLibrary) {
        applyIconLibrary(data.iconLibrary);
      }
    });

    // Announce readiness so the parent's <iframe onload> re-send (which
    // already fires) has a matching signal for the loading-skeleton swap
    // in ../../../tags/create/preview.marko.
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: "design-system-preview-ready" }, "*");
    }
  }
</script>
