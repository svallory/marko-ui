import {
  BASE_COLORS,
  ACCENTS,
  RADII,
  FONTS,
  CHART_PALETTES,
  DEFAULT_CONFIG,
  buildThemeVariables,
  toStyleString,
  toCssBlock,
  parseConfig,
  serializeConfig,
  type DesignSystemConfig,
} from "../../tags/create/theme-options.ts";

<let/config=DEFAULT_CONFIG/>
<let/overlay=null as Partial<DesignSystemConfig> | null/>
<let/previewMode="light" as "light" | "dark"/>
<let/copyState="Copy CSS"/>

// Restore a shared configuration from the query string on first paint, and
// follow the page's own theme for the initial preview surface.
<script>
  const restored = parseConfig(window.location.search);
  config = restored;
  previewMode = document.documentElement.classList.contains("dark")
    ? "dark"
    : "light";
</script>

<const/effectiveConfig=overlay ? { ...config, ...overlay } : config/>
<const/previewStyle=toStyleString(
  buildThemeVariables(effectiveConfig, previewMode),
)/>
<const/chartColors=(
  CHART_PALETTES.find((palette) => palette.name === effectiveConfig.chart) ??
  CHART_PALETTES[0]
).colors/>

<const/commitConfig=(next: DesignSystemConfig) => {
  config = next;
  overlay = null;
  copyState = "Copy CSS";
  // Keep the URL shareable without adding a history entry per click.
  window.history.replaceState(
    null,
    "",
    window.location.pathname + serializeConfig(next),
  );
}/>

<const/randomize=() => {
  const pick = (options: { name: string }[]) =>
    options[Math.floor(Math.random() * options.length)].name;
  commitConfig({
    baseColor: pick(BASE_COLORS),
    accent: pick(ACCENTS),
    radius: pick(RADII),
    font: pick(FONTS),
    chart: pick(CHART_PALETTES),
  });
}/>

<const/applyOverlay=(next: Partial<DesignSystemConfig> | null) => {
  overlay = next;
}/>

<const/setPreviewMode=(mode: "light" | "dark") => {
  previewMode = mode;
}/>

<const/resetConfig=() => {
  commitConfig(DEFAULT_CONFIG);
}/>

<const/copyCss=() => {
  navigator.clipboard
    .writeText(toCssBlock(config))
    .then(() => {
      copyState = "Copied!";
    })
    .catch(() => {
      copyState = "Copy failed";
    });
}/>

<div
  class="relative flex min-h-[calc(100vh-8rem)] flex-col [--customizer-width:18rem] [--gap:1rem] md:[--gap:1.5rem]"
>
  <div class="flex flex-col gap-2 px-(--gap) pt-(--gap)">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-semibold tracking-tight">Create</h1>
        <p class="max-w-2xl text-sm text-muted-foreground">
          Tune the marko-ui token set and watch real components react. Copy the
          result straight into your
          <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">globals.css</code>.
        </p>
      </div>
      <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">
        Preview — settings live in the URL, nothing is saved server-side
      </span>
    </div>
  </div>

  <div
    data-slot="designer"
    class="flex min-h-0 flex-1 flex-col gap-(--gap) p-(--gap) md:flex-row-reverse"
  >
    <create-customizer
      config=config
      configChange=commitConfig
      previewChange=applyOverlay
      mode=previewMode
      modeChange=setPreviewMode
      onRandomize=randomize
      onReset=resetConfig
      onCopy=copyCss
      copyState=copyState
    />

    <div class="relative min-h-[32rem] flex-1 overflow-hidden rounded-2xl border border-border md:min-h-0">
      <create-preview
        style=previewStyle
        mode=previewMode
        chartColors=chartColors
      />
    </div>
  </div>
</div>
