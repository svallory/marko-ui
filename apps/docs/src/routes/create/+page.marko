// Ported from shadcn/ui app/(app)/(create)/create/page.tsx +
// create/layout.tsx. The real /create page: design-system.marko is this
// port's single state container replacing the source's
// LocksProvider > HistoryProvider > PreviewOverrideProvider stack (see its
// header comment for the full provider-to-container mapping) and mounts
// Preview + Customizer + WelcomeDialog + the reset/open-preset/action-menu
// dialogs — everything create/page.tsx composes directly, matching the
// same tree here.
//
// Deviations from source:
// - No CreateSkeleton/Suspense boundary: the source's HistoryProvider reads
//   useSearchParams(), which opts a Next.js subtree out of prerendering, so
//   loading.tsx / create-skeleton.marko paint until that resolves
//   client-side. This route has no equivalent server/client boundary (Vite
//   SSR renders design-system.marko synchronously with URL-derived
//   defaults, matching every other page on this site) — create-skeleton.marko
//   is kept as an available tag (ported faithfully) but isn't reachable
//   from this route, since there's no async gap for it to fill here.
// - Outer wrapper class: source's
//   `[--customizer-width:--spacing(48)] [--gap:--spacing(4)]
//   md:[--gap:--spacing(6)] 2xl:[--customizer-width:--spacing(56)]`
//   uses shadcn's own Tailwind v4 `--spacing()` function tokens, not
//   present in this docs site's config; the equivalent literal rem values
//   are used instead (48*0.25rem=12rem... actually --spacing(n) = n*0.25rem
//   in Tailwind v4, so --spacing(48)=12rem, --spacing(56)=14rem,
//   --spacing(4)=1rem, --spacing(6)=1.5rem) — same computed values, spelled
//   as directly usable custom properties.
import DesignSystem from "../../tags/create/design-system.marko";

<div
  class="relative z-10 flex min-h-0 flex-1 flex-col overflow-hidden [--customizer-width:12rem] [--gap:1rem] md:[--gap:1.5rem] 2xl:[--customizer-width:14rem]"
>
  <div
    data-slot="designer"
    class="flex min-h-0 flex-1 flex-col gap-(--gap) p-(--gap) pt-[calc(var(--gap)*0.25)] md:flex-row-reverse"
  >
    <DesignSystem/>
  </div>
</div>
