// Rebuilt to match shadcn/ui's `/create` page (MIT): the canvas IS the real
// component showcase grid — the same dense, multi-column masonry of cards
// used on the home page — filling the viewport edge to edge, with a
// floating dark customizer panel pinned over the top-left corner. Token
// choices apply live by setting CSS custom properties on a wrapper div
// around the reused `<home-showcase>` grid, exactly like shadcn swaps CSS
// variables on its preview iframe's document root.
import "../../tags/home/home-showcase.marko";
import {
  BASE_COLORS,
  ACCENTS,
  RADII,
  FONTS,
  CHART_PALETTES,
  DEFAULT_CONFIG,
  buildThemeVariables,
  toStyleString,
  toCssBlock,
  parseConfig,
  serializeConfig,
  type DesignSystemConfig,
} from "../../tags/create/theme-options.ts";

<let/config=DEFAULT_CONFIG/>
<let/overlay=null as Partial<DesignSystemConfig> | null/>
<let/previewMode="light" as "light" | "dark"/>
<let/copyState="Copy CSS"/>

// Restore a shared configuration from the query string on first paint, and
// follow the page's own theme for the initial canvas surface.
<script>
  const restored = parseConfig(window.location.search);
  config = restored;
  previewMode = document.documentElement.classList.contains("dark")
    ? "dark"
    : "light";
</script>

<const/effectiveConfig=overlay ? { ...config, ...overlay } : config/>
<const/canvasStyle=toStyleString(buildThemeVariables(effectiveConfig, previewMode))/>

<const/commitConfig=(next: DesignSystemConfig) => {
  config = next;
  overlay = null;
  copyState = "Copy CSS";
  // Keep the URL shareable without adding a history entry per click.
  window.history.replaceState(
    null,
    "",
    window.location.pathname + serializeConfig(next),
  );
}/>

<const/randomize=() => {
  const pick = (options: { name: string }[]) =>
    options[Math.floor(Math.random() * options.length)].name;
  commitConfig({
    baseColor: pick(BASE_COLORS),
    accent: pick(ACCENTS),
    radius: pick(RADII),
    fontHeading: pick(FONTS),
    font: pick(FONTS),
    chart: pick(CHART_PALETTES),
  });
}/>

<const/applyOverlay=(next: Partial<DesignSystemConfig> | null) => {
  overlay = next;
}/>

<const/setPreviewMode=(mode: "light" | "dark") => {
  previewMode = mode;
}/>

<const/resetConfig=() => {
  commitConfig(DEFAULT_CONFIG);
}/>

<const/copyCss=() => {
  navigator.clipboard
    .writeText(toCssBlock(config))
    .then(() => {
      copyState = "Copied!";
    })
    .catch(() => {
      copyState = "Copy failed";
    });
}/>

<div class="relative isolate min-h-[calc(100vh-3.5rem)]" data-slot="create-page">
  <!-- Headings/card titles read --font-heading, which the "Heading" picker
       sets; nothing else in the registry consumes that variable yet, so it
       is scoped here rather than added globally. -->
  <style>
    [data-slot="create-canvas"] h1,
    [data-slot="create-canvas"] h2,
    [data-slot="create-canvas"] h3,
    [data-slot="create-canvas"] h4,
    [data-slot="create-canvas"] [data-slot="card-title"] {
      font-family: var(--font-heading);
    }
  </style>

  <div
    class=`${previewMode === "dark" ? "dark" : ""} relative w-full overflow-x-hidden bg-background text-foreground`
    style=canvasStyle
    data-slot="create-canvas"
  >
    <home-showcase/>
  </div>

  <div
    class="pointer-events-none fixed inset-x-0 top-[3.5rem] bottom-0 z-40 flex items-start p-4 md:p-6"
  >
    <create-customizer
      class="pointer-events-auto"
      config=config
      configChange=commitConfig
      previewChange=applyOverlay
      mode=previewMode
      modeChange=setPreviewMode
      onRandomize=randomize
      onReset=resetConfig
      onCopy=copyCss
      copyState=copyState
    />
  </div>
</div>
