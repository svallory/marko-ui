// Ported from shadcn/ui app/(app)/(typeset)/typeset/page.tsx +
// typeset/layout.tsx. Wrapper class strings and the data-slot="designer"
// inner frame are verbatim; typeset-app.marko is this port's single state
// container, replacing the source's LocksProvider > Suspense >
// TypesetHistoryProvider > TypesetPreviewOverrideProvider stack, and it
// mounts DocsPanel + Preview + Customizer in the same order page.tsx does
// (see its header comment for the full provider-to-container mapping).
//
// Deviations from source:
// - No Suspense/TypesetSkeleton boundary: upstream's HistoryProvider reads
//   useSearchParams(), which opts a Next subtree out of prerendering, so
//   typeset-skeleton paints until that resolves client-side. This route SSRs
//   synchronously from URL-derived defaults like every other page here, so
//   there is no async gap to fill (typeset-skeleton.marko is ported and
//   available but unreachable — same call /create's port made).
// - `previewFontVariables` (the next/font variable class list applied to the
//   wrapper) has no analogue: there is no next/font here, the preview iframe
//   loads faces via a Google Fonts link instead. Dropped rather than faked.
// - `--spacing(n)` Tailwind-v4 function tokens are spelled as the literal
//   rem values they compute to (n * 0.25rem), matching how
//   ../create/+page.marko already handles the same wrapper.
import TypesetApp from "../../tags/typeset/typeset-app.marko";

<div
  class="relative z-10 flex min-h-0 flex-1 flex-col overflow-hidden section-soft [--customizer-width:12rem] [--gap:1rem] md:[--gap:1.5rem] 2xl:[--customizer-width:14rem]"
>
  <div
    data-slot="designer"
    class="flex min-h-0 flex-1 flex-col items-start gap-(--gap) p-(--gap) pt-[calc(var(--gap)*0.25)] md:flex-row-reverse"
  >
    <TypesetApp/>
  </div>
</div>
