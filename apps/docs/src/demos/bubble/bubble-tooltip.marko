import Bubble from "@marko-ui/shadcn/ui/bubble/bubble.marko";
import BubbleContent from "@marko-ui/shadcn/ui/bubble/bubble-content.marko";
import BubbleReactions from "@marko-ui/shadcn/ui/bubble/bubble-reactions.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";
import Tooltip from "@marko-ui/shadcn/ui/tooltip/tooltip.marko";

<div class="flex w-full max-w-sm flex-col gap-4 py-12">
  <Bubble variant="secondary">
    <BubbleContent>Did you remove the stale route?</BubbleContent>
  </Bubble>
  <Bubble align="end">
    <BubbleContent>Yes, removed it from the registry.</BubbleContent>
    <BubbleReactions>
      // `aria-label` is required on the trigger itself: @zag-js/tooltip's
      // getTriggerProps() only sets `aria-describedby` while the tooltip is
      // actually OPEN (it's `void 0` when closed, by design — the content
      // shouldn't be announced until shown), so an icon-only button has no
      // accessible name at all in its default/closed state (axe: button-name).
      // `aria-describedby` also wouldn't be sufficient by itself even when
      // present — it supplements an accessible name, it doesn't provide one.
      <Tooltip content="Read on Jan 5, 2026 at 4:32 PM">
        <@trigger|triggerProps|>
          <Button ...triggerProps variant="ghost" size="icon-xs" aria-label="Read on Jan 5, 2026 at 4:32 PM">
            <Icon name="Check"/>
          </Button>
        </@trigger>
      </Tooltip>
    </BubbleReactions>
  </Bubble>
</div>
