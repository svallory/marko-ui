import InputOTP from "@marko-ui/shadcn/ui/input-otp/input-otp.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

<Card class="mx-auto max-w-md">
  <CardHeader>
    <CardTitle>Verify your login</CardTitle>
    <CardDescription>
      Enter the verification code we sent to your email address: <span class="font-medium">m@example.com</span>.
    </CardDescription>
  </CardHeader>
  <CardContent>
    <Field>
      <div class="flex items-center justify-between">
        <FieldLabel for="otp-verification">Verification code</FieldLabel>
        <Button variant="outline" size="xs">
          <Icon name="RefreshCwIcon"/>
          Resend Code
        </Button>
      </div>
      <InputOTP length=6 groupSize=3 id="otp-verification" required
        class="*:data-[slot=input-otp-slot]:h-12 *:data-[slot=input-otp-slot]:w-11 *:data-[slot=input-otp-slot]:text-xl"
      />
      <FieldDescription>
        <a href="#">I no longer have access to this email address.</a>
      </FieldDescription>
    </Field>
  </CardContent>
  <CardFooter>
    <Field>
      <Button type="submit" class="w-full">Verify</Button>
      <div class="text-sm text-muted-foreground">
        Having trouble signing in? <a href="#" class="underline underline-offset-4 transition-colors hover:text-primary">Contact support</a>
      </div>
    </Field>
  </CardFooter>
</Card>
