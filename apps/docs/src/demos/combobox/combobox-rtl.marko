// Static RTL port: shadcn's source drives this demo through a client-side
// language-selector (useTranslation) that has no equivalent in this docs
// app (see skills/port-to-marko — no such utility exists here). Instead of
// faking an interactive language switcher, this ports the RTL VISUAL and
// markup behavior directly: a `dir="rtl"` combobox with Arabic copy,
// matching the source's default locale ("ar"). `dir` is a real machine prop
// (@zag-js/combobox `combobox.props`), so it drives both the DOM attribute
// and Zag's own RTL-aware keyboard/positioning logic.
import Combobox from "@marko-ui/shadcn/ui/combobox/combobox.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";

static const categories = [
  { value: "technology", label: "التكنولوجيا" },
  { value: "design", label: "التصميم" },
  { value: "business", label: "الأعمال" },
  { value: "marketing", label: "التسويق" },
  { value: "education", label: "التعليم" },
  { value: "health", label: "الصحة" },
];

<Field dir="rtl" class="mx-auto w-full max-w-xs">
  <FieldLabel>الفئات</FieldLabel>
  <Combobox
    items=categories
    multiple
    inputBehavior="autohighlight"
    defaultValue=["technology"]
    placeholder="أضف فئات"
    dir="rtl"
  />
</Field>
