import ContextMenu from "@marko-ui/registry/ui/context-menu/context-menu.marko";

static const ITEMS = [
  { value: "copy", label: "Copy" },
  { value: "paste", label: "Paste" },
  { type: "separator" },
  { value: "delete", label: "Delete", danger: true },
];

<let/selected=""/>

<div class="flex items-center gap-4">
  <ContextMenu items=ITEMS select(value) { selected = value; }>
    <@content>
      <div class="flex h-[100px] w-[200px] items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground">
        Right click here
      </div>
    </@content>
  </ContextMenu>
  <span class="text-muted-foreground text-sm">selected: ${selected || "none"}</span>
</div>
