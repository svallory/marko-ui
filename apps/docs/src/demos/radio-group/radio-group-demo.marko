import RadioGroup from "@marko-ui/shadcn/ui/radio-group/radio-group.marko";

static const ITEMS = [
  { value: "default", label: "Default" },
  { value: "comfortable", label: "Comfortable" },
  { value: "compact", label: "Compact" },
];

// `defaultValue`, not `value`: a `value` with no change handler is a CONTROLLED
// value, so the group can never move. The hero example is the first thing an
// agent reads; a frozen one teaches the opposite of what it shows.
<RadioGroup items=ITEMS defaultValue="comfortable"/>
