// Upstream's radio-group-rtl demo drives a live language switcher
// (useTranslation) that has no equivalent in this docs app — established
// precedent: demos/select/select-rtl.marko, demos/badge/badge-rtl.marko.
// This ports the RTL VISUAL directly: a static dir="rtl" group with Arabic
// copy, matching upstream's default locale ("ar"). `dir` is not a
// @zag-js/radio-group machine prop, so it passes through as a plain native
// attribute on the root div — CSS logical properties handle the mirroring.
import RadioGroup from "@marko-ui/shadcn/ui/radio-group/radio-group.marko";

static const ITEMS = [
  { value: "default", label: "افتراضي" },
  { value: "comfortable", label: "مريح" },
  { value: "compact", label: "مضغوط" },
];

<RadioGroup items=ITEMS value="comfortable" dir="rtl" class="w-fit"/>
