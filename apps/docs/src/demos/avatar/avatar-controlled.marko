import Avatar from "@marko-ui/registry/ui/avatar/avatar.marko";

<let/status="unknown"/>
<let/src="https://github.com/shadcn.png"/>

<div class="flex flex-col items-start gap-3">
  <Avatar
    src=src
    alt="Controlled avatar"
    fallback="CN"
    statusChange(nextStatus) { status = nextStatus; }
  />
  <div class="flex gap-2">
    <button
      class="border-input rounded-md border px-2 py-1 text-sm"
      onClick() { src = "https://github.com/shadcn.png"; }
    >
      Valid src
    </button>
    <button
      class="border-input rounded-md border px-2 py-1 text-sm"
      onClick() { src = "https://broken-image-url.example/none.png"; }
    >
      Broken src
    </button>
  </div>
  <p class="text-muted-foreground text-sm">Status: ${status}</p>
</div>
