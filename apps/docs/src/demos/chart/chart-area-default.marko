// Mirrors shadcn's chart-area-default: same Card composition, data, config
// (var(--chart-1)) and footer text. indicator="line" + cursor=false match
// the ChartTooltipContent/ChartTooltip props in the original.
import Chart from "@marko-ui/shadcn/ui/chart/chart.marko";
import AreaChart from "@marko-ui/shadcn/ui/chart/area.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";

static const chartData = [
  { month: "January", desktop: 186 },
  { month: "February", desktop: 305 },
  { month: "March", desktop: 237 },
  { month: "April", desktop: 73 },
  { month: "May", desktop: 209 },
  { month: "June", desktop: 214 },
];

static const chartConfig = {
  desktop: {
    label: "Desktop",
    color: "var(--chart-1)",
  },
};

<Card>
  <CardHeader>
    <CardTitle>Area Chart</CardTitle>
    <CardDescription>
      Showing total visitors for the last 6 months
    </CardDescription>
  </CardHeader>
  <CardContent>
    <Chart config=chartConfig>
      <AreaChart
        data=chartData
        config=chartConfig
        xKey="month"
        xTickFormatter=(value) => value.slice(0, 3)
        indicator="line"
        cursor=false
      >
        <@series dataKey="desktop" type="natural"/>
      </AreaChart>
    </Chart>
  </CardContent>
  <CardFooter>
    <div class="flex w-full items-start gap-2 text-sm">
      <div class="grid gap-2">
        <div class="flex items-center gap-2 leading-none font-medium">
          Trending up by 5.2% this month
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M16 7h6v6"/>
            <path d="m22 7-8.5 8.5-5-5L2 15"/>
          </svg>
        </div>
        <div class="flex items-center gap-2 leading-none text-muted-foreground">
          January - June 2024
        </div>
      </div>
    </div>
  </CardFooter>
</Card>
