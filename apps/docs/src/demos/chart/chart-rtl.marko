// Port of shadcn's chart-rtl.tsx. Upstream drives a live docs-site language
// switcher (English/Arabic/Hebrew) we haven't ported — see
// notes/docs-canonical-structure.md, RTL is component behavior, not site
// chrome — so this uses the same static Arabic content upstream defaults
// to (locale "ar"), wrapped in `dir="rtl"`, matching the button-rtl /
// avatar-rtl demos' established pattern for this port.
//
// PARTIAL PORT — disclosed omission: upstream's chart-rtl also mirrors the
// plot itself (CartesianGrid orientation="right", XAxis reversed) so bars
// and gridlines visually flow right-to-left with the page. Our BarChart
// (packages/shadcn/ui/chart/bar.marko) has no `orientation`/`reversed`
// props — cartesianCtx/xTicks always lay out left-to-right regardless of
// `dir`. That is a component-source gap (out of this demo's file
// territory to fix — see task's FILE TERRITORY note), reported as
// blocked-needs-component-change. This demo therefore ports the RTL
// *label/legend/tooltip* content faithfully (Arabic month names, `dir`
// wrapper, legend, tooltip) but the plot geometry stays LTR.
import Chart from "@marko-ui/shadcn/ui/chart/chart.marko";
import BarChart from "@marko-ui/shadcn/ui/chart/bar.marko";

static const chartData = [
  { month: "يناير", desktop: 186, mobile: 80 },
  { month: "فبراير", desktop: 305, mobile: 200 },
  { month: "مارس", desktop: 237, mobile: 120 },
  { month: "أبريل", desktop: 73, mobile: 190 },
  { month: "مايو", desktop: 209, mobile: 130 },
  { month: "يونيو", desktop: 214, mobile: 140 },
];

static const chartConfig = {
  desktop: { label: "سطح المكتب", color: "var(--chart-2)" },
  mobile: { label: "الجوال", color: "var(--chart-1)" },
};

<div dir="rtl">
  <Chart config=chartConfig class="min-h-[200px] w-full">
    <BarChart
      data=chartData
      config=chartConfig
      xKey="month"
      tickMargin=10
      legend="bottom"
    >
      <@series dataKey="desktop" radius=4/>
      <@series dataKey="mobile" radius=4/>
    </BarChart>
  </Chart>
</div>
