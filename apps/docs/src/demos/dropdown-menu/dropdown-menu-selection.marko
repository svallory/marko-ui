import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

static const ITEMS = [
  { value: "edit", label: "Edit" },
  { value: "duplicate", label: "Duplicate" },
  { value: "archive", label: "Archive" },
  { type: "separator" },
  { value: "delete", label: "Delete", variant: "destructive" },
];

<let/selected=""/>

<div class="flex items-center gap-4">
  <DropdownMenu items=ITEMS select(value) { selected = value; }>
    <@trigger|triggerProps|>
      <Button variant="outline" ...triggerProps>Open menu</Button>
    </@trigger>
  </DropdownMenu>
  <span class="text-sm text-muted-foreground">selected: ${selected || "none"}</span>
</div>
