import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

// Two technically-forced omissions:
// 1. `menu.props` (from @zag-js/menu) DOES include a `dir` prop that the
//    machine would use to auto-flip floating-ui placement under RTL, but
//    dropdown-menu.marko's own `Input` interface is a plain object type
//    (not `MachineInput<...>`) that never re-exposes `dir` as a declared
//    prop — passing `dir="rtl"` to <DropdownMenu> is a type error even
//    though the machine would accept it at runtime. Getting the real
//    floating-ui RTL flip (as opposed to just RTL text/logical-property
//    layout) needs a component-source change, which is out of scope here
//    (see this port's territory rules) — reported as
//    blocked-needs-component-change. We fall back to the same static
//    `dir="rtl"` wrapper precedent already used by button-rtl/avatar-rtl/
//    input-rtl (see those files), which is correct for text direction and
//    Tailwind logical-property layout but does not exercise floating-ui's
//    own RTL placement flip the way upstream's demo does.
// 2. Submenu nesting: same one-level limit as dropdown-menu-submenu.marko
//    — upstream nests "More" inside "Invite users"; we flatten "More"'s
//    items directly into "Invite users".
<let/statusBar=true/>
<let/activityBar=false/>
<let/panel=false/>
<let/position="bottom"/>

<const/items=[
  {
    type: "sub",
    label: "الحساب",
    subEntries: [
      { value: "profile", label: "الملف الشخصي" },
      { value: "billing", label: "الفوترة" },
      { value: "settings", label: "الإعدادات" },
    ],
  },
  { type: "separator" },
  { type: "label", label: "الفريق" },
  { value: "team", label: "الفريق" },
  {
    type: "sub",
    label: "دعوة المستخدمين",
    subEntries: [
      { value: "email", label: "البريد الإلكتروني" },
      { value: "message", label: "رسالة" },
      { type: "separator" },
      { value: "calendar", label: "تقويم" },
      { value: "chat", label: "دردشة" },
      { type: "separator" },
      { value: "webhook", label: "خطاف ويب" },
      { type: "separator" },
      { value: "advanced", label: "متقدم..." },
    ],
  },
  { value: "new-team", label: "فريق جديد", shortcut: "⌘+T" },
  { type: "separator" },
  { type: "label", label: "عرض" },
  { type: "checkbox", value: "status-bar", label: "شريط الحالة", checked: statusBar },
  { type: "checkbox", value: "activity-bar", label: "شريط النشاط", checked: activityBar },
  { type: "checkbox", value: "panel", label: "لوحة", checked: panel },
  { type: "separator" },
  { type: "label", label: "الموضع" },
  { type: "radio", value: "top", label: "أعلى", radioGroup: "position", checked: position === "top" },
  { type: "radio", value: "bottom", label: "أسفل", radioGroup: "position", checked: position === "bottom" },
  { type: "radio", value: "right", label: "يمين", radioGroup: "position", checked: position === "right" },
  { type: "radio", value: "left", label: "يسار", radioGroup: "position", checked: position === "left" },
  { type: "separator" },
  { value: "logout", label: "تسجيل الخروج", variant: "destructive" },
]/>

<div dir="rtl" class="flex justify-center">
  <DropdownMenu
    items=items
    select(value) {
      if (value === "status-bar") statusBar = !statusBar;
      else if (value === "activity-bar") activityBar = !activityBar;
      else if (value === "panel") panel = !panel;
      else if (value === "top" || value === "bottom" || value === "right" || value === "left") position = value;
    }
    class="w-36"
  >
    <@trigger|triggerProps|>
      <Button variant="outline" ...triggerProps>افتح القائمة</Button>
    </@trigger>
  </DropdownMenu>
</div>
