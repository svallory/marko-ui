import PasswordInput from "@marko-ui/registry/ui/password-input/password-input.marko";

<let/visible=false/>

<div class="flex flex-col gap-2">
  <span class="text-sm text-muted-foreground">visible: ${String(visible)}</span>
  <PasswordInput
    label="Password"
    placeholder="Enter your password"
    name="password"
    visible=visible
    visibleChange=(next) => { visible = next; }
    class="w-[320px]"
  />
</div>
