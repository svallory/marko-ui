// Static RTL port: upstream's spinner-rtl demo drives a live docs-site
// language switcher (useTranslation across en/ar/he) that has no
// equivalent in this app — same established precedent as
// demos/card/card-rtl.marko and demos/input-group/input-group-rtl.marko.
// This ports the RTL VISUAL and markup directly using the source's default
// locale ("ar"): a `dir="rtl"` Item with Arabic copy. Item's parts already
// restyle correctly under dir="rtl" since their layout is Tailwind
// flex/grid with no hard-coded physical margins on the RTL-sensitive
// elements.
import Item from "@marko-ui/shadcn/ui/item/item.marko";
import ItemContent from "@marko-ui/shadcn/ui/item/content.marko";
import ItemMedia from "@marko-ui/shadcn/ui/item/media.marko";
import ItemTitle from "@marko-ui/shadcn/ui/item/title.marko";
import Spinner from "@marko-ui/shadcn/ui/spinner/spinner.marko";

<div class="flex w-full max-w-xs flex-col gap-4 [--radius:1rem]" dir="rtl">
  <Item variant="muted" dir="rtl">
    <ItemMedia>
      <Spinner/>
    </ItemMedia>
    <ItemContent>
      <ItemTitle class="line-clamp-1">جاري معالجة الدفع...</ItemTitle>
    </ItemContent>
    <ItemContent class="flex-none justify-end">
      <span class="text-sm tabular-nums">١٠٠.٠٠ دولار</span>
    </ItemContent>
  </Item>
</div>
