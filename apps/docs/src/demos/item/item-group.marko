import Item from "@marko-ui/shadcn/ui/item/item.marko";
import ItemGroup from "@marko-ui/shadcn/ui/item/group.marko";
import ItemMedia from "@marko-ui/shadcn/ui/item/media.marko";
import ItemContent from "@marko-ui/shadcn/ui/item/content.marko";
import ItemTitle from "@marko-ui/shadcn/ui/item/title.marko";
import ItemDescription from "@marko-ui/shadcn/ui/item/description.marko";
import ItemActions from "@marko-ui/shadcn/ui/item/actions.marko";
import Avatar from "@marko-ui/shadcn/ui/avatar/avatar.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

static const PEOPLE = [
  { username: "shadcn", avatar: "https://github.com/shadcn.png", email: "shadcn@vercel.com" },
  { username: "maxleiter", avatar: "https://github.com/maxleiter.png", email: "maxleiter@vercel.com" },
  { username: "evilrabbit", avatar: "https://github.com/evilrabbit.png", email: "evilrabbit@vercel.com" },
];

<ItemGroup class="max-w-sm">
  <for|person| of=PEOPLE by=(person) => person.username>
    <Item variant="outline">
      <ItemMedia>
        <Avatar src=person.avatar alt=person.username fallback=person.username.charAt(0).toUpperCase() class="grayscale"/>
      </ItemMedia>
      <ItemContent class="gap-1">
        <ItemTitle>${person.username}</ItemTitle>
        <ItemDescription>${person.email}</ItemDescription>
      </ItemContent>
      <ItemActions>
        <Button variant="ghost" size="icon" class="rounded-full" aria-label=`Invite ${person.username}`>
          <Icon name="Plus"/>
        </Button>
      </ItemActions>
    </Item>
  </for>
</ItemGroup>
