import Drawer from "@marko-ui/shadcn/ui/drawer/drawer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

// Upstream: registry/bases/base/examples/drawer-example.tsx (DrawerNonModal).
// Base UI's `disablePointerDismissal` maps to our machine's
// `closeOnInteractOutside={false}` (both stop outside presses from
// dismissing the drawer). Base UI's `modal="trap-focus"` three-way mode has
// no equivalent on our zag-js/drawer machine (boolean `modal` only), so this
// demo covers the `modal={false}` case shown in the upstream preview.
<Drawer modal=false closeOnInteractOutside=false swipeDirection="end">
  <@trigger|props|>
    <Button ...props variant="outline">Non Modal</Button>
  </@trigger>
  <@title>Non Modal Drawer</@title>
  <@content>
    <div class="h-80 w-full bg-muted"/>
  </@content>
</Drawer>
