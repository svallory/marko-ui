import Dialog from "@marko-ui/shadcn/ui/dialog/dialog.marko";
import Drawer from "@marko-ui/shadcn/ui/drawer/drawer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";

// Upstream: registry/new-york-v4/examples/drawer-dialog.tsx — renders a
// Dialog on desktop and a Drawer on mobile, switching on a `useMediaQuery`
// React hook. This codebase has no shared media-query hook, so the
// desktop/mobile split is done directly with `matchMedia` in a lifecycle
// hook per the LIFECYCLE-CLEANUP pattern (a bare `return () => {}` from
// onMount is silently dropped). SSR renders the mobile (Drawer) branch;
// the client corrects to Dialog above the breakpoint immediately on mount,
// before paint, so there is no visible flash in practice.
<let/isDesktop=false>

<lifecycle
  onMount() {
    const query = window.matchMedia("(min-width: 768px)");
    const update = () => { isDesktop = query.matches; };
    update();
    query.addEventListener("change", update);
    return { cleanup: () => query.removeEventListener("change", update) };
  }
  onDestroy() { this.cleanup?.(); }
/>

<if=isDesktop>
  <Dialog>
    <@trigger|props|>
      <Button ...props variant="outline">Edit Profile</Button>
    </@trigger>
    <@title>Edit profile</@title>
    <@description>Make changes to your profile here. Click save when you're done.</@description>
    <@content>
      <form class="grid items-start gap-6">
        <div class="grid gap-3">
          <Label for="drawer-dialog-email">Email</Label>
          <Input type="email" id="drawer-dialog-email" name="email" value="shadcn@example.com"/>
        </div>
        <div class="grid gap-3">
          <Label for="drawer-dialog-username">Username</Label>
          <Input id="drawer-dialog-username" name="username" value="@shadcn"/>
        </div>
        <Button type="submit">Save changes</Button>
      </form>
    </@content>
  </Dialog>
</if>
<else>
  <Drawer>
    <@trigger|props|>
      <Button ...props variant="outline">Edit Profile</Button>
    </@trigger>
    <@title>Edit profile</@title>
    <@description>Make changes to your profile here. Click save when you're done.</@description>
    <@content>
      <form class="grid items-start gap-6">
        <div class="grid gap-3">
          <Label for="drawer-dialog-email-mobile">Email</Label>
          <Input type="email" id="drawer-dialog-email-mobile" name="email" value="shadcn@example.com"/>
        </div>
        <div class="grid gap-3">
          <Label for="drawer-dialog-username-mobile">Username</Label>
          <Input id="drawer-dialog-username-mobile" name="username" value="@shadcn"/>
        </div>
      </form>
    </@content>
    <@footer>
      <Button type="submit">Save changes</Button>
    </@footer>
  </Drawer>
</else>
