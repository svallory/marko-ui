// Mirrors shadcn's drawer-demo.tsx: "Move Goal" activity chart drawer.
// Upstream renders a bare recharts <BarChart><Bar dataKey="goal"/></BarChart>
// with no axes/grid/tooltip — our Chart/BarChart primitives support most of
// that via grid=false yAxis=false tooltip=false legend=false, but bar.marko
// always renders <ChartXAxis> unconditionally (no xAxis boolean prop exists
// to suppress it, unlike yAxis) — a real missing-capability gap, not
// something this demo file can route around structurally. Worked around
// with xTickFormatter=() => "" so no tick text paints (matches upstream's
// visual absence of an axis), though the axis <g> and its bottom margin
// still exist in the DOM. The `goal` field has no natural x-key upstream
// (implicit array index), so we synthesize one.
// DEVIATION (documented, not a missing-primitive skip): upstream wraps its
// header/body/footer in an inner `mx-auto w-full max-w-sm` div so the drawer
// content narrows below the drawer's own `sm:max-w-lg`. Our <Drawer> splits
// header/content/footer into three separate attr-tags rendered as siblings
// by the component itself (see drawer.marko) with no class-passthrough hook
// on the header/footer parts, so that inner wrapper can't be reproduced
// without changing the drawer primitive. Content stays at the drawer's
// default sm:max-w-lg instead of shadcn's narrower sm:max-w-sm for this
// demo — a real but minor width difference, not a content/interaction gap.
import Drawer from "@marko-ui/shadcn/ui/drawer/drawer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Chart from "@marko-ui/shadcn/ui/chart/chart.marko";
import BarChart from "@marko-ui/shadcn/ui/chart/bar.marko";

static const rawData = [400, 300, 200, 300, 200, 278, 189, 239, 300, 200, 278, 189, 349];
static const chartData = rawData.map((goal, index) => ({ index: String(index), goal }));

static const chartConfig = {
  goal: {
    label: "Goal",
    color: "hsl(var(--foreground))",
  },
};

<let/goal=350/>

<Drawer>
  <@trigger|props|>
    <Button ...props variant="outline">Open Drawer</Button>
  </@trigger>
  <@title>Move Goal</@title>
  <@description>Set your daily activity goal.</@description>
  <@content>
    <div class="p-4 pb-0">
      <div class="flex items-center justify-center space-x-2">
        <Button
          variant="outline"
          size="icon"
          class="h-8 w-8 shrink-0 rounded-full"
          disabled=(goal <= 200)
          onClick=() => { goal = Math.max(200, goal - 10); }
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"/></svg>
          <span class="sr-only">Decrease</span>
        </Button>
        <div class="flex-1 text-center">
          <div class="text-7xl font-bold tracking-tighter">${goal}</div>
          <div class="text-[0.70rem] text-muted-foreground uppercase">Calories/day</div>
        </div>
        <Button
          variant="outline"
          size="icon"
          class="h-8 w-8 shrink-0 rounded-full"
          disabled=(goal >= 400)
          onClick=() => { goal = Math.min(400, goal + 10); }
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <span class="sr-only">Increase</span>
        </Button>
      </div>
      <div class="mt-3 h-[120px]">
        <Chart config=chartConfig class="aspect-auto h-full w-full">
          <BarChart
            data=chartData
            config=chartConfig
            xKey="index"
            width=384
            height=120
            margin={ top: 0, right: 0, bottom: 0, left: 0 }
            grid=false
            yAxis=false
            tooltip=false
            cursor=false
            legend=false
            xTickFormatter=() => ""
          >
            <@series dataKey="goal"/>
          </BarChart>
        </Chart>
      </div>
    </div>
  </@content>
  <@footer>
    <Button>Submit</Button>
    <Button variant="outline">Cancel</Button>
  </@footer>
</Drawer>
