import Sheet from "@marko-ui/shadcn/ui/sheet/sheet.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";

// Upstream's sheet-rtl demo drives a live language switcher
// (English/Arabic/Hebrew, docs-site chrome we haven't ported — same
// precedent as dialog-rtl.marko, alert-dialog-rtl.marko and
// button-rtl.marko): static Arabic content instead of a live switcher.
// Upstream also flips `side` to "left" when RTL so the sheet opens from
// the reading-start edge; we do the same here. Our Sheet's `dir` prop is
// a plain native attribute pass-through (dialogMachine.splitProps leaves
// it alone; see packages/shadcn/ui/sheet/sheet.marko's nativeAttrs), so
// it lands on the root element exactly like upstream's `dir={dir}` on
// `SheetContent` — no machine-level RTL behavior is lost by this port.
<div dir="rtl">
  <Sheet dir="rtl" side="left">
    <@trigger|props|>
      <Button ...props variant="outline">فتح</Button>
    </@trigger>
    <@title>تعديل الملف الشخصي</@title>
    <@description>قم بإجراء تغييرات على ملفك الشخصي هنا. انقر حفظ عند الانتهاء.</@description>
    <div class="grid gap-4 px-4">
      <div class="grid gap-2">
        <Label for="sheet-rtl-name">الاسم</Label>
        <Input id="sheet-rtl-name" name="name" value="Pedro Duarte"/>
      </div>
      <div class="grid gap-2">
        <Label for="sheet-rtl-username">اسم المستخدم</Label>
        <Input id="sheet-rtl-username" name="username" value="peduarte"/>
      </div>
    </div>
    <@footer>
      <Button type="submit">حفظ التغييرات</Button>
      <Button variant="outline">إغلاق</Button>
    </@footer>
  </Sheet>
</div>
