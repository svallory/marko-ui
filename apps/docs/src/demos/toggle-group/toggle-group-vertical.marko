import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

// Technically-forced omission: upstream's icon-only items each carry their
// own `aria-label` (e.g. "Toggle bold"). ToggleGroupItemAttrs (see
// packages/shadcn/ui/toggle-group/toggle-group.marko) only forwards
// `value`/`disabled`/`content` per `<@item>` — there is no per-item
// passthrough for arbitrary attributes, so an icon-only item here would
// have no accessible name. Compound `<@item>` content adds a visually
// hidden label alongside the icon instead of an aria-label, keeping every
// item accessible without a component-source change.
<ToggleGroup multiple orientation="vertical" spacing=1 value=["bold", "italic"]>
  <@item value="bold">
    <Icon name="Bold"/>
    <span class="sr-only">Bold</span>
  </@item>
  <@item value="italic">
    <Icon name="Italic"/>
    <span class="sr-only">Italic</span>
  </@item>
  <@item value="underline">
    <Icon name="Underline"/>
    <span class="sr-only">Underline</span>
  </@item>
</ToggleGroup>
