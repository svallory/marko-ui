import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";

static const ALIGNMENT = [
  { value: "left", label: "Left" },
  { value: "center", label: "Center" },
  { value: "right", label: "Right" },
];

// `defaultValue`, not `value`: `value` is the CONTROLLED prop, so a value with
// no change handler is a group that can never be clicked. See the same fix in
// radio-group-demo.marko.
<ToggleGroup items=ALIGNMENT defaultValue=["center"]/>
