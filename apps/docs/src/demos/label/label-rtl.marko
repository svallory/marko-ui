import Checkbox from "@marko-ui/shadcn/ui/checkbox/checkbox.marko";

// Static RTL port: shadcn's label-rtl source drives a client-side language
// selector (useTranslation) defaulting to Arabic, with no equivalent in
// this docs app — see demos/checkbox/checkbox-rtl.marko for the
// established precedent (dir="rtl" on the wrapper only; Field's/plain
// layout is Tailwind logical properties, so it already restyles
// correctly). This ports the RTL VISUAL and markup directly: a dir="rtl"
// wrapper with Arabic copy, matching the source's default locale ("ar").
// Our Checkbox root IS a <label> (see label-demo.marko's own comment on
// this), so the label text is the checkbox's own `content` body rather
// than a separate <Label for=...>.
<div dir="rtl" class="flex gap-2">
  <Checkbox id="terms-rtl">قبول الشروط والأحكام</Checkbox>
</div>
