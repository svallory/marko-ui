import Collapsible from "@marko-ui/shadcn/ui/collapsible/collapsible.marko";

<let/open=false/>

<div class="w-72 space-y-3">
  <p class="text-sm text-muted-foreground">
    State: <strong>${open ? "open" : "closed"}</strong>
  </p>
  <Collapsible
    class="space-y-2"
    open=open
    openChange(next) { open = next; }
  >
    <@trigger|triggerProps|>
      <button
        ...triggerProps
        class="flex w-full items-center justify-between text-sm font-semibold"
      >
        Controlled from the parent
      </button>
    </@trigger>
    <p class="rounded-md border px-4 py-3 text-sm text-muted-foreground">
      This panel's open state is owned by the parent and toggled with the button below.
    </p>
  </Collapsible>
  <button
    type="button"
    class="rounded-md border px-3 py-1.5 text-sm hover:bg-accent"
    onClick() { open = !open; }
  >
    Toggle externally
  </button>
</div>
