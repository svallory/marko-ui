// Static RTL port: shadcn's textarea-rtl source drives a client-side
// language selector (useTranslation) with no equivalent in this docs app —
// see demos/input/input-rtl.marko for the established precedent. This
// ports the RTL VISUAL and markup directly: a dir="rtl" feedback field
// with Arabic copy, matching the source's default locale ("ar"). Field and
// Textarea already restyle correctly under dir="rtl" since their layout is
// Tailwind logical properties.
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Textarea from "@marko-ui/shadcn/ui/textarea/textarea.marko";

<Field class="w-full max-w-xs" dir="rtl">
  <FieldLabel for="textarea-rtl-feedback">التعليقات</FieldLabel>
  <Textarea id="textarea-rtl-feedback" placeholder="تعليقاتك تساعدنا على التحسين..." dir="rtl" rows=4/>
  <FieldDescription>شاركنا أفكارك حول خدمتنا.</FieldDescription>
</Field>
