import Marquee from "@marko-ui/shadcn/ui/marquee/marquee.marko";

static const LOGOS = ["Acme", "Globex", "Initech", "Umbrella", "Soylent", "Stark", "Wayne", "Wonka"];

<Marquee items=LOGOS side="top" pauseOnInteraction class="h-72 w-full max-w-xs mx-auto">
  <@content|logo|>
    <span class="px-4 py-6 text-lg font-semibold text-muted-foreground">${logo}</span>
  </@content>
</Marquee>
