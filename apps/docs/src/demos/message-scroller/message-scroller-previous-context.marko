// Faithful structural port of upstream's `message-scroller-previous-context.tsx`.
// A slider drives `scrollPreviousItemPeek` on the provider so the reader can
// see how much of the previous turn stays visible above a newly anchored row.
//
// SIMPLIFICATION FROM SOURCE: upstream streams scripted replies through
// `useChat`/`@ai-sdk/react`; this port has no AI SDK equivalent, so replies
// are appended in one shot after a short `setTimeout` instead of
// token-by-token (see message-scroller-demo.marko's header comment for the
// same simplification). The `scrollPreviousItemPeek` behavior under test is
// unaffected. `MessageAnimated`'s Framer Motion entrance is also dropped.
import MessageScrollerProvider from "@marko-ui/shadcn/ui/message-scroller/message-scroller-provider.marko";
import MessageScroller from "@marko-ui/shadcn/ui/message-scroller/message-scroller.marko";
import MessageScrollerViewport from "@marko-ui/shadcn/ui/message-scroller/viewport.marko";
import MessageScrollerContent from "@marko-ui/shadcn/ui/message-scroller/content.marko";
import MessageScrollerItem from "@marko-ui/shadcn/ui/message-scroller/item.marko";
import MessageScrollerButton from "@marko-ui/shadcn/ui/message-scroller/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";
import Message from "@marko-ui/shadcn/ui/message/message.marko";
import MessageContent from "@marko-ui/shadcn/ui/message/content.marko";
import Bubble from "@marko-ui/shadcn/ui/bubble/bubble.marko";
import BubbleContent from "@marko-ui/shadcn/ui/bubble/bubble-content.marko";
import Tooltip from "@marko-ui/shadcn/ui/tooltip/tooltip.marko";
import Slider from "@marko-ui/shadcn/ui/slider/slider.marko";

static const DEFAULT_PEEK = 64;

export interface ChatMessage {
  id: string;
  role: "user" | "assistant";
  text: string;
}

static const SCRIPT: ChatMessage[] = [
  { id: "prev-1-user", role: "user", text: "I'm building a chat for our app and the scroll behavior is driving me nuts. Every time the AI streams a reply, the whole thread jumps around." },
  { id: "prev-1-assistant", role: "assistant", text: "That's the classic streaming scroll problem. Wrap your message list in MessageScroller and turn on autoScroll — the viewport pins to the bottom as tokens arrive." },
  { id: "prev-2-user", role: "user", text: "Okay, but when someone sends a new message the view still feels jarring — like the whole conversation reloads from the top." },
  { id: "prev-2-assistant", role: "assistant", text: "MessageScrollerItem fixes that with turn anchoring. It also leaves a small peek of the previous exchange visible above the anchor, so context isn't lost." },
];

<let/messages=(SCRIPT.slice(0, 2) as ChatMessage[])/>
<let/peek=DEFAULT_PEEK/>
<let/busy=false/>
<let/providerKey=0/>
<const/nextMessage=SCRIPT[messages.length]/>

<const/send=() => {
  if (!nextMessage || busy) return;
  const outgoing = nextMessage;
  messages = [...messages, outgoing];
  if (outgoing.role === "user") {
    busy = true;
    setTimeout(() => {
      const reply = SCRIPT[messages.length];
      if (reply) messages = [...messages, reply];
      busy = false;
    }, 700);
  }
}/>

<const/reset=() => {
  messages = SCRIPT.slice(0, 2);
  peek = DEFAULT_PEEK;
  providerKey += 1;
  busy = false;
}/>

// `scrollPreviousItemPeek` is read ONCE when the provider's controller is
// created (packages/shadcn/ui/message-scroller/lib/controller.ts never
// re-reads it) — unlike upstream's React `key={demoKey}` remount idiom,
// Marko has no per-tag remount primitive, so a single-item keyed `<for>` is
// used to force the provider subtree to unmount/remount when `providerKey`
// changes, the same way `key={demoKey}` does in the source.
<for|generation| of=[providerKey] by=(value) => value>
  <MessageScrollerProvider|controller| scrollMargin=24 scrollPreviousItemPeek=peek>
    <div class="relative flex flex-col gap-4">
      <Card class="mx-auto h-140 w-full max-w-sm gap-0">
        <CardHeader class="gap-1 border-b">
          <CardTitle>Keeping Context Visible</CardTitle>
          <CardDescription>New turns keep part of the previous reply in view.</CardDescription>
          <CardAction>
            <Tooltip>
              <@trigger|props|>
                <Button ...props variant="outline" size="icon" aria-label="Reset context example" disabled=busy onClick=reset>
                  <Icon name="RotateCwIcon"/>
                </Button>
              </@trigger>
              Reset
            </Tooltip>
          </CardAction>
        </CardHeader>
        <CardContent class="flex-1 overflow-hidden p-0">
          <MessageScroller controller=controller>
            <MessageScrollerViewport controller=controller>
              <MessageScrollerContent controller=controller aria-busy=busy class="p-4">
                <for|message| of=messages by=(message) => message.id>
                  <MessageScrollerItem controller=controller messageId=message.id scrollAnchor=(message.role === "user")>
                    <Message align=(message.role === "user" ? "end" : "start")>
                      <MessageContent>
                        <Bubble variant=(message.role === "user" ? "muted" : "ghost")>
                          <BubbleContent class="space-y-2">
                            <p class="whitespace-pre-wrap">${message.text}</p>
                          </BubbleContent>
                        </Bubble>
                      </MessageContent>
                    </Message>
                  </MessageScrollerItem>
                </for>
              </MessageScrollerContent>
            </MessageScrollerViewport>
            <MessageScrollerButton controller=controller/>
          </MessageScroller>
        </CardContent>
        <CardFooter class="flex-col gap-2">
          <div class="flex w-full items-center gap-3">
            <span class="w-10 shrink-0 text-xs tabular-nums text-muted-foreground">${peek}px</span>
            <Slider
              aria-label="Previous context peek"
              value=[peek]
              min=64
              max=128
              step=1
              disabled=busy
              valueChange=(value: number[]) => { peek = value[0] ?? DEFAULT_PEEK; }
              class="flex-1"
            />
            <Button type="button" size="icon-sm" disabled=(!nextMessage || busy) onClick=send>
              <Icon name="ArrowUpIcon"/>
              <span class="sr-only">Send</span>
            </Button>
          </div>
        </CardFooter>
      </Card>
      <div class="px-0.5 text-center text-xs text-muted-foreground">
        Adjust the slider and send. Observe the previous message peek
      </div>
    </div>
  </MessageScrollerProvider>
</for>
