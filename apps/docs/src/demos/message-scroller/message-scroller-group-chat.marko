// Faithful port of upstream's `message-scroller-group-chat.tsx`. A group
// chat where a Marker (join event) is scrollAnchor'd as the turn boundary
// instead of a message — anchoring is role-independent.
//
// SIMPLIFICATION FROM SOURCE: none needed — upstream's demo is already plain
// scripted state with no AI SDK / motion dependency.
import MessageScrollerProvider from "@marko-ui/shadcn/ui/message-scroller/message-scroller-provider.marko";
import MessageScroller from "@marko-ui/shadcn/ui/message-scroller/message-scroller.marko";
import MessageScrollerViewport from "@marko-ui/shadcn/ui/message-scroller/viewport.marko";
import MessageScrollerContent from "@marko-ui/shadcn/ui/message-scroller/content.marko";
import MessageScrollerItem from "@marko-ui/shadcn/ui/message-scroller/item.marko";
import MessageScrollerButton from "@marko-ui/shadcn/ui/message-scroller/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";
import Marker from "@marko-ui/shadcn/ui/marker/marker.marko";
import MarkerContent from "@marko-ui/shadcn/ui/marker/content.marko";
import Message from "@marko-ui/shadcn/ui/message/message.marko";
import MessageContent from "@marko-ui/shadcn/ui/message/content.marko";
import MessageHeader from "@marko-ui/shadcn/ui/message/header.marko";
import Bubble from "@marko-ui/shadcn/ui/bubble/bubble.marko";
import BubbleContent from "@marko-ui/shadcn/ui/bubble/bubble-content.marko";
import Tooltip from "@marko-ui/shadcn/ui/tooltip/tooltip.marko";

static const CURRENT_USER = "Grace";

export type GroupChatItem =
  | { id: string; type: "event"; text: string; scrollAnchor?: boolean }
  | { id: string; type: "message"; sender: string; role: "assistant" | "participant"; text: string; scrollAnchor?: boolean };

static const INITIAL_ITEMS: GroupChatItem[] = [
  { id: "group-1", type: "message", sender: "Grace", role: "participant", text: "@mary, the astrophage line keeps matching Venus energy output. Can you check my math?" },
  { id: "group-2", type: "message", sender: "Mary (Agent)", role: "assistant", text: "Yes. Confirmed. The curve points to a microorganism harvesting stellar energy and breeding near carbon dioxide. If @rocky agrees, this is the clue we need." },
  { id: "group-3", type: "message", sender: "Grace", role: "participant", text: "ping @rocky", scrollAnchor: true },
];

static const ROCKY_MARKER: GroupChatItem = { id: "group-4", type: "event", text: "Rocky has joined the chat", scrollAnchor: true };
static const ROCKY_MESSAGE: GroupChatItem = { id: "group-5", type: "message", sender: "Rocky", role: "participant", text: "Amaze. Astrophage eats light, makes heat, goes to carbon dioxide. Rocky has fuel model. Grace is smart." };

<let/rockyTurn=("idle" as "idle" | "marker" | "message")/>
<const/items=(
  rockyTurn === "message" ? [...INITIAL_ITEMS, ROCKY_MARKER, ROCKY_MESSAGE]
  : rockyTurn === "marker" ? [...INITIAL_ITEMS, ROCKY_MARKER]
  : INITIAL_ITEMS
)/>
<const/buttonLabel=(rockyTurn === "idle" ? "Add Rocky" : "Send Message as Rocky")/>
<const/isComplete=(rockyTurn === "message")/>

<const/reset=() => { rockyTurn = "idle"; }/>
<const/advance=() => { rockyTurn = rockyTurn === "idle" ? "marker" : "message"; }/>

<MessageScrollerProvider>
  <@content|controller|>
    <div class="relative flex flex-col gap-4">
      <Card class="mx-auto h-140 w-full max-w-sm gap-0">
        <CardHeader class="gap-1 border-b">
          <CardTitle>Group Chat</CardTitle>
          <CardDescription>
            A group chat with several participants and an assistant. The Marker is marked as a turn.
          </CardDescription>
          <CardAction>
            <Tooltip>
              <@trigger|props|>
                <Button ...props type="button" variant="outline" size="icon" aria-label="Reset conversation" disabled=(rockyTurn === "idle") onClick=reset>
                  <Icon name="RotateCwIcon"/>
                </Button>
              </@trigger>
              <@content>Reset</@content>
            </Tooltip>
          </CardAction>
        </CardHeader>
        <CardContent class="min-h-0 flex-1 p-0">
          <MessageScroller controller=controller>
            <MessageScrollerViewport controller=controller>
              <MessageScrollerContent controller=controller class="p-4">
                <for|item| of=items by=(item) => item.id>
                  <if=(item.type === "message")>
                    <MessageScrollerItem controller=controller messageId=item.id scrollAnchor=item.scrollAnchor>
                      <Message align=(item.sender === CURRENT_USER ? "end" : "start")>
                        <MessageContent>
                          <if=(item.sender !== CURRENT_USER)>
                            <MessageHeader>${item.sender}</MessageHeader>
                          </if>
                          <Bubble variant=(item.sender === CURRENT_USER ? "muted" : item.role === "assistant" ? "ghost" : "tinted")>
                            <BubbleContent>${item.text}</BubbleContent>
                          </Bubble>
                        </MessageContent>
                      </Message>
                    </MessageScrollerItem>
                  </if>
                  <else>
                    <MessageScrollerItem controller=controller scrollAnchor=(item.scrollAnchor ?? false)>
                      <Marker variant="separator">
                        <MarkerContent>${item.text}</MarkerContent>
                      </Marker>
                    </MessageScrollerItem>
                  </else>
                </for>
              </MessageScrollerContent>
            </MessageScrollerViewport>
            <MessageScrollerButton controller=controller/>
          </MessageScroller>
        </CardContent>
        <CardFooter class="flex flex-col items-center gap-2 border-t">
          <Button type="button" disabled=isComplete onClick=advance class="w-full" variant="secondary">
            ${buttonLabel}
          </Button>
          <p class="text-xs text-muted-foreground">
            <if=(rockyTurn === "idle")>This will create a marker and make it the anchor</if>
            <else>Now send Rocky's reply into the conversation</else>
          </p>
        </CardFooter>
      </Card>
      <div class="mx-auto max-w-sm px-0.5 text-center text-xs text-balance text-muted-foreground">
        When a user joins, a marker is created. scrollAnchor on the marker marks it as the next turn
      </div>
    </div>
  </@content>
</MessageScrollerProvider>
