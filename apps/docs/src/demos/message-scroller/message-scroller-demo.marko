// Faithful structural port of upstream's `message-scroller-demo.tsx` (base
// style). Behavior preserved: send a scripted user turn, the assistant reply
// arrives after a short delay, `scrollAnchor` settles the user turn near the
// top, and `MessageScrollerButton` offers a jump back to the live edge.
//
// SIMPLIFICATION FROM SOURCE: upstream drives message playback through
// `useChat` (`@ai-sdk/react`) plus a `createChat().transport()` fixture that
// streams tokens; this port has no AI SDK / streaming-transport equivalent,
// so the scripted assistant replies are appended in ONE shot after a
// `setTimeout` delay instead of token-by-token. The scroll/anchor/auto-follow
// BEHAVIOR under test — MessageScroller itself — is unaffected; only the
// upstream demo's own fake-network simulation is simplified. Framer Motion
// entrance animation (`MessageAnimated`) is also dropped — see
// message-scroller-animation.marko for the one demo that ports an
// entrance-animation approximation.
import MessageScrollerProvider from "@marko-ui/shadcn/ui/message-scroller/message-scroller-provider.marko";
import MessageScroller from "@marko-ui/shadcn/ui/message-scroller/message-scroller.marko";
import MessageScrollerViewport from "@marko-ui/shadcn/ui/message-scroller/viewport.marko";
import MessageScrollerContent from "@marko-ui/shadcn/ui/message-scroller/content.marko";
import MessageScrollerItem from "@marko-ui/shadcn/ui/message-scroller/item.marko";
import MessageScrollerButton from "@marko-ui/shadcn/ui/message-scroller/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";
import Empty from "@marko-ui/shadcn/ui/empty/empty.marko";
import EmptyHeader from "@marko-ui/shadcn/ui/empty/header.marko";
import EmptyMedia from "@marko-ui/shadcn/ui/empty/media.marko";
import EmptyTitle from "@marko-ui/shadcn/ui/empty/title.marko";
import EmptyDescription from "@marko-ui/shadcn/ui/empty/description.marko";
import Message from "@marko-ui/shadcn/ui/message/message.marko";
import MessageContent from "@marko-ui/shadcn/ui/message/content.marko";
import Bubble from "@marko-ui/shadcn/ui/bubble/bubble.marko";
import BubbleContent from "@marko-ui/shadcn/ui/bubble/bubble-content.marko";
import Tooltip from "@marko-ui/shadcn/ui/tooltip/tooltip.marko";

export interface ChatMessage {
  id: string;
  role: "user" | "assistant";
  text: string;
}

static const SCRIPT: ChatMessage[] = [
  {
    id: "demo-1-user",
    role: "user",
    text: "I'm building a chat for our app and the scroll behavior is driving me nuts. Every time the AI streams a reply, the whole thread jumps around.",
  },
  {
    id: "demo-1-assistant",
    role: "assistant",
    text: "That's the classic streaming scroll problem. Wrap your message list in MessageScroller and turn on autoScroll — the viewport pins to the bottom as tokens arrive, so users always see the latest text land in place.\n\nIt only auto-scrolls while the reader is already at the bottom. The moment they scroll up, auto-scroll backs off and their position is preserved.",
  },
  {
    id: "demo-2-user",
    role: "user",
    text: "Okay, but when someone sends a new message the view still feels jarring — like the whole conversation reloads from the top.",
  },
  {
    id: "demo-2-assistant",
    role: "assistant",
    text: "MessageScrollerItem fixes that with turn anchoring. Set scrollAnchor on the turn that should settle near the top instead of blindly snapping to the document bottom.\n\nIt also leaves a small peek of the previous exchange visible above the anchor, so context isn't lost.",
  },
  {
    id: "demo-3-user",
    role: "user",
    text: "And if they've scrolled up to re-read an older answer? I don't want to yank them back down.",
  },
  {
    id: "demo-3-assistant",
    role: "assistant",
    text: "You won't. Auto-scroll only runs when the viewport is already pinned to the bottom, so scrolling up is a deliberate opt-out. When there is content they haven't seen, MessageScrollerButton appears — one tap jumps them back and re-engages auto-scroll.",
  },
];

<let/messages=([] as ChatMessage[])/>
<let/busy=false/>
<const/nextMessage=SCRIPT[messages.length]/>

<const/send=() => {
  if (!nextMessage || busy) return;
  const outgoing = nextMessage;
  messages = [...messages, outgoing];
  if (outgoing.role === "user") {
    busy = true;
    setTimeout(() => {
      const reply = SCRIPT[messages.length];
      if (reply) messages = [...messages, reply];
      busy = false;
    }, 700);
  }
}/>

<const/reset=() => {
  messages = [];
  busy = false;
}/>

<MessageScrollerProvider autoScroll>
  <@content|controller|>
    <div class="relative flex flex-col gap-4">
      <Card class="mx-auto h-140 w-full max-w-sm gap-0">
        <CardHeader class="gap-1 border-b">
          <CardTitle>New Chat</CardTitle>
          <CardDescription>How can I help you today?</CardDescription>
          <CardAction>
            <Tooltip>
              <@trigger|props|>
                <Button ...props variant="outline" size="icon" aria-label="Reset conversation" disabled=busy onClick=reset>
                  <Icon name="RotateCwIcon"/>
                </Button>
              </@trigger>
              <@content>Reset</@content>
            </Tooltip>
          </CardAction>
        </CardHeader>
        <CardContent class="flex-1 overflow-hidden p-0">
          <if=(messages.length === 0)>
            <Empty class="h-full">
              <EmptyHeader>
                <EmptyMedia variant="icon">
                  <Icon name="MessageCircleIcon"/>
                </EmptyMedia>
                <EmptyTitle>Morning, shadcn!</EmptyTitle>
                <EmptyDescription>
                  What are we working on today? Press send to start a new conversation
                </EmptyDescription>
              </EmptyHeader>
            </Empty>
          </if>
          <else>
            <MessageScroller controller=controller>
              <MessageScrollerViewport controller=controller>
                <MessageScrollerContent controller=controller aria-busy=busy class="p-4">
                  <for|message| of=messages by=(message) => message.id>
                    <MessageScrollerItem controller=controller messageId=message.id scrollAnchor=(message.role === "user")>
                      <Message align=(message.role === "user" ? "end" : "start")>
                        <MessageContent>
                          <Bubble variant=(message.role === "user" ? "muted" : "ghost")>
                            <BubbleContent class="space-y-2">
                              <for|paragraph| of=message.text.split(/\n\s*\n/)>
                                <p class="whitespace-pre-wrap">${paragraph}</p>
                              </for>
                            </BubbleContent>
                          </Bubble>
                        </MessageContent>
                      </Message>
                    </MessageScrollerItem>
                  </for>
                </MessageScrollerContent>
              </MessageScrollerViewport>
              <MessageScrollerButton controller=controller/>
            </MessageScroller>
          </else>
        </CardContent>
        <CardFooter class="flex-col gap-2">
          <div class="flex h-14 w-full items-center rounded-md border border-input px-3 py-2.5 text-sm">
            <if=nextMessage>
              <span class=("line-clamp-2 " + (busy ? "opacity-60" : ""))>${nextMessage.text}</span>
            </if>
            <else>
              <span class="text-muted-foreground">No messages queued. Reset the conversation.</span>
            </else>
            <Button
              type="button"
              size="icon-sm"
              class="ml-auto shrink-0"
              disabled=(!nextMessage || busy)
              onClick=send
            >
              <Icon name="ArrowUpIcon"/>
              <span class="sr-only">Send</span>
            </Button>
          </div>
        </CardFooter>
      </Card>
      <div class="px-0.5 text-center text-xs text-muted-foreground">
        Demo is read only. Press send to send messages.
      </div>
    </div>
  </@content>
</MessageScrollerProvider>
