// Faithful port of upstream's `message-scroller-scrollable.tsx`. A footer
// reports which edges are still scrollable — upstream's
// `useMessageScrollerScrollable` equivalent here is subscribing to the
// provider controller's own `stateStore` (same store button.marko already
// subscribes to for its active/inert state).
//
// SIMPLIFICATION FROM SOURCE: none needed for behavior — upstream's demo
// already used plain scripted message data, no AI SDK / motion dependency.
import MessageScrollerProvider from "@marko-ui/shadcn/ui/message-scroller/message-scroller-provider.marko";
import MessageScroller from "@marko-ui/shadcn/ui/message-scroller/message-scroller.marko";
import MessageScrollerViewport from "@marko-ui/shadcn/ui/message-scroller/viewport.marko";
import MessageScrollerContent from "@marko-ui/shadcn/ui/message-scroller/content.marko";
import MessageScrollerItem from "@marko-ui/shadcn/ui/message-scroller/item.marko";
import MessageScrollerButton from "@marko-ui/shadcn/ui/message-scroller/button.marko";
import type { MessageScrollerControllerGetter } from "@marko-ui/shadcn/ui/message-scroller/lib/controller.ts";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Message from "@marko-ui/shadcn/ui/message/message.marko";
import MessageContent from "@marko-ui/shadcn/ui/message/content.marko";
import Bubble from "@marko-ui/shadcn/ui/bubble/bubble.marko";
import BubbleContent from "@marko-ui/shadcn/ui/bubble/bubble-content.marko";

export interface ChatMessage {
  id: string;
  role: "user" | "assistant";
  text: string;
}

static const MESSAGES: ChatMessage[] = Array.from({ length: 12 }, (_, index) => ({
  id: `scrollable-${index + 1}`,
  role: index % 2 === 0 ? "user" : "assistant",
  text:
    index % 2 === 0
      ? `Review scroll checkpoint ${index + 1}.`
      : `Checkpoint ${index + 1} is synced. The scrollable hook updates as the viewport moves.\n\nWhen the reader is at the first message, the footer should only point them down. Once they move into the middle of the transcript, it should explain that both directions are available.\n\nAt the latest message, the footer should switch again and only point them back up.`,
}));

<let/scrollableStart=false/>
<let/scrollableEnd=false/>

<const/subscribeScrollable=(controller: MessageScrollerControllerGetter) => {
  const store = controller().stateStore;
  const sync = () => {
    const snapshot = store.getSnapshot();
    scrollableStart = snapshot.start;
    scrollableEnd = snapshot.end;
  };
  sync();
  return { unsubscribe: store.subscribe(sync) };
}/>

<const/status=(
  scrollableStart && scrollableEnd ? "You can scroll both ways."
  : scrollableEnd ? "You are at the top. You can only scroll down."
  : scrollableStart ? "You are at the bottom. You can only scroll up."
  : "All messages fit in the viewport."
)/>

<div class="mx-auto flex w-full max-w-sm flex-col gap-4">
  <Card class="h-140 w-full gap-0 overflow-hidden">
    <CardHeader class="gap-1 border-b">
      <CardTitle>Scroll Status</CardTitle>
      <CardDescription>Where the reader can go scroll to based on current scroll position.</CardDescription>
    </CardHeader>
    <MessageScrollerProvider defaultScrollPosition="start">
      <@content|controller|>
        <lifecycle onMount() { return subscribeScrollable(controller); } onDestroy() { this.unsubscribe?.(); }/>
        <CardContent class="flex-1 overflow-hidden p-0">
          <MessageScroller controller=controller>
            <MessageScrollerViewport controller=controller>
              <MessageScrollerContent controller=controller class="gap-4 p-4">
                <for|message| of=MESSAGES by=(message) => message.id>
                  <MessageScrollerItem controller=controller messageId=message.id scrollAnchor=(message.role === "user")>
                    <Message align=(message.role === "user" ? "end" : "start")>
                      <MessageContent>
                        <Bubble variant=(message.role === "user" ? "muted" : "ghost")>
                          <BubbleContent class="space-y-2">
                            <for|paragraph| of=message.text.split(/\n\s*\n/)>
                              <p class="whitespace-pre-wrap">${paragraph}</p>
                            </for>
                          </BubbleContent>
                        </Bubble>
                      </MessageContent>
                    </Message>
                  </MessageScrollerItem>
                </for>
              </MessageScrollerContent>
            </MessageScrollerViewport>
            <MessageScrollerButton controller=controller/>
          </MessageScroller>
        </CardContent>
        <CardFooter class="justify-center border-t text-center text-sm text-muted-foreground">
          ${status}
        </CardFooter>
      </@content>
    </MessageScrollerProvider>
  </Card>
  <div class="px-0.5 text-center text-xs text-muted-foreground">
    Scroll the transcript to see the footer update.
  </div>
</div>
