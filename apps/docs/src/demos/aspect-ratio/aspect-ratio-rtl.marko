// Static RTL port: upstream's aspect-ratio-rtl demo drives a live docs-site
// language switcher (useTranslation across en/ar/he) that has no
// equivalent in this app — same established precedent as
// demos/progress/progress-rtl.marko and demos/card/card-rtl.marko. This
// ports the RTL VISUAL and markup directly using the source's default
// locale ("ar"): a `dir="rtl"` figure with an Arabic caption below a
// 16/9 image. AspectRatio itself has no physical (left/right) styling to
// flip — its only rule is `aspect-ratio` on a relatively positioned div —
// so no extra RTL-specific class is needed on the component; only the
// figcaption's centered text and the figure's dir attribute matter here.
import AspectRatio from "@marko-ui/shadcn/ui/aspect-ratio/aspect-ratio.marko";

<figure class="w-full max-w-sm" dir="rtl">
  <AspectRatio ratio=(16 / 9) class="rounded-lg bg-muted">
    <img
      src="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80"
      alt="Photo by Drew Beamer"
      class="h-full w-full rounded-lg object-cover"
    />
  </AspectRatio>
  <figcaption class="mt-2 text-center text-sm text-muted-foreground">
    منظر طبيعي جميل
  </figcaption>
</figure>
