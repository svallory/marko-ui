import Skeleton from "@marko-ui/shadcn/ui/skeleton/skeleton.marko";

// Upstream's skeleton-rtl demo drives a live language switcher (docs-site
// chrome we haven't ported — see notes/docs-canonical-structure.md, RTL is
// component behavior, not site machinery). The faithful equivalent is a
// static dir="rtl" wrapper, matching the precedent set by
// demos/avatar/avatar-rtl.marko and demos/tooltip/tooltip-rtl.marko.
<div dir="rtl" class="flex items-center gap-4">
  <Skeleton class="h-12 w-12 rounded-full"/>
  <div class="space-y-2">
    <Skeleton class="h-4 w-[250px]"/>
    <Skeleton class="h-4 w-[200px]"/>
  </div>
</div>
