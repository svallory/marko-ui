import SidebarProvider from "@marko-ui/shadcn/ui/sidebar/provider.marko";
import Sidebar from "@marko-ui/shadcn/ui/sidebar/sidebar.marko";
import SidebarHeader from "@marko-ui/shadcn/ui/sidebar/header.marko";
import SidebarContent from "@marko-ui/shadcn/ui/sidebar/content.marko";
import SidebarFooter from "@marko-ui/shadcn/ui/sidebar/footer.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/shadcn/ui/sidebar/group-label.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";
import SidebarTrigger from "@marko-ui/shadcn/ui/sidebar/trigger.marko";

// Upstream links out to a standalone `/view/base-nova/sidebar-rtl` page
// rather than an inline demo (see base/sidebar.mdx's "RTL" section — a
// `<Button asChild>` linking out, no `<ComponentPreview>` marker), so there
// is no upstream demo source to port line-for-line. This demo instead
// mirrors sidebar-demo.marko under `dir="rtl"`, matching the same static-RTL
// pattern used by pagination-rtl.marko/field-rtl.marko: `Sidebar`,
// `SidebarTrigger`, and `SidebarRail` carry logical positioning and
// `rtl:`/`mu-rtl-flip` classes (see packages/shadcn/ui/sidebar/trigger.marko,
// rail.marko), so layout mirrors with no extra props beyond `dir="rtl"` on
// the wrapping element.
static const NAV_ITEMS = [
  { title: "دخل", href: "#", active: true },
  { title: "التقويم", href: "#" },
  { title: "بحث", href: "#" },
  { title: "الإعدادات", href: "#" },
];

<div dir="rtl" class="h-[420px] w-full overflow-hidden rounded-lg border">
  <SidebarProvider width="14rem" class="min-h-0 h-full">
    <@sidebar|{ open, toggle }|>
      <Sidebar open=open>
        <@content>
          <SidebarHeader>
            <div class="flex items-center gap-2 px-2 text-sm font-semibold">شركة أكمي</div>
          </SidebarHeader>
          <SidebarContent>
            <SidebarGroup>
              <SidebarGroupLabel>المنصة</SidebarGroupLabel>
              <SidebarMenu>
                <for|item| of=NAV_ITEMS>
                  <SidebarMenuItem>
                    <SidebarMenuButton href=item.href active=item.active>
                      ${item.title}
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                </for>
              </SidebarMenu>
            </SidebarGroup>
          </SidebarContent>
          <SidebarFooter>
            <div class="px-2 text-xs text-sidebar-foreground/70">v1.0.0</div>
          </SidebarFooter>
        </@content>
      </Sidebar>
    </@sidebar>
    <@content|{ open, toggle }|>
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex h-12 items-center gap-2 border-b px-3">
          <SidebarTrigger open=open toggle=toggle/>
          <span class="text-sm text-muted-foreground">
            الشريط الجانبي ${open ? "مفتوح" : "مغلق"}
          </span>
        </header>
        <main class="flex-1 overflow-auto p-4 text-sm text-muted-foreground">
          منطقة المحتوى الرئيسية. انقر على الزر لطي الشريط الجانبي.
        </main>
      </div>
    </@content>
  </SidebarProvider>
</div>
