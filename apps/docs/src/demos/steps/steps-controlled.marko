import Steps from "@marko-ui/shadcn/ui/steps/steps.marko";

static const SHIPPING_STEPS = [
  { title: "Cart" },
  { title: "Shipping" },
  { title: "Payment" },
  { title: "Confirm" },
];

<let/step=0/>

<p class="mb-4 text-sm text-muted-foreground">Current step: ${step + 1}</p>
<Steps|index|
  items=SHIPPING_STEPS
  step=step
  stepChange(next) { step = next; }
  class="w-[560px]"
>
  <p class="text-muted-foreground text-sm">
    ${SHIPPING_STEPS[index].title} step content.
  </p>
  <@completedContent>
    <p class="text-muted-foreground text-sm">Order complete.</p>
  </@completedContent>
</Steps>
