// Deviation from upstream: upstream imports a `Locale` object from
// `react-day-picker/locale` (arSA) for month/weekday name translation. Our
// Calendar sits directly on the Zag date-picker machine, whose `locale`
// prop is a plain BCP-47 tag string (Intl-backed) rather than a
// react-day-picker Locale object, so `locale="ar-SA"` is the equivalent
// here.
import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";

<div dir="rtl">
  <Calendar
    captionLayout="dropdown"
    dir="rtl"
    locale="ar-SA"
    class="rounded-lg border [--cell-size:--spacing(9)]"
  />
</div>
