// Deviation from upstream: upstream swaps `react-day-picker` for
// `react-day-picker/persian` and loads the Vazirmatn Google Font via
// `next/font/google` for Arabic-script glyphs. Our Calendar sits directly
// on @zag-js/date-picker, which supports non-Gregorian calendars through
// `@internationalized/date`'s own `createCalendar` (the same helper
// upstream's MDX documents at
// /docs/components/base/calendar#persian--hijri--jalali-calendar) paired
// with a Persian locale tag — no react-day-picker calendar swap needed.
// The Vazirmatn font is a cosmetic Next.js font loader (no Marko/Vite
// equivalent wired here) and is intentionally omitted; the browser's
// default Arabic-script fallback renders the digits/month names instead.
//
// `value`/`min`/`max` are intentionally left unset: our Calendar's public
// `value` is a plain `{ year, month, day }` object that
// packages/shadcn/ui/calendar/calendar.marko's `toDateValue()` always
// wraps in a Gregorian `CalendarDate` (it has no calendar-system
// parameter), regardless of the `locale`/`createCalendar` passed here. A
// hardcoded `{ year: 1404, ... }` would therefore be silently
// reinterpreted as a Gregorian date deep inside `@internationalized/date`,
// producing a wrong/invalid selection instead of the intended Persian
// date — a real limitation of the component's value mapping, not
// something this demo can work around. Supporting a controlled initial
// selection for non-Gregorian locales would need calendar-system-aware
// value conversion in calendar.marko itself, which is out of scope here.
import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";
import { createCalendar } from "@internationalized/date";

<Calendar
  locale="fa-IR"
  createCalendar=createCalendar
  class="rounded-lg border"
/>
