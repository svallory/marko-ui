// Technically-forced partial port: upstream injects a `$120`/`$100` price
// label into each day button via a custom `DayButton` render prop
// (`components={{ DayButton: ... }}`). Our Calendar has no per-day
// content-render slot — the day button's markup (`${day.label}`) is fixed
// in packages/shadcn/ui/calendar/calendar.marko. Editing that file is out
// of scope here, so this port keeps the demonstrated `--cell-size`
// resizing and dropdown caption but omits the weekend/weekday price
// labels.
import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";

// Pinned to a fixed date (not wall-clock `new Date()`): this demo's
// selected range is derived from "today" at render time, so a wall-clock
// `today` makes the rendered range drift daily — a demo is only correct
// if it renders byte-identical on any machine, any day, any TZ.
static const rangeStart = new Date(2026, 5, 8);

static function toPlain(date: Date) {
  return { year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate() };
}

static function addDays(base: Date, days: number) {
  const result = new Date(base);
  result.setDate(result.getDate() + days);
  return result;
}

<let/value=[toPlain(rangeStart), toPlain(addDays(rangeStart, 10))]/>

<Card class="mx-auto w-fit p-0">
  <CardContent class="p-0">
    <Calendar
      selectionMode="range"
      value=value
      valueChange=(next) => { value = next; }
      captionLayout="dropdown"
      class="[--cell-size:--spacing(10)] md:[--cell-size:--spacing(12)]"
    />
  </CardContent>
</Card>
