import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";

// Pinned focus month (not wall-clock "today"): without `defaultFocusedValue`
// the Zag machine falls back to the browser's wall-clock today, which makes
// the rendered day grid drift daily — the exact drift the style-matrix DOM
// snapshots caught.
static const focusedValue = { year: 2026, month: 8, day: 15 };

<Calendar defaultFocusedValue=focusedValue/>
