import Dialog from "@marko-ui/registry/ui/dialog/dialog.marko";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Input from "@marko-ui/registry/ui/input/input.marko";
import Label from "@marko-ui/registry/ui/label/label.marko";

<Dialog>
  <@trigger|props|>
    <Button ...props variant="outline">Share</Button>
  </@trigger>
  <@title>Share link</@title>
  <@description>Anyone who has this link will be able to view this.</@description>
  <@content>
    <div class="flex items-center gap-2">
      <div class="grid flex-1 gap-2">
        <Label for="link" class="sr-only">Link</Label>
        <Input id="link" value="https://marko-ui.dev/docs/installation" readonly/>
      </div>
    </div>
  </@content>
  <@footer>
    <Button type="button">Close</Button>
  </@footer>
</Dialog>
