import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import Switch from "@marko-ui/shadcn/ui/switch/switch.marko";

// Deviation from upstream: upstream wraps each row in
// <FieldLabel htmlFor=...><Field orientation="horizontal">...<Switch/></Field></FieldLabel>,
// with the "card" look (border, padding, checked-state tint) coming from
// FieldLabel's own classes: `has-data-checked:border-primary/30
// has-data-checked:bg-primary/5 has-[>[data-slot=field]]:rounded-lg
// has-[>[data-slot=field]]:border *:data-[slot=field]:p-2.5` (see
// data/shadcn-ui/apps/v4/styles/base-nova/ui/field.tsx). Two structural
// facts block a literal port: (1) our <Switch> already renders its own
// root <label> — nesting it inside a second <FieldLabel> (also a <label>)
// is invalid HTML, the same reason demos/field/field-checkbox.marko and
// demos/field/field-radio.marko compose through the control's own
// `content` slot instead of an external FieldLabel; (2) our
// packages/shadcn/ui/field/field-label.marko has NOT been ported with
// those card-visual classes (it only carries
// `flex w-fit` + the field-wrapping layout classes) even though every
// style layer already ships the underlying `[data-slot=field-label]`
// selectors for them (e.g. style-maia.css: "has-data-checked:bg-primary/5
// has-data-checked:border-primary/30 ... has-[>[data-slot=field]]:border
// *:data-[slot=field]:p-4") — a component-source gap, out of this demo's
// file territory (apps/docs/src/demos/switch/ only) to fix.
//
// CORRECTION (post-review): applying the card classes to Switch's own
// `class` input does NOT land on the label root as the note above assumed.
// packages/shadcn/ui/switch/switch.marko's root <label> has a HARDCODED
// class ("inline-flex items-center gap-2", no input.class interpolation);
// `input.class` is merged only onto the INNER control <span data-slot=
// "switch"> (the small fixed-size mu-switch pill, h/w pinned by
// data-[size=...] in every style layer's CSS) via `cn(..., input.class)`.
// Passing the card classes as Switch's `class` therefore stretches that
// tiny pill itself into a "card", while the `content` slot renders in a
// SEPARATE sibling <span data-slot="switch-text"> — not nested inside the
// styled element at all. That produces a broken, malformed visual, not an
// equivalent card.
//
// Fix: style a plain wrapping <div> (not a <label>, so no nested-label
// HTML-validity problem) as the card, and lay the title/description block
// and the Switch out as ordinary SIBLINGS inside it — exactly the same
// relationship switch-description.marko already uses, just inside a
// bordered/tinted wrapper instead of Field. Switch's own `class` is left
// untouched (its default small pill renders normally; passing card
// classes there would style the wrong element — see CORRECTION above).
// The checked-state tint is driven off the Switch's own root data-state
// via a `has-[]` selector targeting its `data-slot="switch-label"` root —
// that attribute IS real (Zag's dataAttrs, including data-state, spread
// onto both getRootProps() and getControlProps(); see @zag-js/switch's
// switch.connect.mjs). Accessible name comes from `id`/`for`, same as
// switch-description.marko, not from Switch's own `content` slot.
<div class="w-full max-w-sm">
  <FieldGroup>
    <div class="has-[[data-slot=switch-label][data-state=checked]]:border-primary/30 has-[[data-slot=switch-label][data-state=checked]]:bg-primary/5 dark:has-[[data-slot=switch-label][data-state=checked]]:border-primary/20 dark:has-[[data-slot=switch-label][data-state=checked]]:bg-primary/10 flex w-full items-center justify-between gap-2 rounded-lg border p-2.5">
      <label for="switch-share" class="flex flex-1 cursor-pointer flex-col gap-0.5 text-left leading-snug">
        <span class="text-sm leading-none font-medium">Share across devices</span>
        <span class="text-muted-foreground text-sm font-normal">
          Focus is shared across devices, and turns off when you leave the app.
        </span>
      </label>
      <Switch id="switch-share"/>
    </div>
    <div class="has-[[data-slot=switch-label][data-state=checked]]:border-primary/30 has-[[data-slot=switch-label][data-state=checked]]:bg-primary/5 dark:has-[[data-slot=switch-label][data-state=checked]]:border-primary/20 dark:has-[[data-slot=switch-label][data-state=checked]]:bg-primary/10 flex w-full items-center justify-between gap-2 rounded-lg border p-2.5">
      <label for="switch-notifications" class="flex flex-1 cursor-pointer flex-col gap-0.5 text-left leading-snug">
        <span class="text-sm leading-none font-medium">Enable notifications</span>
        <span class="text-muted-foreground text-sm font-normal">
          Receive notifications when focus mode is enabled or disabled.
        </span>
      </label>
      <Switch id="switch-notifications" defaultChecked/>
    </div>
  </FieldGroup>
</div>
