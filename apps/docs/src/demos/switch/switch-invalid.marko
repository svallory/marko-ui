import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldContent from "@marko-ui/shadcn/ui/field/field-content.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Switch from "@marko-ui/shadcn/ui/switch/switch.marko";

// Deviation from upstream: same FieldLabel/nested-<label> constraint as
// switch-description.marko — FieldLabel/FieldDescription are used as
// standalone text next to the switch rather than an external wrapper
// around it. `invalid` is a real @zag-js/switch machine prop (not purely
// presentational sugar): it sets `aria-invalid` and `data-invalid` on the
// hidden input/control, which the style layers restyle against directly
// (`aria-invalid:ring-destructive/20 ... aria-invalid:border-destructive`
// in mu-switch). Field's own `data-invalid` drives the label/description
// dimming via `group-data-*` selectors.
// `ids={{ hiddenInput: "..." }}`: our Switch is Zag-backed, so its native
// `id` input becomes a machine scope -- the rendered hidden <input> gets
// a derived id, not the literal string passed in. This pins the literal
// DOM id so `FieldLabel for=` actually resolves (axe: label).
<div class="w-full max-w-sm">
  <Field orientation="horizontal" invalid>
    <FieldContent>
      <FieldLabel for="switch-terms">Accept terms and conditions</FieldLabel>
      <FieldDescription>You must accept the terms and conditions to continue.</FieldDescription>
    </FieldContent>
    <Switch id="switch-terms" ids={ hiddenInput: "switch-terms" } invalid/>
  </Field>
</div>
