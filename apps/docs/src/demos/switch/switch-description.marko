import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldContent from "@marko-ui/shadcn/ui/field/field-content.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Switch from "@marko-ui/shadcn/ui/switch/switch.marko";

// Deviation from upstream: upstream pairs a bare <Switch id> with an
// external <FieldLabel htmlFor>. Our <Switch> already renders its own root
// <label> around the hidden input (see packages/shadcn/ui/switch/switch.marko),
// so a second wrapping <FieldLabel> (also a <label>) would produce nested
// labels — the same established deviation as demos/field/field-checkbox.marko
// and demos/field/field-radio.marko. We use FieldLabel/FieldDescription as
// standalone text next to the switch, inside a <Field orientation="horizontal">
// for layout only, and rely on `id`/`for` to pair them for the accessible name.
<div class="w-full max-w-sm">
  <Field orientation="horizontal">
    <FieldContent>
      <FieldLabel for="switch-focus-mode">Share across devices</FieldLabel>
      <FieldDescription>
        Focus is shared across devices, and turns off when you leave the app.
      </FieldDescription>
    </FieldContent>
    <Switch id="switch-focus-mode"/>
  </Field>
</div>
