import ButtonGroup from "@marko-ui/shadcn/ui/button-group/button-group.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

// Two technically-forced omissions (same pair as dropdown-menu-rtl.marko,
// which this demo's dropdown reuses):
// 1. dropdown-menu.marko's `Input` never re-exposes the menu machine's
//    `dir` prop, so it can't drive floating-ui's own RTL placement flip —
//    only the static `dir="rtl"` wrapper (correct for text/logical-property
//    layout) is available. See dropdown-menu-rtl.marko for the full note.
// 2. Upstream's demo also drives a live language switcher (English/Arabic/
//    Hebrew) via docs-site chrome we haven't ported — same precedent as
//    button-rtl.marko: static Arabic content instead of a live switcher.
<let/label="personal"/>

<const/items=[
  { value: "read", label: "وضع علامة كمقروء" },
  { value: "archive", label: "أرشفة" },
  { type: "separator" },
  { value: "snooze", label: "تأجيل" },
  { value: "calendar", label: "إضافة إلى التقويم" },
  { value: "list", label: "إضافة إلى القائمة" },
  {
    type: "sub",
    label: "تصنيف كـ...",
    subEntries: [
      { value: "personal", label: "شخصي", radioGroup: "label", checked: label === "personal" },
      { value: "work", label: "عمل", radioGroup: "label", checked: label === "work" },
      { value: "other", label: "آخر", radioGroup: "label", checked: label === "other" },
    ],
  },
  { type: "separator" },
  { value: "trash", label: "سلة المهملات", variant: "destructive" },
]/>

<div dir="rtl" class="flex justify-center">
  <ButtonGroup>
    <ButtonGroup class="hidden sm:flex">
      <Button variant="outline" size="icon" aria-label="Go Back">
        <Icon name="ArrowLeftIcon" class="rtl:rotate-180"/>
      </Button>
    </ButtonGroup>
    <ButtonGroup>
      <Button variant="outline">أرشفة</Button>
      <Button variant="outline">تقرير</Button>
    </ButtonGroup>
    <ButtonGroup>
      <Button variant="outline">تأجيل</Button>
      <DropdownMenu
        items=items
        class="w-40"
        select(value) {
          if (value === "personal" || value === "work" || value === "other") label = value;
        }
      >
        <@trigger|triggerProps|>
          <Button variant="outline" size="icon" ...triggerProps aria-label="More Options">
            <Icon name="MoreHorizontalIcon"/>
          </Button>
        </@trigger>
      </DropdownMenu>
    </ButtonGroup>
  </ButtonGroup>
</div>
