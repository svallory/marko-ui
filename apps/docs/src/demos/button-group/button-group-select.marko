import ButtonGroup from "@marko-ui/shadcn/ui/button-group/button-group.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

static const CURRENCIES = [
  { value: "$", label: "US Dollar" },
  { value: "€", label: "Euro" },
  { value: "£", label: "British Pound" },
];

<let/currency=["$"]/>

// Technically-forced deviation: upstream's SelectTrigger accepts arbitrary
// children (it renders the bare currency symbol via a `font-mono` class,
// not the selected item's label). Our Select trigger always shows
// `valueAsString || placeholder` (the item's `label`) with no custom
// content slot — see select.marko's `<span data-slot="select-value">`.
// Faithful port of the composition (currency select + amount input +
// send button inside a ButtonGroup); the trigger renders "US Dollar"
// etc. instead of the bare "$" symbol.
<ButtonGroup>
  <ButtonGroup>
    <Select
      items=CURRENCIES
      value=currency
      valueChange=(next) => { currency = next; }
    />
    <Input placeholder="10.00" pattern="[0-9]*"/>
  </ButtonGroup>
  <ButtonGroup>
    <Button aria-label="Send" size="icon" variant="outline">
      <Icon name="ArrowRightIcon"/>
    </Button>
  </ButtonGroup>
</ButtonGroup>
