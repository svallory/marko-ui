// Static RTL port: upstream's empty-rtl demo drives a live docs-site
// language switcher (useTranslation across en/ar/he) that has no
// equivalent in this app — same established precedent as
// demos/card/card-rtl.marko and demos/badge/badge-rtl.marko (see
// notes/docs-canonical-structure.md, RTL is component behavior, not site
// machinery). This ports the RTL VISUAL and markup directly using the
// source's default locale ("ar"): a `dir="rtl"` empty state with Arabic
// copy. Empty/EmptyHeader/EmptyMedia/EmptyTitle/EmptyDescription/
// EmptyContent already restyle correctly under dir="rtl" since their
// layout is Tailwind flex/grid with no hard-coded physical margins.
// Upstream's trailing "Learn More" link uses `LinkButton`
// (aria)/`Button asChild` (radix)/`Button render={<a/>}` (base) — this
// port's Button is a native <button> only (no polymorphic render prop),
// so the link is a plain <a> styled with buttonVariants({ variant:
// "link" }), matching the precedent in demos/button/button-render.marko.
import Empty from "@marko-ui/shadcn/ui/empty/empty.marko";
import EmptyHeader from "@marko-ui/shadcn/ui/empty/header.marko";
import EmptyMedia from "@marko-ui/shadcn/ui/empty/media.marko";
import EmptyTitle from "@marko-ui/shadcn/ui/empty/title.marko";
import EmptyDescription from "@marko-ui/shadcn/ui/empty/description.marko";
import EmptyContent from "@marko-ui/shadcn/ui/empty/content.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import { buttonVariants } from "@marko-ui/shadcn/ui/button/variants.ts";

<Empty dir="rtl">
  <EmptyHeader>
    <EmptyMedia variant="icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
        <path d="m10 13-2 2 2 2"/>
        <path d="m14 17 2-2-2-2"/>
      </svg>
    </EmptyMedia>
    <EmptyTitle>لا توجد مشاريع بعد</EmptyTitle>
    <EmptyDescription>لم تقم بإنشاء أي مشاريع بعد. ابدأ بإنشاء مشروعك الأول.</EmptyDescription>
  </EmptyHeader>
  <EmptyContent class="flex-row justify-center gap-2">
    <Button>إنشاء مشروع</Button>
    <Button variant="outline">استيراد مشروع</Button>
  </EmptyContent>
  <a href="#" class=`${buttonVariants({ variant: "link", size: "sm" })} text-muted-foreground`>
    تعرف على المزيد
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-270">
      <path d="M7 7h10v10"/>
      <path d="M7 17 17 7"/>
    </svg>
  </a>
</Empty>
