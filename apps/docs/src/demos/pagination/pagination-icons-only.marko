import Pagination from "@marko-ui/shadcn/ui/pagination/pagination.marko";
import PaginationContent from "@marko-ui/shadcn/ui/pagination/content.marko";
import PaginationItem from "@marko-ui/shadcn/ui/pagination/item.marko";
import PaginationNext from "@marko-ui/shadcn/ui/pagination/next.marko";
import PaginationPrevious from "@marko-ui/shadcn/ui/pagination/previous.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";

static const rowsPerPage = [
  { value: "10", label: "10" },
  { value: "25", label: "25" },
  { value: "50", label: "50" },
  { value: "100", label: "100" },
];

<div class="flex items-center justify-between gap-4">
  <Field orientation="horizontal" class="w-fit">
    <FieldLabel for="pagination-icons-only-rows">Rows per page</FieldLabel>
    <Select id="pagination-icons-only-rows" items=rowsPerPage defaultValue=["25"] class="w-20"/>
  </Field>
  <Pagination class="mx-0 w-auto">
    <PaginationContent>
      <PaginationItem>
        <PaginationPrevious href="#"/>
      </PaginationItem>
      <PaginationItem>
        <PaginationNext href="#"/>
      </PaginationItem>
    </PaginationContent>
  </Pagination>
</div>
