// Upstream's "Plugins" demo wires Embla's `embla-carousel-autoplay` plugin
// through the `plugins=` prop, stopping/resuming on hover via the plugin
// instance's own `stop`/`reset` methods. Our carousel is backed by
// @zag-js/carousel, which has no plugin system — autoplay is a NATIVE
// machine capability (`autoplay` prop), so there is no `plugins` prop to
// port. This ports the demo's BEHAVIOR (autoplay every 2s, pause on hover,
// resume on leave) by toggling the reactive `autoplay` prop itself on
// hover, rather than calling `pause()`/`play()` on the connect api pulled
// out via `<Carousel/carouselApi/>`: that attr-tag-return binding, read
// from inside an `onMouseEnter`/`onMouseLeave` handler passed as a PROP to
// the same `<Carousel>` tag, is a reference cycle Marko 6.3.34's compiler
// cannot hoist correctly — it silently compiles the reference to its
// `_hoist_read_error` sentinel (always `undefined` at runtime) instead of
// erroring at build time. Verified: every route rendering this demo threw
// `Cannot read properties of undefined (reading 'pause')` on hover, both
// client-side here and in the equivalent SSR-time read in
// carousel-api.marko. Driving `autoplay` as a controlled prop needs no such
// closure and carries the same user-visible behavior.
import Carousel from "@marko-ui/shadcn/ui/carousel/carousel.marko";

static const SLIDES = [1, 2, 3, 4, 5];

<let/paused=false/>

<div
  class="w-full max-w-[10rem] sm:max-w-xs"
  onMouseEnter() { paused = true; }
  onMouseLeave() { paused = false; }
>
  <Carousel
    items=SLIDES
    autoplay=(paused ? false : { delay: 2000 })
    class="w-full"
  >
    <@content|item|>
      <div class="p-1">
        <div class="flex aspect-square items-center justify-center rounded-lg border bg-card">
          <span class="text-4xl font-semibold">${item}</span>
        </div>
      </div>
    </@content>
  </Carousel>
</div>
