// Upstream wires `aria-invalid` directly on `NativeSelect` and pairs it with
// `data-invalid` on a `Field` wrapper for styling. Our native-select is a
// single unsplit component with no separate trigger part, so `aria-invalid`
// passes straight through native-select.marko's native-attribute forwarding
// (anything not component-owned lands on the native `<select>`).
import NativeSelect from "@marko-ui/shadcn/ui/native-select/native-select.marko";
import NativeSelectOption from "@marko-ui/shadcn/ui/native-select/native-select-option.marko";

<NativeSelect aria-invalid="true" aria-label="Error state">
  <NativeSelectOption value="">Error state</NativeSelectOption>
  <NativeSelectOption value="apple">Apple</NativeSelectOption>
  <NativeSelectOption value="banana">Banana</NativeSelectOption>
  <NativeSelectOption value="blueberry">Blueberry</NativeSelectOption>
</NativeSelect>
