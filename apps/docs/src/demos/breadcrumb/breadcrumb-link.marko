import Breadcrumb from "@marko-ui/shadcn/ui/breadcrumb/breadcrumb.marko";
import BreadcrumbItem from "@marko-ui/shadcn/ui/breadcrumb/item.marko";
import BreadcrumbLink from "@marko-ui/shadcn/ui/breadcrumb/link.marko";
import BreadcrumbPage from "@marko-ui/shadcn/ui/breadcrumb/page.marko";
import BreadcrumbSeparator from "@marko-ui/shadcn/ui/breadcrumb/separator.marko";

// Upstream's `render` prop lets BreadcrumbLink hand its anchor markup to a
// routing library's own Link component (e.g. Next.js's <Link>). Our
// BreadcrumbLink always renders a real <a href>, so there is no separate
// "custom link component" API to demonstrate — this port shows the same
// composed markup upstream produces (an anchor to the current section).
<Breadcrumb>
  <BreadcrumbItem>
    <BreadcrumbLink href="#link-component">Home</BreadcrumbLink>
  </BreadcrumbItem>
  <BreadcrumbSeparator/>
  <BreadcrumbItem>
    <BreadcrumbLink href="#link-component">Components</BreadcrumbLink>
  </BreadcrumbItem>
  <BreadcrumbSeparator/>
  <BreadcrumbItem>
    <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
  </BreadcrumbItem>
</Breadcrumb>
