import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";

static const departments = [
  { value: "engineering", label: "Engineering" },
  { value: "design", label: "Design" },
  { value: "marketing", label: "Marketing" },
  { value: "sales", label: "Sales" },
  { value: "support", label: "Customer Support" },
  { value: "hr", label: "Human Resources" },
  { value: "finance", label: "Finance" },
  { value: "operations", label: "Operations" },
];

// Deviation from upstream: upstream pairs a bare <FieldLabel> with
// <Select><SelectTrigger>...<SelectValue/> — our Select is a single
// component that already renders its own accessible `label` (Zag's
// getLabelProps) above the trigger, so a second wrapping <FieldLabel>
// would double up. We pass `label=` directly to <Select> instead.
<Field class="w-full max-w-md">
  <Select items=departments label="Department" placeholder="Choose department"/>
  <FieldDescription>Select your department or area of work.</FieldDescription>
</Field>
