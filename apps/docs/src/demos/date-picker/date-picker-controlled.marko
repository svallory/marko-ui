import DatePicker from "@marko-ui/registry/ui/date-picker/date-picker.marko";

<let/value="2026-08-10"/>

<div class="flex items-center gap-4">
  <DatePicker
    value=value
    valueChange=(next) => { value = next ?? ""; }
  />
  <span class="text-sm text-muted-foreground">value: ${value || "none"}</span>
</div>
