// Composed from Popover + Calendar. `captionLayout="dropdown"` swaps the
// Calendar's caption for native month/year <select>s, matching upstream's
// react-day-picker `captionLayout="dropdown"`. The popover closes itself
// once a date is picked (controlled `open`), matching upstream's
// setOpen(false) inside onSelect.
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Popover from "@marko-ui/shadcn/ui/popover/popover.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";

<let/open=false/>
<let/value=[] as { year: number; month: number; day: number }[]/>

<Field class="mx-auto w-44">
  <FieldLabel for="date">Date of birth</FieldLabel>
  <Popover open=open openChange=(next) => { open = next; } class="w-auto overflow-hidden p-0">
    <@trigger|props|>
      <Button ...props variant="outline" id="date" class="justify-start font-normal">
        <if=value[0]>
          ${new Date(value[0].year, value[0].month - 1, value[0].day).toLocaleDateString()}
        </if>
        <else>
          Select date
        </else>
      </Button>
    </@trigger>
    <Calendar
      captionLayout="dropdown"
      value=value
      valueChange=(next) => {
        value = next;
        open = false;
      }
    />
  </Popover>
</Field>
