// Composed from InputGroup + Popover + Calendar. Upstream syncs a free-text
// input with the Calendar via three pieces of local state (date/month/value);
// ported the same way onto our primitives. Calendar's month navigation isn't
// separately controllable on our port (no `month`/`onMonthChange` props are
// exposed), so picking a typed date scrolls the calendar via `value`, not a
// separate `month` binding — a real, disclosed deviation from upstream.
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import InputGroup from "@marko-ui/shadcn/ui/input-group/input-group.marko";
import InputGroupInput from "@marko-ui/shadcn/ui/input-group/input.marko";
import InputGroupAddon from "@marko-ui/shadcn/ui/input-group/addon.marko";
import InputGroupButton from "@marko-ui/shadcn/ui/input-group/button.marko";
import Popover from "@marko-ui/shadcn/ui/popover/popover.marko";
import Calendar from "@marko-ui/shadcn/ui/calendar/calendar.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

static function formatDate(date?: { year: number; month: number; day: number }) {
  if (!date) return "";
  return new Date(date.year, date.month - 1, date.day).toLocaleDateString("en-US", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}

static function parseInput(text: string) {
  const date = new Date(text);
  if (isNaN(date.getTime())) return undefined;
  return { year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate() };
}

<const/initial=(parseInput("2025-06-01")!)/>

<let/open=false/>
<let/value=[initial]/>
<let/text=formatDate(initial)/>

<Field class="mx-auto w-48">
  <FieldLabel for="date-required">Subscription Date</FieldLabel>
  <InputGroup>
    <InputGroupInput
      id="date-required"
      value=text
      placeholder="June 01, 2025"
      valueChange=(next) => {
        text = next ?? "";
        const parsed = parseInput(text);
        if (parsed) value = [parsed];
      }
      onKeyDown(event: KeyboardEvent) {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          open = true;
        }
      }
    />
    <InputGroupAddon align="inline-end">
      <Popover open=open openChange=(next) => { open = next; } class="w-auto overflow-hidden p-0">
        <@trigger|props|>
          <InputGroupButton ...props id="date-picker" variant="ghost" size="icon-xs" aria-label="Select date">
            <Icon name="Calendar"/>
            <span class="sr-only">Select date</span>
          </InputGroupButton>
        </@trigger>
        <Calendar
          value=value
          valueChange=(next) => {
            value = next;
            text = formatDate(next[0]);
            open = false;
          }
        />
      </Popover>
    </InputGroupAddon>
  </InputGroup>
</Field>
