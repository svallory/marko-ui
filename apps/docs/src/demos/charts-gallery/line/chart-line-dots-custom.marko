// Port of shadcn's chart-line-dots-custom.tsx — the dot is entirely replaced
// by a GitCommitVertical glyph via line.marko's `dotContent` render-prop
// (Marko.Body<[{x,y,row}]>), nested as `<@series><@dotContent|{x,y,row}|>`.
import Chart from "@marko-ui/shadcn/ui/chart/chart.marko";
import LineChart from "@marko-ui/shadcn/ui/chart/line.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";

static const chartData = [
  { month: "January", desktop: 186, mobile: 80 },
  { month: "February", desktop: 305, mobile: 200 },
  { month: "March", desktop: 237, mobile: 120 },
  { month: "April", desktop: 73, mobile: 190 },
  { month: "May", desktop: 209, mobile: 130 },
  { month: "June", desktop: 214, mobile: 140 },
];

static const chartConfig = {
  desktop: { label: "Desktop", color: "var(--chart-1)" },
  mobile: { label: "Mobile", color: "var(--chart-2)" },
};

static const r = 24;

<Card>
  <CardHeader>
    <CardTitle>Line Chart - Custom Dots</CardTitle>
    <CardDescription>January - June 2024</CardDescription>
  </CardHeader>
  <CardContent>
    <Chart config=chartConfig>
      <LineChart
        data=chartData
        config=chartConfig
        xKey="month"
        xTickFormatter=(value) => value.slice(0, 3)
        hideLabel
        cursor=false
      >
        <@series dataKey="desktop" type="natural" strokeWidth=2>
          <@dotContent|{ x, y }|>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="var(--background)"
              stroke="var(--color-desktop)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              x=(x - r / 2)
              y=(y - r / 2)
              width=r
              height=r
            >
              <path d="M12 3v6"/>
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 15v6"/>
            </svg>
          </@dotContent>
        </@series>
      </LineChart>
    </Chart>
  </CardContent>
  <CardFooter class="flex-col items-start gap-2 text-sm">
    <div class="flex gap-2 leading-none font-medium">
      Trending up by 5.2% this month
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M16 7h6v6"/>
        <path d="m22 7-8.5 8.5-5-5L2 15"/>
      </svg>
    </div>
    <div class="leading-none text-muted-foreground">
      Showing total visitors for the last 6 months
    </div>
  </CardFooter>
</Card>
