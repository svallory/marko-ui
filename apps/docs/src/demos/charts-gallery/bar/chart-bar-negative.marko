// Port of shadcn's chart-bar-negative.tsx — per-row fill via row.fill
// (positive/negative → chart-1/chart-2), category-name label above each bar
// via bar.marko's `labels` (LabelList-equivalent).
import Chart from "@marko-ui/registry/ui/chart/chart.marko";
import BarChart from "@marko-ui/registry/ui/chart/bar.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";

static const chartData = [
  { month: "January", visitors: 186, fill: "var(--chart-1)" },
  { month: "February", visitors: 205, fill: "var(--chart-1)" },
  { month: "March", visitors: -207, fill: "var(--chart-2)" },
  { month: "April", visitors: 173, fill: "var(--chart-1)" },
  { month: "May", visitors: -209, fill: "var(--chart-2)" },
  { month: "June", visitors: 214, fill: "var(--chart-1)" },
];

static const chartConfig = {
  visitors: { label: "Visitors" },
};

<Card>
  <CardHeader>
    <CardTitle>Bar Chart - Negative</CardTitle>
    <CardDescription>January - June 2024</CardDescription>
  </CardHeader>
  <CardContent>
    <Chart config=chartConfig>
      <BarChart
        data=chartData
        config=chartConfig
        xKey="month"
        grid
        hideLabel
        hideIndicator
        cursor=false
        labels=[{ dataKey: "month", position: "top" }]
      >
        <@series dataKey="visitors"/>
      </BarChart>
    </Chart>
  </CardContent>
  <CardFooter class="flex-col items-start gap-2 text-sm">
    <div class="flex gap-2 leading-none font-medium">
      Trending up by 5.2% this month
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M16 7h6v6"/>
        <path d="m22 7-8.5 8.5-5-5L2 15"/>
      </svg>
    </div>
    <div class="leading-none text-muted-foreground">
      Showing total visitors for the last 6 months
    </div>
  </CardFooter>
</Card>
