import Badge from "@marko-ui/shadcn/ui/badge/badge.marko";
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";

// Upstream renders the badge ITSELF as the `<a>` via Base UI's `render`
// prop (asChild-style polymorphism). Our Badge has no `render`/asChild
// equivalent (packages/shadcn/ui/badge/badge.marko always renders a
// `<span>`), so we nest the anchor inside the badge instead. This matches
// our badge CSS's own contract — mu-badge-variant-* rules already target a
// child `[a]:hover:...` selector (packages/shadcn/styles/style-nova.css) —
// so hover/focus styling still lands correctly on the link.
<Badge>
  <a href="#link">
    Open Link
    <Icon name="ArrowUpRightIcon" data-icon="inline-end"/>
  </a>
</Badge>
