import Timer from "@marko-ui/shadcn/ui/timer/timer.marko";
import type * as timerMachine from "@zag-js/timer";

<let/parts=(["minutes", "seconds"] as timerMachine.TimePart[])/>

<div class="flex flex-col items-center gap-3">
  <Timer parts=parts/>
  <div class="flex gap-2">
    <button
      type="button"
      class="rounded-md border px-2 py-1 text-sm"
      onClick() { parts = ["seconds"]; }
    >
      Seconds only
    </button>
    <button
      type="button"
      class="rounded-md border px-2 py-1 text-sm"
      onClick() { parts = ["minutes", "seconds"]; }
    >
      Min:Sec
    </button>
    <button
      type="button"
      class="rounded-md border px-2 py-1 text-sm"
      onClick() { parts = ["hours", "minutes", "seconds"]; }
    >
      Hr:Min:Sec
    </button>
  </div>
</div>
