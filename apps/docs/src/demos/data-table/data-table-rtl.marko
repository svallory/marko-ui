import DataTable from "@marko-ui/shadcn/ui/data-table/data-table.marko";

// Upstream's data-table-rtl demo drives a live language switcher
// (useTranslation over en/ar/he, defaulting to "ar") that has no
// equivalent in this docs app — see demos/pagination/pagination-rtl.marko
// and demos/badge/badge-rtl.marko for the established precedent. This
// ports the RTL VISUAL directly: static `dir="rtl"` wrapper with Arabic
// content and Arabic currency formatting, matching the source's default
// locale.
//
// Scope deviation from upstream (component-capability driven, not a
// choice): our `DataTable` (packages/shadcn/ui/data-table/data-table.marko)
// only implements columns + data + click-to-sort. Upstream's RTL demo also
// exercises TanStack Table's filtering, column-visibility toggle, row
// selection (checkbox column), row-actions dropdown menu, and pagination
// controls — none of which our component supports. Those parts are
// omitted here rather than faked; only Status/Email (sortable)/Amount
// (RTL currency-formatted) are ported, matching what data-table-demo
// already covers for our component's real surface.
static const payments = [
  { id: "m5gr84i9", amount: 316, status: "success", email: "ken99@example.com" },
  { id: "3u1reuv4", amount: 242, status: "success", email: "Abe45@example.com" },
  { id: "derv1ws0", amount: 837, status: "processing", email: "Monserrat44@example.com" },
  { id: "5kma53ae", amount: 874, status: "success", email: "Silas22@example.com" },
  { id: "bhqecj4p", amount: 721, status: "failed", email: "carmella@example.com" },
];

static const statusLabels: Record<string, string> = {
  success: "ناجح",
  processing: "قيد المعالجة",
  failed: "فشل",
  pending: "قيد الانتظار",
};

static const columns = [
  {
    accessorKey: "status",
    header: "الحالة",
    cell: (row: (typeof payments)[number]) => statusLabels[row.status] ?? row.status,
  },
  { accessorKey: "email", header: "البريد الإلكتروني" },
  {
    accessorKey: "amount",
    header: "المبلغ",
    cell: (row: (typeof payments)[number]) =>
      new Intl.NumberFormat("ar-SA", { style: "currency", currency: "USD" }).format(row.amount),
  },
];

<div dir="rtl">
  <DataTable columns=columns data=payments/>
</div>
