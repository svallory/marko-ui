import DataTable from "@marko-ui/shadcn/ui/data-table/data-table.marko";
import type { DataTableColumn } from "@marko-ui/shadcn/ui/data-table/data-table.marko";

static const payments = [
  { id: "728ed52f", amount: 100, status: "pending", email: "m@example.com" },
  { id: "489e1d42", amount: 125, status: "processing", email: "example@gmail.com" },
  { id: "a1b2c3d4", amount: 250, status: "success", email: "jane@example.com" },
  { id: "e5f6a7b8", amount: 75, status: "failed", email: "john@example.com" },
  { id: "c9d0e1f2", amount: 300, status: "success", email: "alice@example.com" },
];

static const columns: DataTableColumn<(typeof payments)[number]>[] = [
  { accessorKey: "status", header: "Status" },
  { accessorKey: "email", header: "Email" },
  {
    accessorKey: "amount",
    header: "Amount",
    cell: (row) =>
      new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(row.amount),
  },
];

// KNOWN UNSOUNDNESS, not just an inference-gap workaround: DataTable's
// Input<TData> is generic, but a Marko tag call never infers TData from
// the call site at all -- every <DataTable ...=.../> is checked against
// TData's default (Record<string, unknown>), confirmed by an isolated
// repro (removing this cast produces a genuine TS2322 even though
// `columns` is correctly typed against payments' real row shape, and
// there is no generic-tag-call syntax to instantiate TData explicitly).
// This cast makes that TS2322 disappear by widening `columns`' element
// type to DataTableColumn<Record<string, unknown>>, whose `cell` field
// is `(row: Record<string, unknown>) => ...` -- a genuinely different,
// wider function type than the real `(row: typeof payments[number]) =>
// ...`. Any code that holds the widened-typed array could call `cell`
// with an arbitrary Record<string, unknown> and the type system would
// accept it, even though only the correctly-shaped row is ever passed
// at DataTable's actual runtime call site. Tried and rejected: dropping
// the cast (TS2322, above), and a single combined columns+data prop
// (would change DataTable's public Input for every consumer, out of
// scope for a demo-only fix).
<DataTable columns=(columns as DataTableColumn<Record<string, unknown>>[]) data=payments/>
