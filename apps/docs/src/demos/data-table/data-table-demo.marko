import DataTable from "@marko-ui/shadcn/ui/data-table/data-table.marko";
import type { DataTableColumn } from "@marko-ui/shadcn/ui/data-table/data-table.marko";

static const payments = [
  { id: "728ed52f", amount: 100, status: "pending", email: "m@example.com" },
  { id: "489e1d42", amount: 125, status: "processing", email: "example@gmail.com" },
  { id: "a1b2c3d4", amount: 250, status: "success", email: "jane@example.com" },
  { id: "e5f6a7b8", amount: 75, status: "failed", email: "john@example.com" },
  { id: "c9d0e1f2", amount: 300, status: "success", email: "alice@example.com" },
];

static const columns: DataTableColumn<(typeof payments)[number]>[] = [
  { accessorKey: "status", header: "Status" },
  { accessorKey: "email", header: "Email" },
  {
    accessorKey: "amount",
    header: "Amount",
    cell: (row) =>
      new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(row.amount),
  },
];

// DataTable's Input<TData> is generic, but a custom tag call can't jointly
// infer TData across two sibling props (columns=/data=) the way a plain
// TS function call would - each is checked independently against the
// component's default TData = Record<string, unknown>. `columns` above is
// already correctly typed against payments' real row shape, so this cast
// only defeats that inference gap, not a real mismatch.
<DataTable columns=(columns as DataTableColumn<Record<string, unknown>>[]) data=payments/>
