import Resizable from "@marko-ui/shadcn/ui/resizable/resizable.marko";

static const PANELS = [
  { id: "one", defaultSize: 50 },
  { id: "two", defaultSize: 50 },
];

<let/sizes=[50, 50]/>

<div class="flex flex-col gap-3">
  <Resizable|panel|
    panels=PANELS
    class="min-h-[200px] max-w-md rounded-lg border md:min-w-[450px]"
    resizeChange=(newSizes) => { sizes = newSizes; }
  >
    <div class="flex h-full items-center justify-center p-6">
      <span class="font-semibold">${panel.id === "one" ? "One" : "Two"}</span>
    </div>
  </Resizable>
  <span class="text-sm text-muted-foreground">
    sizes: ${sizes.map((size) => `${Math.round(size)}%`).join(" / ")}
  </span>
</div>
