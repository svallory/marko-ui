import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";
import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";

static const SPACING_OPTIONS = [
  { value: "4", label: "16px", class: "[--card-spacing:--spacing(4)]" },
  { value: "5", label: "20px", class: "[--card-spacing:--spacing(5)]" },
  { value: "6", label: "24px", class: "[--card-spacing:--spacing(6)]" },
  { value: "8", label: "32px", class: "[--card-spacing:--spacing(8)]" },
];

<let/spacing="4"/>
<const/selectedSpacing=SPACING_OPTIONS.find((option) => option.value === spacing)/>

<div class="mx-auto grid w-full max-w-sm gap-4">
  <ToggleGroup
    items=SPACING_OPTIONS
    value=[spacing]
    valueChange=(next) => { if (next[0]) spacing = next[0]; }
    variant="outline"
    size="sm"
    class="justify-center"
  />
  <Card class=selectedSpacing?.class>
    <CardHeader>
      <CardTitle>Login to your account</CardTitle>
      <CardDescription>Enter your email below to login to your account</CardDescription>
      <CardAction>
        <Button variant="link">Sign Up</Button>
      </CardAction>
    </CardHeader>
    <CardContent>
      <div class="flex flex-col gap-6">
        <div class="grid gap-2">
          <Label for="card-spacing-email">Email</Label>
          <Input id="card-spacing-email" type="email" placeholder="m@example.com" required/>
        </div>
        <div class="grid gap-2">
          <div class="flex items-center">
            <Label for="card-spacing-password">Password</Label>
            <a href="#" class="ml-auto inline-block text-sm underline-offset-4 hover:underline">
              Forgot your password?
            </a>
          </div>
          <Input id="card-spacing-password" type="password" required/>
        </div>
      </div>
    </CardContent>
    <CardFooter class="flex-col gap-2">
      <Button type="submit" class="w-full">Login</Button>
      <Button variant="outline" class="w-full">Login with Google</Button>
    </CardFooter>
  </Card>
</div>
