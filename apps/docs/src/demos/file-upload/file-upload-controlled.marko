import FileUpload from "@marko-ui/shadcn/ui/file-upload/file-upload.marko";

<let/lastFiles=[] as { name: string; size: number; type: string }[]/>

<p class="text-muted-foreground mb-4 text-sm">
  Files: ${lastFiles.map((file) => file.name).join(", ") || "none"}
</p>
<FileUpload filesChange(files) { lastFiles = files; }/>
