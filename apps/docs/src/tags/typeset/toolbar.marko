// Ported from shadcn/ui app/(app)/(typeset)/components/toolbar.tsx.
// Two floating pill groups over the preview iframe: the numbered
// content-item pills (tooltipped with the item label) and the "Open in New
// Tab" link. Wrapper/pill/link class strings and the `dark` scoping class
// are verbatim.
//
// - `data-active` is written as String(...) — Marko renders a bare attribute
//   for boolean `true`, which would stop `data-[active=true]:` from matching
//   (see notes/component-authoring.md).
// - Upstream reads/writes params via useTypesetSearchParams; here the
//   committed item and the setter arrive as attrs from the typeset-app
//   container, and the open-in-new-tab href is serialized from those params.
// - DEV_CONTENT_OPTIONS is empty upstream (both entries commented out), so
//   its dev-only pill group renders nothing; the group and its divider are
//   ported anyway, gated on the same emptiness check.
import Tooltip from "@marko-ui/shadcn/ui/tooltip/tooltip.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import {
  CONTENT_OPTIONS,
  DEV_CONTENT_OPTIONS,
  IS_DEV,
} from "./lib/fixtures/index.ts";
import {
  serializeTypesetSearchParams,
  type TypesetSearchParams,
} from "./lib/search-params.ts";

export interface Input {
  params: TypesetSearchParams;
  onItemChange: (item: string) => void;
}

<const/href=serializeTypesetSearchParams(
  `/typeset/preview/${input.params.item}`,
  input.params,
)/>
<const/showDevOptions=(IS_DEV && DEV_CONTENT_OPTIONS.length > 0)/>

<div class="absolute bottom-3 left-1/2 z-20 flex -translate-x-1/2 items-center justify-center gap-1.5">
  <div class="dark flex items-center gap-1 rounded-xl bg-card/90 p-1 shadow-xl backdrop-blur-xl">
    <for|option, index| of=CONTENT_OPTIONS by=(option) => option.value>
      <Tooltip positioning={ placement: "top", offset: { mainAxis: 10 } } content=option.label>
        <@trigger|triggerProps: Record<string, unknown>|>
          <Button
            ...triggerProps
            variant="ghost"
            size="sm"
            data-active=String(input.params.item === option.value)
            class="h-7 min-w-7 cursor-pointer rounded-lg px-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground"
            on-click() { input.onItemChange(option.value); }
          >
            ${String(index + 1).padStart(2, "0")}
          </Button>
        </@trigger>
      </Tooltip>
    </for>
    <if=showDevOptions>
      <div class="hidden items-center gap-1 md:flex">
        <div class="mx-0.5 h-4 w-px bg-border"/>
        <for|option, index| of=DEV_CONTENT_OPTIONS by=(option) => option.value>
          <Tooltip positioning={ placement: "top", offset: { mainAxis: 10 } } content=option.label>
            <@trigger|triggerProps: Record<string, unknown>|>
              <Button
                ...triggerProps
                variant="ghost"
                size="sm"
                data-active=String(input.params.item === option.value)
                class="h-7 min-w-7 cursor-pointer rounded-lg px-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground"
                on-click() { input.onItemChange(option.value); }
              >
                ${String(CONTENT_OPTIONS.length + index + 1).padStart(2, "0")}
              </Button>
            </@trigger>
          </Tooltip>
        </for>
      </div>
    </if>
  </div>
  <div class="dark flex items-center gap-1 rounded-xl bg-card/90 p-1 shadow-xl backdrop-blur-xl">
    // Upstream renders <Button asChild> wrapping an <a>; Marko has no asChild,
    // so the anchor carries the button's resolved class string directly.
    <a
      href=href
      target="_blank"
      rel="noreferrer"
      data-slot="button"
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg whitespace-nowrap outline-none h-7 cursor-pointer px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0"
    >
      // hugeicons LinkSquare02Icon
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 md:hidden">
        <path d="M10.5 13.5L20 4"/>
        <path d="M20 8.5V4H15.5"/>
        <path d="M20 14v3a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h3"/>
      </svg>
      <span class="max-md:sr-only">Open in New Tab</span>
    </a>
  </div>
</div>
