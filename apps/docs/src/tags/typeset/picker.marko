// Ported from shadcn/ui app/(app)/(typeset)/components/picker.tsx.
//
// Upstream that file is itself "a copy of create's picker with lucide icons
// instead of IconPlaceholder" — and our /create port already has the same
// primitive at ../create/picker.marko. This file is the TYPESET variant of
// it rather than a reuse, because typeset's picker.tsx exposes two parts
// create's does not use and which typeset's main-menu.tsx depends on:
// PickerItem (a plain action item) and PickerShortcut (the right-aligned
// ⌘Z/R hint) mixed in the same popup as radio sections.
//
// Round 2: rebuilt on the registry DropdownMenu (packages/shadcn/ui/
// dropdown-menu) instead of a hand-rolled @zag-js/menu popup. DropdownMenu's
// `items=` array already supports mixed action + radio entries in one list
// (type discriminant per entry) plus separators between groups, so no new
// registry capability was needed beyond the positioning/onHighlightChange
// pass-throughs added to dropdown-menu.marko for this task (mobile anchor
// override + hover-preview, which this file used to hand-roll a whole
// parallel menu for). The dark floating-panel look (bg-neutral-950/80) is
// shadcn's own verbatim upstream class for this popup, kept as a `class`
// override on the registry component rather than the registry default.
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import type { DropdownMenuItem } from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import type * as menu from "@zag-js/menu";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";

export interface PickerRadioOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface PickerSection {
  /** Optional group label (PickerLabel upstream). */
  label?: string;
  options: PickerRadioOption[];
}

export interface PickerAction {
  /** Stable id — zag needs a value per item. */
  value: string;
  label: string;
  /** Right-aligned shortcut hint (PickerShortcut upstream). */
  shortcut?: string;
  disabled?: boolean;
  /** Start a new group after a separator (PickerSeparator upstream). */
  startsGroup?: boolean;
}

export interface Input {
  /** Trigger content — renders inside the styled trigger button. */
  trigger: Marko.AttrTag<{ content: Marko.Body }>;
  /** Radio sections; mutually exclusive with `actions` in practice. */
  sections?: PickerSection[];
  /** Plain action items (main-menu). */
  actions?: PickerAction[];
  /** Currently committed radio value. */
  value?: string;
  onValueChange?: (value: string) => void;
  onActionSelect?: (value: string) => void;
  /**
   * Fired when the highlighted (hovered/focused) item changes; `null` when
   * nothing is highlighted. Mirrors shadcn's onItemPreview / clearOverride.
   */
  onItemPreview?: (value: string | null) => void;
  closeOnClick?: boolean;
  side?: "top" | "bottom" | "left" | "right";
  align?: "start" | "center" | "end";
  /** Cross-axis nudge along the align edge (Base UI's PickerContent alignOffset). */
  alignOffset?: number;
  /**
   * Mobile-only anchor override (option-picker/font-picker's `anchor={isMobile
   * ? anchorRef : undefined}`): when set, the popup positions against this
   * element instead of the trigger button — upstream anchors every field's
   * popup to the customizer Card on mobile so it doesn't hug a cramped
   * trigger. `undefined`/no-op on desktop, same as upstream's ternary.
   */
  anchorEl?: () => HTMLElement | null;
  disabled?: boolean;
  class?: string;
  contentClass?: string;
}

<const/actions=(input.actions ?? [])/>
<const/sections=(input.sections ?? [])/>
// main-menu.tsx wraps each run of actions in its own <PickerGroup>: a new
// group starts at index 0 and at every action with startsGroup — expressed
// here as a leading separator before each new group (DropdownMenu's own
// separator entry), same visible effect as a distinct group wrapper.
<const/items=[
  ...actions.flatMap((action, index): DropdownMenuItem[] => [
    ...(index > 0 && action.startsGroup ? [{ type: "separator" as const }] : []),
    { type: "item", value: action.value, label: action.label, shortcut: action.shortcut, disabled: action.disabled },
  ]),
  ...(actions.length > 0 && sections.length > 0 ? [{ type: "separator" as const }] : []),
  ...sections.flatMap((section, sectionIndex): DropdownMenuItem[] => [
    ...(sectionIndex > 0 ? [{ type: "separator" as const }] : []),
    ...(section.label ? [{ type: "label" as const, label: section.label }] : []),
    ...section.options.map((option): DropdownMenuItem => ({
      type: "radio",
      value: option.value,
      label: option.label,
      disabled: option.disabled,
      checked: option.value === input.value,
      radioGroup: "picker",
    })),
  ]),
] satisfies DropdownMenuItem[]/>

<DropdownMenu/menuApi
  items=items
  disabled=input.disabled
  closeOnSelect=(actions.length > 0 ? undefined : input.closeOnClick)
  positioning={
    placement: `${input.side ?? "bottom"}${input.align && input.align !== "center" ? `-${input.align}` : ""}` as NonNullable<menu.Props["positioning"]>["placement"],
    gutter: 20,
    offset: input.alignOffset ? { crossAxis: input.alignOffset } : undefined,
    getAnchorElement: input.anchorEl ? () => input.anchorEl!() : undefined,
  }
  onHighlightChange(details: menu.HighlightChangeDetails) {
    input.onItemPreview?.(details.highlightedValue);
  }
  onOpenChange(details: menu.OpenChangeDetails) {
    if (!details.open) input.onItemPreview?.(null);
  }
  class=cn(
    "bg-neutral-950/80 text-neutral-100 ring-neutral-950/80 backdrop-blur-xl dark:bg-neutral-800/90 dark:ring-neutral-700/50 **:data-[slot=dropdown-menu-label]:text-neutral-400 **:data-[slot=dropdown-menu-separator]:bg-neutral-600 dark:**:data-[slot=dropdown-menu-separator]:bg-neutral-700 **:data-[slot=dropdown-menu-item]:text-neutral-100 **:data-[slot=dropdown-menu-item]:focus:bg-neutral-600 dark:**:data-[slot=dropdown-menu-item]:focus:bg-neutral-700/80 **:data-[slot=dropdown-menu-radio-item]:text-neutral-100 **:data-[slot=dropdown-menu-radio-item]:focus:bg-neutral-600 dark:**:data-[slot=dropdown-menu-radio-item]:focus:bg-neutral-700/80 **:data-[slot=dropdown-menu-shortcut]:text-neutral-400!",
    input.contentClass,
  )
  select(value: string) {
    if (actions.some((action) => action.value === value)) {
      input.onActionSelect?.(value);
    }
  }
  radioChange(_group, value) {
    input.onValueChange?.(value);
  }
>
  <@trigger|triggerProps|>
    <button type="button"
      ...triggerProps
      disabled=input.disabled
      class=cn(
        "relative w-36 shrink-0 touch-manipulation rounded-xl p-3 ring-1 ring-foreground/10 select-none hover:bg-muted focus-visible:ring-foreground/50 focus-visible:outline-none disabled:opacity-50 data-[state=open]:bg-muted md:w-full md:rounded-lg md:px-2.5 md:py-2",
        input.class,
      )
    >
      <${input.trigger.content}/>
    </button>
  </@trigger>
</DropdownMenu>
// Clicks inside the preview iframe never reach this document, so this
// shield catches outside-clicks over it while the menu is open. left-54
// clears the customizer card. `position: fixed` (viewport-relative) rather
// than the original hand-rolled menu's `absolute`-inside-its-own-portal,
// since this div is NOT inside DropdownMenu's own zag-portal.
//
// Without an explicit close, this becomes a full-viewport click sink that
// swallows every subsequent click on the page (found in browser
// verification during the initial port: the shield measured 1376x916 and
// the docs-panel tabs, Shuffle and the toolbar all stopped responding once
// any picker had been opened). `menuApi().setOpen(false)` restores the
// upstream behavior.
<if=menuApi().open>
  <div
    class="fixed inset-y-0 right-0 left-54 z-40 bg-transparent"
    on-click() { menuApi().setOpen(false); }
  />
</if>
