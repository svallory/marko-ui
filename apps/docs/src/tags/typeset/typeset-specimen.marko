import { FIXTURES, CONTENT_OPTIONS } from "../../lib/typeset-fixtures.ts";

export interface Input {
  active?: keyof typeof FIXTURES;
}

<let/active=input.active ?? "docs"/>

<div>
  <div class="mb-4 inline-flex items-center gap-1 rounded-lg border border-border bg-muted/40 p-1" role="tablist" aria-label="Typography specimen">
    <for|option| of=CONTENT_OPTIONS by=(option)=>option.value>
      <button
        type="button"
        role="tab"
        aria-selected=(active === option.value)
        data-value=option.value
        onClick() {
          active = option.value;
        }
        class=`rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
          active === option.value
            ? "bg-background text-foreground shadow-sm"
            : "text-muted-foreground hover:text-foreground"
        }`
      >
        ${option.label}
      </button>
    </for>
  </div>

  <div class="typeset rounded-lg border border-border p-6 sm:p-10" role="tabpanel">
    <if=active === "docs">
      $!{FIXTURES.docs}
    </if>
    <else-if=active === "elements">
      $!{FIXTURES.elements}
    </else-if>
  </div>
</div>
