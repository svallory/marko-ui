import Button from "@marko-ui/registry/ui/button/button.marko";
import Separator from "@marko-ui/registry/ui/separator/separator.marko";
import "../create/create-picker.marko";
import {
  FONTS,
  SIZES,
  LEADINGS,
  FLOWS,
  MEASURES,
  type TypesetConfig,
} from "./typeset-options.ts";

export interface Input {
  config: TypesetConfig;
  configChange: (config: TypesetConfig) => void;
  /** Hover preview: a partial overlay applied without committing. */
  previewChange: (overlay: Partial<TypesetConfig> | null) => void;
  onShuffle: () => void;
  onReset: () => void;
  onCopy: () => void;
  copyState: string;
}

<const/headingFontOptions=FONTS.map((font) => ({ name: font.name, label: font.label }))/>
<const/bodyFontOptions=FONTS.filter((font) => font.name !== "inherit").map((font) => ({
  name: font.name,
  label: font.label,
}))/>
<const/monoFontOptions=bodyFontOptions/>
<const/sizeOptions=SIZES.map((size) => ({ name: size.name, label: size.label }))/>
<const/leadingOptions=LEADINGS.map((leading) => ({ name: leading.name, label: leading.label }))/>
<const/flowOptions=FLOWS.map((flow) => ({ name: flow.name, label: flow.label }))/>
<const/measureOptions=MEASURES.map((measure) => ({ name: measure.name, label: measure.label }))/>

// Single stable handlers keyed by field name — see create-customizer.marko for
// why this must be a stable closure rather than a per-picker factory.
<const/update=(field: string, value: string) => {
  input.configChange({ ...input.config, [field]: value });
}/>

<const/preview=(field: string, value: string | null) => {
  input.previewChange(value === null ? null : { [field]: value });
}/>

<div
  class="flex w-full shrink-0 flex-col gap-0 self-start overflow-visible rounded-2xl border border-border bg-card/90 text-card-foreground shadow-sm backdrop-blur-xl md:max-h-full md:w-(--customizer-width)"
  data-slot="typeset-customizer"
>
  <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-3">
    <span class="text-sm font-semibold tracking-tight">Typeset</span>
  </div>

  <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-visible p-4 md:overflow-y-auto">
    <create-picker
      label="Measure"
      options=measureOptions
      value=input.config.measure
      field="measure"
      valueChange=update
      previewChange=preview
    />

    <Separator class="my-1"/>

    <create-picker
      label="Heading"
      options=headingFontOptions
      value=input.config.heading
      field="heading"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Body"
      options=bodyFontOptions
      value=input.config.body
      field="body"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Mono"
      options=monoFontOptions
      value=input.config.mono
      field="mono"
      valueChange=update
      previewChange=preview
    />

    <Separator class="my-1"/>

    <create-picker
      label="Size"
      options=sizeOptions
      value=input.config.scale
      field="scale"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Leading"
      options=leadingOptions
      value=input.config.leading
      field="leading"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Flow"
      options=flowOptions
      value=input.config.flow
      field="flow"
      valueChange=update
      previewChange=preview
    />
  </div>

  <div class="flex flex-col gap-2 border-t border-border p-4">
    <Button size="sm" class="w-full" onClick=input.onCopy>
      ${input.copyState}
    </Button>
    <div class="flex gap-2">
      <Button
        size="sm"
        variant="outline"
        class="flex-1"
        onClick=input.onShuffle
      >
        Shuffle
      </Button>
      <Button
        size="sm"
        variant="outline"
        class="flex-1"
        onClick=input.onReset
      >
        Reset
      </Button>
    </div>
  </div>
</div>
