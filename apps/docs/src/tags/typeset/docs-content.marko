// Ported from the TypesetDocsContent half of shadcn/ui
// app/(app)/(typeset)/components/docs-panel.tsx, along with its private
// leaves: DocsSection, DocsProse, DocsCode, DocsCommand, DocsFonts,
// FrameworkPicker, CopyCssButton, CopyPromptButton. Every class string and
// the four numbered docs steps are verbatim.
//
// Deviations, each forced:
// - Round 2: the Docs/Prompt switch is now the registry Tabs, using its
//   `<@panel|>` attr-tag form to host this file's full markup body per tab
//   (Tabs DOES support that — the earlier "items=[]-driven, can't host
//   inline body content" claim was wrong; `panel.content` renders a
//   supplied body verbatim, see tabs.marko). The framework Select is
//   visually pinned into the tabslist header row with absolute
//   positioning, since Tabs' own root has no slot for extra header content
//   beside its trigger list.
// - The CSS fetch targets /typeset/css, not /typeset.css: @marko/run treats
//   a period as the flat-route separator so the literal path cannot be
//   declared (see ../../routes/typeset/css/+handler.ts, and the shared
//   TYPESET_CSS_PATH constant in lib/docs-content.ts).
// - trackEvent() calls are dropped — this site has no analytics pipeline.
//   The clipboard write and the 2s "copied" state they wrapped are kept.
// - useConfig()'s persisted package-manager preference becomes a local
//   <let> (no cross-page config store here); the pm switch is now the
//   registry ToggleGroup and the command transforms are unchanged.
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";
import Tabs from "@marko-ui/shadcn/ui/tabs/tabs.marko";
import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";
import { highlightCode } from "../../lib/highlight-code.ts";
import { TEMPLATES } from "./lib/templates.ts";
import {
  getCommandForPackageManager,
  getDocsContent,
  PACKAGE_MANAGERS,
  TYPESET_CSS_PATH,
  type PackageManager,
} from "./lib/docs-content.ts";
import type { TypesetSearchParams } from "./lib/search-params.ts";

export interface Input {
  params: TypesetSearchParams;
}

static const FRAMEWORK_ITEMS = TEMPLATES.map((template) => ({
  value: template.value,
  label: template.title,
}));

<let/tab="docs"/>
<let/framework="next"/>
<let/packageManager="pnpm" as PackageManager/>
<let/rawCss=null as string | null/>
<let/hasCopiedCss=false/>
<let/hasCopiedPrompt=false/>
<let/fetched=false/>

<script>
  // Upstream fetches the shipped stylesheet so "Copy typeset.css" hands over
  // the real file rather than a reconstruction.
  if (!fetched && typeof window !== "undefined") {
    fetched = true;
    fetch(TYPESET_CSS_PATH)
      .then((response) => response.text())
      .then((text) => {
        rawCss = text;
      })
      .catch(() => {
        rawCss = null;
      });
  }
</script>

<const/docs=getDocsContent(input.params, framework)/>

<const/copyCss=() => {
  if (!rawCss) return;
  navigator.clipboard.writeText(rawCss).then(() => {
    hasCopiedCss = true;
  });
}/>

<const/copyPrompt=() => {
  navigator.clipboard.writeText(docs.prompt).then(() => {
    hasCopiedPrompt = true;
  });
}/>

// The 2s revert, as its own effect keyed on the flag — upstream is
// `useEffect(() => { if (hasCopied) { const t = setTimeout(...); return () =>
// clearTimeout(t) } }, [hasCopied])`, once per button.
//
// It must be an effect, not a setTimeout chained inside the clipboard
// promise: that puts the assignment two async hops from the event handler,
// where Marko's reactivity does not track it (verified on the production
// build — the icon flipped to the checkmark and never reverted). Reading the
// flag inside a <script> makes the dependency explicit so the revert
// re-renders.
//
// The timer id is parked on `refs` (a non-reactive holder) and cleared by
// the callback, so a repeat click re-arms the revert rather than stacking
// overlapping timers.
<let/refs={ cssTimer: 0, promptTimer: 0 }/>

<script>
  if (hasCopiedCss && !refs.cssTimer) {
    refs.cssTimer = window.setTimeout(() => {
      refs.cssTimer = 0;
      hasCopiedCss = false;
    }, 2000);
  }
</script>

<script>
  if (hasCopiedPrompt && !refs.promptTimer) {
    refs.promptTimer = window.setTimeout(() => {
      refs.promptTimer = 0;
      hasCopiedPrompt = false;
    }, 2000);
  }
</script>

<lifecycle
  onDestroy() {
    if (refs.cssTimer) window.clearTimeout(refs.cssTimer);
    if (refs.promptTimer) window.clearTimeout(refs.promptTimer);
  }
/>

// The header row (tabslist + framework Select) has no slot on Tabs' own
// root, so it's rendered as a sibling positioned over the rendered
// tabslist — Tabs has no concept of extra header content beside its
// trigger list. The border/padding that used to live on this file's own
// hand-rolled header div is applied to Tabs' list via an arbitrary
// descendant selector, since Tabs exposes no listClass prop.
<div class="relative flex min-h-0 flex-1 flex-col gap-0">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-center justify-end gap-2 px-4 py-3">
    <div class="pointer-events-auto">
      <Select
        items=FRAMEWORK_ITEMS
        value=[framework]
        valueChange=(value: string[]) => { framework = value[0] ?? "next"; }
        positioning={ placement: "bottom-end" }
      />
    </div>
  </div>
  <Tabs value:=tab class="flex min-h-0 flex-1 flex-col gap-0 [&_[data-slot=tabs-list]]:mx-4 [&_[data-slot=tabs-list]]:my-3">
    <@trigger value="docs">Docs</@trigger>
    <@trigger value="prompt">Prompt</@trigger>
    <@panel value="docs">
      <div class="min-h-0 flex-1 scroll-fade scrollbar-none overflow-y-auto p-4 md:p-6">
        <div class="flex flex-col gap-6">
          <section class="flex flex-col gap-2.5">
            <h3 class="text-sm font-medium">1. Create typeset.css</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">
              Copy the stylesheet into a <code class="font-mono">typeset.css</code> file next to your main CSS file, then import it:
            </p>
            <Button type="button"
              variant="outline"
              size="sm"
              class="w-fit"
              disabled=(!rawCss)
              on-click() { copyCss(); }
            >
              <if=hasCopiedCss>
                <svg data-icon="inline-start" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </if>
              <else>
                <svg data-icon="inline-start" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </else>
              Copy typeset.css
            </Button>
            <div class="relative rounded-lg bg-muted/60">
              <await|highlighted|=highlightCode('@import "tailwindcss";\n@import "./typeset.css";', "css")>
                <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed"><code>$!{highlighted}</code></pre>
              </await>
            </div>
          </section>
          <section class="flex flex-col gap-2.5">
            <h3 class="text-sm font-medium">2. Add the fonts</h3>
            <if=(framework === "next")>
              <p class="text-sm leading-relaxed text-muted-foreground">
                Load the fonts with <code class="font-mono">next/font</code> in your root layout:
              </p>
              <div class="relative rounded-lg bg-muted/60">
                <await|highlighted|=highlightCode(docs.nextFontCode, "ts")>
                  <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed"><code>$!{highlighted}</code></pre>
                </await>
              </div>
            </if>
            <else>
              <div class="rounded-lg bg-muted/60">
                <div class="flex items-center gap-3 px-3 pt-2">
                  <ToggleGroup
                    value=[packageManager]
                    valueChange=(value: string[]) => { packageManager = (value[0] ?? "pnpm") as PackageManager; }
                    deselectable=false
                    items=PACKAGE_MANAGERS.map((pm) => ({ value: pm, label: pm }))
                    size="sm"
                    class="gap-3 **:data-[slot=toggle-group-item]:h-auto **:data-[slot=toggle-group-item]:rounded-none **:data-[slot=toggle-group-item]:border-none **:data-[slot=toggle-group-item]:bg-transparent! **:data-[slot=toggle-group-item]:p-0 **:data-[slot=toggle-group-item]:font-mono **:data-[slot=toggle-group-item]:text-xs **:data-[slot=toggle-group-item]:text-muted-foreground **:data-[slot=toggle-group-item]:hover:text-foreground **:data-[slot=toggle-group-item]:hover:bg-transparent! **:data-[slot=toggle-group-item]:data-[state=on]:text-foreground **:data-[slot=toggle-group-item]:data-[state=on]:bg-transparent!"
                  />
                </div>
                <await|highlighted|=highlightCode(getCommandForPackageManager(packageManager, docs.fontsourceCommand), "bash")>
                  <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-xs leading-relaxed"><code>$!{highlighted}</code></pre>
                </await>
              </div>
              <p class="text-sm leading-relaxed text-muted-foreground">Then import them in your CSS file:</p>
              <div class="relative rounded-lg bg-muted/60">
                <await|highlighted|=highlightCode(docs.fontsourceCss, "css")>
                  <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed"><code>$!{highlighted}</code></pre>
                </await>
              </div>
            </else>
          </section>
          <section class="flex flex-col gap-2.5">
            <h3 class="text-sm font-medium">3. Create your custom typeset</h3>
            <div class="relative rounded-lg bg-muted/60">
              <await|highlighted|=highlightCode(docs.preset, "css")>
                <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed"><code>$!{highlighted}</code></pre>
              </await>
            </div>
          </section>
          <section class="flex flex-col gap-2.5">
            <h3 class="text-sm font-medium">4. Wrap your content</h3>
            <div class="relative rounded-lg bg-muted/60">
              <await|highlighted|=highlightCode(docs.usage, "html")>
                <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed"><code>$!{highlighted}</code></pre>
              </await>
            </div>
          </section>
        </div>
      </div>
    </@panel>
    <@panel value="prompt">
      <div class="min-h-0 flex-1 scroll-fade scrollbar-none overflow-y-auto p-4 md:p-6">
        <div class="flex flex-col gap-2.5">
          <p class="text-sm leading-relaxed text-muted-foreground">
            One prompt with your picks baked in. Copy it and paste it into your coding agent.
          </p>
          // Deliberately NOT run through highlightCode: this is a natural-
          // language LLM prompt, not code (see docs.prompt in
          // ./lib/docs-content.ts) — syntax coloring here would be noise.
          <div class="relative rounded-lg bg-muted/60">
            <pre class="scrollbar-none overflow-x-auto p-3 font-mono text-sm leading-relaxed max-h-102 scroll-fade overflow-y-auto whitespace-pre-wrap">${docs.prompt}</pre>
          </div>
          <Button type="button" variant="outline" size="sm" class="w-fit" on-click() { copyPrompt(); }>
            <if=hasCopiedPrompt>
              <svg data-icon="inline-start" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </if>
            <else>
              <svg data-icon="inline-start" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </else>
            Copy Prompt
          </Button>
        </div>
      </div>
    </@panel>
  </Tabs>
</div>
