// Faithful port of shadcn/ui's app/(app)/charts/layout.tsx (PageHeader +
// PageNav chrome) and app/(app)/charts/[type]/page.tsx (the 12-slot grid),
// merged into one tag mirroring blocks-gallery.marko's precedent — our
// router calls this the same way for /charts (type="area") and
// /charts/$type.
//
// shadcn's ChartDisplay/ChartToolbar/ChartIframe/ChartCodeViewer machinery
// (iframe preview + code viewer + copy button) is deliberately NOT ported —
// see the port-shadcn-resource task spec: it's non-visual site plumbing for
// their live-registry/v0 integration, not part of the visual parity target.
// Each grid cell just renders the demo's <Card> directly, same as our own
// /blocks gallery precedent but even simpler (no toolbar chrome at all).
//
// Static per-type <if> chain, NOT a dynamic-tag-by-id indirection: dynamic
// tags in route-reachable files crash production hydration (see the
// port-shadcn-resource skill's Marko 6 gotchas). Each type's fixed demo list
// is statically imported and rendered.
import "./charts-nav.marko";
import { buttonVariants } from "@marko-ui/shadcn/ui/button/variants.ts";
import { badgeVariants } from "@marko-ui/shadcn/ui/badge/variants.ts";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";
import { CHART_TYPES } from "../../lib/charts-list.ts";

import ChartAreaInteractive from "../../demos/charts-gallery/area/chart-area-interactive.marko";
import ChartAreaDefault from "../../demos/charts-gallery/area/chart-area-default.marko";
import ChartAreaLinear from "../../demos/charts-gallery/area/chart-area-linear.marko";
import ChartAreaStep from "../../demos/charts-gallery/area/chart-area-step.marko";
import ChartAreaLegend from "../../demos/charts-gallery/area/chart-area-legend.marko";
import ChartAreaStacked from "../../demos/charts-gallery/area/chart-area-stacked.marko";
import ChartAreaStackedExpand from "../../demos/charts-gallery/area/chart-area-stacked-expand.marko";
import ChartAreaIcons from "../../demos/charts-gallery/area/chart-area-icons.marko";
import ChartAreaGradient from "../../demos/charts-gallery/area/chart-area-gradient.marko";
import ChartAreaAxes from "../../demos/charts-gallery/area/chart-area-axes.marko";

import ChartBarInteractive from "../../demos/charts-gallery/bar/chart-bar-interactive.marko";
import ChartBarDefault from "../../demos/charts-gallery/bar/chart-bar-default.marko";
import ChartBarHorizontal from "../../demos/charts-gallery/bar/chart-bar-horizontal.marko";
import ChartBarMultiple from "../../demos/charts-gallery/bar/chart-bar-multiple.marko";
import ChartBarStacked from "../../demos/charts-gallery/bar/chart-bar-stacked.marko";
import ChartBarLabel from "../../demos/charts-gallery/bar/chart-bar-label.marko";
import ChartBarLabelCustom from "../../demos/charts-gallery/bar/chart-bar-label-custom.marko";
import ChartBarMixed from "../../demos/charts-gallery/bar/chart-bar-mixed.marko";
import ChartBarActive from "../../demos/charts-gallery/bar/chart-bar-active.marko";
import ChartBarNegative from "../../demos/charts-gallery/bar/chart-bar-negative.marko";

import ChartLineInteractive from "../../demos/charts-gallery/line/chart-line-interactive.marko";
import ChartLineDefault from "../../demos/charts-gallery/line/chart-line-default.marko";
import ChartLineLinear from "../../demos/charts-gallery/line/chart-line-linear.marko";
import ChartLineStep from "../../demos/charts-gallery/line/chart-line-step.marko";
import ChartLineMultiple from "../../demos/charts-gallery/line/chart-line-multiple.marko";
import ChartLineDots from "../../demos/charts-gallery/line/chart-line-dots.marko";
import ChartLineDotsCustom from "../../demos/charts-gallery/line/chart-line-dots-custom.marko";
import ChartLineDotsColors from "../../demos/charts-gallery/line/chart-line-dots-colors.marko";
import ChartLineLabel from "../../demos/charts-gallery/line/chart-line-label.marko";
import ChartLineLabelCustom from "../../demos/charts-gallery/line/chart-line-label-custom.marko";

import ChartPieSimple from "../../demos/charts-gallery/pie/chart-pie-simple.marko";
import ChartPieSeparatorNone from "../../demos/charts-gallery/pie/chart-pie-separator-none.marko";
import ChartPieLabel from "../../demos/charts-gallery/pie/chart-pie-label.marko";
import ChartPieLabelCustom from "../../demos/charts-gallery/pie/chart-pie-label-custom.marko";
import ChartPieLabelList from "../../demos/charts-gallery/pie/chart-pie-label-list.marko";
import ChartPieLegend from "../../demos/charts-gallery/pie/chart-pie-legend.marko";
import ChartPieDonut from "../../demos/charts-gallery/pie/chart-pie-donut.marko";
import ChartPieDonutActive from "../../demos/charts-gallery/pie/chart-pie-donut-active.marko";
import ChartPieDonutText from "../../demos/charts-gallery/pie/chart-pie-donut-text.marko";
import ChartPieStacked from "../../demos/charts-gallery/pie/chart-pie-stacked.marko";
import ChartPieInteractive from "../../demos/charts-gallery/pie/chart-pie-interactive.marko";

export interface Input {
  /** A CHART_TYPES slug; unrecognized values fall back to CHART_TYPES[0] (area). */
  type: string;
}

static const TOTAL_SLOTS = 12;
// shadcn's grid.map((_, index) => ...) empty-slot placeholder class, for any
// slot beyond a type's actual chart count (chart-pie-* has 11, the rest 10 —
// none of our 4 types reach 12, so every grid always shows at least one).
static const EMPTY_SLOT_CLASS = "hidden aspect-square w-full rounded-lg border border-dashed xl:block";
static const FULL_WIDTH_CLASS = "md:col-span-2 lg:col-span-3";

<const/typeEntry=(CHART_TYPES.find((entry) => entry.slug === input.type) ?? CHART_TYPES[0])/>
<const/typeLabel=(typeEntry.label.replace(" Charts", ""))/>

// ---- PageHeader (shadcn components/page-header.tsx, via charts/layout.tsx) ----
<section class="border-grid">
  <div class="container-wrapper">
    <div class="container flex flex-col items-center gap-2 px-6 py-8 text-center md:py-16 lg:py-20 xl:gap-4">
      <a href="/docs/changelog" class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
        <span data-slot="badge" class=cn(badgeVariants({ variant: "secondary" }), "bg-muted gap-1")>
          New Questionnaire component
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </span>
      </a>
      <h1 class="leading-tighter max-w-3xl text-3xl font-semibold tracking-tight text-balance text-primary lg:leading-[1.1] lg:font-semibold xl:text-5xl xl:tracking-tighter">
        Beautiful Charts &amp; Graphs
      </h1>
      <p class="max-w-4xl text-base text-balance text-foreground sm:text-lg">
        A collection of ready-to-use chart components built with d3. From basic charts to rich data displays, copy and paste into your apps.
      </p>
      <div class="flex w-full items-center justify-center gap-2 pt-2 **:data-[slot=button]:shadow-none">
        <a href="#charts" data-slot="button" class=buttonVariants({ size: "sm" })>Browse Charts</a>
        <a href="/docs/components/chart" data-slot="button" class=buttonVariants({ variant: "ghost", size: "sm" })>Documentation</a>
      </div>
    </div>
  </div>
</section>

// ---- PageNav (shadcn components/page-nav.tsx) ----
<div id="charts" class="container-wrapper scroll-mt-24">
  <div class="container flex items-center justify-between gap-4 py-4">
    <charts-nav activeSlug=typeEntry.slug/>
  </div>
</div>

// ---- Chart grid (shadcn app/(app)/charts/[type]/page.tsx) ----
<div class="container-wrapper flex-1">
  <div class="container pb-6">
    <section class="theme-container">
      <div class="grid flex-1 gap-12 lg:gap-24">
        <h2 class="sr-only">${typeLabel} Charts</h2>
        <div class="grid flex-1 scroll-mt-20 items-stretch gap-10 md:grid-cols-2 md:gap-6 lg:grid-cols-3 xl:gap-10">
          <if=(typeEntry.slug === "area")>
            <div class=FULL_WIDTH_CLASS><ChartAreaInteractive/></div>
            <ChartAreaDefault/>
            <ChartAreaLinear/>
            <ChartAreaStep/>
            <ChartAreaLegend/>
            <ChartAreaStacked/>
            <ChartAreaStackedExpand/>
            <ChartAreaIcons/>
            <ChartAreaGradient/>
            <ChartAreaAxes/>
            <for|index| of=Array.from({ length: TOTAL_SLOTS - 10 })>
              <div class=EMPTY_SLOT_CLASS></div>
            </for>
          </if>
          <else if=(typeEntry.slug === "bar")>
            <div class=FULL_WIDTH_CLASS><ChartBarInteractive/></div>
            <ChartBarDefault/>
            <ChartBarHorizontal/>
            <ChartBarMultiple/>
            <ChartBarStacked/>
            <ChartBarLabel/>
            <ChartBarLabelCustom/>
            <ChartBarMixed/>
            <ChartBarActive/>
            <ChartBarNegative/>
            <for|index| of=Array.from({ length: TOTAL_SLOTS - 10 })>
              <div class=EMPTY_SLOT_CLASS></div>
            </for>
          </else>
          <else if=(typeEntry.slug === "line")>
            <div class=FULL_WIDTH_CLASS><ChartLineInteractive/></div>
            <ChartLineDefault/>
            <ChartLineLinear/>
            <ChartLineStep/>
            <ChartLineMultiple/>
            <ChartLineDots/>
            <ChartLineDotsCustom/>
            <ChartLineDotsColors/>
            <ChartLineLabel/>
            <ChartLineLabelCustom/>
            <for|index| of=Array.from({ length: TOTAL_SLOTS - 10 })>
              <div class=EMPTY_SLOT_CLASS></div>
            </for>
          </else>
          <else>
            <ChartPieSimple/>
            <ChartPieSeparatorNone/>
            <ChartPieLabel/>
            <ChartPieLabelCustom/>
            <ChartPieLabelList/>
            <ChartPieLegend/>
            <ChartPieDonut/>
            <ChartPieDonutActive/>
            <ChartPieDonutText/>
            <ChartPieStacked/>
            <ChartPieInteractive/>
            <for|index| of=Array.from({ length: TOTAL_SLOTS - 11 })>
              <div class=EMPTY_SLOT_CLASS></div>
            </for>
          </else>
        </div>
      </div>
    </section>
  </div>
</div>
