export interface Input {
  title: string;
  description?: string;
  content?: Marko.Body;
}

<main class="mx-auto max-w-3xl space-y-8 p-8">
  <a href="/" class="text-sm text-muted-foreground hover:underline">← marko-ui</a>
  <div>
    <h1 class="text-2xl font-bold">${input.title}</h1>
    <if=input.description>
      <p class="mt-1 text-muted-foreground">${input.description}</p>
    </if>
  </div>
  <${input.content}/>
</main>
