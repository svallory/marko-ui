// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/styles/rhea/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/styles/rhea/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/styles/rhea/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/styles/rhea/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/styles/rhea/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/styles/rhea/ui/card/footer.marko";
import ItemGroup from "@marko-ui/shadcn/styles/rhea/ui/item/group.marko";
import Item from "@marko-ui/shadcn/styles/rhea/ui/item/item.marko";
import ItemContent from "@marko-ui/shadcn/styles/rhea/ui/item/content.marko";
import ItemDescription from "@marko-ui/shadcn/styles/rhea/ui/item/description.marko";
import ItemFooter from "@marko-ui/shadcn/styles/rhea/ui/item/footer.marko";
import Progress from "@marko-ui/shadcn/styles/rhea/ui/progress/progress.marko";

static const TARGETS = [
  {
    label: "Retirement",
    total: "$420,000",
    percent: 65,
    saved: "$273,000",
  },
  {
    label: "Real Estate",
    total: "$85,000",
    percent: 32,
    saved: "$27,200",
  },
];

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Savings Targets</CardTitle>
    <CardDescription>
      Active milestones for 2024 across your portfolio. Monitor how close you
      are to each savings goal.
    </CardDescription>
  </CardHeader>
  <CardContent>
    <ItemGroup class="gap-3">
      <for|target| of=TARGETS by=(target) => target.label>
        <Item role="listitem" variant="muted" class="flex-col items-stretch">
          <ItemContent class="gap-3">
            <ItemDescription class="text-muted-foreground text-xs font-medium tracking-wider uppercase">
              ${target.label}
            </ItemDescription>
            <span class="text-3xl font-semibold tabular-nums">${target.total}</span>
            <Progress
              value=target.percent
              aria-label=`${target.label} savings progress`
            />
          </ItemContent>
          <ItemFooter>
            <span class="text-muted-foreground text-sm">${target.percent}% achieved</span>
            <span class="text-sm font-medium tabular-nums">${target.saved}</span>
          </ItemFooter>
        </Item>
      </for>
    </ItemGroup>
  </CardContent>
  <CardFooter>
    <CardDescription class="text-center">
      You have not met your targets for this year.
    </CardDescription>
  </CardFooter>
</Card>
