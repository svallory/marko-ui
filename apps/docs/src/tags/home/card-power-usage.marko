// Adapted from shadcn/ui `app/(app)/(root)/cards/power-usage.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import Separator from "@marko-ui/shadcn/ui/separator/separator.marko";

static const CHART_DATA = [
  { hour: "6a", usage: 1.2 },
  { hour: "8a", usage: 2.8 },
  { hour: "10a", usage: 3.1 },
  { hour: "12p", usage: 2.4 },
  { hour: "2p", usage: 3.4 },
  { hour: "4p", usage: 2.9 },
  { hour: "6p", usage: 3.8 },
  { hour: "8p", usage: 3.2 },
];

static const MAX_USAGE = Math.max(...CHART_DATA.map((entry) => entry.usage));

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Power Usage</CardTitle>
    <CardDescription>Whole Home</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <div
      class="flex h-[140px] w-full items-end gap-2"
      role="img"
      aria-label="Power usage by hour"
    >
      <for|entry| of=CHART_DATA by=(entry) => entry.hour>
        <div class="flex h-full flex-1 flex-col justify-end gap-1.5">
          <div
            class="bg-chart-2 min-h-2 rounded-t"
            style={ height: `${(entry.usage / MAX_USAGE) * 100}%` }
          />
          <span class="text-muted-foreground text-center text-xs">${entry.hour}</span>
        </div>
      </for>
    </div>
    <Separator/>
    <div class="grid grid-cols-2 gap-4">
      <div class="flex flex-col gap-0.5">
        <span class="text-muted-foreground text-sm">Currently Using</span>
        <span class="text-lg font-semibold tabular-nums">3.4 kW</span>
      </div>
      <div class="flex flex-col gap-0.5">
        <span class="text-muted-foreground text-sm">Solar Gen</span>
        <span class="text-lg font-semibold tabular-nums">+1.2 kW</span>
      </div>
    </div>
  </CardContent>
</Card>
