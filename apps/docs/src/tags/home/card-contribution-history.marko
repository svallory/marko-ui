// (MIT), rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/styles/rhea/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/styles/rhea/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/styles/rhea/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/styles/rhea/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/styles/rhea/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/styles/rhea/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/styles/rhea/ui/button/button.marko";
import Item from "@marko-ui/shadcn/styles/rhea/ui/item/item.marko";
import ItemContent from "@marko-ui/shadcn/styles/rhea/ui/item/content.marko";
import ItemDescription from "@marko-ui/shadcn/styles/rhea/ui/item/description.marko";

static const CHART_DATA = [
  { month: "Dec", amount: 800 },
  { month: "Jan", amount: 1100 },
  { month: "Feb", amount: 900 },
  { month: "Mar", amount: 1300 },
  { month: "Apr", amount: 750 },
];

static const MAX_AMOUNT = Math.max(...CHART_DATA.map((entry) => entry.amount));

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Contribution History</CardTitle>
    <CardDescription>Last 6 months of activity</CardDescription>
  </CardHeader>
  <CardContent>
    <div
      class="flex h-[200px] w-full items-end gap-3"
      role="img"
      aria-label="Last 6 months of contribution activity"
    >
      <for|entry, index| of=CHART_DATA by=(entry) => entry.month>
        <div class="flex h-full flex-1 flex-col justify-end gap-2">
          <div
            data-index=String(index)
            class="min-h-2 rounded-lg data-[index=0]:bg-chart-1 data-[index=1]:bg-chart-2 data-[index=2]:bg-chart-3 data-[index=3]:bg-chart-4 data-[index=4]:bg-chart-5"
            style={ height: `${(entry.amount / MAX_AMOUNT) * 100}%` }
          />
          <span class="text-muted-foreground text-center text-xs">${entry.month}</span>
        </div>
      </for>
    </div>
  </CardContent>
  <CardContent>
    <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2">
      <Item variant="muted" class="flex-col items-stretch">
        <ItemContent class="gap-1">
          <ItemDescription class="text-muted-foreground text-xs font-medium tracking-wider uppercase">
            Upcoming
          </ItemDescription>
          <span class="text-base font-semibold">May 2024</span>
          <span class="text-muted-foreground text-sm">Scheduled</span>
        </ItemContent>
      </Item>
      <Item variant="muted" class="flex-col items-stretch">
        <ItemContent class="gap-1">
          <ItemDescription class="text-muted-foreground text-xs font-medium tracking-wider uppercase">
            Savings Plan
          </ItemDescription>
          <span class="text-base font-semibold">Accelerated</span>
          <span class="text-muted-foreground text-sm">Recurring</span>
        </ItemContent>
      </Item>
    </div>
  </CardContent>
  <CardFooter>
    <Button class="w-full">View Full Report</Button>
  </CardFooter>
</Card>
