// Adapted from shadcn/ui `app/(app)/(root)/cards/notification-settings.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Checkbox from "@marko-ui/shadcn/ui/checkbox/checkbox.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldContent from "@marko-ui/shadcn/ui/field/field-content.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";

static const NOTIFICATIONS = [
  {
    id: "releases",
    label: "New releases",
    description: "Components added to the registry.",
    defaultChecked: true,
  },
  {
    id: "breaking",
    label: "Breaking changes",
    description: "API changes that need a migration.",
    defaultChecked: true,
  },
  {
    id: "digest",
    label: "Weekly digest",
    description: "A summary of everything that shipped.",
    defaultChecked: false,
  },
];

<Card class="w-full">
  <CardHeader>
    <CardTitle>Notifications</CardTitle>
    <CardDescription>Choose which updates you want to receive.</CardDescription>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <for|notification| of=NOTIFICATIONS by=(notification) => notification.id>
        <Field orientation="horizontal">
          <Checkbox
            id=`notify-${notification.id}`
            defaultChecked=notification.defaultChecked
          />
          <FieldContent>
            <FieldLabel for=`notify-${notification.id}`>${notification.label}</FieldLabel>
            <FieldDescription>${notification.description}</FieldDescription>
          </FieldContent>
        </Field>
      </for>
    </FieldGroup>
  </CardContent>
  <CardFooter>
    <Button class="w-full" size="sm">Save preferences</Button>
  </CardFooter>
</Card>
