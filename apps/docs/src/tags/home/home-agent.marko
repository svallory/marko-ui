            <CardContent class="flex flex-col gap-4">
              // 4-step numbered stepper with connecting lines. <ol> for real
              // list semantics — <ol> only permits <li> children, so the
              // connector is a CSS ::before on each non-first <li> (an
              // absolutely positioned line reaching back to the previous
              // circle) rather than a DOM sibling, keeping the circle+label
              // column's own flex layout undisturbed by the connector's
              // width. The line's ::before is a later sibling of the
              // PREVIOUS <li>'s circle in paint order (both z-index:auto,
              // painted in DOM order), so without an explicit stacking
              // order it draws on top of that circle instead of stopping at
              // its edge — hence the circle needs `relative z-10` (not just
              // `relative`) to guarantee it paints above every connector.
              <ol class="flex items-start justify-between">
                <for|step, index| of=STEPS>
                  <li
                    class=`relative flex flex-1 flex-col items-center gap-1.5 ${index > 0 ? "before:absolute before:right-1/2 before:top-3.5 before:h-px before:w-full before:-translate-x-3.5 before:bg-border" : ""}`
                  >
                    <span class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-xs font-semibold text-background tabular-nums">
                      ${step.n}
                    </span>
                    <span class="text-xs whitespace-nowrap text-muted-foreground">${step.label}</span>
                  </li>
                </for>
              </ol>

