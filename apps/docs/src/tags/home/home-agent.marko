import CardContent from "@marko-ui/shadcn/ui/card/content.marko";

// The Counter example, byte-identical to component-party.dev's own source
// (content/2-templating/4-event-click/{react/Counter.jsx,marko/Counter.marko}
// on github.com/matschik/component-party.dev, main branch — fetched and
// diffed 2026-09-25; both include their trailing newline, which is why each
// literal ends with `\n` before the closing backtick). Line/byte counts
// below are DERIVED from these literals at module scope, never hand-typed,
// so the labels can never drift from what's actually shown.
static const REACT_CODE = `import { useState } from "react";

export default function Counter() {
  const [count, setCount] = useState(0);

  function incrementCount() {
    setCount((count) => count + 1);
  }

  return (
    <>
      <p>Counter: {count}</p>
      <button onClick={incrementCount}>+1</button>
    </>
  );
}
`;

static const MARKO_CODE = `<let/count=0>
<p>Counter: \${count}</p>
<button onClick() { count++ }>+1</button>
`;

// Derived, not hand-typed: byteLength/lines always match what's rendered.
// TextEncoder, not Buffer.byteLength — this module is imported at module
// scope by a client-compiled tag path (same reasoning as highlight-code.ts's
// own header comment on why it avoids node:crypto: Buffer is a Node global,
// unavailable in the browser bundle, and would throw on first access there).
// TextEncoder is a Web/Node-common API and gives the identical UTF-8 byte
// count.
static const REACT_BYTES = new TextEncoder().encode(REACT_CODE).length;
static const REACT_LINES = REACT_CODE.split("\n").length - 1; // trailing \n
static const MARKO_BYTES = new TextEncoder().encode(MARKO_CODE).length;
static const MARKO_LINES = MARKO_CODE.split("\n").length - 1; // trailing \n
static const SIZE_RATIO = (REACT_BYTES / MARKO_BYTES).toFixed(1);

static const STEPS = [
  { n: 1, label: "Inventory" },
  { n: 2, label: "Port" },
  { n: 3, label: "Verify" },
  { n: 4, label: "Publish" },
] as const;

