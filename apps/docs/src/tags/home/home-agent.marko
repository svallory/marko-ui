//   React  Counter.jsx   — 16 lines / 298 B
//   Marko  Counter.marko — 3 lines / 81 B
static const REACT_CODE = `import { useState } from "react";

export default function Counter() {
  const [count, setCount] = useState(0);

  function increment() {
    setCount(count + 1);
  }

  return (
    <>
      <p>Counter: {count}</p>
      <button onClick={increment}>+1</button>
    </>
  );
}`;

static const MARKO_CODE = `<let/count=0/>
<p>Counter: \${count}</p>
<button onClick(){ count++ }>+1</button>`;

