// Layout adapted from shadcn/ui `app/(app)/(root)/cards/index.tsx` (MIT):
// a dense, full-width multi-column masonry of real interactive demo cards,
// on a muted section background with a top gradient wash, decorative
// skeleton "rails" flanking the grid past ~2200px, and a bottom fade. Every
// real card below is a rebuild of the same-named shadcn card on marko-ui's
// own registry components; the rails reuse a small set of representative
// skeleton shapes (see rail-card.marko) rather than porting all sixteen.
import CardUiElements from "./card-ui-elements.marko";
import CardSidebarNav from "./card-sidebar-nav.marko";
import CardSavingsTargets from "./card-savings-targets.marko";
import CardContributionHistory from "./card-contribution-history.marko";
import CardClaimableBalance from "./card-claimable-balance.marko";
import CardDividendIncome from "./card-dividend-income.marko";
import CardNewMilestone from "./card-new-milestone.marko";
import CardPayoutThreshold from "./card-payout-threshold.marko";
import CardAccountAccess from "./card-account-access.marko";
import CardQrConnect from "./card-qr-connect.marko";
import CardMessageScroller from "./card-message-scroller.marko";
import CardPayments from "./card-payments.marko";
import CardEmptyDistribute from "./card-empty-distribute.marko";
import CardAnalytics from "./card-analytics.marko";
import CardNotifications from "./card-notifications.marko";
import CardPowerUsage from "./card-power-usage.marko";
import RailCard from "./rail-card.marko";

// min-w-0 on every column: grid tracks default to min-width:auto, which lets
// wide children (the install command <pre>, the QR svg) push the track past
// the viewport instead of scrolling inside their own box.
<!-- Wrapper classes verbatim from shadcn CardsDemo (cards/index.tsx),
     including theme-neutral: legacy-themes.css remaps --chart-* (and friends)
     to neutral grays inside it — this is why shadcn's homepage charts render
     gray even though :root's chart palette is blue. -->
<section
  id="components"
  data-slot="demo"
  class="style-rhea theme-neutral relative flex w-full max-w-none flex-col gap-(--gap) overflow-hidden bg-muted p-12 pb-0! [--gap:--spacing(8)] 3xl:[--gap:--spacing(8)] min-[1900px]:p-12 min-[1900px]:[--gap:--spacing(10)]! lg:p-6 lg:[--gap:--spacing(6)] dark:bg-background"
>
  <!-- Decorative skeleton rails: shadcn shows these past min-[2200px] only,
       muted and non-interactive, to suggest a much larger component grid
       continuing off-screen. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-8 z-0 hidden min-[2200px]:block"
  >
    <div class="absolute top-0 left-[calc(50%-950px-21rem)] grid w-80 grid-cols-1 gap-6 opacity-40">
      <RailCard variant="chart"/>
      <RailCard variant="list"/>
      <RailCard variant="header-form"/>
    </div>
    <div class="absolute top-0 right-[calc(50%-950px-21rem)] grid w-80 grid-cols-1 gap-6 opacity-40">
      <RailCard variant="qr"/>
      <RailCard variant="tiles"/>
      <RailCard variant="profile"/>
    </div>
  </div>

  <!-- Grid + column classes verbatim from shadcn CardsDemo. Column contents
       match shadcn's card-for-card: column 4 carries our CardMessageScroller
       port (wrapped in the same text-center/text-xs-hiding div as shadcn's
       MessageScrollerDemo slot). CardComponentStats and CardInstall removed
       from column 5 per site polish. -->
  <div class="relative z-10 mx-auto grid gap-(--gap) **:data-[slot=card]:w-full min-[1400px]:grid-cols-4! min-[1900px]:grid-cols-5! md:max-w-3xl md:grid-cols-2 lg:max-w-none lg:grid-cols-3 xl:max-w-[1600px] 2xl:max-w-[1900px]">
    <div class="flex flex-col items-start gap-(--gap)">
      <CardUiElements/>
      <CardSidebarNav/>
      <CardSavingsTargets/>
    </div>
    <div class="hidden flex-col gap-(--gap) lg:flex">
      <CardContributionHistory/>
      <CardClaimableBalance/>
      <CardDividendIncome/>
    </div>
    <div class="hidden flex-col gap-(--gap) min-[1400px]:flex">
      <CardNewMilestone/>
      <CardPayoutThreshold/>
      <CardAccountAccess/>
    </div>
    <div class="hidden flex-col gap-(--gap) md:flex">
      <CardQrConnect/>
      <div class="**:[.text-center.text-xs]:hidden">
        <CardMessageScroller/>
      </div>
      <CardPayments/>
    </div>
    <div class="hidden flex-col gap-(--gap) min-[1900px]:flex">
      <CardEmptyDistribute/>
      <CardAnalytics/>
      <CardNotifications/>
      <CardPowerUsage/>
    </div>
  </div>

  <!-- Top-light gradient wash: the section background bleeds from the page
       background into the muted showcase tone. Light-mode only, like
       shadcn's own (their dark variant relies on bg-background already
       matching the wash, so it is simply hidden). -->
  <div class="absolute inset-x-0 top-0 z-1 h-120 bg-linear-to-b from-background via-muted to-transparent dark:hidden"/>

  <!-- Bottom fade: the grid dissolves into transparent at the section's
       lower edge instead of ending on a hard line. -->
  <div class="absolute inset-x-0 bottom-0 z-20 h-48 bg-linear-to-t from-background via-muted/80 to-transparent lg:h-80 xl:h-64 dark:via-background/80"/>
</section>
