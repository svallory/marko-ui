// Layout adapted from shadcn/ui `app/(app)/(root)/cards/index.tsx` (MIT).
// The decorative skeleton "rails" are intentionally dropped.
import "./card-ui-elements.marko";
import "./card-analytics.marko";
import "./card-notifications.marko";
import "./card-install.marko";
import "./card-component-stats.marko";

<section
  id="components"
  data-slot="home-showcase"
  class="relative w-full overflow-hidden bg-muted p-6 lg:p-10 dark:bg-background"
>
  <div class="relative z-10 mx-auto grid max-w-6xl gap-6 md:grid-cols-2 xl:grid-cols-3">
    // min-w-0 on every column: grid tracks default to min-width:auto, which
    // lets wide children (the install command <pre>) push the track past the
    // viewport instead of scrolling inside their own box.
    <div class="flex min-w-0 flex-col gap-6">
      <card-ui-elements/>
    </div>
    <div class="flex min-w-0 flex-col gap-6">
      <card-notifications/>
      <card-analytics/>
    </div>
    <div class="flex min-w-0 flex-col gap-6 md:col-span-2 xl:col-span-1">
      <card-install/>
      <card-component-stats/>
    </div>
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-24 bg-linear-to-t from-background to-transparent"
  />
</section>
