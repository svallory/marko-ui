// Adapted from shadcn/ui `app/(app)/(root)/cards/new-milestone.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Input from "@marko-ui/registry/ui/input/input.marko";
import Label from "@marko-ui/registry/ui/label/label.marko";

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Set a new milestone</CardTitle>
    <CardDescription>
      Define your financial target and we'll help you pace your savings.
    </CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <div class="grid gap-2">
      <Label for="milestone-goal-name">Goal Name</Label>
      <Input id="milestone-goal-name" placeholder="e.g. New Car, Home Downpayment"/>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div class="grid gap-2">
        <Label for="milestone-target-amount">Target Amount</Label>
        <Input id="milestone-target-amount" value="$15,000"/>
      </div>
      <div class="grid gap-2">
        <Label for="milestone-target-date">Target Date</Label>
        <Input id="milestone-target-date" value="Dec 2025"/>
      </div>
    </div>
  </CardContent>
  <CardFooter class="flex-col gap-2">
    <Button class="w-full">Create Goal</Button>
    <Button variant="outline" class="w-full">Cancel</Button>
  </CardFooter>
</Card>
