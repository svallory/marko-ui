// Adapted from shadcn/ui `app/(app)/(root)/cards/payout-threshold.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardAction from "@marko-ui/registry/ui/card/action.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Select from "@marko-ui/registry/ui/select/select.marko";
import Slider from "@marko-ui/registry/ui/slider/slider.marko";
import Textarea from "@marko-ui/registry/ui/textarea/textarea.marko";
import Label from "@marko-ui/registry/ui/label/label.marko";

static const CURRENCIES = [
  { value: "usd", label: "USD — United States Dollar" },
  { value: "eur", label: "EUR — Euro" },
  { value: "gbp", label: "GBP — British Pound" },
  { value: "jpy", label: "JPY — Japanese Yen" },
];

// The shadcn original renders a static Progress bar for the payout amount.
// Here it is a real Slider so the value is actually draggable.
<let/payoutAmount=[2500]/>

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Payout Threshold</CardTitle>
    <CardDescription>
      Set the minimum balance required before a payout is triggered.
    </CardDescription>
    <CardAction>
      <Button
        variant="ghost"
        size="icon"
        class="bg-muted size-8"
        aria-label="Dismiss payout threshold"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </Button>
    </CardAction>
  </CardHeader>
  <CardContent class="flex flex-col gap-5">
    <div class="grid gap-2">
      <Select
        items=CURRENCIES
        defaultValue=["usd"]
        label="Preferred Currency"
        class="w-full [&_[data-slot=select-trigger]]:w-full"
      />
    </div>

    <div class="grid gap-3">
      <div class="flex items-baseline justify-between">
        <Label id="min-payout-label">Minimum Payout Amount</Label>
        <span class="text-2xl font-semibold tabular-nums">
          $${payoutAmount[0].toLocaleString("en-US")}.00
        </span>
      </div>
      <Slider
        value:=payoutAmount
        min=50
        max=10000
        step=50
        aria-labelledby="min-payout-label"
      />
      <div class="text-muted-foreground flex items-center justify-between text-sm">
        <span>$50 (MIN)</span>
        <span>$10,000 (MAX)</span>
      </div>
    </div>

    <div class="grid gap-2">
      <Label for="payout-notes">Notes</Label>
      <Textarea
        id="payout-notes"
        placeholder="Add any notes for this payout configuration..."
        class="min-h-[100px]"
      />
    </div>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Save Threshold</Button>
  </CardFooter>
</Card>
