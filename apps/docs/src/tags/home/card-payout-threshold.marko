// Adapted from shadcn/ui `app/(app)/(root)/cards/payout-threshold.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/styles/rhea/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/styles/rhea/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/styles/rhea/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/styles/rhea/ui/card/description.marko";
import CardAction from "@marko-ui/shadcn/styles/rhea/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/styles/rhea/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/styles/rhea/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/styles/rhea/ui/button/button.marko";
import Select from "@marko-ui/shadcn/styles/rhea/ui/select/select.marko";
import Progress from "@marko-ui/shadcn/styles/rhea/ui/progress/progress.marko";
import Textarea from "@marko-ui/shadcn/styles/rhea/ui/textarea/textarea.marko";
import Field from "@marko-ui/shadcn/styles/rhea/ui/field/field.marko";
import FieldDescription from "@marko-ui/shadcn/styles/rhea/ui/field/field-description.marko";
import FieldGroup from "@marko-ui/shadcn/styles/rhea/ui/field/field-group.marko";
import FieldLabel from "@marko-ui/shadcn/styles/rhea/ui/field/field-label.marko";

static const CURRENCIES = [
  { value: "usd", label: "USD — United States Dollar" },
  { value: "eur", label: "EUR — Euro" },
  { value: "gbp", label: "GBP — British Pound" },
  { value: "jpy", label: "JPY — Japanese Yen" },
];

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Payout Threshold</CardTitle>
    <CardDescription>
      Set the minimum balance required before a payout is triggered.
    </CardDescription>
    <CardAction>
      <Button
        variant="ghost"
        size="icon"
        class="bg-muted size-8"
        aria-label="Dismiss payout threshold"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </Button>
    </CardAction>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <Field>
        <FieldLabel for="preferred-currency">Preferred Currency</FieldLabel>
        <Select
          items=CURRENCIES
          defaultValue=["usd"]
          class="w-full [&_[data-slot=select-trigger]]:w-full"
        />
      </Field>

      <Field>
        <div class="flex items-baseline justify-between">
          <FieldLabel id="min-payout-label">Minimum Payout Amount</FieldLabel>
          <span class="text-2xl font-semibold tabular-nums">
            $2500.00
          </span>
        </div>
        <Progress
          value=25
          aria-labelledby="min-payout-label"
          aria-valuetext="$2,500 of $10,000"
        />
        <div class="flex items-center justify-between">
          <FieldDescription>$50 (MIN)</FieldDescription>
          <FieldDescription>$10,000 (MAX)</FieldDescription>
        </div>
      </Field>

      <Field>
        <FieldLabel for="payout-notes">Notes</FieldLabel>
        <Textarea
          id="payout-notes"
          placeholder="Add any notes for this payout configuration..."
          class="min-h-[100px]"
        />
      </Field>
    </FieldGroup>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Save Threshold</Button>
  </CardFooter>
</Card>
