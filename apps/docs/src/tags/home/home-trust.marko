// Trust strip between the hero and the showcase: static cards written as
// plain markup, styled by the `home-trust-*` classes in the style block below
// (Tailwind @apply, so utilities stay the single source of design values).
//   - Identity facts (component/style counts, no-JS rendering, license),
//     maintained by hand next to their sources — see the COMPONENTS import and
//     the VISUAL_STYLES const below.
//   - Quality claims (WCAG scan, Lighthouse accessibility): the values are CI
//     gates (axe: 0 means 0; Lighthouse floors in .github/lighthouse) — if a
//     gate is ever loosened, edit them here. No network fetch; live badges
//     for the repo live on the README (`badges-main`).
//
// Hero-stat-size cards — 3 across on desktop, 2 across on mobile. ALL use the real <Card>
// component so they look identical in every registry style (radius/ring/bg
// are per-style tokens baked into Card's own class list — a hand-rolled
// `<a class="rounded-xl border ...">` drifts from Card the moment a style
// changes those values, which is exactly what happened here before: the
// linked two receipts (components, styles) were plain anchors with
// hardcoded rounded-xl/border/bg-muted, while the other two used <Card> —
// verified mismatched in lyra/sera (rounded-none) and luma (rounded-4xl)
// via the /create style switcher). A linked receipt's <Card> contains a
// stretched-link <a> (position: absolute, inset-0, z-10 — a real element,
// not a ::before/::after pseudo, so its href/title/rel stay on a real
// anchor) so the whole card is the click target while Card supplies all
// visible chrome.
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import { COMPONENTS } from "../../lib/components-list.ts";

static const REPO = "https://github.com/svallory/marko-ui";

// Mirrors VISUAL_STYLES in packages/marko-ui/src/registry/constants.ts (the
// registry's actual source of truth) — apps/docs has no dependency on that
// package (marko-ui/registry needs a built dist/), so this is maintained by
// hand next to its source, same as COMPONENTS above. .length is DERIVED
// from the array, never a hardcoded number, so a future style addition or
// removal here can't silently desync the label from the list beside it.
// 9 real ports incl. new-york; there is no extra "default"/fallback style
// (see constants.ts's own FALLBACK_STYLE comment).
static const VISUAL_STYLES = [
  "rhea", "nova", "vega", "lyra", "maia", "mira", "luma", "sera", "new-york",
] as const;

<section aria-label="Project quality receipts" class="home-trust">
  <div class="home-trust-inner">
    <div class="home-trust-grid">
      // Linked cards carry a stretched-link <a> (real element, absolute
      // inset-0) so the whole card is the click target while <Card> keeps
      // supplying radius/bg per registry style.
      <Card class="home-trust-card">
        <a
          class="home-trust-link"
          href=`${REPO}/tree/main/packages/shadcn/ui`
          target="_blank"
          rel="noreferrer"
          title="The full registry — every component in readable .marko source"
        >
          <span class="sr-only">${COMPONENTS.length} components</span>
        </a>
        <span class="home-trust-value">${COMPONENTS.length}</span>
        <span class="home-trust-label">components</span>
      </Card>
      <Card class="home-trust-card">
        <a
          class="home-trust-link"
          href=`${REPO}/tree/main/packages/shadcn/styles`
          target="_blank"
          rel="noreferrer"
          title="9 complete style ports — rhea, nova, vega, lyra, maia, mira, luma, sera, new-york"
        >
          <span class="sr-only">${VISUAL_STYLES.length} styles</span>
        </a>
        <span class="home-trust-value">${VISUAL_STYLES.length}</span>
        <span class="home-trust-label">styles</span>
      </Card>
      <Card class="home-trust-card">
        <span class="home-trust-value">0 JS</span>
        <span class="home-trust-label">needed to render</span>
      </Card>
      <Card class="home-trust-card">
        <a
          class="home-trust-link"
          href=`${REPO}/blob/main/scripts/ci/axe-scan.ts`
          target="_blank"
          rel="noreferrer"
          title="axe-core WCAG 2.2 A/AA scan across every component demo page — CI fails on any violation"
        >
          <span class="sr-only">0 WCAG 2.2 AA violations</span>
        </a>
        <span class="home-trust-value">0</span>
        <span class="home-trust-label">WCAG 2.2 AA<br>violations</span>
      </Card>
      <Card class="home-trust-card">
        <a
          class="home-trust-link"
          href=`${REPO}/actions/workflows/lighthouse.yml`
          target="_blank"
          rel="noreferrer"
          title="Lighthouse accessibility score on component pages"
        >
          <span class="sr-only">100 Lighthouse accessibility</span>
        </a>
        <span class="home-trust-value">100</span>
        <span class="home-trust-label">Lighthouse<br>accessibility</span>
      </Card>
      // Text-only: sized to fit its card on one line at every breakpoint.
      <Card class="home-trust-card home-trust-card-text">
        <span class="home-trust-label home-trust-label-line">MIT License</span>
      </Card>
    </div>
  </div>
</section>

<style>
  @reference "../../app.css";

  .home-trust {
    @apply border-y border-border/60 bg-background;
  }
  .home-trust-inner {
    @apply mx-auto max-w-5xl px-6 py-8;
  }
  .home-trust-grid {
    @apply grid grid-cols-2 gap-3 sm:grid-cols-3;
  }
  .home-trust-card {
    @apply relative flex flex-col items-center justify-center gap-1 border-0 bg-muted/50 px-4 py-6 text-center shadow-none ring-0;
  }
  .home-trust-card-text {
    @apply min-w-0 gap-0;
  }
  .home-trust-link {
    @apply absolute inset-0 z-10 rounded-[inherit] outline-none focus-visible:ring-2 focus-visible:ring-ring;
  }
  .home-trust-value {
    @apply font-martian text-4xl font-bold tracking-tight text-foreground tabular-nums sm:text-5xl;
  }
  .home-trust-label {
    @apply text-xl font-bold tracking-tight text-foreground sm:text-2xl mt-2;
  }
  .home-trust-label-line {
    @apply w-full truncate whitespace-nowrap;
  }
</style>
