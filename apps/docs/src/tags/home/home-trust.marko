// Trust strip between the hero and the showcase. Two kinds of proof, no
// overlap:
//   - RECEIPTS: identity facts about the library (component/style counts,
//     no-JS rendering), maintained by hand next to their sources:
//       COMPONENTS: dirs in packages/shadcn/ui
//       STYLES:     default + style-*.css in packages/shadcn/styles
//   - BADGES: live shields.io endpoint images fed by CI (the `badges` branch
//     is rewritten on every green main build) — checks, WCAG scan, Lighthouse
//     accessibility. Their numbers update themselves; never restate them as
//     receipts.
static const REPO = "https://github.com/svallory/marko-ui";

static const RECEIPTS = [
  {
    value: "86",
    label: "components",
    title: "The full registry — every component in readable .marko source",
    href: `${REPO}/tree/main/packages/shadcn/ui`,
  },
  {
    value: "9",
    label: "styles",
    title: "The default style plus 8 complete ports",
    href: `${REPO}/tree/main/packages/shadcn/styles`,
  },
] as const;

static const BADGE_ENDPOINT = (name: string) =>
  `https://img.shields.io/endpoint?url=${encodeURIComponent(
    `https://raw.githubusercontent.com/svallory/marko-ui/badges/${name}.json`,
  )}`;

static const BADGES = [
  {
    alt: "Tests passing (behavior, hydration, and style-matrix suites)",
    title: "Behavior, hydration, and style-matrix suites — run on every push",
    src: BADGE_ENDPOINT("checks-count"),
    href: `${REPO}/actions/workflows/ci.yml`,
  },
  {
    alt: "WCAG 2.2 AA automated scan: 0 violations",
    title:
      "axe-core WCAG 2.2 A/AA scan across every component demo page — CI fails on any violation",
    src: BADGE_ENDPOINT("axe"),
    href: `${REPO}/blob/main/scripts/ci/axe-scan.ts`,
  },
  {
    alt: "Lighthouse accessibility 100 on component pages",
    title: "Minimum Lighthouse accessibility score across audited component pages",
    src: BADGE_ENDPOINT("lighthouse-accessibility"),
    href: `${REPO}/actions/workflows/lighthouse.yml`,
  },
  // OpenSSF Scorecard deliberately absent: the pipeline runs weekly, but at
  // 3.8/10 (new repo — no branch protection, unpinned actions) the badge
  // reads as a warning, not a receipt. Add it back once the score is earned.
] as const;

<section
  aria-label="Project quality receipts"
  class="border-y border-border/60 bg-background"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center px-6 py-5">
    <for|receipt, index| of=RECEIPTS>
      <a
        href=receipt.href
        target="_blank"
        rel="noreferrer"
        title=receipt.title
        class=`group flex min-w-32 flex-col items-center gap-0.5 px-6 py-1 text-center outline-none focus-visible:rounded-md focus-visible:ring-2 focus-visible:ring-ring ${index > 0 ? "border-s border-border/60" : ""}`
      >
        <span class="text-lg font-semibold tracking-tight text-primary tabular-nums">
          ${receipt.value}
        </span>
        <span class="text-xs text-muted-foreground underline-offset-4 group-hover:underline">
          ${receipt.label}
        </span>
      </a>
    </for>
    <p class="flex min-w-32 flex-col items-center justify-center gap-0.5 border-s border-border/60 px-6 py-1 text-center">
      <span class="text-lg font-semibold tracking-tight text-primary" aria-hidden="true">
        &lt;/&gt;
      </span>
      <span class="text-xs text-muted-foreground">renders without JavaScript</span>
    </p>
  </div>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-2 px-6 pb-5">
    <for|badge| of=BADGES>
      <a
        href=badge.href
        target="_blank"
        rel="noreferrer"
        title=badge.title
        class="inline-flex outline-none focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-ring"
      >
        <img src=badge.src alt=badge.alt height="20" loading="lazy"/>
      </a>
    </for>
  </div>
</section>
