// Trust strip between the hero and the showcase: every claim is a RECEIPT —
// a number the repo can back, linking straight to its proof. No third-party
// badge images (shields.io etc.): those read as decoration; a stat that
// links to the actual test suite reads as evidence. Numbers are maintained
// by hand next to their sources — update them when the suites change:
//   - CHECKS:      `bunx vitest run` total (120) + Playwright style-matrix
//                  total (511, e2e/results.json stats.expected) — both run
//                  in CI on every push (.github/workflows/ci.yml)
//   - COMPONENTS:  dirs in packages/registry/default/ui
//   - STYLES:      default + dirs in packages/registry/styles
//   - AXE:         `bun scripts/ci/axe-scan.ts` — the CI axe job fails on any
//                  violation, so "0" stays true
//   - LIGHTHOUSE:  minimum accessibility score across the component pages
//                  audited by .github/workflows/lighthouse.yml
static const REPO = "https://github.com/svallory/marko-ui";

static const RECEIPTS = [
  {
    value: "631",
    label: "checks on every push",
    title:
      "120 behavior & hydration tests plus 511 style-matrix checks (every component rendered, hydrated, and interacted with in every style) — CI-enforced",
    href: `${REPO}/actions/workflows/ci.yml`,
  },
  {
    value: "86",
    label: "components",
    title: "The full registry — every component in readable .marko source",
    href: `${REPO}/tree/main/packages/registry`,
  },
  {
    value: "9",
    label: "styles",
    title: "The default style plus 8 complete ports",
    href: `${REPO}/tree/main/packages/registry/styles`,
  },
  {
    value: "0",
    label: "axe violations",
    title:
      "axe-core WCAG scan across all 79 component demo pages — CI fails on any violation (the remaining 7 components ship without demo pages yet)",
    href: `${REPO}/blob/main/scripts/ci/axe-scan.ts`,
  },
  {
    value: "100",
    label: "Lighthouse accessibility",
    title:
      "Minimum Lighthouse accessibility score across audited component pages — re-audited on every push",
    href: `${REPO}/actions/workflows/lighthouse.yml`,
  },
] as const;

<section
  aria-label="Project test and coverage numbers"
  class="border-y border-border/60 bg-background"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-stretch justify-center px-6 py-5">
    <for|receipt, index| of=RECEIPTS>
      <a
        href=receipt.href
        target="_blank"
        rel="noreferrer"
        title=receipt.title
        class=`group flex min-w-40 flex-1 flex-col items-center gap-0.5 px-6 py-1 text-center outline-none focus-visible:rounded-md focus-visible:ring-2 focus-visible:ring-ring ${index > 0 ? "border-s border-border/60" : ""}`
      >
        <span class="text-lg font-semibold tracking-tight text-primary tabular-nums">
          ${receipt.value}
        </span>
        <span class="text-xs text-muted-foreground underline-offset-4 group-hover:underline">
          ${receipt.label}
        </span>
      </a>
    </for>
    <p class="flex min-w-40 flex-1 flex-col items-center justify-center gap-0.5 border-s border-border/60 px-6 py-1 text-center">
      <span class="text-lg font-semibold tracking-tight text-primary" aria-hidden="true">
        &lt;/&gt;
      </span>
      <span class="text-xs text-muted-foreground">renders without JavaScript</span>
    </p>
  </div>
</section>
