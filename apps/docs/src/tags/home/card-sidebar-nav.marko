<div class="grid w-full min-w-0 grid-cols-2 gap-4 xl:gap-6">
  <for|section| of=SECTIONS by=(section) => section.label>
    <Card class=`w-full min-w-0 overflow-hidden rounded-3xl py-0 ${section.gridClass}`>
      <SidebarProvider class="min-h-0">
        <@content>
          <Sidebar collapsible="none" class="w-full bg-transparent">
            <SidebarContent class="gap-0 overflow-hidden">
              <SidebarGroup>
                <SidebarGroupLabel>${section.label}</SidebarGroupLabel>
                <SidebarMenu class="gap-1">
                  <for|entry| of=section.items by=(entry) => entry.label>
                    <SidebarMenuItem>
                      <SidebarMenuButton active=entry.active>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <for|d| of=ICON_PATHS[entry.icon]>
                            <path d=d/>
                          </for>
                        </svg>
                        ${entry.label}
                      </SidebarMenuButton>
                    </SidebarMenuItem>
                  </for>
                </SidebarMenu>
              </SidebarGroup>
