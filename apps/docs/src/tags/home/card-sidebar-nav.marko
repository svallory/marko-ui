static const SECTIONS = [
  {
    label: "Overview",
    items: [
      { label: "Analytics", icon: "chart-bar", active: true },
      { label: "Transactions", icon: "cash", active: false },
      { label: "Investments", icon: "trending-up", active: false },
      { label: "Accounts", icon: "wallet", active: false },
    ],
  },
  {
    label: "Account",
    items: [
      { label: "Profile", icon: "user", active: false },
      { label: "Billing", icon: "credit-card", active: true },
      { label: "Notifications", icon: "bell", active: false },
      { label: "Security", icon: "lock", active: false },
    ],
  },
];

<div class="grid w-full min-w-0 grid-cols-1 gap-6 sm:grid-cols-2">
  <for|section| of=SECTIONS by=(section) => section.label>
    <Card class="w-full min-w-0 overflow-hidden bg-sidebar py-3">
      <div class="flex flex-col gap-1 px-2">
        <SidebarGroupLabel>${section.label}</SidebarGroupLabel>
        <SidebarMenu class="gap-1">
          <for|entry| of=section.items by=(entry) => entry.label>
            <SidebarMenuItem>
              <SidebarMenuButton active=entry.active>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <for|d| of=ICON_PATHS[entry.icon]>
                    <path d=d/>
                  </for>
                </svg>
                ${entry.label}
              </SidebarMenuButton>
            </SidebarMenuItem>
          </for>
        </SidebarMenu>
      </div>
    </Card>
  </for>
</div>
