// Adapted from shadcn/ui `app/(app)/(root)/cards/ui-elements.tsx` (MIT),
// rebuilt on marko-ui's own registry components.
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import ButtonGroup from "@marko-ui/shadcn/ui/button-group/button-group.marko";
import Badge from "@marko-ui/shadcn/ui/badge/badge.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import InputGroup from "@marko-ui/shadcn/ui/input-group/input-group.marko";
import InputGroupInput from "@marko-ui/shadcn/ui/input-group/input.marko";
import InputGroupAddon from "@marko-ui/shadcn/ui/input-group/addon.marko";
import InputGroupText from "@marko-ui/shadcn/ui/input-group/text.marko";
import Textarea from "@marko-ui/shadcn/ui/textarea/textarea.marko";
import Checkbox from "@marko-ui/shadcn/ui/checkbox/checkbox.marko";
import Switch from "@marko-ui/shadcn/ui/switch/switch.marko";
import RadioGroup from "@marko-ui/shadcn/ui/radio-group/radio-group.marko";
import AlertDialog from "@marko-ui/shadcn/ui/alert-dialog/alert-dialog.marko";
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";

static const FRUIT_OPTIONS_UNLABELED = [
  { value: "apple", label: "" },
  { value: "banana", label: "" },
];

static const QUICK_ACTIONS = [
  { type: "label" as const, label: "Quick Actions" },
  { value: "mute", label: "Mute Conversation" },
  { value: "read", label: "Mark as Read" },
  { value: "block", label: "Block User" },
  { type: "separator" as const },
  { value: "delete", label: "Delete Conversation", danger: true },
];

<Card class="w-full min-w-0">
  <CardContent class="flex min-w-0 flex-col gap-6">
    <div class="flex flex-wrap gap-2">
      <Button>
        Button
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </Button>
      <Button variant="secondary">Secondary</Button>
      <Button variant="outline">Outline</Button>
    </div>

    <FieldGroup>
      <Field>
        <InputGroup>
          <InputGroupInput placeholder="Name" aria-label="Name"/>
          <InputGroupAddon align="inline-end">
            <InputGroupText>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            </InputGroupText>
          </InputGroupAddon>
        </InputGroup>
      </Field>
      <Field class="flex-1">
        <Textarea placeholder="Message" class="resize-none" aria-label="Message"/>
      </Field>
    </FieldGroup>

    <div class="flex items-center gap-2">
      <div class="flex gap-2">
        <Badge>Badge</Badge>
        <Badge variant="secondary">Secondary</Badge>
        <Badge variant="outline" class="hidden 4xl:flex">Outline</Badge>
      </div>
      <RadioGroup
        items=FRUIT_OPTIONS_UNLABELED
        defaultValue="apple"
        aria-label="Fruit preference"
        class="ml-auto flex w-fit gap-3"
      />
      <div class="flex gap-3">
        <Checkbox defaultChecked aria-label="Enable email alerts"/>
        <Checkbox class="hidden 4xl:flex" aria-label="Enable push alerts"/>
      </div>
      <Switch defaultChecked class="flex 4xl:hidden" aria-label="Enable compact notifications"/>
    </div>

    <div class="flex items-center gap-4">
      <AlertDialog cancelText="Don't allow" actionText="Allow">
        <@trigger|triggerProps|>
          <Button ...triggerProps variant="outline">
            <span class="hidden md:flex">Alert Dialog</span>
            <span class="flex md:hidden">Dialog</span>
          </Button>
        </@trigger>
        <@title>Allow accessory to connect?</@title>
        <@description>
          Do you want to allow the USB accessory to connect to this device and
          your data?
        </@description>
      </AlertDialog>

      <ButtonGroup class="ml-auto">
        <Button variant="outline">Button Group</Button>
        <DropdownMenu items=QUICK_ACTIONS>
          <@trigger|triggerProps|>
            <Button
              ...triggerProps
              variant="outline"
              size="icon"
              aria-label="Open quick actions"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m18 15-6-6-6 6"/>
              </svg>
            </Button>
          </@trigger>
        </DropdownMenu>
      </ButtonGroup>

      <Switch defaultChecked class="hidden 4xl:flex" aria-label="Enable advanced setting"/>
    </div>
  </CardContent>
</Card>
