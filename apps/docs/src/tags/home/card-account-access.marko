// Adapted from shadcn/ui `app/(app)/(root)/cards/account-access.tsx` (MIT),
// rebuilt on marko-ui's own registry components. The shadcn source uses a
// plain <Input type="password">, not a reveal-toggle password input — ported
// as such for structural parity (no PasswordInput here).
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Item from "@marko-ui/shadcn/ui/item/item.marko";
import ItemMedia from "@marko-ui/shadcn/ui/item/media.marko";
import ItemContent from "@marko-ui/shadcn/ui/item/content.marko";
import ItemTitle from "@marko-ui/shadcn/ui/item/title.marko";
import ItemDescription from "@marko-ui/shadcn/ui/item/description.marko";

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Account Access</CardTitle>
    <CardDescription>Update your credentials or re-authenticate.</CardDescription>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <Field>
        <FieldLabel for="account-email">Email Address</FieldLabel>
        <Input id="account-email" type="email" placeholder="artist@studio.inc"/>
      </Field>
      <Field>
        <div class="flex items-center justify-between">
          <FieldLabel for="account-password">Current Password</FieldLabel>
          <a
            href="#"
            class="text-muted-foreground hover:text-foreground text-xs font-medium tracking-wider uppercase"
          >
            Forgot?
          </a>
        </div>
        <Input id="account-password" type="password" placeholder="••••••••••••••••••••••••"/>
      </Field>
    </FieldGroup>
  </CardContent>
  <CardFooter class="flex-col gap-4">
    <Button class="w-full">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Update Security
    </Button>
    <a href="#" class="w-full">
      <Item variant="muted">
        <ItemMedia variant="icon">
          <svg
            class="text-destructive size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4"/>
            <path d="M12 16h.01"/>
          </svg>
        </ItemMedia>
        <ItemContent>
          <ItemTitle>Danger Zone</ItemTitle>
          <ItemDescription class="line-clamp-1">
            Archive account and remove catalog
          </ItemDescription>
        </ItemContent>
        <svg
          class="size-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </Item>
    </a>
  </CardFooter>
</Card>
