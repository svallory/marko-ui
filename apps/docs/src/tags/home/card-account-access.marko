// Adapted from shadcn/ui `app/(app)/(root)/cards/account-access.tsx` (MIT),
// rebuilt on marko-ui's own registry components. The plain password <Input>
// of the original becomes marko-ui's PasswordInput (with a reveal toggle).
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Input from "@marko-ui/registry/ui/input/input.marko";
import Label from "@marko-ui/registry/ui/label/label.marko";
import PasswordInput from "@marko-ui/registry/ui/password-input/password-input.marko";
import Item from "@marko-ui/registry/ui/item/item.marko";
import ItemMedia from "@marko-ui/registry/ui/item/media.marko";
import ItemContent from "@marko-ui/registry/ui/item/content.marko";
import ItemTitle from "@marko-ui/registry/ui/item/title.marko";
import ItemDescription from "@marko-ui/registry/ui/item/description.marko";

<Card class="w-full min-w-0">
  <CardHeader>
    <CardTitle>Account Access</CardTitle>
    <CardDescription>Update your credentials or re-authenticate.</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <div class="grid gap-2">
      <Label for="account-email">Email Address</Label>
      <Input id="account-email" type="email" placeholder="artist@studio.inc"/>
    </div>
    <div class="grid gap-2">
      <div class="flex items-center justify-between">
        <Label for="account-password">Current Password</Label>
        <a
          href="#"
          class="text-muted-foreground hover:text-foreground text-xs font-medium tracking-wider uppercase"
        >
          Forgot?
        </a>
      </div>
      <PasswordInput id="account-password" placeholder="••••••••••••"/>
    </div>
  </CardContent>
  <CardFooter class="flex-col gap-4">
    <Button class="w-full">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Update Security
    </Button>
    <a href="#" class="w-full">
      <Item variant="muted">
        <ItemMedia variant="icon">
          <svg
            class="text-destructive size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4"/>
            <path d="M12 16h.01"/>
          </svg>
        </ItemMedia>
        <ItemContent>
          <ItemTitle>Danger Zone</ItemTitle>
          <ItemDescription class="line-clamp-1">
            Archive account and remove catalog
          </ItemDescription>
        </ItemContent>
        <svg
          class="size-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </Item>
    </a>
  </CardFooter>
</Card>
