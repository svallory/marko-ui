// Rebuilt (Round 2) from packages/shadcn/ui/sidebar parts, matching
// upstream's components/docs-sidebar.tsx, which is built from the same
// Sidebar kit (Sidebar, SidebarContent, SidebarGroup, SidebarGroupLabel,
// SidebarGroupContent, SidebarMenu, SidebarMenuItem, SidebarMenuButton with
// isActive). className overrides on SidebarMenuButton below are copied
// verbatim from docs-sidebar.tsx:202 (only the active-state selector syntax
// differs: data-[active=true]:X -> our shipped data-active: custom-variant,
// which matches the same data-active="true" attribute this component sets).
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/shadcn/ui/sidebar/group-label.marko";
import SidebarGroupContent from "@marko-ui/shadcn/ui/sidebar/group-content.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";

export interface DocsSidebarSection {
  title: string;
  items: Array<{ href: string; label: string }>;
}

export interface Input {
  sections: DocsSidebarSection[];
  /** Current route pathname, for server-side active-link detection (no
      client script needed — matches components-sidebar.marko's pattern). */
  currentPath?: string;
  class?: string;
}

<const/isActive=(href: string) =>
  input.currentPath != null &&
  (href === "/docs" ? input.currentPath === href : input.currentPath.startsWith(href))/>

<nav class=`flex flex-col gap-4 no-scrollbar ${input.class ?? ""}` data-slot="docs-sidebar">
  <for|section| of=input.sections by=(section)=>section.title>
    <SidebarGroup>
      <SidebarGroupLabel class="font-medium text-muted-foreground">
        ${section.title}
      </SidebarGroupLabel>
      <SidebarGroupContent>
        <SidebarMenu class="gap-0.5">
          <for|item| of=section.items by=(item)=>item.href>
            <SidebarMenuItem>
              <SidebarMenuButton
                href=item.href
                active=isActive(item.href)
                class="relative h-[30px] w-fit overflow-visible border border-transparent text-[0.8rem] font-medium data-active:border-accent data-active:bg-accent"
              >
                ${item.label}
              </SidebarMenuButton>
            </SidebarMenuItem>
          </for>
        </SidebarMenu>
      </SidebarGroupContent>
    </SidebarGroup>
  </for>
</nav>
