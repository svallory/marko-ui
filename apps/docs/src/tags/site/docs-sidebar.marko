export interface DocsSidebarSection {
  title: string;
  items: Array<{ href: string; label: string }>;
}

export interface Input {
  sections: DocsSidebarSection[];
  class?: string;
}

<nav/navEl class=`flex flex-col gap-4 no-scrollbar ${input.class ?? ""}` data-slot="docs-sidebar">
  <for|section| of=input.sections by=(section)=>section.title>
    <div class="flex flex-col p-2">
      <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-muted-foreground">${section.title}</div>
      <ul class="flex w-full min-w-0 flex-col gap-0.5">
        <for|item| of=section.items by=(item)=>item.href>
          <li>
            <a
              href=item.href
              data-site-nav-link
              data-href=item.href
              class="relative flex h-[30px] w-fit items-center overflow-visible rounded-md border border-transparent px-2 text-[0.8rem] font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground data-active:border-accent data-active:bg-accent data-active:font-medium"
            >
              ${item.label}
            </a>
          </li>
        </for>
      </ul>
    </div>
  </for>
</nav>

<lifecycle
  onMount() {
    const path = window.location.pathname;
    navEl()?.querySelectorAll("[data-site-nav-link]").forEach((link) => {
      const href = link.getAttribute("data-href");
      link.toggleAttribute("data-active", href === path);
    });
  }
/>
