import "../../tags/site/main-nav.marko";
import "../../tags/site/mobile-nav.marko";
import "../../tags/site/github-link.marko";
import "../../tags/theme-toggle.marko";

<!-- DELIBERATE DEVIATION FROM shadcn: no border-b here. shadcn's own
     site-header.tsx (data/shadcn-ui/apps/v4/components/site-header.tsx)
     also ships with no bottom border, so this both matches the source and
     satisfies the user's explicit "remove the line under the header" ask
     even if it hadn't. -->
<!-- style-new-york: upstream's site chrome (header/nav/sidebars/footer) is
     built from registry/new-york-v4/ui — matching that style directly, now
     that new-york is ported (previously approximated with style-vega, whose
     .mu-button base also uses rounded-md; see git history for that
     rationale). Component previews stay nova (component-preview.tsx's own
     default) — only chrome opts into new-york, nested inside the nova body
     per app.css's "nova imports first" cascade rule. -->
<header class="style-new-york sticky top-0 z-50 w-full bg-background text-foreground" data-slot="site-header">
  <div class="container-wrapper px-6">
    <div class="flex h-14 items-center gap-4">
      <mobile-nav class="flex lg:hidden"/>
      <a href="/" class="text-sm font-semibold tracking-tight">marko-ui</a>
      <main-nav class="hidden lg:flex"/>
      <div class="ml-auto flex items-center gap-1">
        <github-link/>
        <theme-toggle/>
      </div>
    </div>
  </div>
</header>
