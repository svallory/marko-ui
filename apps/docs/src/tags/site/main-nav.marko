import { buttonVariants } from "@marko-ui/shadcn/ui/button/variants.ts";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";

export interface Input {
  class?: string;
}

static const NAV_ITEMS = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/components", label: "Components" },
  { href: "/blocks", label: "Blocks" },
  { href: "/charts", label: "Charts" },
  { href: "/typeset", label: "Typeset" },
  { href: "/create", label: "Create" },
];

<nav class=`items-center gap-0 ${input.class ?? ""}` data-slot="main-nav">
  <for|item| of=NAV_ITEMS by=(item)=>item.href>
    <a
      href=item.href
      data-site-nav-link
      data-href=item.href
      class=cn(
        buttonVariants({ variant: "ghost", size: "sm" }),
        "text-muted-foreground data-active:text-foreground",
      )
    >
      ${item.label}
    </a>
  </for>
</nav>

<script>
  const path = window.location.pathname;
  document.querySelectorAll("[data-site-nav-link]").forEach((link) => {
    const href = link.getAttribute("data-href");
    const isActive = href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
    link.toggleAttribute("data-active", Boolean(isActive));
  });
</script>
