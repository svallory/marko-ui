<let/messages=([] as ChatMessage[])/>
<let/busy=false/>
<let/enteringId=(null as string | null)/>
<const/nextMessage=SCRIPT[messages.length]/>
<const/preset=(PRESETS.find((entry) => entry.value === presetId) ?? PRESETS[0])/>

<const/send=() => {
  if (!nextMessage || busy) return;
  const outgoing = nextMessage;
  messages = [...messages, outgoing];
  enteringId = outgoing.id;
  requestAnimationFrame(() => requestAnimationFrame(() => {
    if (enteringId === outgoing.id) enteringId = null;
