static const PRESETS = [
  { value: "fade", label: "Fade", enterClass: "opacity-0", restClass: "opacity-100" },
  { value: "slide-up", label: "Slide Up", enterClass: "translate-y-2 opacity-0", restClass: "translate-y-0 opacity-100" },
