// Ported from shadcn/ui app/(app)/(create)/components/accent-picker.tsx
// (exported there as MenuAccentPicker). Subtle/Bold radio picker for the
// menu accent, with the source's paint-bucket trigger SVG whose fills flip
// to solid when the accent is "bold", and "Bold" disabled while the menu
// color is translucent. Replaces the phase-2 inert placeholder in
// customizer.marko. LockButton restored per source (param="menuAccent",
// absolute top-1/2 right-8). The source wraps this picker with `pr-3
// md:pr-0` on the group div — preserved.
import { MENU_ACCENTS, type MenuAccentValue, type MenuColorValue } from "./lib/registry-config.ts";
import Picker from "./picker.marko";
import LockButton from "./lock-button.marko";

export interface Input {
  value: MenuAccentValue;
  menuColor: MenuColorValue;
  onValueChange: (value: MenuAccentValue) => void;
  onItemPreview?: (value: MenuAccentValue | null) => void;
  locked: boolean;
  onToggleLock: () => void;
  isMobile?: boolean;
}

<const/currentAccent=MENU_ACCENTS.find((accent) => accent.value === input.value)/>

<div class="group/picker relative pr-3 md:pr-0">
  <Picker
    value=input.value
    onValueChange=(value) => input.onValueChange(value as MenuAccentValue)
    onItemPreview=(value) => input.onItemPreview?.(value as MenuAccentValue | null)
    closeOnClick=input.isMobile
    side=(input.isMobile ? "top" : "right")
    align=(input.isMobile ? "center" : "start")
    sections=[{
      options: MENU_ACCENTS.map((accent) => ({
        value: accent.value,
        label: accent.label,
        disabled:
          accent.value === "bold" &&
          (input.menuColor === "default-translucent" ||
            input.menuColor === "inverted-translucent"),
      })),
    }]
  >
    <@trigger>
      <div class="flex flex-col justify-start text-left">
        <div class="text-xs text-muted-foreground">Menu Accent</div>
        <div class="text-sm font-medium text-foreground">${currentAccent?.label}</div>
      </div>
      <div class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="128"
          height="128"
          viewBox="0 0 24 24"
          fill="none"
          class="size-4 text-foreground"
        >
          <path
            d="M19 12.1294L12.9388 18.207C11.1557 19.9949 10.2641 20.8889 9.16993 20.9877C8.98904 21.0041 8.80705 21.0041 8.62616 20.9877C7.53195 20.8889 6.64039 19.9949 4.85726 18.207L2.83687 16.1811C1.72104 15.0622 1.72104 13.2482 2.83687 12.1294M19 12.1294L10.9184 4.02587M19 12.1294H2.83687M10.9184 4.02587L2.83687 12.1294M10.9184 4.02587L8.89805 2"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-accent=currentAccent?.value
            class="fill-muted-foreground/30 data-[accent=bold]:fill-foreground"
          />
          <path
            d="M22 20C22 21.1046 21.1046 22 20 22C18.8954 22 18 21.1046 18 20C18 18.8954 20 17 20 17C20 17 22 18.8954 22 20Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-accent=currentAccent?.value
            class="fill-muted-foreground/30 data-[accent=bold]:fill-foreground"
          />
        </svg>
      </div>
    </@trigger>
  </Picker>
  <LockButton
    locked=input.locked
    onToggle=input.onToggleLock
    class="absolute top-1/2 right-8 -translate-y-1/2"
  />
</div>
