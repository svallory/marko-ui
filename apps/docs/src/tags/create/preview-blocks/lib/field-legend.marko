// Stand-in for shadcn's ui/field.tsx FieldLegend — see field-group.marko's
// header. Nova defaults baked in.
import { cn } from "@marko-ui/registry/lib/utils.ts";

export interface Input extends Marko.Input<"legend"> {
  variant?: "legend" | "label";
}

<const/{ variant = "legend", class: className, content, ...rest }=input/>

<legend
  ...rest
  data-slot="field-legend"
  data-variant=variant
  class=cn(
    "cn-field-legend mb-1.5 font-medium data-[variant=label]:text-sm data-[variant=legend]:text-base",
    className,
  )
>
  <${content}/>
</legend>
