// Stand-in for shadcn's ui/field.tsx FieldLabel — see field-group.marko's
// header. Wraps the registry Label with the field-label slot + nova classes.
import Label from "@marko-ui/registry/ui/label/label.marko";

export interface Input extends Marko.Input<"label"> {}

<const/{ class: className, content, ...rest }=input/>

<Label
  ...rest
  data-slot="field-label"
  class=`cn-field-label group/field-label peer/field-label flex w-fit gap-2 leading-snug group-data-[disabled=true]/field:opacity-50 has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col has-[>[data-slot=field]]:rounded-lg has-[>[data-slot=field]]:border ${className ?? ""}`
>
  <${content}/>
</Label>
