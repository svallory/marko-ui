// Ported from shadcn's IconPlaceholder as used inside the preview-page /
// preview showcase cards. UNBLOCKED 2026-08-13: this now delegates to the
// real registry Icon component (packages/registry/default/ui/icon/) —
// TODO.md's "icon strategy" decision was option (a), shadcn's own
// generated-per-library-map approach (see build-icons.ts).
//
// Names here are lucide symbol names (with or without the "Icon" suffix —
// both forms resolve, see render.ts's withSuffixFallback), matching every
// existing `<Icon name="...">` call site across the preview cards.
//
// iconLibrary is read once at SSR time from the URL (matching the existing
// `item` param pattern in ../../../routes/create/preview/+page.marko) —
// there is no prop-threading from that route down through 30+ leaf preview
// cards, and Marko has no context API (see notes/plans/compound-tag-dx
// research: `$global` writes are request-scoped and dead for client-side
// reactivity, but reading `$global.url` at SSR time, like every other
// route-param read in this app, is exactly what it's for). Live switching
// when the picker changes WITHOUT a reload happens entirely client-side: a
// script in the preview route walks every `[data-icon-name]` element this
// tag renders and patches its markup via the same lib/render.ts resolver —
// see that route's header comment for why (the iframe-preview pattern:
// theme/param updates flow only through postMessage, never a src reload).
import Icon from "@marko-ui/registry/ui/icon/icon.marko";
import type { IconLibraryName } from "@marko-ui/registry/ui/icon/icon-names.ts";

export interface Input {
  name: string;
  class?: string;
}

<const/iconLibrary=($global.url.searchParams.get("iconLibrary") ?? "lucide") as IconLibraryName/>

<Icon name=input.name library=iconLibrary class=input.class/>
