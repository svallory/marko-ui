// preview-04 card: demos marko-ui's `rating-group` (no shadcn equivalent)
// in an order-review scenario.
import Button from "@marko-ui/registry/ui/button/button.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import RatingGroup from "@marko-ui/registry/ui/rating-group/rating-group.marko";
import Textarea from "@marko-ui/registry/ui/textarea/textarea.marko";

<let/rating=4/>

<Card>
  <CardHeader>
    <CardTitle>How was your order?</CardTitle>
    <CardDescription>Order #48-2210 · Delivered Apr 9</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <RatingGroup
      label="Overall rating"
      value=rating
      valueChange=(next: number) => { rating = next; }
    />
    <Textarea placeholder="Tell us more (optional)..." class="min-h-20 resize-none"/>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Submit Review</Button>
  </CardFooter>
</Card>
