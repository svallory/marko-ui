          <FieldLabel for="target-amount">Target Amount</FieldLabel>
          <Input id="target-amount" value="$15,000"/>
        </Field>
        <Field>
          <FieldLabel for="target-date">Target Date</FieldLabel>
          <Input id="target-date" value="Dec 2025"/>
