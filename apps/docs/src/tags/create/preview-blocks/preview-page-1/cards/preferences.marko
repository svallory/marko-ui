// Ported from shadcn registry/bases/base/blocks/preview-02/cards/preferences.tsx
// API adaptation: this registry's Select is a single items-driven tag rather
// than compound Select* parts, so the trigger/value/content markup lives
// inside it (same data-slots emitted).
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldContent from "@marko-ui/shadcn/ui/field/field-content.marko";
import FieldDescription from "@marko-ui/shadcn/ui/field/field-description.marko";
import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import FieldSeparator from "@marko-ui/shadcn/ui/field/field-separator.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";
import Switch from "@marko-ui/shadcn/ui/switch/switch.marko";
import Icon from "../../lib/icon.marko";

static const CURRENCIES = [
  { label: "USD — United States Dollar", value: "usd" },
  { label: "EUR — Euro", value: "eur" },
  { label: "GBP — British Pound", value: "gbp" },
  { label: "JPY — Japanese Yen", value: "jpy" },
];

<Card>
  <CardHeader>
    <CardTitle>Preferences</CardTitle>
    <CardDescription>
      Manage your account settings and notifications.
    </CardDescription>
    <CardAction>
      <Button variant="ghost" size="icon-sm" class="bg-muted">
        <Icon name="XIcon"/>
      </Button>
    </CardAction>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <Field>
        <FieldLabel for="default-currency">Default Currency</FieldLabel>
        <Select
          ids={ trigger: "default-currency" }
          items=CURRENCIES
          defaultValue=["usd"]
          class="w-full [&_[data-slot=select-trigger]]:w-full"
        />
      </Field>
      <FieldSeparator class="-my-4 style-sera:hidden"/>
      <Field orientation="horizontal">
        <FieldContent>
          <FieldLabel for="public-statistics">
            Public Statistics
          </FieldLabel>
          <FieldDescription>
            Allow others to see your total stream count and listening
            activity
          </FieldDescription>
        </FieldContent>
        <Switch id="public-statistics" defaultChecked/>
      </Field>
      <FieldSeparator class="-my-4 style-sera:hidden"/>
      <Field orientation="horizontal">
        <FieldContent>
          <FieldLabel for="email-notifications">
            Email Notifications
          </FieldLabel>
          <FieldDescription>
            Monthly royalty reports and distribution updates
          </FieldDescription>
        </FieldContent>
        <Switch id="email-notifications" defaultChecked/>
      </Field>
    </FieldGroup>
  </CardContent>
  <CardFooter>
    <Button variant="outline">Reset</Button>
    <Button class="ml-auto">Save Preferences</Button>
  </CardFooter>
</Card>
