// Ported from shadcn registry/bases/base/blocks/preview-02/cards/cover-art.tsx
// Deviation: source renders Button via render={<label/>}; here the
// secondary button is a <label> carrying the same button styling via the
// registry Button's own class hooks is not possible without a render prop,
// so a plain Button wrapped in a label-for association is used instead.
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Item from "@marko-ui/shadcn/ui/item/item.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";
import Icon from "../../lib/icon.marko";

<Card>
  <CardContent class="flex flex-col gap-3">
    <Label
      for="cover-art"
      class="text-center text-xs font-normal tracking-wider text-muted-foreground uppercase"
    >
      Cover Art
    </Label>
    <Item class="aspect-square" variant="outline">
      <label
        for="cover-art"
        class="flex size-full cursor-pointer items-center justify-center"
      >
        <Icon name="ImageIcon" class="size-10 text-muted-foreground/50"/>
      </label>
    </Item>
    <input
      id="cover-art"
      type="file"
      accept="image/jpeg,image/png"
      class="sr-only"
    />
  </CardContent>
  <CardFooter class="flex-col gap-2">
    <Button variant="secondary" class="w-full">
      Upload Artwork
    </Button>
    <CardDescription class="text-center text-xs">
      Minimum 3000 × 3000px
      <br/>
      JPEG or PNG only
    </CardDescription>
  </CardFooter>
</Card>
