// Ported from shadcn registry/bases/base/blocks/preview-02/cards/card-overview.tsx
// Chart: recharts <BarChart> → our d3-geometry BarChart primitive. The source
// puts className="text-[10px]" on <XAxis/>; our x-axis part takes no class, so
// the equivalent scoped variant ([&_.recharts-xAxis]:text-[10px]) rides on the
// ChartContainer class — same computed CSS on the same recharts-xAxis element.
import Badge from "@marko-ui/registry/ui/badge/badge.marko";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import Chart from "@marko-ui/registry/ui/chart/chart.marko";
import BarChart from "@marko-ui/registry/ui/chart/bar.marko";

static const activityData = [
  { month: "Jan", amount: 40 },
  { month: "Feb", amount: 55 },
  { month: "Mar", amount: 35 },
  { month: "Apr", amount: 60 },
  { month: "May", amount: 45 },
  { month: "Jun", amount: 50 },
  { month: "Jul", amount: 65 },
  { month: "Aug", amount: 40 },
  { month: "Sep", amount: 55 },
  { month: "Oct", amount: 70 },
  { month: "Nov", amount: 45 },
  { month: "Dec", amount: 80 },
];

static const chartConfig = {
  amount: {
    label: "Activity",
    color: "var(--chart-2)",
  },
};

<div class="grid grid-cols-2 gap-3">
  <Card>
    <CardContent>
      <CardDescription>Card Balance</CardDescription>
      <CardTitle class="text-2xl tabular-nums">US$12.94</CardTitle>
      <CardDescription class="tabular-nums">
        US$11,337.06 Available
      </CardDescription>
    </CardContent>
  </Card>
  <Card class="flex flex-col justify-between">
    <CardContent class="flex flex-1 flex-col justify-between">
      <div class="flex flex-col gap-1">
        <CardDescription>Payment Due</CardDescription>
        <CardTitle class="text-2xl">1 Apr</CardTitle>
      </div>
      <Button variant="outline" size="sm" class="mt-3 w-full">
        Pay Early
      </Button>
    </CardContent>
  </Card>
  <Card class="col-span-2">
    <CardContent class="flex flex-col gap-2">
      <div class="flex items-center justify-between">
        <CardDescription>Yearly Activity</CardDescription>
        <Badge variant="secondary">+US$0.25 Daily Cash</Badge>
      </div>
      <Chart
        config=chartConfig
        class="h-20 w-full [&_.recharts-xAxis]:text-[10px]"
      >
        <BarChart
          data=activityData
          config=chartConfig
          xKey="month"
          width=330
          height=80
          margin={ top: 4, right: 0, bottom: 0, left: 0 }
          grid=false
          tickMargin=4
          xTickFormatter=(value) => String(value).slice(0, 1)
          cursor=false
          hideLabel
        >
          <@series dataKey="amount" radius=[3, 3, 0, 0]/>
        </BarChart>
      </Chart>
    </CardContent>
  </Card>
</div>
