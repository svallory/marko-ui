// Ported from shadcn registry/bases/base/blocks/preview-02/cards/release-catalog.tsx
import Badge from "@marko-ui/registry/ui/badge/badge.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import InputGroup from "@marko-ui/registry/ui/input-group/input-group.marko";
import InputGroupAddon from "@marko-ui/registry/ui/input-group/addon.marko";
import InputGroupInput from "@marko-ui/registry/ui/input-group/input.marko";
import Item from "@marko-ui/registry/ui/item/item.marko";
import ItemContent from "@marko-ui/registry/ui/item/content.marko";
import ItemDescription from "@marko-ui/registry/ui/item/description.marko";
import ItemGroup from "@marko-ui/registry/ui/item/group.marko";
import ItemMedia from "@marko-ui/registry/ui/item/media.marko";
import ItemTitle from "@marko-ui/registry/ui/item/title.marko";
import ToggleGroup from "@marko-ui/registry/ui/toggle-group/toggle-group.marko";
import Icon from "../../lib/icon.marko";

static const HOLDINGS = [
  { ticker: "VOO", name: "Vanguard S&P 500 ETF", type: "ETF", added: "Jan 2021", shares: "112", value: "$48,230.40" },
  { ticker: "VIG", name: "Vanguard Dividend Appreciation", type: "ETF", added: "Mar 2022", shares: "450", value: "$26,033.79" },
  { ticker: "AAPL", name: "Apple Inc.", type: "Stock", added: "Nov 2020", shares: "85", value: "$18,488.90" },
  { ticker: "O", name: "Realty Income Corp", type: "REIT", added: "Jun 2023", shares: "320", value: "$15,136.59" },
];

static const FILTERS = [
  { value: "stocks", label: "Stocks" },
  { value: "etfs", label: "ETFs" },
  { value: "reits", label: "REITs" },
];

<Card>
  <CardHeader>
    <div class="flex items-center justify-between gap-3">
      <InputGroup class="max-w-sm">
        <InputGroupAddon>
          <Icon name="SearchIcon"/>
        </InputGroupAddon>
        <InputGroupInput placeholder="Search holdings or tickers..."/>
      </InputGroup>
      <ToggleGroup defaultValue=["etfs"] variant="outline" items=FILTERS/>
    </div>
  </CardHeader>
  <CardContent>
    <ItemGroup>
      <for|holding| of=HOLDINGS by=(holding) => holding.ticker>
        <Item variant="muted">
          <ItemMedia>
            <div class="flex size-12 items-center justify-center rounded-lg border text-sm font-semibold">
              ${holding.ticker}
            </div>
          </ItemMedia>
          <ItemContent>
            <ItemTitle>${holding.name}</ItemTitle>
            <ItemDescription class="text-xs tracking-wider uppercase">
              ${holding.shares} Shares · ${holding.added}
            </ItemDescription>
          </ItemContent>
          <div class="flex shrink-0 items-center gap-6">
            <Badge variant="outline">${holding.type}</Badge>
            <div class="flex flex-col items-end gap-0.5">
              <span class="text-xs tracking-wider text-muted-foreground uppercase">
                Value
              </span>
              <span class="font-medium tabular-nums">${holding.value}</span>
            </div>
          </div>
        </Item>
      </for>
    </ItemGroup>
  </CardContent>
</Card>
