// preview-page-3 card: demos marko-ui's `number-input` (no shadcn equivalent)
// in a seat-licenses purchase scenario.
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";
import NumberInput from "@marko-ui/shadcn/ui/number-input/number-input.marko";
import Separator from "@marko-ui/shadcn/ui/separator/separator.marko";

<let/seats="5"/>

<const/seatCount=(Number.parseInt(seats, 10) || 0)/>
<const/total=(seatCount * 12)/>

<Card>
  <CardHeader>
    <CardTitle>Team Seats</CardTitle>
    <CardDescription>$12 per seat, billed monthly.</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <div class="flex items-center justify-between gap-3">
      <Label>Seats</Label>
      <NumberInput
        value=seats
        valueChange=(next: string) => { seats = next; }
        min=1
        max=500
      />
    </div>
    <Separator/>
    <div class="flex items-center justify-between">
      <span class="text-sm text-muted-foreground">Monthly total</span>
      <span class="text-sm font-semibold tabular-nums">$${total}.00</span>
    </div>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Update Subscription</Button>
  </CardFooter>
</Card>
