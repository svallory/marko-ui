// preview-page-3 card: demos marko-ui's `tree-view` (no shadcn equivalent) in
// a repository file-browser scenario.
import Badge from "@marko-ui/shadcn/ui/badge/badge.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import TreeView from "@marko-ui/shadcn/ui/tree-view/tree-view.marko";

static const FILE_TREE = [
  {
    id: "src",
    label: "src",
    children: [
      {
        id: "components",
        label: "components",
        children: [
          { id: "button.marko", label: "button.marko" },
          { id: "input.marko", label: "input.marko" },
        ],
      },
      { id: "index.ts", label: "index.ts" },
      { id: "app.ts", label: "app.ts" },
    ],
  },
  {
    id: "public",
    label: "public",
    children: [
      { id: "favicon.ico", label: "favicon.ico" },
      { id: "robots.txt", label: "robots.txt" },
    ],
  },
  { id: "package.json", label: "package.json" },
  { id: "readme.md", label: "README.md" },
];

<let/selected=["index.ts"]/>

<Card>
  <CardHeader>
    <CardTitle>
      marko-ui/app <Badge variant="secondary">main</Badge>
    </CardTitle>
    <CardDescription>Browse files in this branch.</CardDescription>
  </CardHeader>
  <CardContent>
    <TreeView
      items=FILE_TREE
      selectedValue=selected
      selectedValueChange=(value: string[]) => { selected = value; }
    />
  </CardContent>
</Card>
