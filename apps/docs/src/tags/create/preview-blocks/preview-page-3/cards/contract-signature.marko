// preview-page-3 card: demos marko-ui's `signature-pad` (no shadcn equivalent)
// in a contract-signing scenario.
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import SignaturePad from "@marko-ui/shadcn/ui/signature-pad/signature-pad.marko";

<let/strokes=[] as string[]/>

<Card>
  <CardHeader>
    <CardTitle>Sign Agreement</CardTitle>
    <CardDescription>
      Master service agreement · Rev. 2026-03
    </CardDescription>
  </CardHeader>
  <CardContent>
    <SignaturePad drawEndChange=(next: string[]) => { strokes = next; }/>
  </CardContent>
  <CardFooter class="flex-col gap-2">
    <Button class="w-full" disabled=(strokes.length === 0)>
      Submit Signature
    </Button>
    <CardDescription class="text-center text-xs">
      By signing you agree to the terms of service.
    </CardDescription>
  </CardFooter>
</Card>
