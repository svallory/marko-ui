// preview-page-3 card: demos marko-ui's `date-input` (no shadcn equivalent) in
// an identity-verification scenario.
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import DateInput from "@marko-ui/shadcn/ui/date-input/date-input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";

<let/value=["1990-06-15"]/>

<Card>
  <CardHeader>
    <CardTitle>Verify Your Identity</CardTitle>
    <CardDescription>
      Enter your date of birth as it appears on your ID.
    </CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-2">
    <Label>Date of birth</Label>
    <DateInput value=value valueChange=(next: string[]) => { value = next; }/>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Continue</Button>
  </CardFooter>
</Card>
