// Ported from shadcn registry/bases/base/blocks/preview/cards/typography-specimen.tsx
// The source reads live params via useDesignSystemSearchParams; the iframe
// here has no hook, so the labels update from the same
// `design-system-params` postMessage the route already receives — same
// data source, iframe-side (same pattern as style-overview).
// API adaptation: this registry's Select is a single items-driven tag rather
// than compound Select* parts, so the trigger/value/content markup lives
// inside it (same data-slots emitted); the trigger is widened to w-full via a
// class on the root (same pattern as report-bug). The Dialog is likewise a
// single tag with @trigger/@title/@description/@content/@footer attr tags
// emitting the same dialog-* data-slots; Cancel closes via controlled open
// state (DialogClose equivalent).
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import Dialog from "@marko-ui/shadcn/ui/dialog/dialog.marko";
import Field from "@marko-ui/shadcn/ui/field/field.marko";
import FieldGroup from "@marko-ui/shadcn/ui/field/field-group.marko";
import FieldLabel from "@marko-ui/shadcn/ui/field/field-label.marko";
import Input from "@marko-ui/shadcn/ui/input/input.marko";
import Select from "@marko-ui/shadcn/ui/select/select.marko";
import Textarea from "@marko-ui/shadcn/ui/textarea/textarea.marko";
import { FONTS } from "../../../lib/fonts.ts";
import type { DesignSystemSearchParams } from "../../../lib/search-params.ts";

static const CATEGORIES = [
  { label: "General", value: "general" },
  { label: "Bug Report", value: "bug" },
  { label: "Feature Request", value: "feature" },
  { label: "Improvement", value: "improvement" },
];

<let/headingLabel="Inherit"/>
<let/bodyLabel="Default"/>

<let/listening=false/>
<script>
  if (!listening && typeof window !== "undefined") {
    listening = true;
    window.addEventListener("message", (event: MessageEvent) => {
      if (!event.data || typeof event.data !== "object") return;
      if (event.data.type !== "design-system-params") return;
      const params = event.data.data as DesignSystemSearchParams;
      const currentFont = FONTS.find((font) => font.value === params.font);
      const currentFontHeading = FONTS.find(
        (font) => font.value === params.fontHeading,
      );
      headingLabel =
        currentFontHeading?.name && currentFontHeading.name !== currentFont?.name
          ? currentFontHeading.name
          : "Inherit";
      bodyLabel = currentFont?.name ?? "Default";
    });
  }
</script>

<let/feedbackOpen=false/>

<Card>
  <CardContent class="flex flex-col gap-2">
    <div class="text-xs font-medium text-muted-foreground uppercase">
      ${headingLabel} - ${bodyLabel}
    </div>
    <p class="cn-font-heading text-2xl font-medium style-sera:text-lg style-sera:font-semibold style-sera:tracking-wider style-sera:uppercase">
      Designing with rhythm and hierarchy.
    </p>
    <p class="text-sm leading-relaxed text-muted-foreground">
      A strong body style keeps long-form content readable and balances the
      visual weight of headings.
    </p>
    <p class="text-sm leading-relaxed text-muted-foreground">
      Thoughtful spacing and cadence help paragraphs scan quickly without
      feeling dense.
    </p>
  </CardContent>
  <CardFooter>
    <Dialog open=feedbackOpen openChange=((open: boolean) => (feedbackOpen = open))>
      <@trigger|triggerProps|>
        <Button ...triggerProps variant="outline" class="w-full">
          Share Feedback
        </Button>
      </@trigger>
      <@title>Share Feedback</@title>
      <@description>
        Let us know how we can improve your experience.
      </@description>
      <@content>
        <FieldGroup>
          <div class="grid grid-cols-2 gap-3">
            <Field>
              <FieldLabel for="feedback-name">Name</FieldLabel>
              <Input id="feedback-name" placeholder="Your name"/>
            </Field>
            <Field>
              <FieldLabel for="feedback-email">Email</FieldLabel>
              <Input
                id="feedback-email"
                type="email"
                placeholder="you@example.com"
              />
            </Field>
          </div>
          <Field>
            <FieldLabel for="feedback-category">Category</FieldLabel>
            <Select
              ids={ trigger: "feedback-category" }
              items=CATEGORIES
              defaultValue=["general"]
              class="w-full [&_[data-slot=select-trigger]]:w-full"
            />
          </Field>
          <Field>
            <FieldLabel for="feedback-message">Message</FieldLabel>
            <Textarea
              id="feedback-message"
              placeholder="Tell us what's on your mind..."
              class="min-h-24 resize-none"
            />
          </Field>
        </FieldGroup>
      </@content>
      <@footer>
        <Button variant="outline" onClick() { feedbackOpen = false; }>
          Cancel
        </Button>
        <Button>Submit</Button>
      </@footer>
    </Dialog>
  </CardFooter>
</Card>
