// Ported from shadcn registry/bases/base/blocks/preview/cards/style-overview.tsx
// The source reads live params via useDesignSystemSearchParams; the iframe
// here has no hook, so the labels update from the same
// `design-system-params` postMessage the route already receives — same
// data source, iframe-side.
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import { STYLES } from "../../../lib/registry-config.ts";
import { FONTS } from "../../../lib/fonts.ts";
import type { DesignSystemSearchParams } from "../../../lib/search-params.ts";

static const SWATCHES = [
  "--background",
  "--foreground",
  "--primary",
  "--secondary",
  "--muted",
  "--accent",
  "--border",
  "--chart-1",
  "--chart-2",
  "--chart-3",
  "--chart-4",
  "--chart-5",
];

<let/styleTitle="Nova"/>
<let/fontLabel="Inter"/>

<let/listening=false/>
<script>
  if (!listening && typeof window !== "undefined") {
    listening = true;
    window.addEventListener("message", (event: MessageEvent) => {
      if (!event.data || typeof event.data !== "object") return;
      if (event.data.type !== "design-system-params") return;
      const params = event.data.data as DesignSystemSearchParams;
      const currentStyle = STYLES.find((style) => style.name === params.style);
      const currentFont = FONTS.find((font) => font.value === params.font);
      const currentFontHeading = FONTS.find((font) => font.value === params.fontHeading);
      if (currentStyle) styleTitle = currentStyle.title;
      fontLabel =
        currentFontHeading?.name && currentFontHeading.name !== currentFont?.name
          ? currentFontHeading.name
          : (currentFont?.name ?? fontLabel);
    });
  }
</script>

<Card>
  <CardContent class="flex flex-col gap-6 style-lyra:gap-4 style-mira:gap-4">
    <div class="flex flex-col gap-1">
      <div class="cn-font-heading text-2xl font-medium style-lyra:text-lg style-mira:text-lg style-sera:text-lg style-sera:font-semibold style-sera:tracking-wide style-sera:uppercase">
        ${styleTitle} - ${fontLabel}
      </div>
      <div class="line-clamp-2 text-base text-muted-foreground style-lyra:text-sm style-mira:text-sm style-sera:text-sm style-sera:leading-relaxed">
        Designers love packing quirky glyphs into test phrases. This is a
        preview of the typography styles.
      </div>
    </div>
    <div class="grid grid-cols-6 gap-3">
      <for|variant| of=SWATCHES by=(variant) => variant>
        <div class="flex flex-col flex-wrap items-center gap-2">
          <div
            class="relative aspect-square w-full rounded-lg bg-(--color) after:absolute after:inset-0 after:rounded-lg after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten style-sera:rounded-none style-sera:after:rounded-none"
            style={ "--color": `var(${variant})` }
          />
          <div class="hidden max-w-14 truncate font-mono text-[0.60rem] md:block style-lyra:max-w-10 style-mira:max-w-10">
            ${variant}
          </div>
        </div>
      </for>
    </div>
  </CardContent>
</Card>
