// Ported from shadcn registry/bases/base/blocks/preview/cards/invite-team.tsx
// API adaptation: this registry's Select is a single items-driven tag rather
// than compound components; the trigger is narrowed to w-24 via a class on
// the root (same pattern as payout-threshold), and the source's
// `alignItemWithTrigger={false}` + `align="end"` map to zag positioning.
import Button from "@marko-ui/registry/ui/button/button.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import Field from "@marko-ui/registry/ui/field/field.marko";
import FieldLabel from "@marko-ui/registry/ui/field/field-label.marko";
import Input from "@marko-ui/registry/ui/input/input.marko";
import InputGroup from "@marko-ui/registry/ui/input-group/input-group.marko";
import InputGroupAddon from "@marko-ui/registry/ui/input-group/addon.marko";
import InputGroupButton from "@marko-ui/registry/ui/input-group/button.marko";
import InputGroupInput from "@marko-ui/registry/ui/input-group/input.marko";
import Select from "@marko-ui/registry/ui/select/select.marko";
import Separator from "@marko-ui/registry/ui/separator/separator.marko";
import Icon from "../../lib/icon.marko";

static const INVITES = [
  { email: "alex@example.com", role: "Editor" },
  { email: "sam@example.com", role: "Viewer" },
];

static const ROLES = [
  { label: "Admin", value: "admin" },
  { label: "Editor", value: "editor" },
  { label: "Viewer", value: "viewer" },
];

<Card>
  <CardHeader>
    <CardTitle>Invite Team</CardTitle>
    <CardDescription>Add members to your workspace</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <div class="flex flex-col gap-3">
      <for|invite| of=INVITES by=(invite) => invite.email>
        <div class="flex items-center gap-2">
          <Input value=invite.email class="flex-1"/>
          <Select
            items=ROLES
            defaultValue=[invite.role.toLowerCase()]
            positioning={ placement: "bottom-end" }
            class="[&_[data-slot=select-trigger]]:w-24"
          />
        </div>
      </for>
    </div>
    <Button variant="outline">
      <Icon name="PlusIcon"/>
      Add another
    </Button>
    <Separator/>
    <Field>
      <FieldLabel for="invite-link">Or share invite link</FieldLabel>
      <InputGroup>
        <InputGroupInput
          id="invite-link"
          value="https://app.co/invite/x8f2k"
          readonly
        />
        <InputGroupAddon align="inline-end">
          <InputGroupButton size="icon-xs" aria-label="Copy link">
            <Icon name="CopyIcon"/>
          </InputGroupButton>
        </InputGroupAddon>
      </InputGroup>
    </Field>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Send Invites</Button>
  </CardFooter>
</Card>
