// Ported from shadcn registry/bases/base/blocks/preview/cards/invoice.tsx
import Badge from "@marko-ui/shadcn/ui/badge/badge.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import Card from "@marko-ui/shadcn/ui/card/card.marko";
import CardAction from "@marko-ui/shadcn/ui/card/action.marko";
import CardContent from "@marko-ui/shadcn/ui/card/content.marko";
import CardDescription from "@marko-ui/shadcn/ui/card/description.marko";
import CardFooter from "@marko-ui/shadcn/ui/card/footer.marko";
import CardHeader from "@marko-ui/shadcn/ui/card/header.marko";
import CardTitle from "@marko-ui/shadcn/ui/card/title.marko";
import Table from "@marko-ui/shadcn/ui/table/table.marko";
import TableBody from "@marko-ui/shadcn/ui/table/body.marko";
import TableCell from "@marko-ui/shadcn/ui/table/cell.marko";
import TableHead from "@marko-ui/shadcn/ui/table/head.marko";
import TableHeader from "@marko-ui/shadcn/ui/table/header.marko";
import TableRow from "@marko-ui/shadcn/ui/table/row.marko";

static const INVOICE_ITEMS = [
  { item: "Design System License", qty: 1, unitPrice: 499 },
  { item: "Priority Support", qty: 12, unitPrice: 99 },
  { item: "Custom Components", qty: 3, unitPrice: 250 },
];

static const subtotal = INVOICE_ITEMS.reduce(
  (sum, row) => sum + row.qty * row.unitPrice,
  0,
);
static const totalDue = subtotal;

static function formatCurrency(value: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 2,
  }).format(value);
}

<Card>
  <CardHeader>
    <CardTitle>Invoice #INV-2847</CardTitle>
    <CardDescription>Due March 30, 2026</CardDescription>
    <CardAction>
      <Badge variant="secondary">Pending</Badge>
    </CardAction>
  </CardHeader>
  <CardContent>
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>Item</TableHead>
          <TableHead class="text-right">Qty</TableHead>
          <TableHead class="text-right">Rate</TableHead>
          <TableHead class="text-right">Amount</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <for|row| of=INVOICE_ITEMS by=(row) => row.item>
          <TableRow>
            <TableCell>${row.item}</TableCell>
            <TableCell class="text-right tabular-nums">${row.qty}</TableCell>
            <TableCell class="text-right tabular-nums">
              ${formatCurrency(row.unitPrice)}
            </TableCell>
            <TableCell class="text-right tabular-nums">
              ${formatCurrency(row.qty * row.unitPrice)}
            </TableCell>
          </TableRow>
        </for>
        <TableRow>
          <TableCell colspan=3 class="text-right">
            Subtotal
          </TableCell>
          <TableCell class="text-right tabular-nums">
            ${formatCurrency(subtotal)}
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell colspan=3 class="text-right">
            Tax
          </TableCell>
          <TableCell class="text-right tabular-nums">$0.00</TableCell>
        </TableRow>
        <TableRow>
          <TableCell colspan=3 class="text-right">
            Total Due
          </TableCell>
          <TableCell class="text-right tabular-nums">
            ${formatCurrency(totalDue)}
          </TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </CardContent>
  <CardFooter>
    <Button variant="outline" size="sm">
      Download PDF
    </Button>
    <Button size="sm" class="ml-auto">
      Pay Now
    </Button>
  </CardFooter>
</Card>
