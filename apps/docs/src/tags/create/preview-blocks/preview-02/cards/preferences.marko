import Button from "@marko-ui/registry/ui/button/button.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardAction from "@marko-ui/registry/ui/card/action.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import Select from "@marko-ui/registry/ui/select/select.marko";
import Switch from "@marko-ui/registry/ui/switch/switch.marko";
import Field from "../../lib/field.marko";
import FieldContent from "../../lib/field-content.marko";
import FieldDescription from "../../lib/field-description.marko";
import FieldGroup from "../../lib/field-group.marko";
import FieldLabel from "../../lib/field-label.marko";
import FieldSeparator from "../../lib/field-separator.marko";
import Icon from "../../lib/icon.marko";

static const CURRENCIES = [
  { label: "USD — United States Dollar", value: "usd" },
  { label: "EUR — Euro", value: "eur" },
  { label: "GBP — British Pound", value: "gbp" },
  { label: "JPY — Japanese Yen", value: "jpy" },
];

<Card>
  <CardHeader>
    <CardTitle>Preferences</CardTitle>
    <CardDescription>
      Manage your account settings and notifications.
    </CardDescription>
    <CardAction>
      <Button variant="ghost" size="icon-sm" class="bg-muted">
        <Icon name="XIcon"/>
      </Button>
    </CardAction>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <Field>
        <FieldLabel for="default-currency">Default Currency</FieldLabel>
        <Select id="default-currency" items=CURRENCIES defaultValue=["usd"] class="w-full"/>
      </Field>
      <FieldSeparator class="-my-4 style-sera:hidden"/>
      <Field orientation="horizontal">
        <FieldContent>
          <FieldLabel for="public-statistics">Public Statistics</FieldLabel>
          <FieldDescription>
            Allow others to see your total stream count and listening
            activity
          </FieldDescription>
        </FieldContent>
        <Switch id="public-statistics" defaultChecked/>
      </Field>
      <FieldSeparator class="-my-4 style-sera:hidden"/>
      <Field orientation="horizontal">
        <FieldContent>
          <FieldLabel for="email-notifications">Email Notifications</FieldLabel>
          <FieldDescription>
            Monthly royalty reports and distribution updates
          </FieldDescription>
        </FieldContent>
        <Switch id="email-notifications" defaultChecked/>
      </Field>
    </FieldGroup>
  </CardContent>
  <CardFooter>
    <Button variant="outline">Reset</Button>
    <Button class="ml-auto">Save Preferences</Button>
  </CardFooter>
</Card>
