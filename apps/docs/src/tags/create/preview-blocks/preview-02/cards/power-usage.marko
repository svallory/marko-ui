// Chart deviation: recharts BarChart replaced by the static lib/bar-chart
// stand-in (same hourly data, var(--chart-2)).
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import Progress from "@marko-ui/registry/ui/progress/progress.marko";
import Separator from "@marko-ui/registry/ui/separator/separator.marko";
import BarChart from "../../lib/bar-chart.marko";

static const DATA = [1.2, 2.8, 3.1, 2.4, 3.4, 2.9, 3.8, 3.2];
static const HOURS = ["6a", "8a", "10a", "12p", "2p", "4p", "6p", "8p"];

<Card>
  <CardHeader>
    <CardTitle>Power Usage</CardTitle>
    <CardDescription>Whole Home</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    <BarChart
      values=DATA
      labels=HOURS
      radius=4
      class="h-[140px] w-full"
    />
    <Separator/>
    <div class="grid grid-cols-2 gap-4">
      <div class="flex flex-col gap-0.5">
        <span class="text-sm text-muted-foreground">Currently Using</span>
        <span class="text-lg font-semibold tabular-nums">3.4 kW</span>
      </div>
      <div class="flex flex-col gap-0.5">
        <span class="text-sm text-muted-foreground">Solar Gen</span>
        <span class="text-lg font-semibold text-chart-1 tabular-nums">
          +1.2 kW
        </span>
      </div>
    </div>
  </CardContent>
  <CardFooter class="flex-col items-start gap-1">
    <span class="text-sm text-muted-foreground">Battery Level</span>
    <div class="flex w-full items-center gap-2">
      <Progress value=85 class="flex-1"/>
      <span class="text-sm font-medium tabular-nums">85%</span>
    </div>
  </CardFooter>
</Card>
