    </Button>
    // Source renders Item as <a href="#"> via render prop.
    <a href="#" class="w-full" data-slot="item-link">
      <Item variant="muted">
        <ItemMedia variant="icon">
          <Icon name="AlertCircleIcon" class="text-destructive"/>
