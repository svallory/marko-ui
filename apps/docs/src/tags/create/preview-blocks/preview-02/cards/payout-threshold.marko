// Ported from shadcn registry/bases/base/blocks/preview-02/cards/payout-threshold.tsx
// API adaptation: items-driven Select/Slider.
import Button from "@marko-ui/registry/ui/button/button.marko";
import Card from "@marko-ui/registry/ui/card/card.marko";
import CardAction from "@marko-ui/registry/ui/card/action.marko";
import CardContent from "@marko-ui/registry/ui/card/content.marko";
import CardDescription from "@marko-ui/registry/ui/card/description.marko";
import CardFooter from "@marko-ui/registry/ui/card/footer.marko";
import CardHeader from "@marko-ui/registry/ui/card/header.marko";
import CardTitle from "@marko-ui/registry/ui/card/title.marko";
import Select from "@marko-ui/registry/ui/select/select.marko";
import Slider from "@marko-ui/registry/ui/slider/slider.marko";
import Textarea from "@marko-ui/registry/ui/textarea/textarea.marko";
import Field from "../../lib/field.marko";
import FieldDescription from "../../lib/field-description.marko";
import FieldGroup from "../../lib/field-group.marko";
import FieldLabel from "../../lib/field-label.marko";
import Icon from "../../lib/icon.marko";

static const CURRENCIES = [
  { label: "USD — United States Dollar", value: "usd" },
  { label: "EUR — Euro", value: "eur" },
  { label: "GBP — British Pound", value: "gbp" },
  { label: "JPY — Japanese Yen", value: "jpy" },
];

<let/amount=[2500]/>

<Card>
  <CardHeader>
    <CardTitle>Payout Threshold</CardTitle>
    <CardDescription>
      Set the minimum balance required before a payout is triggered.
    </CardDescription>
    <CardAction>
      <Button variant="ghost" size="icon-sm" class="bg-muted">
        <Icon name="XIcon"/>
      </Button>
    </CardAction>
  </CardHeader>
  <CardContent>
    <FieldGroup>
      <Field>
        <FieldLabel for="preferred-currency">Preferred Currency</FieldLabel>
        <Select id="preferred-currency" items=CURRENCIES defaultValue=["usd"] class="w-full"/>
      </Field>
      <Field>
        <div class="flex items-baseline justify-between">
          <FieldLabel for="min-payout">Minimum Payout Amount</FieldLabel>
          <span class="text-2xl font-semibold tabular-nums">
            $${amount[0].toFixed(2)}
          </span>
        </div>
        <Slider
          id="min-payout"
          value=amount
          valueChange=(value: number[]) => { amount = [...value]; }
          min=50
          max=10000
          step=50
        />
        <div class="flex items-center justify-between">
          <FieldDescription>$50 (MIN)</FieldDescription>
          <FieldDescription>$10,000 (MAX)</FieldDescription>
        </div>
      </Field>
      <Field>
        <FieldLabel for="payout-notes">Notes</FieldLabel>
        <Textarea
          id="payout-notes"
          placeholder="Add any notes for this payout configuration..."
          class="min-h-[100px]"
        />
      </Field>
    </FieldGroup>
  </CardContent>
  <CardFooter>
    <Button class="w-full">Save Threshold</Button>
  </CardFooter>
</Card>
