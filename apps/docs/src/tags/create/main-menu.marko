// Ported from shadcn/ui app/(app)/(create)/components/main-menu.tsx.
// Top menu bar of the customizer card header: a single trigger button that
// opens a dropdown with Open Preset/Shuffle/Light-Dark actions, a
// separator, then Undo/Redo/Reset. The source wires these to context hooks
// (useHistory/useOpenPreset/useRandom/useReset/useThemeToggle); Marko has no
// context, so the design-system container passes the equivalent callbacks +
// canGoBack/canGoForward down as attrs.
//
// Deliberate deviation from source: shadcn's real menu also has a
// "Navigate..." item (⌘P) wired to useActionMenuTrigger() / the ⌘K-style
// item-explorer command palette. Per explicit user direction this whole
// surface — the "Actions" footer button that used to open it, the palette
// itself (search in it didn't even work), and the dead item-explorer.marko
// it fronted — has been removed from this port. This is where that item
// used to live in the dropdown.
//
// Round 2: rebuilt on the registry DropdownMenu instead of a hand-rolled
// @zag-js/menu popup — only plain action items here, no new capability
// needed. Dark floating-panel look kept as a `class` override, matching
// shadcn's own upstream class for this popup (see picker.tsx).
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import type { DropdownMenuItem } from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";

export interface Input {
  class?: string;
  canGoBack: boolean;
  canGoForward: boolean;
  onUndo: () => void;
  onRedo: () => void;
  onShuffle: () => void;
  onToggleTheme: () => void;
  onOpenPreset: () => void;
  onShowResetDialog: () => void;
}

<let/isMac=false/>
<lifecycle
  onMount() {
    const platform = navigator.platform;
    const userAgent = navigator.userAgent;
    isMac = /Mac|iPhone|iPad|iPod/.test(platform || userAgent);
  }
/>

<const/items=[
  // Deliberate deviation: shadcn's "Navigate..." (⌘P) item used to go here —
  // removed along with the action-menu surface (see header comment).
  { type: "item", value: "open-preset", label: "Open Preset...", shortcut: "O" },
  { type: "item", value: "shuffle", label: "Shuffle", shortcut: "R" },
  { type: "item", value: "toggle-theme", label: "Light/Dark", shortcut: "D" },
  { type: "separator" },
  { type: "item", value: "undo", label: "Undo", shortcut: (isMac ? "⌘Z" : "Ctrl+Z"), disabled: !input.canGoBack },
  { type: "item", value: "redo", label: "Redo", shortcut: (isMac ? "⇧⌘Z" : "Ctrl+Shift+Z"), disabled: !input.canGoForward },
  { type: "separator" },
  { type: "item", value: "reset", label: "Reset", shortcut: "⇧R" },
] satisfies DropdownMenuItem[]/>

<div data-slot="main-menu">
  <DropdownMenu
    items=items
    positioning={ placement: "right-start", gutter: 20, offset: { crossAxis: -8 } }
    class="bg-neutral-950/80 text-neutral-100 ring-neutral-950/80 backdrop-blur-xl dark:bg-neutral-800/90 dark:ring-neutral-700/50 **:data-[slot=dropdown-menu-separator]:bg-neutral-600 dark:**:data-[slot=dropdown-menu-separator]:bg-neutral-700 **:data-[slot=dropdown-menu-item]:text-neutral-100 **:data-[slot=dropdown-menu-item]:focus:bg-neutral-600 dark:**:data-[slot=dropdown-menu-item]:focus:bg-neutral-700/80 **:data-[slot=dropdown-menu-shortcut]:text-neutral-400!"
    select(value: string) {
      switch (value) {
        case "open-preset":
          input.onOpenPreset();
          break;
        case "shuffle":
          input.onShuffle();
          break;
        case "toggle-theme":
          input.onToggleTheme();
          break;
        case "undo":
          input.onUndo();
          break;
        case "redo":
          input.onRedo();
          break;
        case "reset":
          input.onShowResetDialog();
          break;
      }
    }
  >
    <@trigger|triggerProps|>
      <button type="button"
        ...triggerProps
        class=cn(
          "flex items-center justify-between gap-2 rounded-lg px-1.75 ring-1 ring-foreground/10 focus-visible:ring-1",
          input.class,
        )
      >
        <span class="font-medium">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </@trigger>
  </DropdownMenu>
</div>
