// Ported from shadcn/ui app/(app)/(create)/components/preview-switcher.tsx
// (quoted verbatim in the phase-5 task brief). NOT a desktop/tablet/mobile
// viewport toggle (that doesn't exist anywhere in the source — grepped the
// whole (create) tree for "desktop"/"tablet"/"mobile"/"viewport" and it
// isn't there). It's a two-item "01"/"02" preview switcher between shadcn's
// two dedicated dashboard-style showcase registry items:
// "01" -> "preview-02" (the wide multi-column card grid, and the default
// `item` value), "02" -> "preview" (the second showcase page). The gate
// mirrors the source's `isPreview` check exactly: visible only while
// `item === "preview"` or `item` starts with "preview-0" (so "preview-03",
// dead code in the real product, would also satisfy the gate there even
// though it isn't one of the two switchable items — matched literally).
import Button from "@marko-ui/registry/ui/button/button.marko";

export interface Input {
  item: string;
  onItemChange: (item: string) => void;
}

static const PREVIEW_ITEMS = [
  { label: "01", value: "preview-02" },
  { label: "02", value: "preview" },
] as const;

<const/isPreviewItem=(input.item === "preview" || input.item.startsWith("preview-0"))/>

<if=isPreviewItem>
  <div class="dark absolute right-3 bottom-3 z-20 flex items-center gap-1 rounded-xl bg-card/90 p-1 shadow-xl backdrop-blur-xl" data-slot="preview-switcher">
    <for|item| of=PREVIEW_ITEMS by=(item) => item.value>
      <Button
        variant="ghost"
        size="sm"
        data-active=(input.item === item.value)
        class="h-7 min-w-8 cursor-pointer rounded-lg px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground"
        on-click() { input.onItemChange(item.value); }
      >
        ${item.label}
      </Button>
    </for>
  </div>
</if>
