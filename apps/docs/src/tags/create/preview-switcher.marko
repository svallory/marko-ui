// Ported from shadcn/ui app/(app)/(create)/components/preview-switcher.tsx
// (quoted verbatim in the phase-5 task brief). NOT a desktop/tablet/mobile
// viewport toggle (that doesn't exist anywhere in the source — grepped the
// whole (create) tree for "desktop"/"tablet"/"mobile"/"viewport" and it
// isn't there). It's the pager between the preview showcase pages, shown
// only while the current `item` is one of them (the source gates on its
// registry item names via `item === "preview" || item.startsWith(
// "preview-0")`; our position-based names gate on the "preview-page-"
// prefix instead).
//
// Our pages use position-based item names:
// "01" -> preview-page-1 (ports shadcn's `preview-02`, their default),
// "02" -> preview-page-2 (ports shadcn's `preview`),
// "03" -> preview-page-3 (this repo's own showcase of marko-ui-unique
// components — an intentional addition over shadcn's two-item pager).
import Button from "@marko-ui/shadcn/ui/button/button.marko";

export interface Input {
  item: string;
  onItemChange: (item: string) => void;
}

static const PREVIEW_ITEMS = [
  { label: "01", value: "preview-page-1" },
  { label: "02", value: "preview-page-2" },
  { label: "03", value: "preview-page-3" },
] as const;

<const/isPreviewItem=input.item.startsWith("preview-page-")/>

<if=isPreviewItem>
  <div class="dark absolute right-3 bottom-3 z-20 flex items-center gap-1 rounded-xl bg-card/90 p-1 shadow-xl backdrop-blur-xl" data-slot="preview-switcher">
    <for|item| of=PREVIEW_ITEMS by=(item) => item.value>
      <Button
        variant="ghost"
        size="sm"
        data-active=String(input.item === item.value)
        class="h-7 min-w-8 cursor-pointer rounded-lg px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground"
        on-click() { input.onItemChange(item.value); }
      >
        ${item.label}
      </Button>
    </for>
  </div>
</if>
