// Ported from shadcn/ui app/(app)/(create)/components/open-preset.tsx
// (desktop Dialog variant; the source's mobile Drawer variant is collapsed
// into the same dialog — this repo has no drawer primitive and the fields,
// validation, and submit flow are identical between the two).
//
// Controlled from the design-system container (open + openChange) so the
// customizer footer button, the main-menu item, and the "o" shortcut can
// all open it — the Marko equivalent of the source's useSWR-keyed
// useOpenPreset() shared open state. Input validation is live via
// parsePresetInput: accepts a bare code ("b2D0wqNxT") or a
// "--preset b2D0wqNxT" CLI flag, marks the field invalid otherwise, and
// disables Open until the input parses.
import { parsePresetInput } from "./lib/parse-preset-input.ts";
import Dialog from "@marko-ui/shadcn/ui/dialog/dialog.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import TextInput from "@marko-ui/shadcn/ui/input/input.marko";
import Label from "@marko-ui/shadcn/ui/label/label.marko";

export interface Input {
  open: boolean;
  openChange: (open: boolean) => void;
  onSubmitPreset: (preset: string) => void;
}

static const PRESET_EXAMPLE = "b2D0wqNxT";
static const PRESET_TITLE = "Open Preset";
static const PRESET_DESCRIPTION =
  "Paste a preset code to load a saved configuration.";

<let/inputValue=""/>

<const/nextPreset=parsePresetInput(inputValue)/>
<const/isInvalid=(inputValue.trim().length > 0 && nextPreset === null)/>

<const/handleOpenChange=(open: boolean) => {
  input.openChange(open);
  if (!open) {
    inputValue = "";
  }
}/>

<const/handleSubmit=(event: Event) => {
  event.preventDefault();
  if (!nextPreset) {
    return;
  }
  input.onSubmitPreset(nextPreset);
  handleOpenChange(false);
}/>

<Dialog open=input.open openChange=handleOpenChange class="dark sm:max-w-md">
  <@title>${PRESET_TITLE}</@title>
  <@description>${PRESET_DESCRIPTION}</@description>
  <form on-submit=handleSubmit data-slot="open-preset-form">
    <div class="py-4">
      <Label for="preset-code" class="sr-only">Preset code</Label>
      <TextInput
        id="preset-code"
        value=inputValue
        on-input(event: Event) {
          inputValue = (event.target as HTMLInputElement).value;
        }
        placeholder=`${PRESET_EXAMPLE} or --preset ${PRESET_EXAMPLE}`
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        aria-invalid=(isInvalid ? "true" : "false")
        class="md:h-8"
      />
    </div>
    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <Button
        type="button"
        variant="outline"
        on-click() { handleOpenChange(false); }
      >
        Cancel
      </Button>
      <Button
        type="submit"
        disabled=!nextPreset
      >
        Open
      </Button>
    </div>
  </form>
</Dialog>
