// Ported from shadcn/ui app/(app)/(create)/components/icon-placeholder.tsx.
// Source: given one icon name per library as attrs (`lucide="Home"
// tabler="IconHome" ...`), it looks up the CURRENT iconLibrary param and
// lazy-renders that library's icon component.
//
// UNBLOCKED 2026-08-13: the icon system landed
// (packages/shadcn/ui/icon/, see TODO.md's resolved "icon
// strategy" entry), so this now actually renders instead of always
// returning shadcn's square Suspense fallback. iconLibrary is read from the
// URL at SSR time (matching ./preview-blocks/lib/icon.marko's identical
// pattern — no prop-threading, no context API in Marko 6); live switching
// without a reload happens via the /create/preview route's postMessage
// handler, which patches every `[data-icon-name]` element the underlying
// Icon component renders (same mechanism, see that route's header comment).
//
// Nothing in this port's preview items currently uses this exact
// per-library-attrs shape (preview.marko's cards call the registry Icon
// tag directly, or go through preview-blocks/lib/icon.marko's single
// `name` prop) — this tag exists for API parity with shadcn's source so
// anything reaching for it compiles and renders correctly, not because a
// call site needs it today.
import Icon from "@marko-ui/shadcn/ui/icon/icon.marko";
import type { IconLibraryName } from "@marko-ui/shadcn/ui/icon/icon-names.ts";

// Mirrors shadcn's `{ [K in IconLibraryName]: string }` mapped-type input —
// every library name is a valid attr, all optional (a card only needs to
// pass the libraries it actually has a mapping for).
export interface Input extends Partial<Record<IconLibraryName, string>> {
  class?: string;
}

<const/iconLibrary=($global.url.searchParams.get("iconLibrary") ?? "lucide") as IconLibraryName/>
<const/name=input[iconLibrary]/>

<if=name>
  <Icon name=name library=iconLibrary class=input.class/>
</if>
