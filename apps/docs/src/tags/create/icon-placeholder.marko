// Ported from shadcn/ui app/(app)/(create)/components/icon-placeholder.tsx.
// Source: given one icon name per library as attrs (`lucide="Home"
// tabler="IconHome" ...`), it looks up the CURRENT iconLibrary param and
// lazy-renders that library's icon component — used throughout shadcn's own
// preview registry items (their `component-example`/blocks) so a single
// demo's icons swap when the iconLibrary picker changes.
//
// Honest gap: this repo's registry components (packages/registry/default/**)
// render icons as hardcoded inline SVGs per component, not through a
// swappable icon-library abstraction — there is no lucide-react/
// @tabler/icons-react/etc. dependency to lazy-import here, and porting one
// would mean re-authoring every registry component's icon usage, which is
// out of scope for the /create page port. This tag is kept for API parity
// (so anything reaching for it compiles) but only ever renders a plain
// square fallback glyph (shadcn's own SquareIcon Suspense fallback),
// ignoring which library name is passed and the current iconLibrary param —
// it does NOT actually switch libraries. The iconLibrary picker itself
// still fully works (commits to the URL/preset code, as verified in phase
// 4's browser check); only preview content built with this tag wouldn't
// react to it. Nothing in this port's preview items currently uses this
// tag — see preview.marko's header comment for why (real registry
// components, not shadcn's icon-placeholder-based demo items).
export interface Input {
  lucide?: string;
  tabler?: string;
  hugeicons?: string;
  phosphor?: string;
  remixicon?: string;
  class?: string;
}

<if=(input.lucide || input.tabler || input.hugeicons || input.phosphor || input.remixicon)>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=input.class>
    <rect width="18" height="18" x="3" y="3" rx="2"/>
  </svg>
</if>
