// Floating token-picker panel, adapted from shadcn/ui's `Customizer` (MIT):
// a dark-chrome card pinned over the top-left of the canvas rather than
// docked in page flow. Each row is a real, functional picker — no row here
// is decorative — because marko-ui resolves every choice to concrete CSS
// custom properties instead of swapping between pre-authored theme files.
import Button from "@marko-ui/registry/ui/button/button.marko";
import Separator from "@marko-ui/registry/ui/separator/separator.marko";
import {
  BASE_COLORS,
  ACCENTS,
  RADII,
  FONTS,
  CHART_PALETTES,
  type DesignSystemConfig,
} from "./theme-options.ts";

export interface Input extends Marko.Input<"div"> {
  config: DesignSystemConfig;
  configChange: (config: DesignSystemConfig) => void;
  /** Hover preview: a partial overlay applied without committing. */
  previewChange: (overlay: Partial<DesignSystemConfig> | null) => void;
  mode: "light" | "dark";
  modeChange: (mode: "light" | "dark") => void;
  onRandomize: () => void;
  onReset: () => void;
  onCopy: () => void;
  copyState: string;
}

<const/{ class: className, config, configChange, previewChange, mode, modeChange, onRandomize, onReset, onCopy, copyState, ...rest }=input/>

<const/baseColorOptions=BASE_COLORS.map((baseColor) => ({
  name: baseColor.name,
  label: baseColor.title,
  swatch: baseColor.swatch,
}))/>
<const/accentOptions=ACCENTS.map((accent) => ({
  name: accent.name,
  label: accent.title,
  swatch: accent.swatch,
}))/>
<const/radiusOptions=RADII.map((radius) => ({
  name: radius.name,
  label: radius.label,
}))/>
<const/fontOptions=FONTS.map((font) => ({
  name: font.name,
  label: font.label,
}))/>
<const/chartOptions=CHART_PALETTES.map((palette) => ({
  name: palette.name,
  label: palette.label,
  swatch: palette.colors[0],
}))/>

// Single stable handlers keyed by field name. A factory returning a fresh
// closure per picker would not survive Marko's serialization boundary.
<const/update=(field: string, value: string) => {
  configChange({ ...config, [field]: value });
}/>

<const/preview=(field: string, value: string | null) => {
  previewChange(value === null ? null : { [field]: value });
}/>

<div
  ...rest
  class=`dark flex max-h-[calc(100vh-8rem)] w-72 shrink-0 flex-col gap-0 self-start overflow-visible rounded-2xl border border-border bg-card/90 text-card-foreground shadow-2xl backdrop-blur-xl ${className ?? ""}`
  data-slot="customizer"
>
  <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-3">
    <span class="text-sm font-semibold tracking-tight">Menu</span>
    <button
      type="button"
      aria-label="Toggle preview mode"
      title=`Preview in ${mode === "dark" ? "light" : "dark"} mode`
      class="inline-flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      onClick() {
        modeChange(mode === "dark" ? "light" : "dark");
      }
    >
      <if=(mode === "dark")>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/>
          <path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/>
          <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
      </if>
      <else>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </else>
    </button>
  </div>

  <div class="flex min-h-0 flex-1 flex-col gap-3 overflow-visible p-4 md:overflow-y-auto">
    <create-picker
      label="Base Color"
      options=baseColorOptions
      value=config.baseColor
      field="baseColor"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Theme"
      options=accentOptions
      value=config.accent
      field="accent"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Chart Color"
      options=chartOptions
      value=config.chart
      field="chart"
      valueChange=update
      previewChange=preview
    />

    <Separator class="my-1"/>

    <create-picker
      label="Heading"
      options=fontOptions
      value=config.fontHeading
      field="fontHeading"
      valueChange=update
      previewChange=preview
    />
    <create-picker
      label="Font"
      options=fontOptions
      value=config.font
      field="font"
      valueChange=update
      previewChange=preview
    />

    <Separator class="my-1"/>

    <create-picker
      label="Radius"
      options=radiusOptions
      value=config.radius
      field="radius"
      valueChange=update
      previewChange=preview
    />
  </div>

  <div class="flex flex-col gap-2 border-t border-border p-4">
    <Button size="sm" class="w-full" onClick=onCopy>
      ${copyState}
    </Button>
    <div class="flex gap-2">
      <Button size="sm" variant="outline" class="flex-1" onClick=onRandomize>
        Shuffle
      </Button>
      <Button size="sm" variant="outline" class="flex-1" onClick=onReset>
        Reset
      </Button>
    </div>
  </div>
</div>
