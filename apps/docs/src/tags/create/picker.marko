// Reusable popover/radio-picker primitive for the /create theme builder
// sidebar. Ported behaviorally from shadcn's
// app/(app)/(create)/components/picker.tsx (Base UI `Menu` primitive).
//
// Round 2: rebuilt on the registry DropdownMenu (packages/shadcn/ui/
// dropdown-menu) instead of a hand-rolled @zag-js/menu popup — a single
// radio section list with hover-preview and a mobile anchor override needed
// no new registry capability beyond the positioning/onHighlightChange
// pass-throughs added to dropdown-menu.marko for this task. Hover-preview
// (shadcn's `onItemPreview`) still comes from zag's own `onHighlightChange`,
// unchanged behaviorally from the hand-rolled version. The dark
// floating-panel look (bg-neutral-950/80) is shadcn's own verbatim upstream
// class for this popup, kept as a `class` override on the registry
// component rather than the registry default.
import DropdownMenu from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import type { DropdownMenuItem } from "@marko-ui/shadcn/ui/dropdown-menu/dropdown-menu.marko";
import type * as menu from "@zag-js/menu";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";

export interface PickerRadioOption {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface PickerRadioGroupSection {
  /** Optional group label (PickerLabel in the source). */
  label?: string;
  /** Options rendered together, separated from other sections by a divider. */
  options: PickerRadioOption[];
}

export interface Input {
  /** Trigger content — renders inside the styled trigger button. */
  trigger: Marko.AttrTag<{ content: Marko.Body }>;
  /** Radio sections, rendered in order with a separator between each. */
  sections: PickerRadioGroupSection[];
  /** Currently committed value. */
  value: string | undefined;
  onValueChange: (value: string) => void;
  /**
   * Fired when the highlighted (hovered/focused) item changes; `null` when
   * nothing is highlighted (menu closed or pointer left the list). Mirrors
   * shadcn's `onItemPreview` / `clearOverride` pairing.
   */
  onItemPreview?: (value: string | null) => void;
  /** Close the picker immediately on click (mobile behavior upstream). */
  closeOnClick?: boolean;
  side?: "top" | "bottom" | "left" | "right";
  align?: "start" | "center" | "end";
  /** Distance (px) from the trigger along the side axis. shadcn's PickerContent default is 20. */
  sideOffset?: number;
  /** Distance (px) along the align axis. shadcn's PickerContent default is 0. */
  alignOffset?: number;
  /** Disables the trigger (e.g. radius-picker when the current style forces a fixed radius). */
  disabled?: boolean;
  class?: string;
  contentClass?: string;
}

<const/items=input.sections.flatMap((section, sectionIndex): DropdownMenuItem[] => [
  ...(sectionIndex > 0 ? [{ type: "separator" as const }] : []),
  ...(section.label ? [{ type: "label" as const, label: section.label }] : []),
  ...section.options.map((option): DropdownMenuItem => ({
    type: "radio",
    value: option.value,
    label: option.label,
    disabled: option.disabled,
    checked: option.value === input.value,
    radioGroup: "picker",
  })),
]) satisfies DropdownMenuItem[]/>

<DropdownMenu
  items=items
  disabled=input.disabled
  closeOnSelect=input.closeOnClick
  positioning={
    placement: `${input.side ?? "bottom"}${input.align && input.align !== "center" ? `-${input.align}` : ""}` as NonNullable<menu.Props["positioning"]>["placement"],
    gutter: input.sideOffset ?? 20,
    shift: input.alignOffset ?? 0,
  }
  onHighlightChange(details: menu.HighlightChangeDetails) {
    input.onItemPreview?.(details.highlightedValue);
  }
  onOpenChange(details: menu.OpenChangeDetails) {
    if (!details.open) input.onItemPreview?.(null);
  }
  class=cn(
    "bg-neutral-950/80 text-neutral-100 ring-neutral-950/80 backdrop-blur-xl dark:bg-neutral-800/90 dark:ring-neutral-700/50 **:data-[slot=dropdown-menu-label]:text-neutral-400 **:data-[slot=dropdown-menu-separator]:bg-neutral-600 dark:**:data-[slot=dropdown-menu-separator]:bg-neutral-700 **:data-[slot=dropdown-menu-radio-item]:text-neutral-100 **:data-[slot=dropdown-menu-radio-item]:focus:bg-neutral-600 dark:**:data-[slot=dropdown-menu-radio-item]:focus:bg-neutral-700/80",
    input.contentClass,
  )
  radioChange(_group, value) {
    input.onValueChange(value);
  }
>
  <@trigger|triggerProps|>
    <button type="button"
      ...triggerProps
      disabled=input.disabled
      class=cn(
        "relative w-36 shrink-0 touch-manipulation rounded-xl p-3 ring-1 ring-foreground/10 select-none hover:bg-muted focus-visible:ring-foreground/50 focus-visible:outline-none disabled:opacity-50 data-[state=open]:bg-muted md:w-full md:rounded-lg md:px-2.5 md:py-2",
        input.class,
      )
    >
      <${input.trigger.content}/>
    </button>
  </@trigger>
</DropdownMenu>
