// Ported from shadcn/ui app/(app)/(create)/components/chart-color-picker.tsx.
// Structurally identical to theme-picker.marko (two sections split on
// BASE_COLORS membership, same swatch logic) but its option list is
// `getThemesForBaseColor(baseColor)` scoped to the *current* baseColor
// rather than a caller-supplied `themes` prop — verbatim source behavior.
//
// Deviation: LockButton restored in phase 3 (locked/onToggleLock attrs from the design-system container).
import {
  BASE_COLORS,
  getThemesForBaseColor,
  type BaseColorName,
  type ChartColorName,
} from "./lib/registry-config.ts";
import Picker from "./picker.marko";
import LockButton from "./lock-button.marko";

export interface Input {
  baseColor: BaseColorName;
  value: ChartColorName;
  onValueChange: (value: ChartColorName) => void;
  onItemPreview?: (value: ChartColorName | null) => void;
  locked: boolean;
  onToggleLock: () => void;
  isMobile?: boolean;
}

<const/availableChartColors=getThemesForBaseColor(input.baseColor)/>
<const/currentChartColor=availableChartColors.find((theme) => theme.name === input.value)/>
<const/currentChartColorIsBaseColor=BASE_COLORS.find((baseColor) => baseColor.name === input.value)/>
<const/swatchColor=currentChartColor?.cssVars?.dark?.[currentChartColorIsBaseColor ? "muted-foreground" : "primary"]/>

<const/baseColorThemes=availableChartColors.filter(
  (theme) => BASE_COLORS.find((baseColor) => baseColor.name === theme.name),
)/>
<const/otherThemes=availableChartColors.filter(
  (theme) => !BASE_COLORS.find((baseColor) => baseColor.name === theme.name),
)/>

<div class="group/picker relative">
  <Picker
    value=input.value
    onValueChange=(value) => input.onValueChange(value as ChartColorName)
    onItemPreview=(value) => input.onItemPreview?.(value as ChartColorName | null)
    closeOnClick=input.isMobile
    side=(input.isMobile ? "top" : "right")
    align=(input.isMobile ? "center" : "start")
    contentClass="max-h-92"
    sections=[
      { options: baseColorThemes.map((theme) => ({ value: theme.name, label: theme.title })) },
      { options: otherThemes.map((theme) => ({ value: theme.name, label: theme.title })) },
    ]
  >
    <@trigger>
      <div class="flex flex-col justify-start text-left">
        <div class="text-xs text-muted-foreground">Chart Color</div>
        <div class="text-sm font-medium text-foreground">${currentChartColor?.title}</div>
      </div>
      <div
        class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 rounded-full select-none md:right-2.5"
        style=`background: ${swatchColor}`
      />
    </@trigger>
  </Picker>
  <LockButton
    locked=input.locked
    onToggle=input.onToggleLock
    class="absolute top-1/2 right-8 -translate-y-1/2"
  />
</div>
