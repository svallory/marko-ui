// Title block for a component page: heading, description, the Copy Page
// split button (with its View-as-Markdown / Open-in-AI menu), and the
// prev/next component arrows. Mirrors shadcn's docs-nav + DocsCopyPage row.
export interface ComponentNeighbour {
  name: string;
  title: string;
}

export interface Input {
  title: string;
  description?: string;
  /** Absolute path of this page, e.g. /docs/components/switch. */
  href: string;
  previous?: ComponentNeighbour | null;
  next?: ComponentNeighbour | null;
}

// See the +handler comment: @marko/run reserves `.` as a route separator, so
// the raw-markdown twin lives at /<page>/md rather than /<page>.md.
<const/markdownHref=`${input.href}/md`/>

<id/menuId/>

<div/headerEl class="space-y-2" data-slot="component-page-header" data-page-href=input.href>
  <div class="flex items-start justify-between gap-4">
    <h1 class="scroll-m-20 text-3xl font-bold tracking-tight">${input.title}</h1>

    <div class="flex shrink-0 items-center gap-2">
      <!-- Copy Page split button: primary copies the markdown, chevron opens the menu.
           shadcn's DocsCopyPage: rounded-lg pill on bg-secondary, h-8/md:h-7 sizing,
           icon-prefixed primary button, vertical separator, chevron trigger. -->
      <div class="group/buttons relative flex rounded-lg bg-secondary">
        <button
          type="button"
          data-copy-page
          data-markdown-href=markdownHref
          class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-xs font-medium text-secondary-foreground shadow-none transition-colors hover:bg-muted md:h-7 md:text-[0.8rem]"
        >
          <span data-copy-icon aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="8" width="12" height="12" rx="2"/>
              <path d="M4 16V5a2 2 0 0 1 2-2h11"/>
            </svg>
          </span>
          <span data-copy-label>Copy Page</span>
        </button>
        <span class="my-1 w-px shrink-0 bg-foreground/10" aria-hidden="true"></span>
        <button
          type="button"
          data-copy-menu-trigger
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls=menuId
          aria-label="More page actions"
          class="inline-flex h-8 items-center rounded-lg px-1.5 text-secondary-foreground shadow-none transition-colors hover:bg-muted md:h-7"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <div
          id=menuId
          data-copy-menu
          role="menu"
          hidden
          class="absolute right-0 top-full z-50 mt-1 w-56 overflow-hidden rounded-lg border border-border bg-popover p-1 text-popover-foreground shadow-none"
        >
          <a
            role="menuitem"
            href=markdownHref
            class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-xs transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round" viewBox="0 0 22 16" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M19.5 2.25H2.5C1.80964 2.25 1.25 2.80964 1.25 3.5V12.5C1.25 13.1904 1.80964 13.75 2.5 13.75H19.5C20.1904 13.75 20.75 13.1904 20.75 12.5V3.5C20.75 2.80964 20.1904 2.25 19.5 2.25ZM2.5 1C1.11929 1 0 2.11929 0 3.5V12.5C0 13.8807 1.11929 15 2.5 15H19.5C20.8807 15 22 13.8807 22 12.5V3.5C22 2.11929 20.8807 1 19.5 1H2.5ZM3 4.5H4H4.25H4.6899L4.98715 4.82428L7 7.02011L9.01285 4.82428L9.3101 4.5H9.75H10H11V5.5V11.5H9V7.79807L7.73715 9.17572L7 9.97989L6.26285 9.17572L5 7.79807V11.5H3V5.5V4.5ZM15 8V4.5H17V8H19.5L17 10.5L16 11.5L15 10.5L12.5 8H15Z" fill="currentColor"/>
            </svg>
            View as Markdown
          </a>
          <a
            role="menuitem"
            data-ai-link
            data-ai-base="https://claude.ai/new"
            target="_blank"
            rel="noreferrer"
            href="https://claude.ai/new"
            class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-xs transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m4.714 15.956 4.718-2.648.079-.23-.08-.128h-.23l-.79-.048-2.695-.073-2.337-.097-2.265-.122-.57-.121-.535-.704.055-.353.48-.321.685.06 1.518.104 2.277.157 1.651.098 2.447.255h.389l.054-.158-.133-.097-.103-.098-2.356-1.596-2.55-1.688-1.336-.972-.722-.491L2 6.223l-.158-1.008.655-.722.88.06.225.061.893.686 1.906 1.476 2.49 1.833.364.304.146-.104.018-.072-.164-.274-1.354-2.446-1.445-2.49-.644-1.032-.17-.619a2.972 2.972 0 0 1-.103-.729L6.287.133 6.7 0l.995.134.42.364.619 1.415L9.735 4.14l1.555 3.03.455.898.243.832.09.255h.159V9.01l.127-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.583.28.48.685-.067.444-.286 1.851-.558 2.903-.365 1.942h.213l.243-.242.983-1.306 1.652-2.064.728-.82.85-.904.547-.431h1.032l.759 1.129-.34 1.166-1.063 1.347-.88 1.142-1.263 1.7-.79 1.36.074.11.188-.02 2.853-.606 1.542-.28 1.84-.315.832.388.09.395-.327.807-1.967.486-2.307.462-3.436.813-.043.03.049.061 1.548.146.662.036h1.62l3.018.225.79.522.473.638-.08.485-1.213.62-1.64-.389-3.825-.91-1.31-.329h-.183v.11l1.093 1.068 2.003 1.81 2.508 2.33.127.578-.321.455-.34-.049-2.204-1.657-.85-.747-1.925-1.62h-.127v.17l.443.649 2.343 3.521.122 1.08-.17.353-.607.213-.668-.122-1.372-1.924-1.415-2.168-1.141-1.943-.14.08-.674 7.254-.316.37-.728.28-.607-.461-.322-.747.322-1.476.388-1.924.316-1.53.285-1.9.17-.632-.012-.042-.14.018-1.432 1.967-2.18 2.945-1.724 1.845-.413.164-.716-.37.066-.662.401-.589 2.386-3.036 1.439-1.882.929-1.086-.006-.158h-.055L4.138 18.56l-1.13.146-.485-.456.06-.746.231-.243 1.907-1.312Z" fill="currentColor"/>
            </svg>
            Open in Claude
          </a>
          <a
            role="menuitem"
            data-ai-link
            data-ai-base="https://chatgpt.com/"
            target="_blank"
            rel="noreferrer"
            href="https://chatgpt.com/"
            class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-xs transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5Z" fill="currentColor"/>
            </svg>
            Open in ChatGPT
          </a>
        </div>
      </div>

      <!-- Prev/next component arrows. -->
      <div class="hidden items-center gap-1 sm:flex">
        <if=input.previous>
          <a
            href=`/docs/components/${input.previous.name}`
            aria-label=`Previous: ${input.previous.title}`
            title=input.previous.title
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            <span aria-hidden="true">←</span>
          </a>
        </if>
        <if=input.next>
          <a
            href=`/docs/components/${input.next.name}`
            aria-label=`Next: ${input.next.title}`
            title=input.next.title
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            <span aria-hidden="true">→</span>
          </a>
        </if>
      </div>
    </div>
  </div>

  <if=input.description>
    <p class="max-w-2xl text-base text-muted-foreground">${input.description}</p>
  </if>
</div>

<let/onDocumentClick=null/>
<let/copyRevertTimer=null/>

<lifecycle
  onMount() {
    const root = headerEl();
    if (!root) return;

    const menu = root.querySelector("[data-copy-menu]");
    const trigger = root.querySelector("[data-copy-menu-trigger]");
    const copyButton = root.querySelector("[data-copy-page]");
    const copyIcon = root.querySelector("[data-copy-icon]");
    const copyLabel = root.querySelector("[data-copy-label]");

    const COPY_ICON_SVG = copyIcon.innerHTML;
    const CHECK_ICON_SVG =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

    // The .md endpoint is same-origin, so the raw markdown the AI links and
    // the clipboard both use comes from exactly one source of truth.
    const markdownUrl = new URL(
      copyButton.getAttribute("data-markdown-href"),
      window.location.href,
    ).href;

    root.querySelectorAll("[data-ai-link]").forEach((link) => {
      const prompt =
        `I'm looking at this marko-ui documentation: ${markdownUrl}. ` +
        `Help me understand how to use this component.`;
      link.href = `${link.getAttribute("data-ai-base")}?q=${encodeURIComponent(prompt)}`;
    });

    const closeMenu = () => {
      menu.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
    };

    trigger.addEventListener("click", (clickEvent) => {
      clickEvent.stopPropagation();
      const nowOpen = menu.hidden;
      menu.hidden = !nowOpen;
      trigger.setAttribute("aria-expanded", String(nowOpen));
    });

    copyButton.addEventListener("click", async () => {
      copyLabel.textContent = "Copying…";
      try {
        const response = await fetch(markdownUrl);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        await navigator.clipboard.writeText(await response.text());
        copyLabel.textContent = "Copied";
        copyIcon.innerHTML = CHECK_ICON_SVG;
      } catch {
        copyLabel.textContent = "Failed";
      }
      if (copyRevertTimer) clearTimeout(copyRevertTimer);
      copyRevertTimer = setTimeout(() => {
        copyLabel.textContent = "Copy Page";
        copyIcon.innerHTML = COPY_ICON_SVG;
      }, 1500);
    });

    onDocumentClick = (documentEvent) => {
      if (!menu.hidden && !menu.contains(documentEvent.target)) closeMenu();
    };
    document.addEventListener("click", onDocumentClick);
    root.addEventListener("keydown", (keyEvent) => {
      if (keyEvent.key === "Escape") closeMenu();
    });
  }
  onDestroy() {
    if (onDocumentClick) document.removeEventListener("click", onDocumentClick);
    if (copyRevertTimer) clearTimeout(copyRevertTimer);
  }
/>
