// The Installation section: a Command/Manual tab pair. Command shows the
// shadcn CLI invocation per package manager; Manual shows numbered steps with
// every source file the CLI would have written.
//
// Unlike <package-manager-switcher>, this one's panels are static markup
// (no SSR-time <await>), so the <Tabs> library component's Zag machine can
// own the tab state directly — every panel still server-renders (Zag hides
// the inactive one via `hidden`, not by omitting it), and the choice is
// persisted to localStorage via a client effect that seeds `value` from the
// stored method after resumption.
import "./package-manager-switcher.marko";
import "./expandable-code.marko";
import Tabs from "@marko-ui/shadcn/ui/tabs/tabs.marko";
import type { RegistrySourceFile } from "../../demos/demos-manifest.ts";
import type { PackageManagerCommand } from "./package-manager-switcher.marko";

export interface Input {
  componentName: string;
  /** Registry URL the CLI is pointed at. */
  registryUrl: string;
  dependencies: string[];
  files: RegistrySourceFile[];
}

// Every manager's own way of running a one-off binary.
<const/commands=[
  { manager: "bun", command: `bunx --bun marko-ui@latest add ${input.registryUrl}` },
  { manager: "pnpm", command: `pnpm dlx marko-ui@latest add ${input.registryUrl}` },
  { manager: "npm", command: `npx marko-ui@latest add ${input.registryUrl}` },
  { manager: "yarn", command: `yarn dlx marko-ui@latest add ${input.registryUrl}` },
] as PackageManagerCommand[]/>

<const/dependencyCommands=input.dependencies.length === 0 ? [] : [
  { manager: "bun", command: `bun add ${input.dependencies.join(" ")}` },
  { manager: "pnpm", command: `pnpm add ${input.dependencies.join(" ")}` },
  { manager: "npm", command: `npm install ${input.dependencies.join(" ")}` },
  { manager: "yarn", command: `yarn add ${input.dependencies.join(" ")}` },
] as PackageManagerCommand[]/>

<let/method="cli"/>

static const STORAGE_KEY = "marko-ui.installationType";

<script>
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "cli" || stored === "manual") method = stored;
  } catch {
    // Blocked storage: keep the server-rendered default.
  }
</script>

<div data-slot="install-tabs" class="my-4">
  <Tabs value=method
    translations={ listLabel: "Installation method" }
    valueChange(value) {
      method = value;
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        // Blocked storage: the choice simply does not persist.
      }
    }
  >
    <@trigger value="cli">Command</@trigger>
    <@trigger value="manual">Manual</@trigger>

    <@panel value="cli">
      <package-manager-switcher commands=commands/>
    </@panel>

    <@panel value="manual">
      <!-- Numbered steps, counter-driven so inserting a step needs no renumbering. -->
      <ol class="mt-4 space-y-6 [counter-reset:step] [&>li]:relative [&>li]:pl-9">
        <if=dependencyCommands.length !== 0>
          <li class="before:absolute before:left-0 before:top-0 before:flex before:h-6 before:w-6 before:items-center before:justify-center before:rounded-full before:border before:border-border before:bg-muted before:text-xs before:font-medium before:[counter-increment:step] before:[content:counter(step)]">
            <h3 class="text-sm font-semibold text-foreground">Install dependencies</h3>
            <package-manager-switcher commands=dependencyCommands/>
          </li>
        </if>

        <li class="before:absolute before:left-0 before:top-0 before:flex before:h-6 before:w-6 before:items-center before:justify-center before:rounded-full before:border before:border-border before:bg-muted before:text-xs before:font-medium before:[counter-increment:step] before:[content:counter(step)]">
          <h3 class="text-sm font-semibold text-foreground">
            Copy and paste the following code into your project
          </h3>
          <for|file| of=input.files by=(file) => file.path>
            <expandable-code code=file.content filename=file.path/>
          </for>
        </li>

        <li class="before:absolute before:left-0 before:top-0 before:flex before:h-6 before:w-6 before:items-center before:justify-center before:rounded-full before:border before:border-border before:bg-muted before:text-xs before:font-medium before:[counter-increment:step] before:[content:counter(step)]">
          <h3 class="text-sm font-semibold text-foreground">Update the import paths</h3>
          <p class="mt-2 text-sm text-muted-foreground">
            The snippets above use the paths the CLI would have written. Adjust them to match
            where your project keeps its components and its
            <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.85em] text-foreground">lib/utils.ts</code>.
          </p>
        </li>
      </ol>
    </@panel>
  </Tabs>
</div>
