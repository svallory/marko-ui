// Left rail on component pages: the docs sections above, then every registry
// component. Components without a docs page yet are listed but not linked —
// the reader sees the real shape of the library instead of a list that
// silently omits three quarters of it.
//
// Rebuilt (Round 2, corrected Round 4) from packages/shadcn/ui/sidebar
// parts, matching upstream's components/docs-sidebar.tsx structurally — see
// docs-sidebar.marko's header comment for the full citation; this file
// mirrors the same construction for the components-page rail. The
// undocumented-component case (no upstream equivalent — this app documents
// a page-per-component gap upstream doesn't have) uses SidebarMenuButton's
// own `disabled` state instead of a bespoke span, since the kit already
// styles that affordance (classes.ts: "disabled:pointer-events-none
// disabled:opacity-50").
import { DOCS_NAV } from "./docs-nav.ts";
import { SIDEBAR_COMPONENTS } from "../../lib/component-page-data.ts";
import Sidebar from "@marko-ui/shadcn/ui/sidebar/sidebar.marko";
import SidebarContent from "@marko-ui/shadcn/ui/sidebar/content.marko";
import SidebarGroup from "@marko-ui/shadcn/ui/sidebar/group.marko";
import SidebarGroupLabel from "@marko-ui/shadcn/ui/sidebar/group-label.marko";
import SidebarGroupContent from "@marko-ui/shadcn/ui/sidebar/group-content.marko";
import SidebarMenu from "@marko-ui/shadcn/ui/sidebar/menu.marko";
import SidebarMenuItem from "@marko-ui/shadcn/ui/sidebar/menu-item.marko";
import SidebarMenuButton from "@marko-ui/shadcn/ui/sidebar/menu-button.marko";

export interface Input {
  /** Component name whose entry should read as current, e.g. "switch". */
  activeComponent?: string;
  class?: string;
}

<!-- Sidebar/SidebarContent classNames verbatim from docs-sidebar.tsx:173,181
     (see docs-sidebar.marko's header for the full citation) — this file
     applies the same construction to the components-page rail. -->
<Sidebar
  collapsible="none"
  class="sticky top-[calc(var(--header-height)+0.6rem)] z-30 hidden h-[calc(100svh-10rem)] overflow-hidden overscroll-none bg-transparent [--sidebar-menu-width:--spacing(56)] lg:flex"
>
  <SidebarContent class="w-(--sidebar-menu-width) scroll-fade scrollbar-none overflow-x-hidden pl-2.5">
    <for|section, index| of=DOCS_NAV by=(section) => section.title>
      <SidebarGroup class=(index === 0 ? "pt-12" : undefined)>
        <SidebarGroupLabel class="font-medium text-muted-foreground">
          ${section.title}
        </SidebarGroupLabel>
        <SidebarGroupContent>
          <SidebarMenu class="gap-0.5">
            <for|item| of=section.items by=(item) => item.href>
              <SidebarMenuItem>
                <SidebarMenuButton
                  href=item.href
                  class="relative h-[30px] w-fit overflow-visible border border-transparent text-[0.8rem] font-medium after:absolute after:inset-x-0 after:-inset-y-1 after:z-0 after:rounded-md 3xl:fixed:w-full 3xl:fixed:max-w-48"
                >
                  ${item.label}
                </SidebarMenuButton>
              </SidebarMenuItem>
            </for>
          </SidebarMenu>
        </SidebarGroupContent>
      </SidebarGroup>
    </for>

    <SidebarGroup>
      <SidebarGroupLabel class="font-medium text-muted-foreground">
        Components
      </SidebarGroupLabel>
      <SidebarGroupContent>
        <SidebarMenu class="gap-0.5">
          <for|component| of=SIDEBAR_COMPONENTS by=(component) => component.name>
            <SidebarMenuItem>
              <const/isActive=component.name === input.activeComponent/>
              <SidebarMenuButton
                href=(component.documented ? `/docs/components/${component.name}` : undefined)
                disabled=!component.documented
                aria-current=(isActive ? "page" : undefined)
                active=isActive
                title=(component.documented ? undefined : "Documentation in progress")
                class="relative h-[30px] w-fit overflow-visible border border-transparent text-[0.8rem] font-medium after:absolute after:inset-x-0 after:-inset-y-1 after:z-0 after:rounded-md data-active:border-accent data-active:bg-accent 3xl:fixed:w-full 3xl:fixed:max-w-48"
              >
                ${component.title}
              </SidebarMenuButton>
            </SidebarMenuItem>
          </for>
        </SidebarMenu>
      </SidebarGroupContent>
    </SidebarGroup>
  </SidebarContent>
</Sidebar>
