// Left rail on component pages: the docs sections above, then every registry
// component. Components without a docs page yet are listed but not linked —
// the reader sees the real shape of the library instead of a list that
// silently omits three quarters of it.
import { DOCS_NAV } from "./docs-nav.ts";
import { SIDEBAR_COMPONENTS } from "../../lib/component-page-data.ts";

export interface Input {
  /** Component name whose entry should read as current, e.g. "switch". */
  activeComponent?: string;
  class?: string;
}

<nav class=`flex flex-col gap-4 no-scrollbar ${input.class ?? ""}` data-slot="components-sidebar">
  <for|section| of=DOCS_NAV by=(section) => section.title>
    <div class="flex flex-col p-2">
      <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-muted-foreground">${section.title}</div>
      <ul class="flex w-full min-w-0 flex-col gap-0.5">
        <for|item| of=section.items by=(item) => item.href>
          <li>
            <a
              href=item.href
              class="relative flex h-[30px] w-fit items-center overflow-visible rounded-md border border-transparent px-2 text-[0.8rem] font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              ${item.label}
            </a>
          </li>
        </for>
      </ul>
    </div>
  </for>

  <div class="flex flex-col p-2">
    <div class="flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-muted-foreground">Components</div>
    <ul class="flex w-full min-w-0 flex-col gap-0.5">
      <for|component| of=SIDEBAR_COMPONENTS by=(component) => component.name>
        <li>
          <if=component.documented>
            <a
              href=`/docs/components/${component.name}`
              aria-current=component.name === input.activeComponent ? "page" : undefined
              data-active=component.name === input.activeComponent ? "" : undefined
              class="relative flex h-[30px] w-fit items-center overflow-visible rounded-md border border-transparent px-2 text-[0.8rem] font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground data-active:border-accent data-active:bg-accent data-active:font-medium"
            >
              ${component.title}
            </a>
          </if>
          <else>
            <span
              title="Documentation in progress"
              class="flex h-[30px] w-fit cursor-default items-center rounded-md px-2 text-[0.8rem] font-medium text-muted-foreground/50"
            >
              ${component.title}
            </span>
          </else>
        </li>
      </for>
    </ul>
  </div>
</nav>
