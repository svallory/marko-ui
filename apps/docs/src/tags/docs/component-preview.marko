// The demo rendered live in a bordered stage, with a stacked source block
// below it — shadcn's ComponentPreview + ComponentPreviewTabs (v4). This is
// NOT a Preview/Code tab toggle: the live preview always renders on top, and
// the source starts collapsed to a 3-line peek behind a fade-out gradient
// with a centered "View Code" button. Clicking it expands to the full
// syntax-free source inline and stays expanded (shadcn has no re-collapse).
//
// The demo itself renders through the `demo` attr-tag forwarded by
// <component-page>: the generated per-component static route declares
// <@demo|demoId|> over that component's own renderer tag (a static
// <if>/<else if> chain over statically-imported demos, built by
// scripts/build-demos-manifest.ts), and the demoId travels across the tag
// boundaries by TAG PARAMETERS — never a dynamic tag over a runtime component
// lookup (Marko 6 crashes client hydration in production for those; see
// notes/bug-marko-dynamic-tag-hydration-crash.md) and never closure capture
// of the loop variable (the content-closures defect in the same note).
import "./code-block.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

export interface Input {
  /**
   * Demo dispatcher from <component-page>: `content` receives the demoId and
   * renders that demo via the route's per-component renderer tag.
   */
  demo?: Marko.AttrTag<{ content: Marko.Body<[demoId: string]> }>;
  /** A DemoEntry.demoId from the generated demos manifest, e.g. "button/button-demo". */
  demoId: string;
  /** Raw .marko text of that demo. */
  source: string;
  /** Alignment of the demo inside the stage. shadcn also supports "end". */
  align?: "center" | "start" | "end";
  class?: string;
}

<const/align=input.align ?? "center"/>

// A 3-line peek, `leading-6` to match the expanded <pre>'s line-height.
// Deliberately left as plain text, not run through highlightCode: an
// arbitrary 3-line slice of Marko source routinely lands mid-tag or with
// unclosed brackets, and shiki's tokenizer/HTML output on a truncated
// fragment looks visually broken (stray coloring, malformed nesting) rather
// than just less-highlighted. The full source below (via <code-block>) is
// syntactically complete and highlights normally.
<const/peekLines=input.source.split("\n").slice(0, 3).join("\n")/>

<div/previewEl
  class=`group relative mt-4 mb-12 flex flex-col overflow-hidden rounded-2xl border border-border ${input.class ?? ""}`
  data-slot="component-preview"
  data-not-typeset
>
  // `tabindex="0"`: the stage is a fixed-height (h-72) scroll container, so a
  // demo taller or wider than it clips. Some demos (table, chart, marquee)
  // legitimately exceed it, and the stage itself holds no focusable content in
  // those cases, leaving the overflow unreachable by keyboard (axe
  // `scrollable-region-focusable`). Deliberately no role="region"/aria-label:
  // every page renders ~6 of these, so naming them would add a screenful of
  // identically-named landmarks for screen-reader users to wade through, and
  // the bare tab stop already satisfies the rule.
  <div
    data-slot="preview"
    data-align=align
    tabindex="0"
    class="flex h-72 w-full justify-center overflow-x-auto p-10 data-[align=center]:items-center data-[align=end]:items-start data-[align=start]:items-start sm:data-[align=end]:items-end"
  >
    <if=input.demo>
      <${input.demo.content}(input.demoId)/>
    </if>
  </div>

  <div data-slot="code" data-expanded="false" class="relative overflow-hidden border-t border-border">
    <div/peekEl class="relative">
      // `tabindex="0"`: the peek scrolls horizontally when a source line is
      // wider than the stage, and it holds no focusable content of its own, so
      // without this a keyboard user cannot reach the clipped source (axe
      // `scrollable-region-focusable`). No role/label, for the same
      // landmark-noise reason as the stage above.
      <pre tabindex="0" class="overflow-x-auto bg-code p-4 text-[0.8125rem] leading-6 text-code-foreground"><code class="font-mono">${peekLines}</code></pre>
      <div class="pointer-events-none absolute inset-0 flex items-end justify-center pb-4" style="background: linear-gradient(to top, var(--color-code), color-mix(in oklab, var(--color-code) 60%, transparent), transparent)">
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-view-code
          class="pointer-events-auto relative z-10 rounded-lg bg-background text-foreground shadow-none"
        >
          View Code
        </Button>
      </div>
    </div>
    <div/fullEl hidden>
      <code-block code=input.source language="marko"/>
    </div>
  </div>
</div>

<lifecycle
  onMount() {
    const root = previewEl();
    if (!root) return;

    const codeSlot = root.querySelector('[data-slot="code"]');
    const viewCodeButton = root.querySelector("[data-view-code]");
    const peek = peekEl();
    const full = fullEl();
    if (!codeSlot || !viewCodeButton || !peek || !full) return;

    viewCodeButton.addEventListener("click", () => {
      peek.hidden = true;
      full.hidden = false;
      codeSlot.setAttribute("data-expanded", "true");
    });
  }
/>
