// Package-manager tab strip over a single command, with the choice persisted
// in localStorage so it survives navigation between component pages — the
// behaviour of shadcn's `useConfig().packageManager`.
//
// The pill row is <ToggleGroup> (a Zag machine, single-select/non-deselectable
// radiogroup semantics); the panels stay a plain reactive [hidden] swap, not
// <Tabs>: every command panel has its own SSR-time shiki <await>, and all of
// them render server-side regardless of which manager is selected — there is
// nothing here for a second machine to own.
//
// Commands are shell one-liners, highlighted as bash via SSR-time shiki
// (src/lib/highlight-code.ts).
import { highlightCode } from "../../lib/highlight-code.ts";
import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

export interface PackageManagerCommand {
  manager: string;
  command: string;
}

export interface Input {
  commands: PackageManagerCommand[];
  class?: string;
}

static const STORAGE_KEY = "marko-ui.packageManager";

// Server render shows the first entry; a client effect swaps in the stored
// choice after resumption.
<const/defaultManager=input.commands[0]?.manager ?? ""/>
<let/manager=defaultManager/>
<let/hasCopied=false/>
<let/copyTimer=(null as ReturnType<typeof setTimeout> | null)/>

<script>
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored && input.commands.some((entry) => entry.manager === stored)) manager = stored;
  } catch {
    // Blocked storage: keep the server-rendered default.
  }

  // Keep every switcher on the page (and other tabs) in agreement.
  const handleStorage = (storageEvent: StorageEvent) => {
    if (
      storageEvent.key === STORAGE_KEY &&
      storageEvent.newValue &&
      input.commands.some((entry) => entry.manager === storageEvent.newValue)
    ) {
      manager = storageEvent.newValue;
    }
  };
  window.addEventListener("storage", handleStorage);
  $signal.onabort = () => window.removeEventListener("storage", handleStorage);
</script>

<div
  class=`group relative my-4 overflow-hidden rounded-lg border border-border bg-muted/40 ${input.class ?? ""}`
  data-slot="package-manager-switcher"
  data-default-manager=defaultManager
>
  <div class="flex items-center justify-between gap-2 border-b border-border pr-2">
    <ToggleGroup value=[manager] deselectable=false
      valueChange(value) {
        const next = value[0];
        if (!next) return;
        manager = next;
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          // Private-mode / blocked storage: the choice just does not persist.
        }
      }
      class="overflow-x-auto"
    >
      <for|entry| of=input.commands>
        <@item value=entry.manager>${entry.manager}</@item>
      </for>
    </ToggleGroup>
    <Button
      type="button"
      variant="outline"
      size="xs"
      data-manager-copy
      aria-label="Copy command"
      class="shrink-0 bg-background"
      onClick() {
        const entry = input.commands.find((candidate) => candidate.manager === manager);
        navigator.clipboard.writeText(entry?.command ?? "").then(() => {
          hasCopied = true;
          if (copyTimer) clearTimeout(copyTimer);
          copyTimer = setTimeout(() => { hasCopied = false; }, 1500);
        });
      }
    >
      <if=hasCopied>Copied</if>
      <else>Copy</else>
    </Button>
  </div>

  <for|entry| of=input.commands by=(entry) => entry.manager>
    <await|highlighted|=highlightCode(entry.command, "bash")>
      <pre
        data-manager-panel
        data-manager=entry.manager
        hidden=entry.manager !== manager
        class="overflow-x-auto p-4 text-[0.8125rem] leading-6"
      ><code class="font-mono whitespace-pre">$!{highlighted}</code></pre>
    </await>
  </for>
</div>
