// Static code block with a copy button. Replaces shadcn's rehype-highlighted
// MDX <pre>: highlighting here is SSR-time shiki (src/lib/highlight-code.ts),
// not a build-time MDX pipeline — see that file's header for why. The
// copy button still reads the raw text content of the <code> element, so
// what gets copied is always the plain source, never the highlighted markup.
import { highlightCode } from "../../lib/highlight-code.ts";
import Button from "@marko-ui/shadcn/ui/button/button.marko";

export interface Input {
  code: string;
  language?: string;
  filename?: string;
  class?: string;
}

<id/blockId/>

<div/blockEl class=`group relative my-4 overflow-hidden rounded-lg border border-border bg-muted/40 ${input.class ?? ""}` data-slot="code-block">
  <if=input.filename>
    <div class="flex items-center justify-between border-b border-border px-4 py-2 text-xs font-medium text-muted-foreground">
      <span>${input.filename}</span>
      <if=input.language>
        <span class="uppercase tracking-wide opacity-70">${input.language}</span>
      </if>
    </div>
  </if>
  <await|highlighted|=highlightCode(input.code, input.language ?? "text")>
    // `tabindex="0"`: the block scrolls horizontally on long lines and has no
    // focusable content, so a keyboard user could not otherwise reach the
    // clipped source (axe `scrollable-region-focusable`). No role/label — a
    // docs page renders many of these, and naming each one would bury the
    // page's real landmarks in duplicates.
    <pre tabindex="0" class="overflow-x-auto p-4 text-[0.8125rem] leading-6"><code id=blockId class="font-mono">$!{highlighted}</code></pre>
  </await>
  <Button
    type="button"
    variant="outline"
    size="xs"
    data-copy-code
    data-source=blockId
    aria-label="Copy code"
    class="absolute right-2 top-2 h-7 bg-background text-xs font-medium text-muted-foreground opacity-0 transition-opacity hover:text-foreground focus-visible:opacity-100 group-hover:opacity-100"
  >
    Copy
  </Button>
</div>

<lifecycle
  onMount() {
    const button = blockEl()?.querySelector("[data-copy-code]");
    if (!button) return;
    button.addEventListener("click", () => {
      const sourceId = button.getAttribute("data-source");
      const source = sourceId ? document.getElementById(sourceId) : null;
      if (!source) return;
      navigator.clipboard.writeText(source.textContent ?? "").then(() => {
        button.textContent = "Copied";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      });
    });
  }
/>
