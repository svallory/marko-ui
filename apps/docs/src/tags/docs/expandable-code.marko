// A code block that starts clipped to a fixed height behind a fade, with an
// Expand/Collapse button — shadcn's CodeCollapsibleWrapper. Short files skip
// the whole affordance and render as a plain block. Highlighting is SSR-time
// shiki (src/lib/highlight-code.ts); the language is derived from
// `filename`'s extension when `language` isn't passed explicitly (every
// current caller passes a registry source path, e.g. "button/button.marko").
import { highlightCode, langFromFilename } from "../../lib/highlight-code.ts";

export interface Input {
  code: string;
  filename?: string;
  language?: string;
  /** Lines shown while collapsed. Files at or under this render un-clipped. */
  collapsedLines?: number;
  class?: string;
}

<const/lang=input.language ?? (input.filename ? langFromFilename(input.filename) : "text")/>

<const/collapsedLines=input.collapsedLines ?? 12/>
<const/lineCount=input.code.split("\n").length/>
<const/isCollapsible=(lineCount > collapsedLines)/>
// 1.5rem line-height matches `leading-6` on the <pre>; the extra 2rem keeps
// the fade from cutting a line in half.
<const/collapsedHeight=`${collapsedLines * 1.5 + 2}rem`/>

<id/codeId/>

<div/wrapperEl
  class=`group relative my-4 overflow-hidden rounded-lg border border-border bg-muted/40 ${input.class ?? ""}`
  data-slot="expandable-code"
  data-collapsed=String(isCollapsible)
>
  <if=input.filename>
    <div class="flex items-center justify-between border-b border-border px-4 py-2 text-xs font-medium text-muted-foreground">
      <span class="truncate font-mono">${input.filename}</span>
      <button
        type="button"
        data-code-copy
        aria-label="Copy code"
        class="ml-2 shrink-0 rounded-md border border-border bg-background px-2 py-0.5 transition-colors hover:text-foreground"
      >
        Copy
      </button>
    </div>
  </if>

  <div/viewportEl class="relative overflow-hidden" style=isCollapsible ? `max-height:${collapsedHeight}` : undefined>
    <await|highlighted|=highlightCode(input.code, lang)>
      <pre class="overflow-x-auto p-4 text-[0.8125rem] leading-6"><code id=codeId class="font-mono">$!{highlighted}</code></pre>
    </await>
    <if=isCollapsible>
      <div/fadeEl class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-background to-transparent"/>
    </if>
  </div>

  <if=isCollapsible>
    <div class="border-t border-border p-2 text-center">
      <button
        type="button"
        data-code-toggle
        aria-expanded="false"
        aria-controls=codeId
        class="rounded-md px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        Expand
      </button>
    </div>
  </if>
  <else-if=!input.filename>
    <button
      type="button"
      data-code-copy
      aria-label="Copy code"
      class="absolute right-2 top-2 rounded-md border border-border bg-background px-2 py-1 text-xs font-medium text-muted-foreground opacity-0 transition-opacity hover:text-foreground focus-visible:opacity-100 group-hover:opacity-100"
    >
      Copy
    </button>
  </else-if>
</div>

<lifecycle
  onMount() {
    const root = wrapperEl();
    if (!root) return;

    const copyButton = root.querySelector("[data-code-copy]");
    copyButton?.addEventListener("click", () => {
      const source = document.getElementById(codeId);
      navigator.clipboard.writeText(source?.textContent ?? "").then(() => {
        copyButton.textContent = "Copied";
        setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1500);
      });
    });

    const toggle = root.querySelector("[data-code-toggle]");
    if (!toggle) return;
    const viewport = viewportEl();
    const fade = fadeEl();
    // The collapsed max-height is inline from SSR; expanding clears it rather
    // than animating to a measured height, so long files never get a wrong
    // pixel target when the font finishes loading.
    const collapsedStyle = viewport.style.maxHeight;

    toggle.addEventListener("click", () => {
      const nowExpanded = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(nowExpanded));
      toggle.textContent = nowExpanded ? "Collapse" : "Expand";
      viewport.style.maxHeight = nowExpanded ? "" : collapsedStyle;
      if (fade) fade.hidden = nowExpanded;
      root.setAttribute("data-collapsed", String(!nowExpanded));
      if (!nowExpanded) root.scrollIntoView({ block: "nearest" });
    });
  }
/>
