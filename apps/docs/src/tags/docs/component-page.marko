// Component reference page — the marko-run equivalent of shadcn's
// app/(app)/docs/[[...slug]]/page.tsx for `component: true` pages.
//
// Section order is shadcn's: header → hero preview → Installation → Usage →
// Composition (compound only) → one section per example → API Reference,
// with the sticky "On This Page" rail on the right.
//
// This tag owns its own two-rail frame instead of the <docs-article> used by
// the prose pages: the left rail lists all registry components (COMPONENTS,
// components-list.ts) rather than the DOCS_NAV tree, and the previews need
// the full content width.
//
// One tag serves every documented component: each component has a generated
// STATIC route (src/routes/docs/components/<name>/+page.marko, built by
// scripts/build-demos-manifest.ts) that passes this tag a `demo` attr-tag
// rendering ONLY that component's demos, so no page's client bundle carries
// another component's demos. The /docs/components/$name fallback route calls
// this tag without `demo` — it only ever renders the "Component not
// documented" state, so there is nothing to dispatch.
import "./components-sidebar.marko";
import "./component-page-header.marko";
import "./component-preview.marko";
import "./install-tabs.marko";
import "./composition-tree.marko";
import "./api-table.marko";
import "./code-block.marko";
import "./docs-toc.marko";
import { getComponentPageData } from "../../lib/component-page-data.ts";
import { buttonVariants } from "@marko-ui/shadcn/ui/button/variants.ts";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";

// Components whose docs demos upstream scopes to the "theme-blue" preset via
// previewClassName, on EVERY demo on the page. Verified per-demo, not just
// per-page (Round 5 correction — Round 4's version checked file presence
// only): counted <ComponentPreview>/theme-blue occurrences 1:1 in all 5 of
// these mdx files (9/9 bubble, 8/8 marker, 6/6 message, 6/6 attachment,
// 11/11 message-scroller). chart.mdx is NOT in this set — see below, it
// applies theme-blue to exactly one of its many demos, not all of them.
static const THEME_BLUE_COMPONENTS = new Set([
  "bubble",
  "marker",
  "message",
  "attachment",
  "message-scroller",
]);

// chart.mdx applies theme-blue to ONLY its hero preview (chart.mdx:14-18,
// name="chart-demo"), together with layout overrides that make the
// (otherwise fixed-height) preview stage grow to fit the full chart. Every
// other chart demo on the page (chart.mdx:181-186, 213-217, 252-256,
// 294-298, 337-341, 597-602 — 6 more <ComponentPreview>s, verified none of
// them carry theme-blue) gets plain previewClassName="h-80"/"h-92" and no
// theme override, i.e. the shipped theme's own grey chart-1..5 default.
// Verified exhaustively: chart.mdx has exactly 7 <ComponentPreview>s total
// and exactly 1 "theme-blue" occurrence.
static const CHART_HERO_DEMO_ID = "chart/chart-demo";
// Upstream's className on the hero (chart.mdx:17), targeting `.preview` and
// its child div — mapped to our markup's data-slot="preview" stage
// (component-preview.marko has no `.preview` class, only the data-slot
// attribute, so the descendant selectors are rewritten to match it 1:1;
// semantically identical selectors, same specificity shape).
static const CHART_HERO_CLASS =
  "theme-blue [&_[data-slot=preview]]:h-auto [&_[data-slot=preview]]:p-0 [&_[data-slot=preview]]:lg:min-h-[404px] [&_[data-slot=preview]>div]:w-full [&_[data-slot=preview]>div]:border-none [&_[data-slot=preview]>div]:shadow-none";

export interface Input {
  /** Component name from the URL, e.g. "button". */
  name: string;
  /**
   * Demo dispatcher, declared by each generated static route's +page.marko:
   * the body receives a DemoEntry.demoId and renders that demo (a static
   * per-component <if> chain inside the generated renderer tag — never a
   * dynamic tag over a runtime component lookup, see
   * notes/bug-marko-dynamic-tag-hydration-crash.md). Passed down to
   * <component-preview> as plain input; tag parameters, not closure capture,
   * carry the demoId across the tag boundary.
   */
  demo?: Marko.AttrTag<{ content: Marko.Body<[demoId: string]> }>;
}

<const/page=getComponentPageData(input.name)/>
// Per-demo, not per-page (Round 5 correction) — chart is the one component
// where theme-blue applies to a single demo, not every demo on the page.
// The 5 always-blue components apply it on the stage div (previewClass, no
// layout override needed); chart's one hero demo applies it on the OUTER
// box instead (outerClassFor/CHART_HERO_CLASS), matching upstream's own
// className placement — theme-blue's CSS custom properties inherit down to
// the stage regardless of which element it's declared on.
<const/previewClassFor=(demoId: string) =>
  THEME_BLUE_COMPONENTS.has(input.name) ? "theme-blue" : undefined/>
<const/outerClassFor=(demoId: string) =>
  demoId === CHART_HERO_DEMO_ID ? CHART_HERO_CLASS : undefined/>

<if=!page>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-2xl font-bold text-foreground">Component not documented</h1>
    <p class="mt-2 text-muted-foreground">
      <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">${input.name}</code>
      has no documentation page yet.
    </p>
    <a
      href="/docs"
      class=cn(buttonVariants({ variant: "outline" }), "mt-6")
    >
      Back to docs
    </a>
  </main>
</if>
<else>
  <!-- TOC entries mirror the h2s below, in the same order. -->
  <const/hasAccessibility=Boolean(
    (page.docs.accessibilityKeyboard && page.docs.accessibilityKeyboard.length !== 0) ||
    (page.docs.accessibilityNotes && page.docs.accessibilityNotes.length !== 0),
  )/>
  <const/tocEntries=[
    { id: "installation", label: "Installation" },
    { id: "usage", label: "Usage" },
    ...(page.docs.concepts ? [{ id: "concepts", label: "Concepts" }] : []),
    ...(page.isCompound || page.docs.composition ? [{ id: "composition", label: "Composition" }] : []),
    ...(page.examples.length !== 0 ? [{ id: "examples", label: "Examples" }] : []),
    ...page.examples.map((example) => ({ id: example.id, label: example.title, level: 3 })),
    ...(hasAccessibility ? [{ id: "accessibility", label: "Accessibility" }] : []),
    ...(page.parts.length !== 0 ? [{ id: "api-reference", label: "API Reference" }] : []),
  ]/>

  <div class="container-wrapper flex flex-1 flex-col px-2">
    <div
      class="min-h-min flex-1 items-start lg:grid lg:grid-cols-[var(--sidebar-width)_minmax(0,1fr)]"
      style="--sidebar-width: 18rem"
    >
      <aside class="relative hidden lg:block">
        <!-- Faded vertical divider, ported verbatim from shadcn's docs-sidebar.tsx
             (a gradient hairline, not a solid border-r). Sticky/scroll/height
             classes live on components-sidebar.marko's own Sidebar/
             SidebarContent parts now (Round 4) — this <aside> is just a plain
             positioning wrapper. -->
        <div class="absolute top-12 right-2 bottom-0 hidden h-full w-px bg-[linear-gradient(to_bottom,transparent_0%,var(--border)_10%,var(--border)_90%,transparent_100%)] lg:flex"/>
        <components-sidebar activeComponent=page.name/>
      </aside>

      <div class="flex items-stretch pb-8 xl:w-full">
        <div class="flex min-w-0 flex-1 flex-col">
          <div class="mx-auto flex w-full max-w-160 min-w-0 flex-1 flex-col gap-6 px-4 py-6 text-foreground md:px-0 lg:py-8 dark:text-foreground">
            <nav class="hidden items-center gap-1.5 text-sm text-muted-foreground md:flex" aria-label="Breadcrumb">
              <a href="/docs" class="transition-colors hover:text-foreground">Docs</a>
              <span aria-hidden="true">/</span>
              <span>Components</span>
              <span aria-hidden="true">/</span>
              <span class="text-foreground">${page.title}</span>
            </nav>

            <component-page-header
              title=page.title
              description=page.description
              href=page.href
              previous=page.previous
              next=page.next
            />

            <!-- Hero preview: the first example, shown before any prose. -->
            <if=page.examples[0]>
              <!--
                Every other section on this page opens with a visible <h2>; the
                hero is the only one without, which left a heading gap right
                after the <h1>. A component that renders its own headings then
                lands at the wrong depth — accordion's items are <h3> (matching
                upstream shadcn's AccordionHeader), so the page read h1 to h3.
                Labelling the hero closes the gap at the page level, where the
                defect is, instead of changing a registry component's heading
                level to suit one docs page. sr-only because the stage is
                self-evident on screen and the design has no visible heading
                here.

                The section wrapper is load-bearing, not decoration: the
                behavior suite's demoByTitle() helper finds a demo by taking the
                div whose DIRECT child is a heading, so an unwrapped heading
                here would make the page's outer wrapper div match that shape
                too and every demo lookup would resolve to ~29 elements
                (Playwright strict-mode violation). Keeping the heading inside a
                section — as Installation/Usage/Examples already do — keeps the
                only heading-bearing divs the per-example ones.
              -->
              <section>
                <h2 class="sr-only">Example</h2>
                <!-- The demo's own title rides along sr-only: the behavior
                     suite's demoByTitle() locates a demo by the heading that
                     titles it, and this demo no longer appears under Examples
                     (see below), so without this the tests' usual entry point
                     would vanish. -->
                <div>
                  <h3 class="sr-only">${page.examples[0].title}</h3>
                  <component-preview
                    demo=input.demo
                    demoId=page.examples[0].demoId
                    source=page.examples[0].source
                    previewClass=previewClassFor(page.examples[0].demoId)
                    class=outerClassFor(page.examples[0].demoId)
                  />
                </div>
              </section>
            </if>

            <section>
              <h2 id="installation" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                Installation
              </h2>
              <install-tabs
                componentName=page.name
                registryUrl=page.registryUrl
                dependencies=page.registry.dependencies
                files=page.registry.files
              />
            </section>

            <section>
              <h2 id="usage" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                Usage
              </h2>
              <p class="text-sm text-muted-foreground">
                Tags are registered automatically — <code>${page.docs.usageTags}</code> needs no import.
              </p>
              <code-block code=page.docs.usageSnippet language="marko"/>
              <p class="text-sm text-muted-foreground">
                Prefer explicit imports (or overriding a tag)? Import the file directly:
              </p>
              <code-block code=page.docs.importSnippet language="marko"/>
            </section>

            <if=page.docs.concepts>
              <section>
                <h2 id="concepts" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  Concepts
                </h2>
                <p class="mt-4 text-sm leading-7 text-muted-foreground">${page.docs.concepts}</p>
              </section>
            </if>

            <if=page.isCompound>
              <section>
                <h2 id="composition" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  Composition
                </h2>
                <composition-tree componentName=page.name parts=page.parts/>
              </section>
            </if>
            <!-- Single-file components whose anatomy is expressed through
                 slots/render-props (e.g. tooltip's @trigger plus its own
                 default body) have nothing for composition-tree to
                 enumerate — api-reference.json sees one part, so isCompound
                 is false. docs.composition is the prose fallback for
                 those. -->
            <else if=page.docs.composition>
              <section>
                <h2 id="composition" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  Composition
                </h2>
                <p class="mt-4 text-sm leading-7 text-muted-foreground">${page.docs.composition}</p>
              </section>
            </else>

            <if=page.examples.length !== 0>
              <section>
                <h2 id="examples" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  Examples
                </h2>
                <!-- The hero (examples[0]) is rendered in its own section above
                     and is SKIPPED here: rendering it twice would duplicate every
                     hardcoded id in the demo (html-validate no-dup-id) — Zag
                     scopes machine ids, but demo-level ids like
                     "checkbox-demo-terms" are literal. -->
                <for|example, exampleIndex| of=page.examples by=(example) => example.name>
                  <if=exampleIndex !== 0>
                  <div class="mt-8">
                    <h3 id=example.id class="scroll-mt-20 text-lg font-semibold tracking-tight">
                      ${example.title}
                    </h3>
                    <if=example.description>
                      <p class="mt-2 text-sm leading-7 text-muted-foreground">${example.description}</p>
                    </if>
                    <component-preview demo=input.demo demoId=example.demoId source=example.source previewClass=previewClassFor(example.demoId) class=outerClassFor(example.demoId)/>
                  </div>
                  </if>
                </for>
              </section>
            </if>

            <if=hasAccessibility>
              <section>
                <h2 id="accessibility" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  Accessibility
                </h2>
                <if=(page.docs.accessibilityKeyboard && page.docs.accessibilityKeyboard.length !== 0)>
                  <div class="mt-4 overflow-x-auto">
                    <table class="w-full text-sm">
                      <thead>
                        <tr class="border-b border-border text-left">
                          <th class="py-2 pr-4 font-medium text-foreground">Key</th>
                          <th class="py-2 font-medium text-foreground">Description</th>
                        </tr>
                      </thead>
                      <tbody>
                        <for|entry| of=page.docs.accessibilityKeyboard by=(entry) => entry.keys>
                          <tr class="border-b border-border/50">
                            <td class="py-2 pr-4 align-top">
                              <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">${entry.keys}</code>
                            </td>
                            <td class="py-2 align-top text-muted-foreground">${entry.description}</td>
                          </tr>
                        </for>
                      </tbody>
                    </table>
                  </div>
                </if>
                <if=(page.docs.accessibilityNotes && page.docs.accessibilityNotes.length !== 0)>
                  <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-7 text-muted-foreground">
                    <for|note| of=page.docs.accessibilityNotes by=(note) => note>
                      <li>${note}</li>
                    </for>
                  </ul>
                </if>
              </section>
            </if>

            <if=page.parts.length !== 0>
              <section>
                <h2 id="api-reference" class="scroll-mt-20 border-b border-border pb-2 text-xl font-semibold tracking-tight">
                  API Reference
                </h2>
                <p class="mt-4 text-sm leading-7 text-muted-foreground">
                  Extracted from the component's own
                  <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em] text-foreground">Input</code>
                  type, so it always matches the source you copied.
                </p>
                <div class="mt-4">
                  <api-table parts=page.parts/>
                </div>
              </section>
            </if>

            <!-- Full-width pager, matching the arrows in the header. -->
            <if=(page.previous || page.next)>
              <nav class="flex h-16 w-full items-center gap-2" aria-label="Pagination">
                <if=page.previous>
                  <a
                    href=`/docs/components/${page.previous.name}`
                    class=buttonVariants({ variant: "outline", size: "sm" })
                  >
                    ← ${page.previous.title}
                  </a>
                </if>
                <if=page.next>
                  <a
                    href=`/docs/components/${page.next.name}`
                    class=cn(buttonVariants({ variant: "outline", size: "sm" }), "ml-auto")
                  >
                    ${page.next.title} →
                  </a>
                </if>
              </nav>
            </if>
          </div>
        </div>

        <aside class="sticky top-[calc(3.5rem+1px)] z-30 ml-auto hidden h-[90svh] w-56 flex-col gap-4 overflow-hidden overscroll-none pb-8 xl:flex">
          <div class="scrollbar-none flex flex-col gap-8 overflow-y-auto px-8 py-8">
            <docs-toc entries=tocEntries/>
          </div>
        </aside>
      </div>
    </div>
  </div>
</else>
