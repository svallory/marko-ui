// One prop table per component part, rendered from the extracted
// api-reference.json. shadcn links out to the underlying primitive's docs;
// we own the component code, so the real surface is generated instead.

export interface ApiProperty {
  name: string;
  type: string;
  required: boolean;
  /** "machine" (Zag), "variant" (cva), or "own" (added by the component). */
  kind?: string;
  description?: string;
  default?: string;
  options?: string[];
}

export interface ApiPart {
  file: string;
  name: string;
  properties: ApiProperty[];
  /** The native element whose attributes also pass through, if any. */
  nativeAttributes?: string;
}

export interface Input {
  parts: ApiPart[];
  class?: string;
}

// A part with no props of its own is a pure styling wrapper — say so in a
// sentence rather than rendering an empty table with headers.
static function partLabel(part: ApiPart) {
  return part.name.charAt(0).toUpperCase() + part.name.slice(1);
}

<div class=`space-y-8 ${input.class ?? ""}` data-slot="api-table">
  <for|part| of=input.parts by=(part) => part.file>
    <div class="space-y-3">
      <if=input.parts.length !== 1>
        <h3 id=`api-${part.name}` class="scroll-mt-20 font-mono text-base font-semibold text-foreground">
          ${partLabel(part)}
        </h3>
      </if>

      <if=part.properties.length === 0>
        <p class="text-sm text-muted-foreground">
          No props of its own.
          <if=part.nativeAttributes>
            Accepts every <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.85em] text-foreground">&lt;${part.nativeAttributes}&gt;</code> attribute, plus <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.85em] text-foreground">class</code>.
          </if>
        </p>
      </if>
      <else>
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-muted/50 text-left">
                <th class="px-3 py-2 font-semibold">Prop</th>
                <th class="px-3 py-2 font-semibold">Type</th>
                <th class="px-3 py-2 font-semibold">Default</th>
              </tr>
            </thead>
            <tbody>
              <for|property| of=part.properties by=(property) => property.name>
                <tr class="border-t border-border align-top">
                  <td class="px-3 py-2 whitespace-nowrap">
                    <code class="font-mono text-[0.85em] text-foreground">${property.name}</code>
                    <if=property.required>
                      <span class="ml-1 text-destructive" title="Required">*</span>
                    </if>
                    <if=property.description>
                      <p class="mt-1 max-w-prose text-xs leading-5 whitespace-pre-line text-muted-foreground">
                        ${property.description}
                      </p>
                    </if>
                  </td>
                  <td class="px-3 py-2">
                    <code class="font-mono text-[0.8em] break-words text-muted-foreground">${property.type}</code>
                  </td>
                  <td class="px-3 py-2 whitespace-nowrap">
                    <if=property.default>
                      <code class="font-mono text-[0.85em] text-foreground">${property.default}</code>
                    </if>
                    <else>
                      <span class="text-muted-foreground">—</span>
                    </else>
                  </td>
                </tr>
              </for>
            </tbody>
          </table>
        </div>

        <if=part.nativeAttributes>
          <p class="text-xs text-muted-foreground">
            Also accepts every <code class="rounded bg-muted px-1 py-0.5 font-mono text-[0.9em] text-foreground">&lt;${part.nativeAttributes}&gt;</code> attribute.
          </p>
        </if>
      </else>
    </div>
  </for>
</div>
