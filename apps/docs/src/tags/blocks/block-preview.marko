import type { BlockEntry } from "../../lib/blocks-list.ts";
import { COMPONENTS } from "../../lib/components-list.ts";
import Button from "@marko-ui/registry/ui/button/button.marko";
import Badge from "@marko-ui/registry/ui/badge/badge.marko";
import Separator from "@marko-ui/registry/ui/separator/separator.marko";

export interface Input {
  block: BlockEntry;
  /** Registry base the install command points at. */
  registryBase?: string;
}

<const/block=input.block/>
<const/registryBase=input.registryBase ?? "https://marko-ui.saulo.tech/r"/>
<const/installCommand=`bunx shadcn@latest add ${registryBase}/${block.name}.json`/>

<let/copied=false/>

<section
  id=block.name
  data-slot="block-preview"
  class="scroll-mt-24 space-y-4"
>
  <div class="flex flex-wrap items-center gap-2">
    <div class="min-w-0">
      <h2 class="text-lg font-semibold tracking-tight">${block.title}</h2>
      <p class="text-sm text-muted-foreground">${block.description}</p>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <Button
        variant="outline"
        size="sm"
        data-copy-install
        onClick() {
          navigator.clipboard?.writeText(installCommand);
          copied = true;
          setTimeout(() => { copied = false; }, 2000);
        }
      >
        ${copied ? "Copied!" : "Copy install command"}
      </Button>
      <a
        href=`/blocks/view/${block.name}`
        target="_blank"
        rel="noreferrer"
        data-open-block
        class="inline-flex h-8 items-center gap-1.5 rounded-md border px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        Open in new tab
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M15 3h6v6"/>
          <path d="M10 14 21 3"/>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
    <span>Built from</span>
    <for|dependency| of=block.registryDependencies by=(dependency) => dependency>
      <if=COMPONENTS.includes(dependency)>
        <a href=`/components/${dependency}`>
          <Badge variant="secondary" class="hover:bg-secondary/70">${dependency}</Badge>
        </a>
      </if>
      <else>
        <Badge variant="secondary">${dependency}</Badge>
      </else>
    </for>
  </div>

  <div class="overflow-hidden rounded-xl border bg-background shadow-sm">
    <div class="flex items-center gap-2 border-b bg-muted/40 px-3 py-2">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-border"/>
        <span class="size-2.5 rounded-full bg-border"/>
        <span class="size-2.5 rounded-full bg-border"/>
      </div>
      <Separator orientation="vertical" class="mx-1 h-4"/>
      <span class="truncate font-mono text-xs text-muted-foreground">
        /blocks/view/${block.name}
      </span>
    </div>
    <iframe
      src=`/blocks/view/${block.name}`
      title=`${block.title} preview`
      loading="lazy"
      data-block-frame=block.name
      class="w-full border-0 bg-background"
      style={ height: `${block.previewHeight}px` }
    />
  </div>
</section>
