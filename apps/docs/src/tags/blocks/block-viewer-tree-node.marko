// One node (file or folder) of BlockViewerFileTree, ported from
// block-viewer.tsx's `Tree` component. Recursion needs its own tag (Marko
// files can't self-reference by relative import path without one), and
// `interface X { ... }` at the top level of a .marko file fails to parse
// (component-authoring.md's TOP-LEVEL TYPE LANDMINE) — BlockManifestTreeNode
// is imported from the .ts module where it's legally declared instead.
import Collapsible from "@marko-ui/shadcn/ui/collapsible/collapsible.marko";
import type { BlockManifestTreeNode } from "../../lib/blocks-manifest.ts";

export interface Input {
  node: BlockManifestTreeNode;
  depth: number;
  activeFile: string | null;
  onSelect: (target: string) => void;
}

<const/node=input.node/>
<const/isFolder=!!node.children/>
// shadcn uses two distinct formulas for the `--index` custom property
// (block-viewer.tsx's `Tree`): leaf rows step by 1.3rem (1.2rem at depth 2),
// folder rows step by 1.2rem (1rem at depth 1). Indentation is applied via
// the `pl-(--index)` Tailwind v4 arbitrary-var class, matching source
// (not an inline `padding-left`), so a shadcn theme keying off `--index`
// restyles this unchanged.
<const/leafIndex=`${input.depth * (input.depth === 2 ? 1.2 : 1.3)}rem`/>
<const/folderIndex=`${input.depth * (input.depth === 1 ? 1 : 1.2)}rem`/>

<if=!isFolder>
  <button
    type="button"
    data-active=String(node.path === input.activeFile)
    class="rounded-none pl-(--index) whitespace-nowrap flex w-full items-center gap-2 py-1.5 pr-2 text-left text-sm text-code-foreground hover:bg-muted-foreground/15 focus:bg-muted-foreground/15 focus-visible:bg-muted-foreground/15 active:bg-muted-foreground/15 data-[active=true]:bg-muted-foreground/15"
    style={ "--index": leafIndex }
    onClick() { if (node.path) input.onSelect(node.path); }
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 invisible"><path d="m9 18 6-6-6-6"/></svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
    ${node.name}
  </button>
</if>
<else>
  <Collapsible defaultOpen class="group/collapsible">
    <@trigger|props|>
      <button
        ...props
        type="button"
        class="rounded-none pl-(--index) whitespace-nowrap flex w-full items-center gap-2 py-1.5 pr-2 text-left text-sm text-code-foreground hover:bg-muted-foreground/15 focus:bg-muted-foreground/15 focus-visible:bg-muted-foreground/15 active:bg-muted-foreground/15"
        style={ "--index": folderIndex }
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 opacity-70 transition-transform group-data-[state=open]/collapsible:rotate-90"><path d="m9 18 6-6-6-6"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 opacity-70"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
        ${node.name}
      </button>
    </@trigger>
    <for|child| of=node.children ?? [] by=(child) => child.name>
      <block-viewer-tree-node
        node=child
        depth=input.depth + 1
        activeFile=input.activeFile
        onSelect=input.onSelect
      />
    </for>
  </Collapsible>
</else>
