// Block viewer adapted from shadcn with marko-ui registry controls and
// responsive title, description, and action rows. State is owned here.
//
// Source-order note: the Resizable panel group is declared BEFORE the
// toolbar markup that reads its `resizableApi` tag variable, even though
// shadcn's toolbar sits visually above the preview — Marko forbids reading
// a tag variable before its declaration ("Hoisted values can only be read
// in scripts and event handlers", verified empirically). `order-*` utility
// classes on the flex container restore the original visual order.
import Resizable from "@marko-ui/shadcn/ui/resizable/resizable.marko";
import Separator from "@marko-ui/shadcn/ui/separator/separator.marko";
import Button from "@marko-ui/shadcn/ui/button/button.marko";
import "./block-viewer-tree-node.marko";
import Tabs from "@marko-ui/shadcn/ui/tabs/tabs.marko";
import ToggleGroup from "@marko-ui/shadcn/ui/toggle-group/toggle-group.marko";
import { cn } from "@marko-ui/shadcn/lib/utils.ts";
import { BLOCKS_MANIFEST } from "../../lib/blocks-manifest.ts";
import { highlightManifestFiles } from "../../lib/highlight-code.ts";
import type { BlockEntry } from "../../lib/blocks-list.ts";

export interface Input {
  block: BlockEntry;
}

<const/block=input.block/>
<const/manifest=BLOCKS_MANIFEST[block.name]/>

// `activeFile` (and so `activeManifestFile`) changes client-side on every
// file-tree click, entirely after hydration. Marko's <await> tag turns out
// to be unsuitable for that: verified empirically (three separate minimal
// repros) that content and attribute bindings *inside* an <await> body are
// frozen at whatever they were on first resolution — a reactive <let> that
// changes afterward does not re-render anything nested in <await>, and even
// a plain assignment from inside the awaited body's own <script> back to an
// outer <let> never lands, in SSR or the client. So highlighted markup
// cannot live inside a per-file <await>, and switching cannot be a Marko
// reactive re-render of anything under one.
//
// Fix: every file's HTML is highlighted once, up front, inside ONE <await>
// (resolves a single time per page load, same as every other call site);
// each panel is pre-rendered hidden except the default file. From there,
// switching is plain DOM — a <script> reacting to `activeFile` toggles
// `.hidden` directly via querySelector, same mechanism
// package-manager-switcher.marko already uses for its command panels (that
// one does it entirely in onMount off localStorage; this one reacts to a
// Marko <let> instead, since the trigger is the file tree's onClick).
<const/manifestFiles=manifest?.files ?? []/>

<let/view=("preview" as "preview" | "code")/>
<let/activeFile=manifest?.defaultFile ?? null/>
<let/copiedInstall=false/>
<let/copiedFile=false/>
<let/previewSize=100/>

<const/activeManifestFile=manifestFiles.find((file) => file.target === activeFile) ?? null/>
<const/installCommand=`bunx --bun marko-ui@latest add https://marko-ui.saulo.tech/r/${block.name}.json`/>

<div/viewerEl
  id=block.name
  data-view=view
  data-slot="block-viewer"
  class="group/block-view-wrapper flex min-w-0 scroll-mt-24 flex-col-reverse items-stretch gap-4 overflow-hidden md:flex-col"
  style={ "--height": `${block.previewHeight}px` }
>
  // ---- BlockViewerView (desktop/tablet preview, resizable) -----------
  // Declared first so the toolbar below can read `resizableApi`; `order-2`
  // keeps it visually second, matching shadcn's DOM order.
  <div id=`${block.name}-preview` role="tabpanel" aria-label="Preview" class=cn("order-2 hidden md:h-(--height) md:flex", view === "code" && "md:hidden")>
    <div class="relative grid w-full gap-4">
      <div class="absolute inset-0 right-4 [background-image:radial-gradient(#d4d4d4_1px,transparent_1px)] [background-size:20px_20px] dark:[background-image:radial-gradient(#404040_1px,transparent_1px)]"></div>
      <Resizable|panel|/resizableApi
        orientation="horizontal"
        panels=[
          { id: "preview", defaultSize: previewSize, minSize: 30 },
          { id: "spacer", defaultSize: 100 - previewSize, minSize: 0 },
        ]
        class="relative z-10 after:absolute after:inset-0 after:right-3 after:z-0 after:rounded-xl after:bg-surface/50"
      >
        <if=panel.id === "preview">
          <div class="relative aspect-[4/2.5] overflow-hidden rounded-lg border bg-background md:aspect-auto md:rounded-xl">
            <iframe/desktopFrameEl
              title=`${block.title} preview`
              src=`/blocks/view/${block.name}`
              height=block.previewHeight
              loading="lazy"
              class="relative z-20 no-scrollbar w-full bg-background"
            />
          </div>
        </if>
      </Resizable>
    </div>
  </div>

  // ---- BlockViewerToolbar ---------------------------------------------
  <div class="order-1 hidden min-w-0 w-full flex-col gap-3 px-2 md:flex md:pr-4">
    <div class="min-w-0">
      <a href=`#${block.name}` class="text-sm font-medium underline-offset-2 hover:underline">${block.title || block.name}</a>
      <p class="mt-1 text-sm text-muted-foreground">${block.description}</p>
    </div>
    <div class="flex min-w-0 flex-wrap items-center gap-2">
      <Tabs
        value=view
        valueChange(value) { if (value === "preview" || value === "code") view = value; }
        ids={ content: (value: string) => `${block.name}-${value}` }
        class="shrink-0 gap-0! **:data-[slot=tabs-list]:h-8! **:data-[slot=tabs-trigger]:h-6! **:data-[slot=tabs-trigger]:px-2! **:data-[slot=tabs-trigger]:py-0! **:data-[slot=tabs-trigger]:text-xs!"
      >
        <@trigger value="preview">Preview</@trigger>
        <@trigger value="code">Code</@trigger>
      </Tabs>
      <div class="ml-auto flex min-w-0 flex-wrap items-center gap-2">
        <div class="flex h-8 items-center gap-1.5 rounded-md border p-[3px] shadow-none">
          <ToggleGroup
            aria-label="Preview viewport"
            value=[String(previewSize)]
            size="sm"
            spacing=1
            onValueChange(details) {
              const size = Number(details.value[0]);
              if (size !== 100 && size !== 60 && size !== 30) return;
              view = "preview";
              previewSize = size;
              resizableApi().setSizes([size, 100 - size]);
            }
            class="*:size-6! *:min-w-0! *:rounded-sm! *:p-0!"
          >
            <@item value="100">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
              <span class="sr-only">Desktop</span>
            </@item>
            <@item value="60">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="12" x2="12.01" y1="18" y2="18"/></svg>
              <span class="sr-only">Tablet</span>
            </@item>
            <@item value="30">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>
              <span class="sr-only">Mobile</span>
            </@item>
          </ToggleGroup>
          <Separator orientation="vertical" class="h-4!"/>
          <a
            href=`/blocks/view/${block.name}`
            target="_blank"
            rel="noreferrer"
            title="Open in New Tab"
            class="inline-flex size-6 items-center justify-center rounded-sm p-0 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <span class="sr-only">Open in New Tab</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
          </a>
          <Separator orientation="vertical" class="h-4!"/>
          <button
            type="button"
            title="Refresh Preview"
            class="inline-flex size-6 items-center justify-center rounded-sm p-0 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            onClick() {
              // The desktop iframe is rendered inside Resizable's body;
              // resolve both frames from this viewer's own DOM container.
              for (const frame of viewerEl()?.querySelectorAll("iframe") ?? []) {
                frame.src = frame.src;
              }
            }
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg>
            <span class="sr-only">Refresh Preview</span>
          </button>
        </div>
        <Separator orientation="vertical" class="mx-1 h-4!"/>
        <Button type="button"
          variant="outline"
          class="min-w-0 max-w-full gap-1 px-2 shadow-none"
          title=installCommand
          aria-label=`Copy install command: ${installCommand}`
          size="sm"
          onClick() {
            navigator.clipboard?.writeText(installCommand);
            copiedInstall = true;
            setTimeout(() => { copiedInstall = false; }, 2000);
          }
        >
          <if=copiedInstall>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
          </if>
          <else>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
          </else>
          <span class="truncate font-mono text-xs">${installCommand}</span>
        </Button>
      </div>
    </div>
  </div>

  // ---- BlockViewerCode (file tree + source) ---------------------------
  <div id=`${block.name}-code` role="tabpanel" aria-label="Code" class=cn("order-3 mr-[14px] overflow-hidden rounded-xl border bg-code text-code-foreground md:h-(--height)", view === "code" ? "flex" : "hidden")>
    <if=manifest>
      <div class="w-48 shrink-0 overflow-auto border-r lg:w-72">
        <div class="flex h-12 items-center border-b px-4 text-sm font-medium">
          Files
        </div>
        <nav class="flex flex-col gap-1.5 p-2" data-slot="block-viewer-file-tree">
          <for|node| of=manifest.tree by=(node) => node.name>
            <block-viewer-tree-node
              node=node
              depth=1
              activeFile=activeFile
              onSelect(target: string) { activeFile = target; }
            />
          </for>
        </nav>
      </div>
      <if=activeManifestFile>
        <figure/codePanelEl class="mx-0! mt-0 flex min-w-0 flex-1 flex-col rounded-xl border-none">
          <figcaption class="flex h-12 shrink-0 items-center gap-2 border-b px-4 py-2 text-code-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 opacity-70"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span class="min-w-0 truncate">${activeManifestFile.target}</span>
            <div class="ml-auto flex items-center gap-2">
              <button
                type="button"
                class="inline-flex size-7 items-center justify-center rounded-md text-code-foreground/70 transition-colors hover:bg-white/10 hover:text-code-foreground"
                onClick() {
                  navigator.clipboard?.writeText(activeManifestFile?.content ?? "");
                  copiedFile = true;
                  setTimeout(() => { copiedFile = false; }, 2000);
                }
              >
                <if=copiedFile>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 6 9 17l-5-5"/></svg>
                </if>
                <else>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
                </else>
              </button>
            </div>
          </figcaption>
          // SSR-time shiki highlighting (src/lib/highlight-code.ts). Every
          // file is highlighted once, inside a single <await> (see the
          // comment by `manifestFiles` above for why per-file reactivity
          // doesn't work here) — `hidden` below reflects only the file that
          // was active at render/hydration time. The <script> further down
          // reacts to later `activeFile` changes and flips `.hidden`
          // directly via querySelector, entirely outside this <await>.
          <await|highlightedFiles|=highlightManifestFiles(manifestFiles)>
            <for|file| of=manifestFiles by=(f) => f.target>
              <pre data-file-target=file.target hidden=file.target !== activeFile class="no-scrollbar h-full overflow-auto p-4 text-[0.8125rem] leading-6"><code class="font-mono">$!{highlightedFiles[file.target] ?? ""}</code></pre>
            </for>
          </await>
        </figure>
      </if>
    </if>
  </div>

  // ---- BlockViewerMobile ----------------------------------------------
  <div class="order-4 flex min-w-0 flex-col gap-2 md:hidden">
    <div class="min-w-0 px-2">
      <a href=`#${block.name}` class="text-sm font-medium underline-offset-2 hover:underline">${block.title || block.name}</a>
      <p class="mt-1 min-w-0 line-clamp-1 text-sm text-muted-foreground">${block.description}</p>
    </div>
    <div class="overflow-hidden rounded-xl border">
      <iframe/mobileFrameEl
        src=`/blocks/view/${block.name}`
        height=block.previewHeight
        loading="lazy"
        title=`${block.title} preview`
        class="no-scrollbar w-full bg-background"
      />
    </div>
  </div>
</div>

// Drives the code panel's visible file when `activeFile` changes — the
// panels themselves are pre-rendered (all files, highlighted, `hidden`
// except the initially-active one) inside the <await> above; content and
// attributes declared inside that <await> body don't participate in Marko's
// reactivity afterward (see the comment there), so this reacts to
// `activeFile` from OUTSIDE it and flips `.hidden` directly via
// querySelector — a tag variable is a function per this codebase's Marko 6
// conventions, so `codePanelEl()` calls it to get the node.
<script>
  const panel = codePanelEl();
  if (panel) {
    for (const pre of panel.querySelectorAll<HTMLElement>("[data-file-target]")) {
      pre.hidden = pre.getAttribute("data-file-target") !== activeFile;
    }
  }
</script>
