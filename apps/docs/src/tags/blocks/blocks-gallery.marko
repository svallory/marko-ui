import "./blocks-nav.marko";
import "./block-preview.marko";
import { blocksInCategory, BLOCK_CATEGORIES } from "../../lib/blocks-list.ts";

export interface Input {
  /** "" for the featured/all view, otherwise a category slug. */
  categorySlug: string;
}

<const/blocks=blocksInCategory(input.categorySlug)/>
<const/categoryName=BLOCK_CATEGORIES.find((category) => category.slug === input.categorySlug)?.name
  ?? "Blocks"/>

<main data-slot="blocks-page">
  <div class="border-b">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Building Blocks for Marko
      </h1>
      <p class="mt-3 max-w-2xl text-base text-muted-foreground text-balance">
        Whole-page compositions built from marko-ui components. Copy and paste them into
        your @marko/run app, or install them with the shadcn CLI. Open source. Free forever.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a
          href="#blocks"
          class="inline-flex h-8 items-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Browse Blocks
        </a>
        <a
          href="/"
          class="inline-flex h-8 items-center rounded-md px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          View Components
        </a>
      </div>
    </div>
  </div>

  <div id="blocks" class="sticky top-14 z-40 border-b bg-background/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center px-4 py-2 sm:px-6 lg:px-8">
      <blocks-nav activeSlug=input.categorySlug/>
    </div>
  </div>

  <div class="bg-muted/30">
    <div class="mx-auto max-w-6xl space-y-16 px-4 py-10 sm:px-6 lg:px-8 md:py-14">
      <if=blocks.length === 0>
        <p class="text-sm text-muted-foreground">
          No blocks in the ${categoryName} category yet.
        </p>
      </if>
      <else>
        <for|block| of=blocks by=(block) => block.name>
          <block-preview block=block/>
        </for>
      </else>

      <div class="rounded-xl border border-dashed bg-background p-8 text-center">
        <h2 class="text-base font-semibold">Chart blocks coming</h2>
        <p class="mx-auto mt-2 max-w-xl text-sm text-muted-foreground">
          The full shadcn block catalog — dashboard, sidebar shells, login and
          signup screens, and calendar — is ported. Chart blocks arrive with the
          zero-JavaScript chart components currently in development.
        </p>
      </div>
    </div>
  </div>
</main>
