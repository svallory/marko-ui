// Faithful port of shadcn/ui's app/(app)/blocks/layout.tsx (PageHeader +
// PageNav chrome) and page.tsx / [...categories]/page.tsx (the block list
// itself), merged into one tag since our router calls this the same way for
// both the featured "/blocks" route and "/blocks/$category". shadcn's
// FEATURED_BLOCKS constant (dashboard-01, sidebar-07, sidebar-03, login-03,
// login-04) is mirrored for the featured/"" slug; every other slug lists the
// full category, matching [...categories]/page.tsx's getAllBlockIds.
import "./blocks-nav.marko";
import "./block-viewer.marko";
import { buttonVariants } from "@marko-ui/registry/ui/button/variants.ts";
import { badgeVariants } from "@marko-ui/registry/ui/badge/variants.ts";
import { cn } from "@marko-ui/registry/lib/utils.ts";
import { blocksInCategory, findBlock, BLOCK_CATEGORIES } from "../../lib/blocks-list.ts";

export interface Input {
  /** "" for the featured/all view, otherwise a category slug. */
  categorySlug: string;
}

// shadcn/app/(app)/blocks/page.tsx's FEATURED_BLOCKS, in that order.
static const FEATURED_BLOCK_NAMES = ["dashboard-01", "sidebar-07", "sidebar-03", "login-03", "login-04"];

<const/isFeatured=input.categorySlug === ""/>
<const/blocks=isFeatured
  ? FEATURED_BLOCK_NAMES.map((name) => findBlock(name)).filter((block) => block !== undefined)
  : blocksInCategory(input.categorySlug)/>

// ---- PageHeader (shadcn components/page-header.tsx, via blocks/layout.tsx) ----
<section class="border-grid">
  <div class="container-wrapper">
    <div class="container flex flex-col items-center gap-2 px-6 py-8 text-center md:py-16 lg:py-20 xl:gap-4">
      <a href="/docs" data-slot="badge" class=cn(badgeVariants({ variant: "secondary" }), "bg-muted")>
        Built on the marko-ui registry
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <h1 class="leading-tighter max-w-3xl text-3xl font-semibold tracking-tight text-balance text-primary lg:leading-[1.1] lg:font-semibold xl:text-5xl xl:tracking-tighter">
        Building Blocks for the Web
      </h1>
      <p class="max-w-4xl text-base text-balance text-foreground sm:text-lg">
        Clean, modern building blocks. Copy and paste into your apps. Works with all Marko frameworks. Open Source. Free forever.
      </p>
      <div class="flex w-full items-center justify-center gap-2 pt-2 **:data-[slot=button]:shadow-none">
        <a href="#blocks" data-slot="button" class=buttonVariants({ size: "sm" })>Browse Blocks</a>
        <a href="/docs/components" data-slot="button" class=buttonVariants({ variant: "ghost", size: "sm" })>View Components</a>
      </div>
    </div>
  </div>
</section>

// ---- PageNav (shadcn components/page-nav.tsx) ----
<div id="blocks" class="container-wrapper scroll-mt-24">
  <div class="container flex items-center justify-between gap-4 py-4">
    <blocks-nav activeSlug=input.categorySlug/>
    <a
      href="/blocks/sidebar"
      data-slot="button"
      class=cn(buttonVariants({ variant: "secondary", size: "sm" }), "mr-7 hidden shadow-none lg:flex")
    >
      Browse all blocks
    </a>
  </div>
</div>

// ---- Block list (shadcn app/(app)/blocks/page.tsx and [...categories]/page.tsx) ----
<div class="container-wrapper section-soft flex-1 md:py-12">
  <div class="container flex flex-col gap-12 md:gap-24">
    <if=blocks.length === 0>
      <p class="text-sm text-muted-foreground">
        No blocks in the ${BLOCK_CATEGORIES.find((category) => category.slug === input.categorySlug)?.name ?? "Blocks"} category yet.
      </p>
    </if>
    <else>
      <for|block| of=blocks by=(block) => block.name>
        <block-viewer block=block/>
      </for>
    </else>
    <if=isFeatured>
      <div class="container-wrapper">
        <div class="container flex justify-center py-6">
          <a href="/blocks/sidebar" data-slot="button" class=buttonVariants({ variant: "outline" })>
            Browse more blocks
          </a>
        </div>
      </div>
    </if>
  </div>
</div>
