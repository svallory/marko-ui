<let/isMarko=false/>

<script>
  isMarko = document.documentElement.classList.contains("theme-marko");
</script>

<button
  type="button"
  data-slot="palette-toggle"
  aria-label="Toggle Marko brand chart colors"
  aria-pressed=isMarko
  class="inline-flex size-8 items-center justify-center rounded-md text-foreground outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring"
  onClick() {
    const nextIsMarko = !document.documentElement.classList.contains("theme-marko");
    document.documentElement.classList.toggle("theme-marko", nextIsMarko);
    try {
      localStorage.setItem("chart-palette", nextIsMarko ? "marko" : "neutral");
    } catch (error) {}
    isMarko = nextIsMarko;
  }
>
  <if=isMarko>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25"/>
      <path d="M7.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M11.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M15.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
    </svg>
  </if>
  <else>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="M15 15h-1a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25a9 9 0 0 1 -6.372 -15.356"/>
      <path d="M8 4c1.236 -.623 2.569 -1 4 -1c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828a4.516 4.516 0 0 1 -1.127 .73"/>
      <path d="M7.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M11.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M15.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M3 3l18 18"/>
    </svg>
  </else>
  <span class="sr-only">Toggle Marko brand chart colors</span>
</button>
