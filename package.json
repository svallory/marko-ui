{
  "name": "marko-ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "vitest run",
    "build:registry": "bun packages/registry/scripts/build-registry.ts",
    "extract:api": "bun packages/registry/scripts/extract-api.ts",
    "build:demos": "bun apps/docs/scripts/build-demos-manifest.ts",
    "build:blocks-manifest": "bun apps/docs/scripts/build-blocks-manifest.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@marko/type-check": "^3.2.0",
    "@marko/vite": "^6.1.9",
    "@types/node": "^26.2.0",
    "@zag-js/tabs": "1.43.0",
    "marko": "6.3.34",
    "prettier": "^3.9.6",
    "prettier-plugin-marko": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@zag-js/core": "^1.43.0",
    "@zag-js/types": "^1.43.0"
  }
}
